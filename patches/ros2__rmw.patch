+#ifndef RMW__NAMES_AND_TYPES_H_
+#define RMW__NAMES_AND_TYPES_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include <stddef.h>
+
+#include "rcutils/allocator.h"
+#include "rcutils/types.h"
+#include "rmw/macros.h"
+#include "rmw/types.h"
+#include "rmw/visibility_control.h"
+
+/// 主题或服务名称与类型的关联数组。
+typedef struct RMW_PUBLIC_TYPE rmw_names_and_types_s
+{
+  /// 名称数组
+  rcutils_string_array_t names;
+
+  /// 类型名称数组的动态数组，长度与 `names` 相同
+  rcutils_string_array_t * types;
+} rmw_names_and_types_t;
+
+/// 返回一个零初始化的名称与类型数组。
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_names_and_types_t
+rmw_get_zero_initialized_names_and_types(void);
+
+/// 检查给定的 `names_and_types` 数组是否为零初始化。
+/**
+ * <hr>
+ * 属性               | 符合情况
+ * ------------------ | -------------
+ * 分配内存           | 否
+ * 线程安全           | 是
+ * 使用原子操作       | 否
+ * 无锁               | 是
+ *
+ * \par 线程安全
+ *   对名称与类型数组的访问是只读的，但不同步。
+ *   并发读取 `names_and_types` 是安全的，但并发读写不安全。
+ *
+ * \param[in] names_and_types 要检查的数组。
+ * \return 如果数组为零初始化则返回 RMW_RET_OK，否则返回 RMW_RET_INVALID_ARGUMENT。
+ * \remark 此函数在失败时会设置 RMW 错误状态。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_names_and_types_check_zero(rmw_names_and_types_t * names_and_types);
+
+/// 初始化一个名称与类型数组。
+/**
+ * 此函数初始化名称的字符串数组，并根据给定大小为所有类型的字符串数组分配空间，
+ * 但不会初始化每组类型的字符串数组。
+ * 不过，每组类型的字符串数组会被零初始化。
+ *
+ * <hr>
+ * 属性               | 符合情况
+ * ------------------ | -------------
+ * 分配内存           | 是
+ * 线程安全           | 否
+ * 使用原子操作       | 否
+ * 无锁               | 是
+ *
+ * \par 线程安全
+ *   初始化是可重入过程，但：
+ *   - 对名称与类型数组的访问不同步。
+ *     在初始化期间读取或写入 `names_and_types` 不安全。
+ *   - 默认分配器是线程安全对象，但任何自定义 `allocator` 可能不是。
+ *     请查阅分配器文档以获取更多参考。
+ *
+ * \param[inout] names_and_types 成功时要初始化的数组，
+ *   失败时保持不变。
+ * \param[in] size 数组大小。
+ * \param[in] allocator 用于填充 `names_and_types` 的分配器。
+ * \returns 成功时返回 `RMW_RET_OK`，或者
+ * \returns 如果 `names_and_types` 为 NULL 则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \returns 如果 `names_and_types` 不是
+ *   零初始化数组则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \returns 如果 `allocator` 无效（按 rcutils_allocator_is_valid() 定义）
+ *   则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \returns 如果内存分配失败则返回 `RMW_BAD_ALLOC`，或者
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ * \remark 此函数在失败时会设置 RMW 错误状态。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_names_and_types_init(
+  rmw_names_and_types_t * names_and_types,
+  size_t size,
+  rcutils_allocator_t * allocator);
+
+/// 终结一个名称与类型数组。
+/**
+ * 此函数释放名称的字符串数组以及类型的字符串数组，
+ * 并将给定数组零初始化。
+ * 如果发生逻辑错误（例如 `RMW_RET_INVALID_ARGUMENT`），此函数将提前返回，
+ * 使给定数组保持不变。
+ * 否则，即使有错误也会继续执行。
+ *
+ * <hr>
+ * 属性               | 符合情况
+ * ------------------ | -------------
+ * 分配内存           | 否
+ * 线程安全           | 否
+ * 使用原子操作       | 否
+ * 无锁               | 是
+ *
+ * \par 线程安全
+ *   终结是可重入过程，但对名称与类型数组的访问不同步。
+ *   在初始化期间读取或写入 `names_and_types` 不安全。
+ *
+ * \param[inout] names_and_types 要终结的数组。
+ * \returns 成功时返回 `RMW_RET_OK`，或者
+ * \returns 如果 `names_and_types` 为 NULL 则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ * \remark 此函数在失败时会设置 RMW 错误状态。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_names_and_types_fini(rmw_names_and_types_t * names_and_types);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__NAMES_AND_TYPES_H_
