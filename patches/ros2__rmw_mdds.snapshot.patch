+TEST(WaitValidation, later_invalid_collection_does_not_consume_triggered_guard)
+{
+  rmw_mdds::MddsWaitSet wait_impl;
+  rmw_wait_set_t wait_set{};
+  wait_set.implementation_identifier = rmw_mdds::identifier;
+  wait_set.data = &wait_impl;
+
+  rmw_mdds::MddsGuardCondition guard_impl;
+  guard_impl.trigger();
+  void * guard_entry = &guard_impl;
+  rmw_guard_conditions_t guard_conditions{1, &guard_entry};
+
+  std::array<void *, 2> service_entries{&wait_impl, nullptr};
+  const std::array<void *, 2> original_services = service_entries;
+  rmw_services_t invalid_services{service_entries.size(), service_entries.data()};
+  const rmw_time_t no_wait{0, 0};
+
+  EXPECT_EQ(
+    RMW_RET_INVALID_ARGUMENT,
+    rmw_wait(
+      nullptr, &guard_conditions, &invalid_services, nullptr, nullptr,
+      &wait_set, &no_wait));
+  EXPECT_EQ(original_services, service_entries);
+  EXPECT_EQ(&guard_impl, guard_entry);
+  EXPECT_TRUE(rcutils_error_is_set());
+  rcutils_reset_error();
+
+  // A second, otherwise-valid wait still observes the edge. Validation of a
+  // later collection therefore happened before any guard polling/consumption.
+  EXPECT_EQ(
+    RMW_RET_OK,
+    rmw_wait(nullptr, &guard_conditions, nullptr, nullptr, nullptr, &wait_set, &no_wait));
+  EXPECT_EQ(&guard_impl, guard_entry);
+  EXPECT_FALSE(guard_impl.check_and_clear());
+}
