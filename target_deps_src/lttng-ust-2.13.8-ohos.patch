diff --git a/src/lib/lttng-ust-common/ust-cancelstate.c b/src/lib/lttng-ust-common/ust-cancelstate.c
index e42c7b4..4ed93c0 100644
--- a/src/lib/lttng-ust-common/ust-cancelstate.c
+++ b/src/lib/lttng-ust-common/ust-cancelstate.c
@@ -26,7 +26,15 @@ int lttng_ust_cancelstate_disable_push(void)
 
 	if (state->nesting++)
 		goto end;
+#ifdef __MUSL__
+	/* OHOS musl has no thread cancellation (no pthread_setcancelstate);
+	 * cancellation never happens, so the push/pop bookkeeping alone is
+	 * sufficient. */
+	ret = 0;
+	oldstate = 0;
+#else
 	ret = pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &oldstate);
+#endif
 	if (ret) {
 		ERR("pthread_setcancelstate: ret=%d", ret);
 		return -1;
@@ -45,15 +53,23 @@ int lttng_ust_cancelstate_disable_pop(void)
 		return -1;
 	if (--state->nesting)
 		goto end;
+#ifdef __MUSL__
+	/* OHOS musl: no pthread_setcancelstate; see _push(). */
+	ret = 0;
+	oldstate = 0;
+#else
 	ret = pthread_setcancelstate(state->oldstate, &oldstate);
+#endif
 	if (ret) {
 		ERR("pthread_setcancelstate: ret=%d", ret);
 		return -1;
 	}
+#ifndef __MUSL__
 	if (oldstate != PTHREAD_CANCEL_DISABLE) {
 		ERR("pthread_setcancelstate: unexpected oldstate");
 		return -1;
 	}
+#endif
 end:
 	return 0;
 }
