+TEST_F(MddsEventCrossContextTest, callback_clear_in_other_context_retires_old_user_data)
+{
+  rmw_subscription_t * sub_a = make_sub(context_a_, kTopicCrossContextA);
+  ASSERT_NE(nullptr, sub_a);
+  rmw_subscription_t * sub_b = make_sub(context_b_, kTopicCrossContextB);
+  ASSERT_NE(nullptr, sub_b);
+
+  rmw_event_t event_a = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_a, sub_a, RMW_EVENT_SUBSCRIPTION_MATCHED));
+  rmw_event_t event_b = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_b, sub_b, RMW_EVENT_SUBSCRIPTION_MATCHED));
+
+  CrossContextClearRig rig;
+  rig.event_b = &event_b;
+  ASSERT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_a, cross_context_a_cb, &rig));
+  ASSERT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_b, cross_context_b_cb, &rig));
+
+  rmw_publisher_t * pub_a = nullptr;
+  rmw_publisher_t * pub_b = nullptr;
+  std::thread a_thread([&] {pub_a = make_pub(context_a_, kTopicCrossContextA);});
+  const bool a_entered =
+    wait_until([&rig] {return rig.a_entered.load(std::memory_order_acquire);});
+  std::thread b_thread([&] {
+      rig.b_create_started.store(true, std::memory_order_release);
+      pub_b = make_pub(context_b_, kTopicCrossContextB);
+    });
+  a_thread.join();
+  b_thread.join();
+
+  EXPECT_TRUE(a_entered);
+  EXPECT_NE(nullptr, pub_a);
+  EXPECT_NE(nullptr, pub_b);
+  EXPECT_FALSE(rig.error.load(std::memory_order_acquire));
+  EXPECT_TRUE(rig.clear_returned.load(std::memory_order_acquire));
+  // B's delivery was already in flight while A cleared it. It must have been
+  // fenced before calling the old callback, otherwise freeing its user_data at
+  // clear_returned would be a UAF.
+  EXPECT_FALSE(rig.b_callback_started.load(std::memory_order_acquire));
+  EXPECT_FALSE(rig.b_callback_after_clear.load(std::memory_order_acquire));
+
+  EXPECT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_a, nullptr, nullptr));
+  if (pub_a != nullptr) {
+    EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(context_a_.node, pub_a));
+  }
+  if (pub_b != nullptr) {
+    EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(context_b_.node, pub_b));
+  }
+  take_matched(&event_a);
+  take_matched(&event_b);
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(context_a_.node, sub_a));
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(context_b_.node, sub_b));
+}
+
+TEST_F(
+  MddsEventCrossContextTest,
+  deferred_pending_callback_is_retired_before_other_context_fini)
+{
+  rmw_subscription_t * sub_b = make_sub(context_b_, kTopicCrossContextB);
+  ASSERT_NE(nullptr, sub_b);
+  rmw_event_t event_b = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_b, sub_b, RMW_EVENT_SUBSCRIPTION_MATCHED));
+
+  // Establish B's pending state before it has a callback.
+  rmw_publisher_t * pub_b = make_pub(context_b_, kTopicCrossContextB);
+  ASSERT_NE(nullptr, pub_b);
+
+  rmw_subscription_t * sub_a = make_sub(context_a_, kTopicCrossContextA);
+  ASSERT_NE(nullptr, sub_a);
+  rmw_event_t event_a = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_a, sub_a, RMW_EVENT_SUBSCRIPTION_MATCHED));
+
+  CrossContextFiniRig rig;
+  rig.event_b = &event_b;
+  rig.node_b = &context_b_.node;
+  rig.pub_b = &pub_b;
+  rig.sub_b = &sub_b;
+  rig.context_b = &context_b_.context;
+  rig.options_b = &context_b_.options;
+  ASSERT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_a, cross_context_fini_a_cb, &rig));
+
+  // This runs A's callback synchronously. B is finalized before the outer
+  // event dispatcher drains its pending callback snapshot.
+  rmw_publisher_t * pub_a = make_pub(context_a_, kTopicCrossContextA);
+  ASSERT_NE(nullptr, pub_a);
+
+  EXPECT_EQ(1u, rig.hits_a.load());
+  EXPECT_TRUE(rig.callback_set.load(std::memory_order_acquire));
+  EXPECT_TRUE(rig.fini_returned.load(std::memory_order_acquire));
+  EXPECT_FALSE(rig.failed.load(std::memory_order_acquire));
+  // Context fini retired B's pending callback; it must never run after the
+  // fini boundary, and no stale raw event pointer may be dereferenced.
+  EXPECT_EQ(0u, rig.hits_b.load());
+  EXPECT_EQ(nullptr, context_b_.node);
+  EXPECT_EQ(nullptr, context_b_.context.implementation_identifier);
+  EXPECT_EQ(nullptr, context_b_.options.implementation_identifier);
+
+  EXPECT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_a, nullptr, nullptr));
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(context_a_.node, pub_a));
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(context_a_.node, sub_a));
+}
+
+TEST_F(
+  MddsEventCrossContextTest,
+  deferred_pending_callback_pins_context_against_concurrent_fini)
+{
+  rmw_subscription_t * sub_b = make_sub(context_b_, kTopicCrossContextB);
+  ASSERT_NE(nullptr, sub_b);
+  rmw_event_t event_b = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_b, sub_b, RMW_EVENT_SUBSCRIPTION_MATCHED));
+  rmw_publisher_t * pub_b = make_pub(context_b_, kTopicCrossContextB);
+  ASSERT_NE(nullptr, pub_b);
+
+  rmw_subscription_t * sub_a = make_sub(context_a_, kTopicCrossContextA);
+  ASSERT_NE(nullptr, sub_a);
+  rmw_event_t event_a = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_a, sub_a, RMW_EVENT_SUBSCRIPTION_MATCHED));
+
+  ConcurrentContextFiniRig rig;
+  rig.event_b = &event_b;
+  rig.node_b = &context_b_.node;
+  rig.pub_b = &pub_b;
+  rig.sub_b = &sub_b;
+  rig.context_b = &context_b_.context;
+  rig.options_b = &context_b_.options;
+  ASSERT_EQ(
+    RMW_RET_OK,
+    rmw_event_set_callback(&event_a, concurrent_context_fini_a_cb, &rig));
+
+  std::thread finalizer([&rig] {
+      if (!wait_until([&rig] {return rig.callback_set.load(std::memory_order_acquire);})) {
+        rig.failed.store(true, std::memory_order_release);
+        return;
+      }
+      // Keep endpoint destruction from trying to invoke B while A owns the
+      // global callback strand. This does not remove A's already-queued raw
+      // snapshot or its dispatch pin.
+      if (rmw_event_set_callback(rig.event_b, nullptr, nullptr) != RMW_RET_OK) {
+        rig.failed.store(true, std::memory_order_release);
+        return;
+      }
+      if (*rig.pub_b != nullptr &&
+      rmw_destroy_publisher(*rig.node_b, *rig.pub_b) != RMW_RET_OK)
+      {
+        rig.failed.store(true, std::memory_order_release);
+        return;
+      }
+      *rig.pub_b = nullptr;
+      if (*rig.sub_b != nullptr &&
+      rmw_destroy_subscription(*rig.node_b, *rig.sub_b) != RMW_RET_OK)
+      {
+        rig.failed.store(true, std::memory_order_release);
+        return;
+      }
+      *rig.sub_b = nullptr;
+      if (*rig.node_b != nullptr &&
+      rmw_destroy_node(*rig.node_b) != RMW_RET_OK)
+      {
+        rig.failed.store(true, std::memory_order_release);
+        return;
+      }
+      *rig.node_b = nullptr;
+      if (rmw_shutdown(rig.context_b) != RMW_RET_OK) {
+        rig.failed.store(true, std::memory_order_release);
+        return;
+      }
+      rig.finalizer_entered.store(true, std::memory_order_release);
+      if (rmw_context_fini(rig.context_b) != RMW_RET_OK ||
+      rmw_init_options_fini(rig.options_b) != RMW_RET_OK)
+      {
+        rig.failed.store(true, std::memory_order_release);
+        return;
+      }
+      // On the vulnerable implementation fini returned before the deferred
+      // raw B event was consumed. Reuse the allocation before A unwinds.
+      for (size_t i = 0; i < 64; ++i) {
+        rig.allocation_churn.emplace_back(std::make_unique<rmw_mdds::MddsEvent>());
+      }
+      rig.finalizer_done.store(true, std::memory_order_release);
+    });
+
+  rmw_publisher_t * pub_a = make_pub(context_a_, kTopicCrossContextA);
+  if (finalizer.joinable()) {
+    finalizer.join();
+  }
+  EXPECT_NE(nullptr, pub_a);
+  EXPECT_EQ(1u, rig.hits_a.load());
+  EXPECT_TRUE(rig.callback_set.load(std::memory_order_acquire));
+  EXPECT_TRUE(rig.finalizer_entered.load(std::memory_order_acquire));
+  EXPECT_TRUE(rig.finalizer_done.load(std::memory_order_acquire));
+  EXPECT_FALSE(rig.finalizer_finished_while_a_active.load(std::memory_order_acquire));
+  EXPECT_FALSE(rig.failed.load(std::memory_order_acquire));
+  EXPECT_EQ(0u, rig.hits_b.load());
+  EXPECT_EQ(nullptr, context_b_.node);
+  EXPECT_EQ(nullptr, context_b_.context.implementation_identifier);
+  EXPECT_EQ(nullptr, context_b_.options.implementation_identifier);
+
+  EXPECT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_a, nullptr, nullptr));
+  if (pub_a != nullptr) {
+    EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(context_a_.node, pub_a));
+  }
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(context_a_.node, sub_a));
+}
