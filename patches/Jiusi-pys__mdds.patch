+     LivePeerAcceptsFirstNonceAndRejectsChangedNonceWithoutSideEffects) {
+  auto cfg = raw_admission_config();
+  cfg.announce_period_ms = 60000;
+  cfg.udp_announce_ms = 100;
+  std::atomic<size_t> outbound_announces{0};
+  cfg.test_send_hook = [&](const uint8_t *frame, size_t len) {
+    mdds::FrameHeader header{};
+    if (mdds::decode_header(frame, len, header) &&
+        header.type == mdds::FrameType::ANNOUNCE) {
+      outbound_announces.fetch_add(1, std::memory_order_relaxed);
+    }
+    return false;
+  };
+
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+
+  mdds::SessionChallengeBody receiver_challenge;
+  ASSERT_TRUE(peer.session_challenge(cfg.domain_id, kTestBasePort5,
+                                     receiver_challenge, true));
+  ASSERT_TRUE(wait_until(
+      [&] { return outbound_announces.load(std::memory_order_relaxed) >= 1; },
+      2s, 5ms));
+
+  const auto remote = raw_remote_snapshot(0x81, {});
+  const auto first_nonce = raw_challenge_nonce(0x81);
+  const auto first_challenge =
+      mdds::encode_session_challenge(remote.participant_guid, first_nonce);
+  ASSERT_FALSE(first_challenge.empty());
+  const auto announces_before =
+      outbound_announces.load(std::memory_order_relaxed);
+  ASSERT_TRUE(peer.send_frame(first_challenge, kTestBasePort5));
+  const mdds::AnnounceChallengeEcho expected{true, remote.participant_guid,
+                                             first_nonce};
+  ASSERT_TRUE(wait_for_announce_echo(peer, expected));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        return outbound_announces.load(std::memory_order_relaxed) >=
+               announces_before + 1;
+      },
+      2s, 5ms));
+  EXPECT_TRUE(target->remote_participants().empty());
+
+  const auto announces_after_first =
+      outbound_announces.load(std::memory_order_relaxed);
+  const auto changed_nonce = raw_challenge_nonce(0x82);
+  ASSERT_NE(changed_nonce, first_nonce);
+  const auto changed_challenge =
+      mdds::encode_session_challenge(remote.participant_guid, changed_nonce);
+  ASSERT_FALSE(changed_challenge.empty());
+  ASSERT_TRUE(peer.send_frame(changed_challenge, kTestBasePort5));
+
+  const auto settle_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < settle_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_EQ(outbound_announces.load(std::memory_order_relaxed),
+            announces_after_first);
+  EXPECT_TRUE(target->remote_participants().empty());
+}
