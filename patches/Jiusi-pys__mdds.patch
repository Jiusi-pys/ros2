+// Tail-first flood defense: a partial opens ONLY on the offset-0 fragment.
+// 1000 distinct (writer, seq) fragments with offset > 0 create no state and
+// allocate nothing — sparse tail traffic cannot grow the partial map.
+TEST(Reassembler, TailFirstFloodCreatesNoPartials)
+{
+  mdds::Reassembler reasm;
+  auto w = make_test_guid(0x30);
+  std::vector<uint8_t> out;
+  uint8_t b[100] = {};
+
+  for (uint64_t seq = 1; seq <= 1000; ++seq) {
+    EXPECT_FALSE(reasm.add_fragment(w, seq, 1000, 500, b, sizeof(b), out));
+  }
+  EXPECT_EQ(reasm.pending_count(), 0u);
+  EXPECT_EQ(reasm.bytes_in_flight(), 0u);
+  // The offset-0 admission gate is a silent drop, not a budget rejection.
