+// First contact with a reliable writer at seq > 1 must NOT jump the baseline
+// (that would permanently give up recoverable samples). The reader NACKs
+// from 1 instead, and the writer retransmits the head from its history.
+TEST(ReliabilityTest, FirstContactHighSeqRecoversFromWriterHistory) {
+  std::set<uint64_t> dropped;
+  std::mutex drop_mu;
+  auto cfg_a = test_config_3();
+  cfg_a.test_send_hook = [&](const uint8_t *f, size_t n) {
+    mdds::FrameHeader hdr{};
+    if (!mdds::decode_header(f, n, hdr) || hdr.type != mdds::FrameType::DATA) {
+      return false;
+    }
+    mdds::DataBody body{};
+    if (!mdds::decode_data(f, n, body) || body.seq > 5) {
+      return false;
+    }
+    std::lock_guard<std::mutex> lk(drop_mu);
+    return dropped.insert(body.seq).second; // drop only the first copy
+  };
+  auto pa = mdds::Participant::create(cfg_a);
+  auto pb = mdds::Participant::create(test_config_3());
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+
+  auto *w = pa->create_writer("/fc", "test/Fc", default_qos());
+  auto *r = pb->create_reader("/fc", "test/Fc", default_qos());
+  ASSERT_TRUE(wait_matched(w, 1));
+  ASSERT_TRUE(wait_reader_matched(r, 1));
+
+  for (int i = 0; i < 8; ++i) {
+    std::string m = "s" + std::to_string(i + 1);
+    ASSERT_TRUE(
+        w->write(reinterpret_cast<const uint8_t *>(m.data()), m.size()));
+  }
+
+  // The first DATA the reader sees is seq 6 (1..5 lost on the wire). It must
+  // not deliver 6,7,8 and skip the head: everything arrives, in order, and
+  // nothing is counted lost.
+  std::vector<uint64_t> order;
+  auto deadline = std::chrono::steady_clock::now() + 15s;
+  while (std::chrono::steady_clock::now() < deadline && order.size() < 8) {
+    std::vector<uint8_t> out;
+    mdds::MessageInfo info;
+    if (r->take(out, info)) {
+      order.push_back(info.seq);
+    } else {
+      std::this_thread::sleep_for(5ms);
+    }
+  }
+  EXPECT_EQ(order, (std::vector<uint64_t>{1, 2, 3, 4, 5, 6, 7, 8}));
+  EXPECT_EQ(r->messages_lost(), 0u);
+}
