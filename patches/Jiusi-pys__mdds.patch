+TEST_F(DsoftbusTransportFakeTest,
+       OfflineSnapshotRetiresOnceAndPeerCapPreservesLiveAndPendingChannels) {
+  // The transport owns at most 256 routing records.  Fill the table with one
+  // live channel and 255 BindAsync-pending ones, then present an extra online
+  // ID: it must not evict either kind of active ownership to make room.
+  constexpr size_t kPeerCap = 256;
+  constexpr int32_t kLiveFd = 101; // listener Socket() consumes fd 100 first
+  std::vector<std::string> network_ids;
+  network_ids.reserve(kPeerCap + 1);
+  network_ids.emplace_back("fake-live");
+  network_ids.emplace_back("fake-pending");
+  for (size_t i = 2; i < kPeerCap; ++i) {
+    network_ids.emplace_back("fake-cap-" + std::to_string(i));
+  }
+  fake().set_online_nodes(network_ids);
+
+  RecordingListener listener;
+  auto transport = mdds::make_dsoftbus_transport();
+  ASSERT_TRUE(transport->start(config(), &listener));
+  ASSERT_TRUE(fake().wait_for_bind_calls(kPeerCap, 4s));
+
+  emit_bind(kLiveFd, "fake-live");
+  ASSERT_EQ(listener.ups().size(), 1u);
+  EXPECT_EQ(transport->status().peer_count, 1u);
+
+  network_ids.emplace_back("fake-over-cap");
+  fake().set_online_nodes(network_ids);
+  ASSERT_TRUE(fake().wait_for_node_queries(2, 4s));
+  EXPECT_EQ(fake().bind_call_count(), kPeerCap);
+  EXPECT_EQ(transport->status().peer_count, 1u);
+  EXPECT_EQ(fake().shutdown_count(kLiveFd), 0u);
+
+  // A successful empty LNN snapshot means every former ID is offline.  It
+  // tears down the live/pending channels, reports the announced peer exactly
+  // once, and erases its record so a late OnShutdown cannot duplicate it.
+  fake().set_online_nodes({});
+  ASSERT_TRUE(listener.wait_for_down(1, 5s));
+  EXPECT_EQ(listener.downs().size(), 1u);
+  EXPECT_EQ(transport->status().peer_count, 0u);
+  EXPECT_EQ(fake().shutdown_count(kLiveFd), 1u);
+
+  emit_shutdown(kLiveFd, static_cast<ShutdownReason>(0));
+  EXPECT_EQ(listener.downs().size(), 1u);
+
+  transport->stop();
+}
