+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Generic process-wide dispatch registry for C callback APIs that carry no
+// user pointer (e.g. the DSoftBus ISocketListener). One instance is
+// registered at a time. Dispatch stubs Acquire() the live instance under the
+// mutex (inflight++), invoke the handler WITHOUT holding it — handlers reach
+// user callbacks, which may tear the instance down — then Release().
+//
+// Per-generation state (round-4 rework): registration returns a generation
+// token; every generation tracks its own inflight count, its set of
+// in-dispatch drainers, and a cleanup gate. The rules:
+//
+//  - UnregisterAndDrain() closes dispatch for its generation, then waits
+//    until every callback of that generation that is NOT itself draining has
+//    retired (inflight == in-dispatch drainers). ALL drainers of the same
+//    generation wait — a concurrent drainer never gets an early pass while
+//    a parked (non-draining) callback is still executing. A drainer calling
+//    from inside its own dispatched callback tolerates its own frame (and
+//    the frames of other in-dispatch drainers), which is what makes
+//    stop()-from-callback possible without self-deadlock. A drainer frame
+//    is safe to exclude because a frame that entered UnregisterAndDrain
+//    never touches the instance again: the dispatch stub unwinds through
+//    the thread-local marker and Release() only.
+//
+//  - Register()/WaitIdle() block until the slot is free AND the previous
+//    generation is fully retired: drained *and* owner cleanup acknowledged
+//    via MarkCleanupDone(). A new instance can never become dispatchable
+//    while the previous owner's sockets/threads are still being torn down.
+//
+//  - The generation token fences every operation against ABA: a stale
+//    UnregisterAndDrain/MarkCleanupDone from an old owner no-ops.
+//
+// WaitIdle()+mutex()+RegisterLocked() support owners that serialize a
+// multi-step start() against dispatchers: callbacks block in Acquire() until
+// registration completes instead of being dropped against a half-initialized
+// instance. WaitIdle() must be called BEFORE taking mutex() (waiting with
+// the mutex held would starve the old generation's Release()).
+
+#ifndef MDDS_SRC_CALLBACK_REGISTRY_HPP_
+#define MDDS_SRC_CALLBACK_REGISTRY_HPP_
+
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+namespace mdds
+{
+
+template<typename T>
+class CallbackRegistry
+{
+public:
+  /// A dispatch admission can additionally retain the registered object when
+  /// the owner supplied a shared lifetime token at registration time.  The
+  /// raw pointer remains available for C callback adapters, while keep_alive
+  /// makes it safe for such an adapter to run user code that destroys its
+  /// outer (unique_ptr-owned) facade.
+  struct PinnedInstance
+  {
+    T * instance = nullptr;
+    std::shared_ptr<T> keep_alive;
+  };
+
+  /// Block until the registry is registerable: no live instance and the
+  /// previous generation fully retired (drained + cleanup acknowledged + no
+  /// self-draining dispatch frame left to Release()).
+  /// Call WITHOUT holding mutex() — then take mutex() and RegisterLocked().
+  void WaitIdle()
+  {
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait(lock, [this] {
+        return instance_ == nullptr && cleanup_done_ && inflight_ == 0;
+      });
+  }
+
+  /// WaitIdle() + register `inst` as the dispatch target; returns the
+  /// generation token (> 0).
+  uint64_t Register(T * inst)
+  {
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait(lock, [this] {
+        return instance_ == nullptr && cleanup_done_ && inflight_ == 0;
+      });
+    return RegisterLocked(inst);
+  }
+
+  /// Shared-owner variant used by callback adapters whose public facade is
+  /// unique_ptr-owned but whose C callback dispatch must pin the real engine.
+  uint64_t Register(const std::shared_ptr<T> & inst)
+  {
+    if (!inst) {
+      return 0;
+    }
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait(lock, [this] {
+        return instance_ == nullptr && cleanup_done_ && inflight_ == 0;
+      });
+    return RegisterLocked(inst);
+  }
+
+  /// Stop dispatching to generation `gen` and wait until every callback of
+  /// that generation that is not itself draining has retired. Every drainer
+  /// of the generation waits for that quiescence — no early pass for
+  /// concurrent drainers. `self_frames` is the number of newly marked
+  /// dispatch frames owned by this generation; each must later call
+  /// Release(true). Nested C callbacks have multiple pins, so treating this
+  /// as a bool would deadlock a stop initiated by an inner callback while its
+  /// outer callback cannot unwind. Stale tokens (gen != current generation)
+  /// no-op. Returns the number of frames actually admitted as drainers.
+  uint32_t UnregisterAndDrain(T * inst, uint64_t gen, uint32_t self_frames = 0)
+  {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (gen != generation_) {
+      return 0;  // stale owner (ABA fence)
+    }
+    if (instance_ == inst) {
+      instance_ = nullptr;  // close dispatch for this generation
+      // The cleanup owner and every admitted PinnedInstance retain their own
+      // strong token.  Dropping the registry's token here prevents a stopped
+      // generation from being kept alive merely by a closed registry slot.
+      // It must happen only after dispatch admission is closed.
+      keep_alive_.reset();
+    }
+    // Never let a stale/miscomputed caller mask more pins than remain
+    // unmarked. Correct DSoftBus callers provide the exact TLS-stack count;
+    // the clamp makes a counter bug fail closed instead of opening the drain
+    // gate while a foreign callback still owns the instance.
+    const uint32_t available = inflight_ > self_drainers_ ? inflight_ - self_drainers_ : 0;
+    const uint32_t admitted = self_frames < available ? self_frames : available;
+    if (admitted != 0) {
+      self_drainers_ += admitted;
+    }
+    cv_.wait(lock, [this] {return inflight_ <= self_drainers_;});
+    return admitted;
+  }
+
+  /// Acknowledge that generation `gen`'s owner finished its cleanup (threads
+  /// joined, sockets shut). Opens the registration gate for the next
+  /// instance. Stale tokens no-op.
+  void MarkCleanupDone(uint64_t gen)
+  {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (gen != generation_ || instance_ != nullptr) {
+        return;
+      }
+      cleanup_done_ = true;
+    }
+    cv_.notify_all();
+  }
+
+  /// Pin the live instance for one dispatch; nullptr when unregistered.
+  T * Acquire()
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (instance_ == nullptr) {
+      return nullptr;
+    }
+    ++inflight_;
+    return instance_;
+  }
+
+  /// Same admission as Acquire(), plus an optional strong owner pin.  C
+  /// callback stubs must retain this object through their DispatchFrame; a
+  /// callback is allowed to destroy a separate public facade before the stub
+  /// has unwound and called Release().
+  PinnedInstance AcquirePinned()
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (instance_ == nullptr) {
+      return {};
+    }
+    ++inflight_;
+    return PinnedInstance{instance_, keep_alive_};
+  }
+
+  /// Release a dispatch pin. A frame which called UnregisterAndDrain(...,
+  /// true) must pass true so it stops masking other in-flight callbacks once
+  /// it unwinds. Registration remains closed until this last old-generation
+  /// Release(), which prevents an ABA decrement against a new generation.
+  void Release(bool self_in_dispatch_drainer = false)
+  {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      // A mismatched/double Release is a caller bug. Keep the production
+      // counter from wrapping, since a wrapped value would permanently close
+      // the next generation's drain gate.
+      if (inflight_ > 0) {
+        --inflight_;
+      }
+      if (self_in_dispatch_drainer && self_drainers_ > 0) {
+        --self_drainers_;
+      }
+    }
+    cv_.notify_all();
+  }
+
+  /// For owners that must hold the registry mutex across a multi-step
+  /// start(): WaitIdle() first, take mutex(), do setup, RegisterLocked().
+  std::mutex & mutex() {return mutex_;}
+
+  /// Non-blocking admission check for a fail-closed owner. Caller holds
+  /// mutex(): unlike WaitIdle(), this never waits for another live or still
+  /// cleaning generation. A DSoftBus session-name conflict is a startup
+  /// failure, not a reason to hang a second rcl/rmw context indefinitely.
+  bool CanRegisterLocked() const
+  {
+    return instance_ == nullptr && cleanup_done_ && inflight_ == 0;
+  }
+
+  /// Register while holding mutex() (start() serialization, see above).
+  /// Returns 0 when the gate is closed (live instance or unretired previous
+  /// generation — caller skipped WaitIdle()); the caller must fail start().
+  uint64_t RegisterLocked(T * inst)
+  {
+    return RegisterLockedImpl(inst, {});
+  }
+
+  /// Register while holding mutex(), retaining `inst` for dispatch pins.
+  /// See RegisterLocked(T *) for the raw-owner form used by generic tests.
+  uint64_t RegisterLocked(const std::shared_ptr<T> & inst)
+  {
+    if (!inst) {
+      return 0;
+    }
+    return RegisterLockedImpl(inst.get(), inst);
+  }
+
+private:
+  uint64_t RegisterLockedImpl(T * inst, std::shared_ptr<T> keep_alive)
+  {
+    if (!CanRegisterLocked()) {
+      return 0;
+    }
+    instance_ = inst;
+    keep_alive_ = std::move(keep_alive);
+    inflight_ = 0;
+    self_drainers_ = 0;
+    cleanup_done_ = false;  // the new generation owes a cleanup
+    return ++generation_;
+  }
+
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  T * instance_ = nullptr;
+  /// Optional owner pin for AcquirePinned().  Empty for raw registrations
+  /// used by the standalone registry tests.
+  std::shared_ptr<T> keep_alive_;
+  uint64_t generation_ = 0;
+  /// Callbacks of the CURRENT generation currently executing (includes any
+  /// in-dispatch drainer frames below).
+  uint32_t inflight_ = 0;
+  /// Drainers of the current generation waiting from inside their own
+  /// dispatched callback. It counts only frames that have not yet called the
+  /// matching Release(true); this keeps an old dispatch stub from unwinding
+  /// into a newly registered generation.
+  uint32_t self_drainers_ = 0;
+  /// Registration gate: true when no generation owes cleanup (initial state,
+  /// or MarkCleanupDone acknowledged the last unregistered generation).
+  bool cleanup_done_ = true;
+};
+
+}  // namespace mdds
+
+#endif  // MDDS_SRC_CALLBACK_REGISTRY_HPP_
