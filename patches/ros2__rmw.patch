+/// QoS 截止时间默认值。
+#define RMW_QOS_DEADLINE_DEFAULT RMW_DURATION_UNSPECIFIED
+/// 在保持尽可能严格策略的同时匹配大多数端点
+/**
+ * 值为 RMW_DURATION_INFINITE - 1。
+ *
+ * 策略将在创建订阅器或发布器时选择。
+ * 对于订阅器，截止时间将是所有已发现发布器截止时间的最大值。
+ * 对于发布器，截止时间将是所有已发现订阅器截止时间的最小值。
+ *
+ * `rmw_subscription_get_actual_qos` 或 `rmw_publisher_get_actual_qos` 等函数报告的
+ * QoS 策略可能是 best available 或实际截止时间值。
+ *
+ * 服务和客户端不受支持，默认使用 `rmw_qos_profile_services_default` 中的截止时间的值。
+ *
+ * 中间件不期望在创建订阅器或发布器后更新策略，即使所选策略与新发现的端点不兼容。
+ * 因此，应谨慎使用此策略，因为与发现过程竞争可能导致非确定性行为。
+ */
+#define RMW_QOS_DEADLINE_BEST_AVAILABLE {9223372036LL, 854775806LL}
+
+/// QoS 生命周期默认值。
+#define RMW_QOS_LIFESPAN_DEFAULT RMW_DURATION_UNSPECIFIED
+
+/// QoS 活跃度租约时长默认值。
+#define RMW_QOS_LIVELINESS_LEASE_DURATION_DEFAULT RMW_DURATION_UNSPECIFIED
+/// 在保持尽可能严格策略的同时匹配大多数端点
+/**
+ * 值为 RMW_DURATION_INFINITE - 1。
+ *
+ * 策略将在创建订阅器或发布器时选择。
+ * 对于订阅器，租约时长将是所有已发现发布器租约时长的最大值。
+ * 对于发布器，租约时长将是所有已发现订阅器租约时长的最小值。
+ *
+ * `rmw_subscription_get_actual_qos` 或 `rmw_publisher_get_actual_qos` 等函数报告的
+ * QoS 策略可能是 best available 或实际租约时长值。
+ *
+ * 服务和客户端不受支持，默认使用 `rmw_qos_profile_services_default` 中的租约时长的值。
+ *
+ * 中间件不期望在创建订阅器或发布器后更新策略，即使所选策略与新发现的端点不兼容。
+ * 因此，应谨慎使用此策略，因为与发现过程竞争可能导致非确定性行为。
+ */
+#define RMW_QOS_LIVELINESS_LEASE_DURATION_BEST_AVAILABLE {9223372036LL, 854775806LL}
+
+/// ROS 中间件服务质量配置文件。
+typedef struct RMW_PUBLIC_TYPE rmw_qos_profile_s
+{
+  enum rmw_qos_history_policy_e history;
+  /// 消息队列的大小。
+  size_t depth;
+  /// 可靠性 QoS 策略设置
+  enum rmw_qos_reliability_policy_e reliability;
+  /// 持久性 QoS 策略设置
+  enum rmw_qos_durability_policy_e durability;
+  /// 消息预计发送/接收的周期
+  /**
+    * RMW_DURATION_UNSPECIFIED 将使用 RMW 实现的默认值，可能是有限的也可能是无限的。
+    * RMW_DURATION_INFINITE 明确表示消息永远不会错过截止时间预期。
+    */
+  struct rmw_time_s deadline;
+  /// 消息被视为过期且不再有效的年龄
+  /**
+    * RMW_DURATION_UNSPEFICIED 将使用 RMW 实现的默认值，可能是有限的也可能是无限的。
+    * RMW_DURATION_INFINITE 明确表示消息不会过期。
+    */
+  struct rmw_time_s lifespan;
+  /// 活跃度 QoS 策略设置
+  enum rmw_qos_liveliness_policy_e liveliness;
+  /// RMW 节点或发布器必须在此时间内表明其处于活跃状态
+  /**
+    * RMW_DURATION_UNSPEFICIED 将使用 RMW 实现的默认值，可能是有限的也可能是无限的。
+    * RMW_DURATION_INFINITE 明确表示不强制活跃度。
+    */
+  struct rmw_time_s liveliness_lease_duration;
+
+  /// 如果为 true，将绕过所有 ROS 特定的命名空间约定。
+  /**
+   * 例如，在 DDS 和话题的情况下，这意味着典型的 ROS 特定前缀 `rt` 不会按此处所述应用：
+   *
+   *   http://design.ros2.org/articles/topic_and_service_names.html#ros-specific-namespace-prefix
+   *
+   * 当试图将原生 DDS 话题与 ROS 2 话题直接连接时，这可能会很有用。
+   */
+  bool avoid_ros_namespace_conventions;
+} rmw_qos_profile_t;
+
+/// ROS 图实体的全局唯一标识符
+typedef struct RMW_PUBLIC_TYPE rmw_gid_s
+{
+  /// rmw 实现名称
+  const char * implementation_identifier;
+
+  /// GID 字节数据值
+  uint8_t data[RMW_GID_STORAGE_SIZE];
+} rmw_gid_t;
+
+#define RMW_MESSAGE_INFO_SEQUENCE_NUMBER_UNSUPPORTED UINT64_MAX
+
+/// 描述 rmw 消息的信息
+typedef struct RMW_PUBLIC_TYPE rmw_message_info_s
+{
+  /// 发布器发布消息的时间。
+  /**
+   * 获取时间戳的具体点未指定，但应在每次发布过程中一致地取自同一点。
+   */
+  rmw_time_point_value_t source_timestamp;
+  /// 订阅器接收到消息的时间。
+  /**
+   * 获取时间戳的具体点未指定，但应在每次接收消息过程中一致地取自同一点。
+   */
+  rmw_time_point_value_t received_timestamp;
+  /// 由发布器设置的接收消息的序列号。
+  /**
+   * 该序列号由发布器设置，因此与发布器 GID 结合使用时可以唯一标识一条消息。
+   * 对于长时间运行的应用，序列号可能在某个时刻回绕。
+   *
+   * 如果 rmw 实现不支持序列号，其值将为 RMW_MESSAGE_INFO_SEQUENCE_NUMBER_UNSUPPORTED。
+   *
+   * 要求：
+   *
+   * 如果 `psn1` 和 `psn2` 是通过调用 `rmw_take*()` 获得的发布序列号，其中 `psn1` 是在早于 `psn2` 的调用中获得的，
+   * 且两个序列号来自同一发布器（即相同的发布器 gid），则：
+   *
+   * - psn2 > psn1（除非发生回绕）
+   * - `psn2 - psn1 - 1` 是发布器在两次接收消息之间发送的消息数量。
+   *   这些消息可能已被中间发生的其他 `rmw_take*()` 调用取走或丢失。
+   *   当且仅当消息是由发布器连续发送时，`psn2 - psn1 - 1 = 0`。
+   */
+  uint64_t publication_sequence_number;
+  /// 由订阅器设置的接收消息的序列号。
+  /**
+   * 该序列号由订阅器设置，不论消息来自哪个发布器。
+   * 对于长时间运行的应用，序列号可能在某个时刻回绕。
+   *
+   * 如果 rmw 实现不支持序列号，其值将为 RMW_MESSAGE_INFO_SEQUENCE_NUMBER_UNSUPPORTED。
+   *
+   * 要求：
+   *
+   * 如果 `rsn1` 和 `rsn2` 是通过调用 `rmw_take*()` 获得的接收序列号，其中 `rsn1` 是在早于 `rsn2` 的调用中获得的，则：
+   *
+   * - rsn2 > rsn1（除非发生回绕）
+   * - 当且仅当两次 `rmw_take*()` 调用连续发生时，`rsn2 = rsn1 + 1`。
+   */
+  uint64_t reception_sequence_number;
+  /// 发送该消息的发布器的全局唯一标识符。
+  /**
+   * 该标识符在本地上下文中唯一标识发布器，但在其他上下文或进程中不一定相同。
+   * 因此，该标识符将在您的应用中唯一标识发布器，但与另一个应用相比可能不一致。
+   * 即使有此限制，与发布器序列号结合使用时，也可以在本地上下文中唯一标识一条消息。
+   * rmw 实现生成的发布器 GID 可能在某个时刻发生冲突，在这种情况下无法区分哪个发布器发送了消息。
+   * GID 的生成细节取决于 rmw 实现。
+   *
+   * rmw 实现可能需要重用发布器 GID，例如由于唯一标识符耗尽或其他约束，
+   * 在这种情况下，rmw 实现可能会记录发生的情况，但此处未定义该行为。
+   * 但是，如果可能的话，rmw 实现应避免这种情况，并且在实际中应不太可能发生。
+   *
+   * \todo 未来我们希望它能在全局范围内跨上下文、进程和机器唯一标识发布器。
+   */
+  rmw_gid_t publisher_gid;
+
+  /// 该消息是否来自进程内通信
+  bool from_intra_process;
+} rmw_message_info_t;
+
+/// 获取零初始化的消息信息。
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_message_info_t
+rmw_get_zero_initialized_message_info(void);
+
+/// 当历史策略设置为 RMW_QOS_POLICY_HISTORY_KEEP_LAST 时 rmw 队列的默认大小，
+/// 0 表示当前未设置
+enum {RMW_QOS_POLICY_DEPTH_SYSTEM_DEFAULT = 0};
+
+/// 将 rcutils 日志严重级别类型映射为 rmw 特定类型。
+typedef enum RMW_PUBLIC_TYPE
+{
+  /// 调试日志严重级别，用于苛刻的消息
+  RMW_LOG_SEVERITY_DEBUG = RCUTILS_LOG_SEVERITY_DEBUG,
+
+  /// 信息日志严重级别，用于报告预期但不会过多的信息
+  RMW_LOG_SEVERITY_INFO = RCUTILS_LOG_SEVERITY_INFO,
+
+  /// 警告日志严重级别，用于报告可恢复的问题
+  RMW_LOG_SEVERITY_WARN = RCUTILS_LOG_SEVERITY_WARN,
+
+  /// 错误日志严重级别，用于报告不可恢复的问题
+  RMW_LOG_SEVERITY_ERROR = RCUTILS_LOG_SEVERITY_ERROR,
+
+  /// 致命日志严重级别，用于报告导致即将关闭的问题
+  RMW_LOG_SEVERITY_FATAL = RCUTILS_LOG_SEVERITY_FATAL
+} rmw_log_severity_t;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__TYPES_H_
