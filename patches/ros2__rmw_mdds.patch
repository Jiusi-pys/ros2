+#ifndef MDDS_GATEWAY__ACK_FENCE_HPP_
+#define MDDS_GATEWAY__ACK_FENCE_HPP_
+
+#include <atomic>
+#include <chrono>
+#include <functional>
+
+namespace mdds_gateway
+{
+
+/// Result of waiting for one bounded downstream acknowledgement fence.
+enum class AckFenceResult {
+  ACKED,
+  STOPPED,
+  TIMED_OUT,
+};
+
+/// The wait operation is deliberately independent of rclcpp so its deadline
+/// and shutdown semantics can be regression-tested without a live DDS peer.
+struct AckFencePolicy
+{
+  std::chrono::milliseconds poll_interval;
+  std::chrono::milliseconds deadline;
+};
+
+/// Repeatedly invoke `wait_once` until all previously published samples are
+/// acknowledged, the gateway is stopping, or the bounded deadline expires.
+/// Exceptions from `wait_once` deliberately propagate to the caller: the
+/// bridge supplies the rclcpp operation and turns its error into a terminal
+/// gateway failure with the original diagnostic.
+AckFenceResult wait_for_ack_fence(
+  const std::atomic<bool> & running,
+  const AckFencePolicy & policy,
+  const std::function<bool(std::chrono::milliseconds)> & wait_once);
+
+}  // namespace mdds_gateway
+
+#endif  // MDDS_GATEWAY__ACK_FENCE_HPP_
