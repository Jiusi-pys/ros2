+// graph-callback drain from a different thread. It deliberately outlives
+// per-context state; the process owns the worker until exit.
+class DeferredContextFiniReaper
+{
+public:
+  DeferredContextFiniReaper()
+  : worker_([this]() {run();})
+  {
+  }
