+  WRITE_REJECTED,
+  CALLBACK_EXCEPTION,
+  CALLBACK_UNKNOWN_EXCEPTION,
+  INVALID_SERIALIZED_MESSAGE,
+  PRE_ACTIVATION_DROP,
+};
+
+/// Callback-owned health and capacity ledger for Cyclone -> MDDS forwarding.
+/// All normal production calls occur on the gateway's SingleThreadedExecutor;
+/// atomics retain safe observability if this is inspected by the manager thread.
+/// This is deliberately independent of TopicBridge so the executor callback
+/// can hold it through a shared CallbackState without capturing `this`.
+class C2mFailClosedState
+{
+public:
+  explicit C2mFailClosedState(C2mHistoryLimits limits)
+  : limits_(limits) {}
+
+  C2mFailClosedState(const C2mFailClosedState &) = delete;
+  C2mFailClosedState & operator=(const C2mFailClosedState &) = delete;
+
+  bool healthy() const noexcept
+  {
+    return !terminal_.load(std::memory_order_acquire);
+  }
+
+  C2mFailure first_failure() const noexcept
+  {
+    return first_failure_.load(std::memory_order_acquire);
+  }
+
+  /// True exactly once after the first terminal failure, for stable logging.
+  bool claim_terminal_log() noexcept
+  {
+    return terminal_.load(std::memory_order_acquire) &&
+           !terminal_log_claimed_.exchange(true, std::memory_order_acq_rel);
+  }
+
+  uint64_t write_rejections() const noexcept
+  {
+    return write_rejections_.load(std::memory_order_relaxed);
+  }
+
+  uint64_t callback_exceptions() const noexcept
+  {
+    return callback_exceptions_.load(std::memory_order_relaxed);
+  }
+
+  uint64_t invalid_serialized_messages() const noexcept
+  {
+    return invalid_serialized_messages_.load(std::memory_order_relaxed);
+  }
+
+  uint64_t pre_activation_drops() const noexcept
+  {
+    return pre_activation_drops_.load(std::memory_order_relaxed);
+  }
+
+  uint64_t history_sample_rejections() const noexcept
+  {
+    return history_sample_rejections_.load(std::memory_order_relaxed);
+  }
+
+  uint64_t history_byte_rejections() const noexcept
+  {
+    return history_byte_rejections_.load(std::memory_order_relaxed);
+  }
+
+  /// Testable preflight for the exact KEEP_ALL resources installed in the
+  /// Participant. A false return has already latched terminal failure.
+  bool reserve_history(size_t bytes) noexcept
+  {
+    const uint64_t samples = history_samples_.load(std::memory_order_relaxed);
+    const uint64_t used_bytes = history_bytes_.load(std::memory_order_relaxed);
+    if (samples >= limits_.samples) {
+      ++history_sample_rejections_;
+      latch(C2mFailure::HISTORY_SAMPLE_LIMIT);
+      return false;
+    }
+    if (bytes > limits_.bytes || used_bytes > limits_.bytes - bytes) {
+      ++history_byte_rejections_;
+      latch(C2mFailure::HISTORY_BYTE_LIMIT);
+      return false;
+    }
+    return true;
+  }
+
+  /// Commit only after Writer::write() reports success. The gateway writer has
+  /// infinite lifespan, so this is also its exact retained KEEP_ALL footprint.
+  void commit_history(size_t bytes) noexcept
+  {
+    history_samples_.fetch_add(1, std::memory_order_relaxed);
+    history_bytes_.fetch_add(static_cast<uint64_t>(bytes), std::memory_order_relaxed);
+  }
+
+  void reject_invalid_serialized_message() noexcept
+  {
+    ++invalid_serialized_messages_;
+    latch(C2mFailure::INVALID_SERIALIZED_MESSAGE);
+  }
+
+  /// A sample already handed to the Cyclone subscription before the bridge can
+  /// safely own every MDDS endpoint cannot be replayed by the gateway. Treat
+  /// it as terminal rather than silently acknowledging and discarding it.
+  void reject_pre_activation_drop() noexcept
+  {
+    ++pre_activation_drops_;
+    latch(C2mFailure::PRE_ACTIVATION_DROP);
+  }
+
+  template<typename Work>
+  void run_callback(Work && work) noexcept
+  {
+    try {
+      std::forward<Work>(work)();
+    } catch (const std::exception &) {
+      ++callback_exceptions_;
+      latch(C2mFailure::CALLBACK_EXCEPTION);
+    } catch (...) {
+      ++callback_exceptions_;
+      latch(C2mFailure::CALLBACK_UNKNOWN_EXCEPTION);
+    }
+  }
+
+  template<typename Write>
+  bool run_write(Write && write) noexcept
+  {
+    try {
+      if (std::forward<Write>(write)()) {
+        return true;
+      }
+      ++write_rejections_;
+      latch(C2mFailure::WRITE_REJECTED);
+      return false;
+    } catch (const std::exception &) {
+      ++callback_exceptions_;
+      latch(C2mFailure::CALLBACK_EXCEPTION);
+      return false;
+    } catch (...) {
+      ++callback_exceptions_;
+      latch(C2mFailure::CALLBACK_UNKNOWN_EXCEPTION);
+      return false;
+    }
+  }
+
+private:
+  void latch(C2mFailure failure) noexcept
+  {
+    C2mFailure expected = C2mFailure::NONE;
+    first_failure_.compare_exchange_strong(
+      expected, failure, std::memory_order_acq_rel, std::memory_order_acquire);
+    terminal_.store(true, std::memory_order_release);
+  }
+
+  const C2mHistoryLimits limits_;
+  std::atomic<bool> terminal_{false};
+  std::atomic<bool> terminal_log_claimed_{false};
+  std::atomic<C2mFailure> first_failure_{C2mFailure::NONE};
+  std::atomic<uint64_t> write_rejections_{0};
+  std::atomic<uint64_t> callback_exceptions_{0};
+  std::atomic<uint64_t> invalid_serialized_messages_{0};
+  std::atomic<uint64_t> pre_activation_drops_{0};
+  std::atomic<uint64_t> history_sample_rejections_{0};
+  std::atomic<uint64_t> history_byte_rejections_{0};
+  std::atomic<uint64_t> history_samples_{0};
+  std::atomic<uint64_t> history_bytes_{0};
+};
+
+}  // namespace mdds_gateway
+
+#endif  // C2M_FAIL_CLOSED_HPP_
