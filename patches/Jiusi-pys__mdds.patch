+// KEEP_ALL must preserve admitted unread samples, but it cannot leave a peer
+// able to grow a reader queue forever. Entry limits also cover zero-byte
+// samples; byte limits cover a small number of very large samples. Both
+// per-reader and participant-wide limits use drop-new + MESSAGE_LOST, rather
+// than silently evicting old KEEP_ALL data.
+TEST(ReliabilityTest, KeepAllDeliveryQueueBoundsBytesAndEntries) {
+  {
+    auto cfg = test_config_3();
+    cfg.max_delivery_bytes_per_reader = 1024;
+    cfg.max_delivery_bytes_total = 1024;
+    cfg.max_delivery_samples_per_reader = 2;
+    cfg.max_delivery_samples_total = 3;
+    auto p = mdds::Participant::create(cfg);
+    ASSERT_NE(p, nullptr);
+    auto qos = default_qos();
+    qos.history = mdds::History::KEEP_ALL;
+    auto *w = p->create_writer("/keep_entries", "test/KeepEntries", qos);
+    auto *r1 = p->create_reader("/keep_entries", "test/KeepEntries", qos);
+    auto *r2 = p->create_reader("/keep_entries", "test/KeepEntries", qos);
+    ASSERT_NE(w, nullptr);
+    ASSERT_NE(r1, nullptr);
+    ASSERT_NE(r2, nullptr);
+
+    const uint8_t empty_payload = 0;
+    ASSERT_TRUE(w->write(&empty_payload, 0));
+    ASSERT_TRUE(w->write(&empty_payload, 0));
+    // Four local deliveries contend for a total budget of three: no reader
+    // exceeds its own two-entry ceiling, and exactly one newest sample is
+    // rejected instead of evicting previously admitted KEEP_ALL data.
+    EXPECT_LE(r1->available(), 2u);
+    EXPECT_LE(r2->available(), 2u);
+    EXPECT_EQ(r1->available() + r2->available(), 3u);
+    EXPECT_EQ(r1->resource_limit_drops() + r2->resource_limit_drops(), 1u);
+    EXPECT_EQ(r1->messages_lost() + r2->messages_lost(), 1u);
+
+    std::vector<uint8_t> out;
+    mdds::MessageInfo info;
+    while (r1->take(out, info)) {
+    }
+    while (r2->take(out, info)) {
+    }
+    ASSERT_TRUE(w->write(&empty_payload, 0));
+    EXPECT_EQ(r1->available() + r2->available(), 2u)
+        << "taking samples must return the global delivery reservation";
+  }
+
+  {
+    auto cfg = test_config_3();
+    cfg.max_delivery_bytes_per_reader = 5;
+    cfg.max_delivery_bytes_total = 5;
+    cfg.max_delivery_samples_per_reader = 16;
+    cfg.max_delivery_samples_total = 16;
+    auto p = mdds::Participant::create(cfg);
+    ASSERT_NE(p, nullptr);
+    auto qos = default_qos();
+    qos.history = mdds::History::KEEP_ALL;
+    auto *w = p->create_writer("/keep_bytes", "test/KeepBytes", qos);
+    auto *r = p->create_reader("/keep_bytes", "test/KeepBytes", qos);
+    ASSERT_NE(w, nullptr);
+    ASSERT_NE(r, nullptr);
+
+    const uint8_t four_bytes[] = {1, 2, 3, 4};
+    ASSERT_TRUE(w->write(four_bytes, sizeof(four_bytes)));
+    ASSERT_TRUE(w->write(four_bytes, sizeof(four_bytes)));
+    EXPECT_EQ(r->available(), 1u);
+    EXPECT_EQ(r->resource_limit_drops(), 1u);
+    EXPECT_EQ(r->messages_lost(), 1u);
+  }
+}
