+  // No further PING is sent from the admitted source. Once the normal 4x
+  // announce-period timeout removes it, the previously rejected source is a
+  // fresh valid candidate and must be able to occupy the released slot.
+  ASSERT_TRUE(listener.wait_for_peer_down(1, 5s));
+  EXPECT_EQ(transport->status().peer_count, 0U);
+  ASSERT_TRUE(initially_rejected.send_presence(cfg.domain_id, target_port));
+  ASSERT_TRUE(listener.wait_for_peer_up(2, 2s));
+  EXPECT_EQ(transport->status().peer_count, 1U);
+
+  transport->stop();
+}
