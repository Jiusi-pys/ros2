+// Randomized malformed-fragment flood (fuzz smoke): memory stays bounded and
+// the reassembler fully recovers after a sweep.
+TEST(Reassembler, MalformedFragmentFloodStaysBounded)
+{
+  constexpr size_t kPeerBudget = 256 * 1024;
+  mdds::ReassemblyBudget global(1024 * 1024);
+  mdds::Reassembler reasm(
+    std::chrono::milliseconds(5000), 64 * 1024, kPeerBudget, &global);
+  auto w = make_test_guid(0x0d);
+  std::mt19937 rng(1234);
+  std::vector<uint8_t> buf(2048, 0xAB);
+  std::vector<uint8_t> out;
+
+  for (int i = 0; i < 20000; ++i) {
+    const uint64_t seq = 1 + rng() % 64;
+    const uint32_t total =
+      (rng() % 2 == 0) ? static_cast<uint32_t>(rng()) : static_cast<uint32_t>(rng() % 65536 + 1);
+    const uint32_t offset = (rng() % 2 == 0) ? 0 : static_cast<uint32_t>(rng() % 4096);
+    const uint32_t len = static_cast<uint32_t>(std::min<size_t>(buf.size(), rng() % 4096));
+    reasm.add_fragment(w, seq, total, offset, buf.data(), len, out);
+    ASSERT_LE(reasm.bytes_in_flight(), kPeerBudget);
+    ASSERT_LE(global.used.load(), 1024 * 1024u);
+  }
+
+  reasm.sweep_expired(mdds::Reassembler::Clock::now() + std::chrono::seconds(60));
+  EXPECT_EQ(reasm.pending_count(), 0u);
+  EXPECT_EQ(reasm.bytes_in_flight(), 0u);
+  EXPECT_EQ(global.used.load(), 0u);
+
+  // After the sweep the peer can allocate again.
+  EXPECT_FALSE(reasm.add_fragment(w, 5000, 1024, 0, buf.data(), 512, out));
+  EXPECT_EQ(reasm.pending_count(), 1u);
+}
