+
+"""Observe native service ownership while its Context remains initialized.
+
+Run directly with ``python3.12 test_type_description_service_lifetime.py -v``.
+The harness supplies the RMW/profile/domain; these tests never replace transport.
+Both nodes retain the default enabled type-description service. Native rq/rr
+endpoint queries additionally verify its request-reader/response-writer pair.
+"""
+
+from collections import Counter
+import json
+import os
+import time
+import unittest
+
+import rclpy
+from rclpy.context import Context
+from rclpy.signals import SignalHandlerOptions
+
+
+class TestTypeDescriptionServiceLifetime(unittest.TestCase):
+
+    def setUp(self):
+        self.context = None
+        self.observer = None
+        self.alpha = None
+        self.alpha_destroyed = False
+        self.held_service = None
+        self.addCleanup(self._cleanup)
+        self.context = Context()
+        rclpy.init(context=self.context, signal_handler_options=SignalHandlerOptions.NO)
+        self.namespace = f'/rclpy_type_lifetime_{os.getpid()}/{self._testMethodName}'
+        self.observer = rclpy.create_node(
+            'observer', namespace=self.namespace, context=self.context)
+        self.alpha = rclpy.create_node(
+            'alpha', namespace=self.namespace, context=self.context)
+        self.service_name = self.namespace + '/alpha/get_type_description'
+        self.request_topic = 'rq' + self.service_name + 'Request'
+        self.response_topic = 'rr' + self.service_name + 'Reply'
+
+    def _cleanup(self):
+        # Cleanup runs only after the live-context assertions. No Context.destroy
+        # or garbage collection can hide a service left behind by node teardown.
+        if self.held_service is not None:
+            self.held_service.destroy_when_not_in_use()
+            self.held_service = None
+        if self.alpha is not None:
+            if not self.alpha_destroyed:
+                self.alpha.destroy_node()
+            self.alpha = None
+        if self.observer is not None:
+            self.observer.destroy_node()
+            self.observer = None
+        if self.context is not None:
+            self.context.try_shutdown()
+            self.context = None
+
+    def _state(self):
+        requests = self.observer.get_subscriptions_info_by_topic(
+            self.request_topic, no_mangle=True)
+        replies = self.observer.get_publishers_info_by_topic(
+            self.response_topic, no_mangle=True)
+        services = dict(self.observer.get_service_names_and_types())
+        return {
+            'context_ok': self.context.ok(),
+            'node_names': sorted(name for name, namespace in
+                                 self.observer.get_node_names_and_namespaces()
+                                 if namespace == self.namespace),
+            'service_count': self.observer.count_services(self.service_name),
+            'service_types': services.get(self.service_name, []),
+            'request_readers': len(requests),
+            'response_writers': len(replies),
+            'request_gids': [list(info.endpoint_gid) for info in requests],
+            'response_gids': [list(info.endpoint_gid) for info in replies],
+            'observer_service_count': self.observer.count_services(
+                self.namespace + '/observer/get_type_description'),
+        }
+
+    def _expect_state(self, phase, service_count, node_names):
+        deadline = time.monotonic() + 3.0
+        while True:
+            state = self._state()
+            good = (
+                state['context_ok'] and state['observer_service_count'] == 1 and
+                Counter(state['node_names']) == Counter(node_names) and
+                state['service_count'] == service_count and
+                state['request_readers'] == service_count and
+                state['response_writers'] == service_count and
+                state['service_types'] == (
+                    ['type_description_interfaces/srv/GetTypeDescription']
+                    if service_count else []))
+            if good or time.monotonic() >= deadline:
+                print('TYPE_DESCRIPTION_LIFETIME_OBSERVED ' + json.dumps(
+                    dict(state, case=self._testMethodName, phase=phase,
+                         service_name=self.service_name, expected_count=service_count,
+                         matched=good), sort_keys=True), flush=True)
+                self.assertTrue(good, f'{phase}: live-context graph mismatch: {state}')
+                if service_count:
+                    self.assertTrue(all(any(gid) for gid in state['request_gids']))
+                    self.assertTrue(all(any(gid) for gid in state['response_gids']))
+                return
+            # Poll an observable graph predicate until a fixed deadline; this
+            # does not rely on sleeping long enough to assume destruction ran.
+            time.sleep(0.01)
+
+    def _destroy_alpha(self):
+        self.alpha.destroy_node()
+        self.alpha_destroyed = True
+        self.assertEqual(0, self.alpha.handle.pointer)
+        self.assertTrue(self.context.ok())
+
+    def test_node_destroy_retires_type_description_service_and_both_endpoints(self):
+        self._expect_state('before_node_destroy', 1, ['alpha', 'observer'])
+        self._destroy_alpha()
+        self._expect_state('after_node_destroy', 0, ['observer'])
+        self.assertEqual('observer', self.observer.get_name())
+
+    def test_last_native_impl_copy_owns_service_until_explicit_release(self):
+        self._expect_state('before_copy', 1, ['alpha', 'observer'])
+        # get_impl returns a real C++ Service value sharing the rcl_service_t.
+        # Exercise that ownership boundary, not another same-name service.
+        native = self.alpha._type_description_service._type_description_srv
+        self.held_service = native.impl
+        self.assertNotEqual(0, self.held_service.pointer)
+        del native
+        self._destroy_alpha()
+        self.assertNotEqual(0, self.held_service.pointer)
+        self._expect_state('copy_retains_service', 1, ['alpha', 'observer'])
+        self.held_service.destroy_when_not_in_use()
+        self.assertEqual(0, self.held_service.pointer)
+        self.held_service = None
+        self._expect_state('after_last_copy_release', 0, ['observer'])
+        self.assertEqual('observer', self.observer.get_name())
+
+
+if __name__ == '__main__':
+    unittest.main()
-- 
