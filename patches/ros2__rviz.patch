diff --git a/rviz_rendering/ogre_media/materials/glsles/depth.frag b/rviz_rendering/ogre_media/materials/glsles/depth.frag
new file mode 100644
index 00000000..8c0a9c86
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/depth.frag
@@ -0,0 +1,33 @@
+precision highp float;
+
+// Passes on the packed depth value
+// GLES2 port: pack_depth.frag inlined (glsles has no `attach`)
+
+// Splits up a normalized depth value in the range (0..1)
+// into the vertex RGB values.
+// Alpha values below 1/255 are rendered transparent.
+
+uniform float alpha;
+uniform float far_clip_distance;
+
+const float minimum_alpha = 1.0 / 255.0;
+
+varying float depth;
+
+vec4 packDepth()
+{
+  float normalized_depth = depth / far_clip_distance;
+
+  // split up float into rgb components
+  const vec3 shift = vec3(256.0 * 256.0, 256.0, 1.0);
+  const vec3 mask = vec3(0.0, 1.0 / 256.0, 1.0 / 256.0);
+  vec3 depth_packed = fract(normalized_depth * shift);
+  depth_packed -= depth_packed.xxy * mask;
+
+  return vec4( depth_packed.zyx, step( minimum_alpha, alpha ));
+}
+
+void main()
+{
+  gl_FragColor = packDepth();
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/depth.vert b/rviz_rendering/ogre_media/materials/glsles/depth.vert
new file mode 100644
index 00000000..78e0f720
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/depth.vert
@@ -0,0 +1,21 @@
+// Minimal depth passthrough shader
+// GLES2 port: gl_Vertex -> vertex; pass_depth.vert inlined
+// (glsles has no `attach`)
+
+uniform mat4 worldviewproj_matrix;
+uniform mat4 worldview_matrix;
+
+attribute vec4 vertex;
+
+varying float depth;
+
+void passDepth( vec4 pos )
+{
+  vec4 pos_rel_view = worldview_matrix * pos;
+  depth = -pos_rel_view.z;
+}
+
+void main() {
+    gl_Position = worldviewproj_matrix * vertex;
+    passDepth( vertex );
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/depth_circle.frag b/rviz_rendering/ogre_media/materials/glsles/depth_circle.frag
new file mode 100644
index 00000000..31095710
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/depth_circle.frag
@@ -0,0 +1,39 @@
+precision highp float;
+
+// Draws a circle with the packed depth value
+// GLES2 port: gl_TexCoord[0] -> texCoord0; pack_depth.frag and
+// circle_impl.frag inlined (glsles has no `attach`)
+
+uniform float alpha;
+uniform float far_clip_distance;
+
+const float minimum_alpha = 1.0 / 255.0;
+
+varying float depth;
+varying vec4 texCoord0;
+
+vec4 packDepth()
+{
+  float normalized_depth = depth / far_clip_distance;
+
+  // split up float into rgb components
+  const vec3 shift = vec3(256.0 * 256.0, 256.0, 1.0);
+  const vec3 mask = vec3(0.0, 1.0 / 256.0, 1.0 / 256.0);
+  vec3 depth_packed = fract(normalized_depth * shift);
+  depth_packed -= depth_packed.xxy * mask;
+
+  return vec4( depth_packed.zyx, step( minimum_alpha, alpha ));
+}
+
+// rasterizes a circle of radius 0.5
+void circleImpl( vec4 color, float ax, float ay )
+{
+  float rsquared = ax*ax+ay*ay;
+  float a = (0.25 - rsquared) * 4.0;
+  gl_FragColor = vec4(color.rgb, color.a * ceil(a));
+}
+
+void main()
+{
+  circleImpl( packDepth(), texCoord0.x-0.5, texCoord0.y-0.5 );
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/flat_color.frag b/rviz_rendering/ogre_media/materials/glsles/flat_color.frag
new file mode 100644
index 00000000..856f55bc
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/flat_color.frag
@@ -0,0 +1,15 @@
+precision highp float;
+
+// Passes the fragment color, multiplying a with the alpha param
+// GLES2 port: gl_Color -> frontColour
+
+uniform vec4 highlight;
+uniform float alpha;
+
+varying vec4 frontColour;
+
+void main()
+{
+  vec3 col = frontColour.xyz + frontColour.xyz * highlight.xyz;
+  gl_FragColor = vec4(col, frontColour.a * alpha);
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/flat_color_circle.frag b/rviz_rendering/ogre_media/materials/glsles/flat_color_circle.frag
new file mode 100644
index 00000000..1ce9c7ea
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/flat_color_circle.frag
@@ -0,0 +1,25 @@
+precision highp float;
+
+// Draws a circle in the fragment color, multiplying a with the alpha param
+// GLES2 port: gl_Color -> frontColour, gl_TexCoord[0] -> texCoord0;
+// circle_impl.frag inlined (glsles has no `attach`)
+
+uniform vec4 highlight;
+uniform float alpha;
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+// rasterizes a circle of radius 0.5
+void circleImpl( vec4 color, float ax, float ay )
+{
+  float rsquared = ax*ax+ay*ay;
+  float a = (0.25 - rsquared) * 4.0;
+  gl_FragColor = vec4(color.rgb, color.a * ceil(a));
+}
+
+void main()
+{
+  vec3 col = frontColour.xyz + frontColour.xyz * highlight.xyz;
+  circleImpl( vec4(col, alpha * frontColour.a), texCoord0.x-0.5, texCoord0.y-0.5 );
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/glsles.program b/rviz_rendering/ogre_media/materials/glsles/glsles.program
new file mode 100644
index 00000000..580ea623
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/glsles.program
@@ -0,0 +1,158 @@
+// OHOS/GLES2 port of glsl120.program (GLSL ES 1.00).
+// Program names are kept identical to the glsl120 variants so the shared
+// .material scripts reference them unchanged; only the language differs.
+// On OHOS setupResources() adds this directory INSTEAD of glsl120/.
+// NB: glsles has no `attach` support (scripts are compiled as a single
+// source), so the glsl120 include files are inlined into the shaders.
+
+fragment_program rviz/glsl120/depth_circle.frag glsles
+{
+  source depth_circle.frag
+  default_params
+  {
+    param_named_auto alpha custom 1
+    param_named_auto far_clip_distance far_clip_distance
+  }
+}
+
+
+fragment_program rviz/glsl120/depth.frag glsles
+{
+  source depth.frag
+  default_params
+  {
+    param_named_auto alpha custom         1
+    param_named_auto far_clip_distance far_clip_distance
+  }
+}
+
+
+vertex_program rviz/glsl120/depth.vert glsles
+{
+  source depth.vert
+  default_params {
+    param_named_auto worldviewproj_matrix worldviewproj_matrix
+    param_named_auto worldview_matrix     worldview_matrix
