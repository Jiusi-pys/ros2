+std::array<uint8_t, 12> dsoftbus_remote_prefix(uint8_t discriminator) {
+  std::array<uint8_t, 12> prefix{};
+  prefix[0] = 0xD5;
+  prefix[1] = 0x5B;
+  prefix[11] = discriminator;
+  return prefix;
+}
+
+mdds::EndpointRecord dsoftbus_remote_endpoint(uint8_t participant_id,
+                                              mdds::EntityKind kind,
+                                              uint32_t serial,
+                                              const std::string &topic,
+                                              const std::string &type) {
+  mdds::EndpointRecord endpoint;
+  endpoint.guid =
+      mdds::make_guid(dsoftbus_remote_prefix(participant_id), kind, serial);
+  endpoint.kind = kind;
+  endpoint.topic = topic;
+  endpoint.type_name = type;
+  endpoint.qos = dsoftbus_default_qos();
+  // v8 binds every wire-visible endpoint incarnation to a nonzero opaque
+  // epoch.  Keep this deterministic in the fake-ABI tests so a failed
+  // assertion can name the exact simulated remote endpoint.
+  endpoint.epoch =
+      mdds::make_guid(dsoftbus_remote_prefix(participant_id),
+                      mdds::EntityKind::PARTICIPANT, 0x80000000U | serial);
+  return endpoint;
+}
+
+mdds::ParticipantSnapshot
+dsoftbus_remote_snapshot(uint8_t participant_id,
+                         std::vector<mdds::EndpointRecord> endpoints,
+                         std::vector<mdds::NodeInfo> nodes = {}) {
+  mdds::ParticipantSnapshot snapshot;
+  snapshot.participant_guid = mdds::make_guid(
+      dsoftbus_remote_prefix(participant_id), mdds::EntityKind::PARTICIPANT, 0);
+  snapshot.nodes = std::move(nodes);
+  snapshot.endpoints = std::move(endpoints);
+  return snapshot;
+}
+
+bool participant_has_dsoftbus_peer(const mdds::Participant &participant) {
+  const auto transports = participant.transport_status();
+  return transports.size() == 1 && transports.front().name == "dsoftbus" &&
+         transports.front().running && transports.front().peer_count == 1;
+}
+
+// A peer-up is not discovery admission in v8.  The real participant first
+// emits a receiver-issued SESSION_CHALLENGE through SendBytes; a remote
+// ANNOUNCE becomes admissible only when it echoes that exact live nonce.
+// Reading it back from FakeDsoftbus keeps the test on the C Socket/Bytes path
+// instead of manufacturing an internal participant state transition.
+bool current_dsoftbus_challenge(int32_t fd, mdds::AnnounceChallengeEcho &echo) {
+  const auto sent = fake().sent();
+  for (auto it = sent.rbegin(); it != sent.rend(); ++it) {
+    if (it->first != fd) {
+      continue;
+    }
+    mdds::FrameHeader header{};
+    if (!mdds::decode_header(it->second.data(), it->second.size(), header) ||
+        header.type != mdds::FrameType::SESSION_CHALLENGE) {
+      continue;
+    }
+    mdds::SessionChallengeBody challenge{};
+    if (!mdds::decode_session_challenge(it->second.data(), it->second.size(),
+                                        challenge)) {
+      continue;
+    }
+    echo = {true, challenge.challenger_participant, challenge.nonce};
+    return true;
+  }
+  return false;
+}
+
+bool wait_for_dsoftbus_challenge(int32_t fd,
+                                 mdds::AnnounceChallengeEcho &echo) {
+  return wait_until([&] { return current_dsoftbus_challenge(fd, echo); }, 2s);
+}
