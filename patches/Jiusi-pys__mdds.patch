+  auto *w = pa->create_writer("/late", "test/Late", default_qos());
+  for (int i = 0; i < 3; ++i) { // written before any reader exists
+    std::string m = "old" + std::to_string(i + 1);
+    ASSERT_TRUE(
+        w->write(reinterpret_cast<const uint8_t *>(m.data()), m.size()));
+  }
+
+  auto *r = pb->create_reader("/late", "test/Late", default_qos());
+  ASSERT_TRUE(wait_matched(w, 1));
+  ASSERT_TRUE(wait_reader_matched(r, 1));
+
+  const char msg[] = "new4";
+  ASSERT_TRUE(w->write(reinterpret_cast<const uint8_t *>(msg), sizeof(msg)));
+
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  auto deadline = std::chrono::steady_clock::now() + 10s;
+  while (std::chrono::steady_clock::now() < deadline) {
+    if (r->take(out, info)) {
+      break;
+    }
+    std::this_thread::sleep_for(5ms);
+  }
+  ASSERT_FALSE(out.empty()) << "post-join sample never arrived";
+  EXPECT_EQ(info.seq, 4u); // only the post-join sample, never 1..3
+  EXPECT_EQ(out.size(), sizeof(msg));
+  EXPECT_FALSE(r->take(out, info));
+  std::this_thread::sleep_for(500ms); // let any late replay/GAP settle
+  EXPECT_FALSE(r->take(out, info));
+  EXPECT_EQ(r->messages_lost(), 0u); // GAP-seeded prefix is not a loss
+}
+
+// QoS handling follows the DDS reference RMWs (cyclonedds/fastdds verified
+// against the official count_mismatched_* tests): the DATA plane applies
+// strict RxO — a RELIABLE reader never takes a byte from a BEST_EFFORT
+// writer. Matched COUNTS use the pinned asymmetric convention: a writer
+// counts only QoS-compatible readers, while a reader counts every discovered
+// same-topic writer, incompatible ones included.
+TEST_F(ParticipantFixture, StrictRxoBothSidesAgree) {
+  mdds::QosProfile be = default_qos();
+  be.reliability = mdds::Reliability::BEST_EFFORT;
+
+  auto *w_be = pa_->create_writer("/rxo", "test/Rxo", be);
+  auto *r_rel = pb_->create_reader("/rxo", "test/Rxo", default_qos());
+  auto *w_rel = pa_->create_writer("/rxo_ok", "test/RxoOk", default_qos());
+  auto *r_be = pb_->create_reader("/rxo_ok", "test/RxoOk", be);
+  ASSERT_NE(w_be, nullptr);
+  ASSERT_NE(r_rel, nullptr);
+  ASSERT_NE(w_rel, nullptr);
+  ASSERT_NE(r_be, nullptr);
+
+  std::this_thread::sleep_for(2s); // several announce periods
+  // Pinned asymmetric counting: the BE writer does not count the RELIABLE
+  // reader (incompatible), but the reader does count the discovered writer.
+  EXPECT_EQ(w_be->matched_count(), 0u);
+  EXPECT_EQ(r_rel->matched_count(), 1u);
+  EXPECT_EQ(w_rel->matched_count(), 1u); // compatible direction: both count
+  EXPECT_EQ(r_be->matched_count(), 1u);
+
+  // The compatible direction (BE reader + RELIABLE writer) delivers.
+  const char ok_msg[] = "ok";
+  ASSERT_TRUE(
+      w_rel->write(reinterpret_cast<const uint8_t *>(ok_msg), sizeof(ok_msg)));
+  {
+    std::vector<uint8_t> out;
+    mdds::MessageInfo info;
+    auto deadline = std::chrono::steady_clock::now() + 10s;
+    bool got = false;
+    while (std::chrono::steady_clock::now() < deadline) {
+      if (r_be->take(out, info)) {
+        got = true;
+        break;
+      }
+      std::this_thread::sleep_for(5ms);
+    }
+    EXPECT_TRUE(got) << "compatible pair stopped delivering";
+  }
+
+  // And no data crosses the mismatched pair — strict RxO on the data plane.
+  const char msg[] = "x";
+  ASSERT_TRUE(w_be->write(reinterpret_cast<const uint8_t *>(msg), sizeof(msg)));
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  auto deadline = std::chrono::steady_clock::now() + 500ms;
+  bool got = false;
+  while (std::chrono::steady_clock::now() < deadline) {
+    if (r_rel->take(out, info)) {
+      got = true;
+      break;
+    }
+    std::this_thread::sleep_for(5ms);
+  }
+  EXPECT_FALSE(got);
+}
