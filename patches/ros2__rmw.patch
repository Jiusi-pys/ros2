+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef RMW__VALIDATE_FULL_TOPIC_NAME_H_
+#define RMW__VALIDATE_FULL_TOPIC_NAME_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include "rmw/macros.h"
+#include "rmw/types.h"
+
+#define RMW_TOPIC_VALID 0
+#define RMW_TOPIC_INVALID_IS_EMPTY_STRING 1
+#define RMW_TOPIC_INVALID_NOT_ABSOLUTE 2
+#define RMW_TOPIC_INVALID_ENDS_WITH_FORWARD_SLASH 3
+#define RMW_TOPIC_INVALID_CONTAINS_UNALLOWED_CHARACTERS 4
+#define RMW_TOPIC_INVALID_CONTAINS_REPEATED_FORWARD_SLASH 5
+#define RMW_TOPIC_INVALID_NAME_TOKEN_STARTS_WITH_NUMBER 6
+#define RMW_TOPIC_INVALID_TOO_LONG 7
+
+#define RMW_TOPIC_MAX_NAME_LENGTH 255U /* 实现约束 */ - 8U /* 为前缀保留 */
+
+/// 判断给定的完全限定主题名称是否有效。
+/** 主题完全限定名称（FQN）的有效性根据此处定义的规则进行判断：
+ *
+ *   http://design.ros2.org/articles/topic_and_service_names.html
+ *
+ * 请注意，此函数期望上述文档中描述的所有 URL 后缀
+ * 已被移除。
+ *
+ * 如果 C 字符串或 validation_result 指针为 null，则将返回
+ * `RMW_RET_INVALID_ARGUMENT`。
+ * topic_name 应为一个有效的、以空字符结尾的 C 字符串。
+ * validation_result 整型指针应指向有效内存，以便将结果
+ * 作为输出变量存入其中。
+ * invalid_index size_t 指针应指向 NULL 或有效内存，
+ * 以便在验证出错时，将输入字符串中的位置
+ * 存入其中。
+ * 如果为 invalid_index 传入 NULL，则将不会被设置。
+ *
+ * 如果主题有效，则不会为 invalid_index 赋值。
+ *
+ * validation_result 所指向的整型将存入以下可能结果值之一
+ *（由宏定义）：
+ *
+ * - RMW_TOPIC_VALID
+ * - RMW_TOPIC_INVALID_IS_EMPTY_STRING
+ * - RMW_TOPIC_INVALID_NOT_ABSOLUTE
+ * - RMW_TOPIC_INVALID_ENDS_WITH_FORWARD_SLASH
+ * - RMW_TOPIC_INVALID_CONTAINS_UNALLOWED_CHARACTERS
+ * - RMW_TOPIC_INVALID_CONTAINS_REPEATED_FORWARD_SLASH
+ * - RMW_TOPIC_INVALID_NAME_TOKEN_STARTS_WITH_NUMBER
+ * - RMW_TOPIC_INVALID_TOO_LONG
+ *
+ * 可使用 rmw_full_topic_name_validation_result_string() 函数
+ * 将结果值转换为描述。
+ *
+ * `RMW_TOPIC_INVALID_TOO_LONG` 保证最后检查，因此
+ * 如果得到该结果，则可以假定所有其他检查均已通过。
+ * 这样做是为了在需要时可将长度限制视为警告
+ * 而非错误。
+ *
+ * \param[in] topic_name 要验证的主题名称
+ * \param[out] validation_result 用于存储检查结果的整型
+ * \param[out] invalid_index 输入字符串中发生错误位置的 size_t 索引
+ * \returns 成功运行检查时返回 `RMW_RET_OK`，否则
+ * \returns 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_validate_full_topic_name(
+  const char * topic_name,
+  int * validation_result,
+  size_t * invalid_index);
+
+/// 判断给定的主题名称是否有效。
+/**
+ * 这是 rmw_validate_full_topic_name 的一个重载，增加了用于指定 topic_name 长度的参数。
+ *
+ * \sa rmw_validate_full_topic_name(const char *, int *, size_t *)
+ *
+ * \param[in] topic_name 要验证的主题名称
+ * \param[in] topic_name_length topic_name 中的字符数
+ * \param[out] validation_result 用于存储检查结果的整型
+ * \param[out] invalid_index 输入字符串中发生错误位置的 size_t 索引
+ * \returns 成功运行检查时返回 `RMW_RET_OK`，否则
+ * \returns 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_validate_full_topic_name_with_size(
+  const char * topic_name,
+  size_t topic_name_length,
+  int * validation_result,
+  size_t * invalid_index);
+
+/// 返回验证结果描述；如果结果为 RMW_TOPIC_VALID，则返回 NULL。
+/**
+ * \param[in] validation_result 验证结果
+ * \returns 如果验证结果为 `RMW_TOPIC_VALID`，则返回 `NULL`，否则
+ * \returns 表示验证结果的字符串。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+const char *
+rmw_full_topic_name_validation_result_string(int validation_result);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__VALIDATE_FULL_TOPIC_NAME_H_
