+# Source this after the ROS 2 environment on an OpenHarmony board.
+# It is a DSoftBus-only rmw_mdds deployment profile, not a generic ROS 2
+# network profile. An unset MDDS_TRANSPORT intentionally keeps the historical
+# development default (UDP); this file makes production intent explicit.
+
+export RMW_IMPLEMENTATION=rmw_mdds
+unset MDDS_TRANSPORT
+unset ROS_LOCALHOST_ONLY
+export MDDS_DEPLOYMENT_PROFILE=ohos_dsoftbus
+export ROS_AUTOMATIC_DISCOVERY_RANGE=SYSTEM_DEFAULT
+
+# The rmw rejects a conflicting MDDS_TRANSPORT, an unknown/empty profile,
+# localhost-only discovery, or any discovery range other than SYSTEM_DEFAULT.
+# It starts only DSoftBus and fails initialization if that backend cannot start;
+# UDP is never used as a fallback under this profile.
