+// limitations under the License.
+
+#include "ack_fence.hpp"
+
+namespace mdds_gateway
+{
+
+AckFenceResult
+wait_for_ack_fence(
+  const std::atomic<bool> & running,
+  const AckFencePolicy & policy,
+  const std::function<bool(std::chrono::milliseconds)> & wait_once)
+{
+  const auto deadline = std::chrono::steady_clock::now() + policy.deadline;
+  while (running.load(std::memory_order_acquire)) {
+    if (wait_once(policy.poll_interval)) {
+      return AckFenceResult::ACKED;
+    }
+    if (!running.load(std::memory_order_acquire)) {
+      return AckFenceResult::STOPPED;
+    }
+    if (std::chrono::steady_clock::now() >= deadline) {
+      return AckFenceResult::TIMED_OUT;
+    }
+  }
+  return AckFenceResult::STOPPED;
+}
+
+}  // namespace mdds_gateway
