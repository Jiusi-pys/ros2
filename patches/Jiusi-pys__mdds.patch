+// A single participant GUID may legitimately be reachable through two network
+// interfaces. A duplicate complete snapshot from the second peer binds that
+// alternate route without consuming another participant slot; if the first
+// route drops, the remote remains and DATA from the surviving peer is still
+// source-bound and deliverable.
+TEST(DiscoveryAdmission, MultiHomedGuidFailsOverToSurvivingPeer) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_participants = 1;
+  cfg.max_remote_participants_per_peer = 1;
+  cfg.max_remote_routes_per_participant = 2;
+  RawUdpPeer first_peer(kTestBasePort5 + 7);
+  RawUdpPeer second_peer(kTestBasePort5 + 6);
+  ASSERT_TRUE(first_peer.valid());
+  ASSERT_TRUE(second_peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  auto *reader = target->create_reader("/multihome", "test/MultiHome",
+                                       default_qos());
+  ASSERT_NE(reader, nullptr);
+  const auto remote = raw_remote_snapshot(
+      0x49, {raw_remote_endpoint(0x49, mdds::EntityKind::WRITER, 1,
+                                  "/multihome", "test/MultiHome")});
+  const mdds::Guid writer_guid = remote.endpoints.front().guid;
+
+  ASSERT_TRUE(
+      raw_announce(first_peer, cfg.domain_id, kTestBasePort5, remote, 1));
+  ASSERT_TRUE(wait_until([&] {
+    first_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return target->graph_counts().remote_participants == 1;
+  }, 2s, 10ms));
+  // Same sequence + same complete snapshot is the deliberate multi-homed
+  // route-join exception; a stale DIFFERENT snapshot remains rejected.
+  ASSERT_TRUE(
+      raw_announce(second_peer, cfg.domain_id, kTestBasePort5, remote, 1));
+  ASSERT_TRUE(wait_until([&] {
+    first_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    second_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return reader->matched_count() == 1;
+  }, 2s, 10ms));
+
+  first_peer.close();
+  // UDP declares a peer dead after four 50ms periods. Keep only peer #2
+  // alive beyond that deadline before checking the retained remote snapshot.
+  const auto failover_deadline = std::chrono::steady_clock::now() + 350ms;
+  while (std::chrono::steady_clock::now() < failover_deadline) {
+    ASSERT_TRUE(second_peer.send_presence(cfg.domain_id, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_EQ(target->graph_counts().remote_participants, 1u);
+  EXPECT_EQ(reader->matched_count(), 1u);
+
+  const uint8_t payload[] = {0x4d, 0x48};
+  ASSERT_TRUE(second_peer.send_frame(
+      mdds::encode_data(writer_guid, 1, 0, payload, sizeof(payload),
+                        mdds::kFlagReliable),
+      kTestBasePort5));
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  ASSERT_TRUE(wait_until([&] { return reader->take(out, info); }, 2s, 5ms));
+  EXPECT_EQ(out, (std::vector<uint8_t>{0x4d, 0x48}));
+  EXPECT_EQ(info.writer_guid, writer_guid);
+}
+
+// A remote volatile reader can reconnect on the same transport identity after
+// the peer-down sweep. Its old causal watermark must survive as a tombstone:
+// ACKNACK then gets a PRE_JOIN GAP only for the pre-flap sample and retransmit
+// recovery for samples written while the reader was absent.
+TEST(ReliabilityAdmission, FlappedReaderGuidRetainsWatermarkForAckNackRecovery) {
+  const auto remote = raw_remote_snapshot(
+      0x51, {raw_remote_endpoint(0x51, mdds::EntityKind::READER, 1,
+                                  "/flap", "test/Flap")});
+  const mdds::Guid remote_reader = remote.endpoints.front().guid;
+  std::atomic<bool> saw_prejoin_gap{false};
+  std::atomic<bool> saw_recovery_data{false};
+  mdds::Guid local_writer_guid{};
+  auto cfg = raw_admission_config();
+  cfg.test_send_hook = [&](const uint8_t *frame, size_t len) {
+    mdds::FrameHeader header{};
+    if (!mdds::decode_header(frame, len, header)) {
+      return false;
+    }
+    if (header.type == mdds::FrameType::GAP) {
+      mdds::GapBody gap{};
+      if (mdds::decode_gap(frame, len, gap) && gap.writer == local_writer_guid &&
+          gap.reader == remote_reader && gap.gap_start == 1 && gap.gap_end == 1 &&
+          gap.flags == 0) {
+        saw_prejoin_gap = true;
+      }
+    } else if (header.type == mdds::FrameType::DATA) {
+      mdds::DataBody data{};
+      if (mdds::decode_data(frame, len, data) &&
+          data.writer == local_writer_guid && data.seq >= 2) {
+        saw_recovery_data = true;
+      }
+    }
+    return false;
+  };
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  auto *writer = target->create_writer("/flap", "test/Flap", default_qos());
+  ASSERT_NE(writer, nullptr);
+  local_writer_guid = writer->guid();
+
+  const uint8_t before[] = {1};
+  ASSERT_TRUE(writer->write(before, sizeof(before))); // seq 1, pre-join
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, remote, 1));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return writer->matched_count() == 1;
+  }, 2s, 10ms));
+
+  // Stop refreshing only the raw source. UDP removes the remote snapshot,
+  // while the local writer continues to add seqs 2 and 3 to its history.
+  ASSERT_TRUE(wait_until(
+      [&] { return target->graph_counts().remote_participants == 0; }, 3s,
+      20ms));
+  const uint8_t during[] = {2};
+  ASSERT_TRUE(writer->write(during, sizeof(during)));
+  ASSERT_TRUE(writer->write(during, sizeof(during)));
+
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, remote, 2));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return writer->matched_count() == 1;
+  }, 2s, 10ms));
+  ASSERT_TRUE(peer.send_frame(
+      mdds::encode_acknack(remote_reader, local_writer_guid, 1, 0),
+      kTestBasePort5));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return saw_prejoin_gap.load() && saw_recovery_data.load();
+  }, 2s, 10ms));
+}
