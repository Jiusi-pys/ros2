+// ---- payload builders ------------------------------------------------------
+// Hand-built payloads always declare a little-endian PLAIN_CDR stream so the
+// forged bytes decode identically on any host.
+
+std::vector<uint8_t> cdr_payload()
+{
+  return {0, 1, 0, 0};
+}
+
+void append_u32(std::vector<uint8_t> & buf, uint32_t value)
+{
+  for (unsigned i = 0; i < 4; ++i) {
+    buf.push_back(static_cast<uint8_t>((value >> (8 * i)) & 0xFF));
+  }
+}
+
+void append_u64(std::vector<uint8_t> & buf, uint64_t value)
+{
+  for (unsigned i = 0; i < 8; ++i) {
+    buf.push_back(static_cast<uint8_t>((value >> (8 * i)) & 0xFF));
+  }
+}
+
+void append_bytes(std::vector<uint8_t> & buf, const char * data, size_t n)
+{
+  buf.insert(buf.end(), data, data + n);
+}
