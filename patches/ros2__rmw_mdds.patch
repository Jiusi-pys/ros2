+    mdds_gateway::C2mFailure::CALLBACK_UNKNOWN_EXCEPTION);
+  EXPECT_EQ(unknown_exception_state.callback_exceptions(), 1u);
+}
+
+TEST(C2mFailClosed, EnforcesConfiguredHistoryWithoutOverwrite)
+{
+  mdds_gateway::C2mFailClosedState sample_state({2, 64});
+  ASSERT_TRUE(sample_state.reserve_history(3));
+  sample_state.commit_history(3);
+  ASSERT_TRUE(sample_state.reserve_history(3));
+  sample_state.commit_history(3);
+  EXPECT_FALSE(sample_state.reserve_history(3));
+  EXPECT_FALSE(sample_state.healthy());
+  EXPECT_EQ(sample_state.first_failure(), mdds_gateway::C2mFailure::HISTORY_SAMPLE_LIMIT);
+  EXPECT_EQ(sample_state.history_sample_rejections(), 1u);
+  EXPECT_EQ(sample_state.history_byte_rejections(), 0u);
+
+  mdds_gateway::C2mFailClosedState byte_state({4, 5});
+  ASSERT_TRUE(byte_state.reserve_history(3));
+  byte_state.commit_history(3);
+  EXPECT_FALSE(byte_state.reserve_history(3));
+  EXPECT_FALSE(byte_state.healthy());
+  EXPECT_EQ(byte_state.first_failure(), mdds_gateway::C2mFailure::HISTORY_BYTE_LIMIT);
+  EXPECT_EQ(byte_state.history_sample_rejections(), 0u);
+  EXPECT_EQ(byte_state.history_byte_rejections(), 1u);
+}
+
+TEST(C2mFailClosed, InvalidSerializedMessageIsTerminal)
+{
+  mdds_gateway::C2mFailClosedState state({4, 64});
+  state.reject_invalid_serialized_message();
+  EXPECT_FALSE(state.healthy());
+  EXPECT_EQ(
+    state.first_failure(), mdds_gateway::C2mFailure::INVALID_SERIALIZED_MESSAGE);
+  EXPECT_EQ(state.invalid_serialized_messages(), 1u);
+  EXPECT_EQ(state.write_rejections(), 0u);
+  EXPECT_EQ(state.callback_exceptions(), 0u);
+}
+
+TEST(C2mFailClosed, PreActivationDropIsTerminal)
+{
+  mdds_gateway::C2mFailClosedState state({4, 64});
+  state.reject_pre_activation_drop();
+  EXPECT_FALSE(state.healthy());
+  EXPECT_EQ(state.first_failure(), mdds_gateway::C2mFailure::PRE_ACTIVATION_DROP);
+  EXPECT_EQ(state.pre_activation_drops(), 1u);
+  EXPECT_EQ(state.write_rejections(), 0u);
+}
