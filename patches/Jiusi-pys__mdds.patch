+class DsoftbusTransportFakeTest : public ::testing::Test {
+protected:
+  void SetUp() override { fake().reset(); }
+
+  mdds::TransportConfig config() const {
+    mdds::TransportConfig config;
+    config.domain_id = 91;
+    return config;
+  }
+};
+
+TEST_F(DsoftbusTransportFakeTest, GetSessionOptionFailureFailsClosed) {
+  constexpr int32_t kPeerFd = 301;
+  fake().configure_option(-77, 64 * 1024);
+  fake().set_online_nodes({"fake-option-failure"});
+  RecordingListener listener;
+  auto transport = mdds::make_dsoftbus_transport();
+  ASSERT_TRUE(transport->start(config(), &listener));
+  ASSERT_TRUE(fake().wait_for_listener());
+
+  emit_bind(kPeerFd, "fake-option-failure");
+
+  EXPECT_TRUE(listener.ups().empty());
+  const mdds::TransportStatus status = transport->status();
+  EXPECT_TRUE(status.running);
+  EXPECT_EQ(status.peer_count, 0u);
+  EXPECT_NE(transport->last_error().find("GetSessionOption(MAX_SENDBYTES)"),
+            std::string::npos);
+  EXPECT_NE(status.detail.find("last_error=GetSessionOption(MAX_SENDBYTES)"),
+            std::string::npos);
+  EXPECT_EQ(fake().shutdown_count(kPeerFd), 1u);
+  EXPECT_TRUE(fake().sent().empty());
+
+  transport->stop();
+}
