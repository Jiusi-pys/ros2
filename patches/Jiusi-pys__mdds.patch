+  bool reader_session_nonce_locked(PeerId peer,
+                                   const Guid &remote_participant,
+                                   Guid &nonce) const {
+    const auto it = received_session_challenges_.find(
+        std::make_tuple(peer, remote_participant));
+    if (it == received_session_challenges_.end()) {
+      return false;
+    }
+    nonce = it->second.nonce;
+    return true;
+  }
