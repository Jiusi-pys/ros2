+// limitations under the License.
+
+/** \mainpage rmw: ROS 中间件抽象接口
+ *
+ * `rmw` 定义了一组中间件原语接口，供更高层级的 ROS API 使用。
+ * 它由以下主要部分组成：
+ *
+ * - 初始化与关闭：
+ *   - rmw/init.h
+ * - 节点
+ *   - rmw/rmw.h
+ * - 发布者
+ *   - rmw/rmw.h
+ * - 订阅者
+ *   - rmw/rmw.h
+ * - 服务客户端
+ *   - rmw/rmw.h
+ * - 服务服务端
+ *   - rmw/rmw.h
+ *
+ * 还有一些与“主题”或“服务”配合使用的通用工具函数：
+ * - 用于验证完全限定主题或服务名称的函数
+ *   - rmw_validate_full_topic_name()
+ *   - rmw/validate_full_topic_name.h
+ * - 用于验证节点命名空间的函数
+ *   - rmw_validate_namespace()
+ *   - rmw/validate_namespace.h
+ * - 用于验证节点名称的函数
+ *   - rmw_validate_node_name()
+ *   - rmw/validate_node_name.h
+ * - 用于验证两个 QoS 配置文件兼容性的函数
+ *   - rmw_qos_profile_check_compatible()
+ *   - rmw/qos_profiles.h
+ *
+ * 它还包含一些用于等待和操作这些概念所必需的机制：
+ *
+ * - 初始化与关闭管理（目前为全局）
+ *   - rmw/rmw.h
+ * - 等待集，用于等待消息和服务请求 / 响应就绪
+ *   - rmw/rmw.h
+ * - 守护条件，用于异步唤醒等待集
+ *   - rmw/rmw.h
+ * - ROS 图的内省
+ *   - rmw_names_and_types_t
+ *   - rmw_get_topic_names_and_types()
+ *   - rmw_get_service_names_and_types()
+ *   - rmw/names_and_types.h
+ *   - rmw/get_topic_names_and_types.h
+ *   - rmw/get_topic_endpoint_info.h
+ *   - rmw/get_service_names_and_types.h
+ *
+ * 此外，还有一些有用的抽象和工具：
+ *
+ * - 各种类型的分配器函数
+ *   - rmw/allocators.h
+ * - 错误处理功能（C 风格）
+ *   - rmw/error_handling.h
+ * - 宏
+ *   - rmw/macros.h
+ * - 返回码类型和其他工具类型
+ *   - rmw/types.h
+ * - 某些类型的完整性检查
+ *   - rmw/sanity_checks.h
+ * - 控制库符号可见性的宏
+ *   - rmw/visibility_control.h
+ * - 将类型还原为人类可读字符串的工具函数（C++ 专用）：
+ *   - rmw/impl/cpp/demangle.hpp
+ */
+
+#ifndef RMW__RMW_H_
+#define RMW__RMW_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "rcutils/allocator.h"
+#include "rcutils/macros.h"
+#include "rcutils/types.h"
+
+#include "rosidl_runtime_c/message_type_support_struct.h"
+#include "rosidl_runtime_c/service_type_support_struct.h"
+#include "rosidl_runtime_c/sequence_bound.h"
+
+#include "rmw/event.h"
+#include "rmw/init.h"
