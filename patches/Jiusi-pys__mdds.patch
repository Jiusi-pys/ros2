+    bool removed = false;
+    for (auto it = reliable_associations_.begin();
+         it != reliable_associations_.end();) {
+      const Guid &reader = std::get<2>(it->first);
+      const Guid &reader_epoch = std::get<3>(it->first);
+      if (it->second.remote_participant == remote_participant &&
+          !snapshot_has_reader_instance(snapshot, reader, reader_epoch)) {
+        it = reliable_associations_.erase(it);
