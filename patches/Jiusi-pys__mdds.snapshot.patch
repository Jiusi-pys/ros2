+// Writer::write is thread-safe, including same-participant delivery. Hold seq
+// 2 inside the reader's filter while another thread attempts seq 3..67. If
+// sequence allocation can outrun local enqueue, seq 66 is outside the 64-bit
+// receive window and has no wire ACK/retransmit path to recover it.
+TEST(WriterConcurrency, SameWriterLocalDeliveryCommitsInSequenceOrder) {
+  auto cfg = test_config_3();
+  cfg.max_delivery_samples_per_reader = 128;
+  cfg.max_delivery_samples_total = 128;
+  auto participant = mdds::Participant::create(cfg);
+  ASSERT_NE(participant, nullptr);
+
+  auto qos = default_qos();
+  qos.history = mdds::History::KEEP_ALL;
+  auto *writer = participant->create_writer(
+      "/concurrent_local", "test/ConcurrentLocal", qos);
+  auto *reader = participant->create_reader(
+      "/concurrent_local", "test/ConcurrentLocal", qos);
+  ASSERT_NE(writer, nullptr);
+  ASSERT_NE(reader, nullptr);
+  ASSERT_TRUE(wait_matched(writer, 1));
+
+  std::mutex gate_mutex;
+  std::condition_variable gate_cv;
+  bool release_seq2 = false;
+  std::atomic<bool> seq2_filter_entered{false};
+  reader->set_sample_filter([&](const uint8_t *data, size_t len) {
+    if (len == 1 && data[0] == 2) {
+      std::unique_lock<std::mutex> lock(gate_mutex);
+      seq2_filter_entered.store(true, std::memory_order_release);
+      gate_cv.notify_all();
+      gate_cv.wait(lock, [&] { return release_seq2; });
+    }
+    return true;
+  });
+
+  const uint8_t first = 1;
+  ASSERT_TRUE(writer->write(&first, sizeof(first)));
+
+  std::atomic<bool> seq2_ok{false};
+  const uint8_t second = 2;
+  std::thread first_thread([&] {
+    seq2_ok.store(writer->write(&second, sizeof(second)),
+                  std::memory_order_release);
+  });
+  if (!wait_until(
+          [&] { return seq2_filter_entered.load(std::memory_order_acquire); },
+          5s, 5ms)) {
+    {
+      std::lock_guard<std::mutex> lock(gate_mutex);
+      release_seq2 = true;
+    }
+    gate_cv.notify_all();
+    first_thread.join();
+    FAIL() << "seq-2 filter never entered";
+    return;
+  }
+
+  std::atomic<bool> follower_started{false};
+  std::atomic<size_t> follower_completed{0};
+  std::atomic<bool> follower_ok{true};
+  std::thread follower([&] {
+    follower_started.store(true, std::memory_order_release);
+    for (uint8_t value = 3; value <= 67; ++value) {
+      if (!writer->write(&value, sizeof(value))) {
+        follower_ok.store(false, std::memory_order_release);
+      }
+      follower_completed.fetch_add(1, std::memory_order_release);
+    }
+  });
+  const bool follower_did_start = wait_until(
+      [&] { return follower_started.load(std::memory_order_acquire); }, 2s,
+      1ms);
+  if (follower_did_start) {
+    std::this_thread::sleep_for(100ms);
+    EXPECT_EQ(follower_completed.load(std::memory_order_acquire), 0u)
+        << "a later write overtook seq 2 while its local enqueue was blocked";
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(gate_mutex);
+    release_seq2 = true;
+  }
+  gate_cv.notify_all();
+  first_thread.join();
+  follower.join();
+  ASSERT_TRUE(follower_did_start);
+  ASSERT_TRUE(seq2_ok.load(std::memory_order_acquire));
+  ASSERT_TRUE(follower_ok.load(std::memory_order_acquire));
+  ASSERT_EQ(follower_completed.load(std::memory_order_acquire), 65u);
+
+  std::vector<uint64_t> sequences;
+  std::vector<uint8_t> payloads;
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  while (reader->take(out, info)) {
+    sequences.push_back(info.seq);
+    ASSERT_EQ(out.size(), 1u);
+    payloads.push_back(out[0]);
+  }
+  ASSERT_EQ(sequences.size(), 67u);
+  ASSERT_EQ(payloads.size(), 67u);
+  for (uint64_t seq = 1; seq <= 67; ++seq) {
+    EXPECT_EQ(sequences[seq - 1], seq);
+    EXPECT_EQ(payloads[seq - 1], seq);
+  }
+  EXPECT_EQ(reader->messages_lost(), 0u);
+}
