+  auto mutation = original;
+  mutation.endpoints.front().topic = "/qos_omission_mutated";
+  mutation.endpoints.front().type_name = "test/QosLedgerMutated";
+  mutation.endpoints.front().birth_us = 0x45;
+  std::vector<uint8_t> mutation_frame;
+  ASSERT_TRUE(prepare_raw_announce_frame(peer, cfg.domain_id, kTestBasePort5,
