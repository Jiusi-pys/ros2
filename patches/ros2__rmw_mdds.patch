+#include "rmw/event.h"
+#include "rmw/events_statuses/events_statuses.h"
+#include "rmw/init.h"
+#include "rmw/init_options.h"
+#include "rmw/qos_profiles.h"
+#include "rmw/rmw.h"
+
+#include "rosidl_runtime_c/message_type_support_struct.h"
+#include "rosidl_typesupport_introspection_c/identifier.h"
+#include "rosidl_typesupport_introspection_c/message_introspection.h"
+
+#include "common.hpp"
+
+// Fencing tests for the rmw_mdds event callback protocol: a process-wide
+// strand serializes all event callback executions, and a generation re-check
+// after acquiring the strand fences stale deliveries.
+// After rmw_event_set_callback(event, nullptr, ...) returns, the previous
+// (callback, user_data) pair must never be invoked again — including when
+// the clear ran inside another event's callback.
+//
+// All triggers are local matched-count changes: creating/destroying a
+// publisher synchronously refreshes and fires matching subscription events
+// on the CALLING thread (notify_events), which the tests use to place
+// callback executions on chosen threads.
+
+namespace
+{
+
+constexpr char kTopicXcA[] = "/rmw_mdds_event_xc_a";
+constexpr char kTopicXcB[] = "/rmw_mdds_event_xc_b";
+constexpr char kTopicClear[] = "/rmw_mdds_event_clear";
+constexpr char kTopicDeferA[] = "/rmw_mdds_event_defer_a";
+constexpr char kTopicDeferB[] = "/rmw_mdds_event_defer_b";
+constexpr char kTopicCrossContextA[] = "/rmw_mdds_event_cross_context_a";
+constexpr char kTopicCrossContextB[] = "/rmw_mdds_event_cross_context_b";
+
+// Generous sync bound: the board can be loaded; a wait that expires must
+// fail the test, never hang it.
+constexpr std::chrono::milliseconds kSyncTimeout{10000};
+
+template<typename Pred>
+bool
+wait_until(Pred pred, std::chrono::milliseconds timeout = kSyncTimeout)
+{
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  while (!pred()) {
+    if (std::chrono::steady_clock::now() >= deadline) {
+      return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+  }
+  return true;
+}
+
+// Hand-built introspection type support for an empty dummy message: the
+// matched-event face never serializes, so no real message package is needed.
+const rosidl_message_type_support_t *
+dummy_ts_handle(
+  const rosidl_message_type_support_t * handle, const char * identifier)
+{
+  return std::strcmp(handle->typesupport_identifier, identifier) == 0 ? handle : nullptr;
+}
+
+const rosidl_message_type_support_t *
+dummy_message_type_support()
+{
+  static const rosidl_typesupport_introspection_c__MessageMembers members = {
+    "rmw_mdds_test__msg",  // message_namespace_
+    "Dummy",               // message_name_
+    0u,                    // member_count_
+    0u,                    // size_of_
+    false,                 // has_any_key_member_
+    nullptr,               // members_
+    nullptr,               // init_function
+    nullptr                // fini_function
+  };
+  static const rosidl_message_type_support_t ts = {
+    rosidl_typesupport_introspection_c__identifier,  // typesupport_identifier
+    &members,          // data
+    &dummy_ts_handle,  // func
+    nullptr,           // get_type_hash_func
+    nullptr,           // get_type_description_func
+    nullptr            // get_type_description_sources_func
+  };
+  return &ts;
+}
+
+// ---- cross-clear (A clears B / B clears A) --------------------------------
+
+struct CrossClearRig
+{
+  rmw_event_t * event_a = nullptr;
+  rmw_event_t * event_b = nullptr;
+  std::atomic<uint64_t> hits_a{0};
+  std::atomic<uint64_t> hits_b{0};
+  /// 0: A's callback clears B; 1: B's callback clears A.
+  std::atomic<int> phase{0};
+  /// Set by the clearer callback once it is inside (holding the strand).
+  std::atomic<bool> clearer_inside{false};
+  /// Set by the victim thread right before its publisher creation.
+  std::atomic<bool> victim_started{false};
+  /// Victim hit count sampled by the clearer right after the clear returned.
+  std::atomic<uint64_t> victim_hits_at_clear{0};
+  std::atomic<bool> choreo_error{false};
+};
+
+struct CrossClearData
+{
+  CrossClearRig * rig;
+  bool is_a;
+};
+
+void
+cross_clear_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * data = const_cast<CrossClearData *>(static_cast<const CrossClearData *>(user_data));
+  CrossClearRig * rig = data->rig;
+  std::atomic<uint64_t> & my_hits = data->is_a ? rig->hits_a : rig->hits_b;
+  my_hits.fetch_add(1, std::memory_order_relaxed);
+  const bool i_clear = (rig->phase.load(std::memory_order_acquire) == 0) == data->is_a;
+  if (!i_clear) {
+    // Victim side: the strand must fence this delivery once the clear below
+    // landed; running at all is legitimate only before it.
+    return;
+  }
+  rig->clearer_inside.store(true, std::memory_order_release);
+  // Wait until the victim thread has started its publisher creation, then
+  // give it a moment to reach the strand wait inside deliver_event_callback.
+  // The fencing assertion below holds either way; this only improves the
+  // chance that the race window (delivery blocked on the strand while its
+  // callback is cleared) is actually exercised.
+  if (!wait_until([rig] {return rig->victim_started.load(std::memory_order_acquire);})) {
+    rig->choreo_error.store(true, std::memory_order_release);
+    return;
+  }
+  std::this_thread::sleep_for(std::chrono::milliseconds(50));
+  rmw_event_t * victim_event = data->is_a ? rig->event_b : rig->event_a;
+  std::atomic<uint64_t> & victim_hits = data->is_a ? rig->hits_b : rig->hits_a;
+  if (rmw_event_set_callback(victim_event, nullptr, nullptr) != RMW_RET_OK) {
+    rig->choreo_error.store(true, std::memory_order_release);
+    return;
+  }
+  rig->victim_hits_at_clear.store(
+    victim_hits.load(std::memory_order_acquire), std::memory_order_release);
+}
+
+// ---- clear from non-callback context, then free user_data -----------------
+
+struct CountingData
+{
+  explicit CountingData(std::atomic<uint64_t> * shadow_ptr)
+  : shadow(shadow_ptr)
+  {
+  }
+
+  std::atomic<uint64_t> hits{0};
+  /// Lives in the test fixture, NOT freed with this struct: a stale fire
+  /// after the delete is observable here (and writes freed memory above).
+  std::atomic<uint64_t> * shadow;
+};
+
+void
+counting_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * data = const_cast<CountingData *>(static_cast<const CountingData *>(user_data));
+  data->hits.fetch_add(1, std::memory_order_relaxed);
+  data->shadow->fetch_add(1, std::memory_order_relaxed);
+}
+
+// ---- set a new callback from inside a callback (deferred fire) ------------
+
+struct DeferredRig
+{
+  rmw_event_t * event_b = nullptr;
+  std::atomic<uint64_t> hits_a{0};
+  std::atomic<uint64_t> hits_b{0};
+  std::atomic<uint64_t> b_last_count{0};
+  std::atomic<bool> a_returned{false};
+  std::atomic<bool> b_saw_a_returned{false};
+  std::atomic<bool> set_failed{false};
+};
+
+void
+deferred_b_cb(const void * user_data, size_t number_of_events)
+{
+  auto * rig = const_cast<DeferredRig *>(static_cast<const DeferredRig *>(user_data));
+  rig->hits_b.fetch_add(1, std::memory_order_relaxed);
+  rig->b_last_count.store(number_of_events, std::memory_order_relaxed);
+  rig->b_saw_a_returned.store(
+    rig->a_returned.load(std::memory_order_acquire), std::memory_order_release);
+}
+
+void
+deferred_a_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * rig = const_cast<DeferredRig *>(static_cast<const DeferredRig *>(user_data));
+  rig->hits_a.fetch_add(1, std::memory_order_relaxed);
+  // B has pending (untaken) matched state, so this installs an immediate
+  // fire. From callback context it must be deferred to the outermost unwind:
+  // this thread still holds the context strand.
+  if (rmw_event_set_callback(rig->event_b, deferred_b_cb, user_data) != RMW_RET_OK) {
+    rig->set_failed.store(true, std::memory_order_release);
+  }
+  rig->a_returned.store(true, std::memory_order_release);
+}
+
+// ---- cross-rmw_context clear ------------------------------------------------
+
+// A callback in context A clears B while B has already scheduled a delivery.
+// The test deliberately holds B's old callback open on the pre-fix
+// implementation: A then returned from rmw_event_set_callback(B, nullptr)
+// even though B could still dereference its old user_data. With the
+// process-wide strand, B is instead blocked before its callback and the
+// generation re-check drops it after A's clear returns.
+struct CrossContextClearRig
+{
+  rmw_event_t * event_b = nullptr;
+  std::atomic<bool> a_entered{false};
+  std::atomic<bool> b_create_started{false};
+  std::atomic<bool> clear_returned{false};
+  std::atomic<bool> error{false};
+  std::atomic<bool> b_callback_started{false};
+  std::atomic<bool> b_callback_after_clear{false};
+};
+
+void
+cross_context_b_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * rig = const_cast<CrossContextClearRig *>(
+    static_cast<const CrossContextClearRig *>(user_data));
+  rig->b_callback_started.store(true, std::memory_order_release);
+  if (!wait_until([rig] {return rig->clear_returned.load(std::memory_order_acquire);})) {
+    rig->error.store(true, std::memory_order_release);
+    return;
+  }
+  // If this is reached, the old callback ran after the clear returned. A
+  // caller freeing user_data immediately at the clear boundary would have a
+  // UAF here; retain the test object only to make the violation observable.
+  rig->b_callback_after_clear.store(true, std::memory_order_release);
+}
+
+void
+cross_context_a_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * rig = const_cast<CrossContextClearRig *>(
+    static_cast<const CrossContextClearRig *>(user_data));
+  rig->a_entered.store(true, std::memory_order_release);
+  if (!wait_until([rig] {return rig->b_create_started.load(std::memory_order_acquire);})) {
+    rig->error.store(true, std::memory_order_release);
+    rig->clear_returned.store(true, std::memory_order_release);
+    return;
+  }
+
+  auto * event_b_impl = static_cast<rmw_mdds::MddsEvent *>(rig->event_b->data);
+  if (event_b_impl == nullptr || !wait_until([event_b_impl] {
+      std::lock_guard<std::mutex> lock(event_b_impl->context->event_mutex);
+      return event_b_impl->deliver_depth > 0;
+    }))
+  {
+    rig->error.store(true, std::memory_order_release);
+    rig->clear_returned.store(true, std::memory_order_release);
+    return;
+  }
+
+  if (rmw_event_set_callback(rig->event_b, nullptr, nullptr) != RMW_RET_OK) {
+    rig->error.store(true, std::memory_order_release);
+  }
+  // This exact boundary is where user code is entitled to free B's old
+  // user_data. The correct implementation must prevent B's callback above
+  // from ever starting after it becomes true.
+  rig->clear_returned.store(true, std::memory_order_release);
+}
+
+// ---- deferred pending callback followed by context fini -------------------
+
+// A's callback installs B's callback while B already has an unconsumed
+// matched event. The immediate notification is deferred because A owns the
+// process-wide callback strand. A then tears B down before it returns. The
+// deferred snapshot must be retired (not dereferenced after B is freed).
+struct CrossContextFiniRig
+{
+  rmw_event_t * event_b = nullptr;
+  rmw_node_t ** node_b = nullptr;
+  rmw_publisher_t ** pub_b = nullptr;
+  rmw_subscription_t ** sub_b = nullptr;
+  rmw_context_t * context_b = nullptr;
+  rmw_init_options_t * options_b = nullptr;
+  std::atomic<uint64_t> hits_a{0};
+  std::atomic<uint64_t> hits_b{0};
+  std::atomic<bool> callback_set{false};
+  std::atomic<bool> fini_returned{false};
+  std::atomic<bool> failed{false};
+  // On the vulnerable implementation this deliberately reuses the just-freed
+  // MddsEvent allocation before A's deferred queue drains, turning the stale
+  // dereference into a deterministic invalid context pointer instead of a
+  // silent heap read.
+  std::vector<std::unique_ptr<rmw_mdds::MddsEvent>> allocation_churn;
+};
+
+void
+cross_context_fini_b_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * rig = const_cast<CrossContextFiniRig *>(
+    static_cast<const CrossContextFiniRig *>(user_data));
+  rig->hits_b.fetch_add(1, std::memory_order_relaxed);
+}
+
+void
+cross_context_fini_a_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * rig = const_cast<CrossContextFiniRig *>(
+    static_cast<const CrossContextFiniRig *>(user_data));
+  rig->hits_a.fetch_add(1, std::memory_order_relaxed);
+  if (rmw_event_set_callback(
+      rig->event_b, cross_context_fini_b_cb, rig) != RMW_RET_OK)
+  {
+    rig->failed.store(true, std::memory_order_release);
+    return;
+  }
+  rig->callback_set.store(true, std::memory_order_release);
+
+  if (*rig->pub_b != nullptr &&
+    rmw_destroy_publisher(*rig->node_b, *rig->pub_b) != RMW_RET_OK)
+  {
+    rig->failed.store(true, std::memory_order_release);
+    return;
+  }
+  *rig->pub_b = nullptr;
+  if (*rig->sub_b != nullptr &&
+    rmw_destroy_subscription(*rig->node_b, *rig->sub_b) != RMW_RET_OK)
+  {
+    rig->failed.store(true, std::memory_order_release);
+    return;
+  }
+  *rig->sub_b = nullptr;
+  if (*rig->node_b != nullptr &&
+    rmw_destroy_node(*rig->node_b) != RMW_RET_OK)
+  {
+    rig->failed.store(true, std::memory_order_release);
+    return;
+  }
+  *rig->node_b = nullptr;
+  if (rmw_shutdown(rig->context_b) != RMW_RET_OK ||
+    rmw_context_fini(rig->context_b) != RMW_RET_OK ||
+    rmw_init_options_fini(rig->options_b) != RMW_RET_OK)
+  {
+    rig->failed.store(true, std::memory_order_release);
+    return;
+  }
+
+  // Keep these allocations alive until A returns. Before the lifetime fix,
+  // the deferred raw pointer can now alias one of these zero-context objects.
+  for (size_t i = 0; i < 64; ++i) {
+    rig->allocation_churn.emplace_back(std::make_unique<rmw_mdds::MddsEvent>());
+  }
+  rig->fini_returned.store(true, std::memory_order_release);
+}
+
+// ---- concurrent B fini after A queues B's pending callback ---------------
+
+// Unlike the same-thread case above, this exercises the event-dispatch pin
+// against a context fini running on a different thread. The finalizer begins
+// while A still owns the callback strand, so it must wait for A's deferred B
+// snapshot to be drained rather than deleting B's event storage.
+struct ConcurrentContextFiniRig
+{
+  rmw_event_t * event_b = nullptr;
+  rmw_node_t ** node_b = nullptr;
+  rmw_publisher_t ** pub_b = nullptr;
+  rmw_subscription_t ** sub_b = nullptr;
+  rmw_context_t * context_b = nullptr;
+  rmw_init_options_t * options_b = nullptr;
+  std::atomic<uint64_t> hits_a{0};
+  std::atomic<uint64_t> hits_b{0};
+  std::atomic<bool> callback_set{false};
+  std::atomic<bool> finalizer_entered{false};
+  std::atomic<bool> finalizer_done{false};
+  std::atomic<bool> finalizer_finished_while_a_active{false};
+  std::atomic<bool> failed{false};
+  std::vector<std::unique_ptr<rmw_mdds::MddsEvent>> allocation_churn;
+};
+
+void
+concurrent_context_fini_b_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * rig = const_cast<ConcurrentContextFiniRig *>(
+    static_cast<const ConcurrentContextFiniRig *>(user_data));
+  rig->hits_b.fetch_add(1, std::memory_order_relaxed);
+}
+
+void
+concurrent_context_fini_a_cb(const void * user_data, size_t number_of_events)
+{
+  static_cast<void>(number_of_events);
+  auto * rig = const_cast<ConcurrentContextFiniRig *>(
+    static_cast<const ConcurrentContextFiniRig *>(user_data));
+  rig->hits_a.fetch_add(1, std::memory_order_relaxed);
+  if (rmw_event_set_callback(
+      rig->event_b, concurrent_context_fini_b_cb, rig) != RMW_RET_OK)
+  {
+    rig->failed.store(true, std::memory_order_release);
+    return;
+  }
+  rig->callback_set.store(true, std::memory_order_release);
+  if (!wait_until([rig] {return rig->finalizer_entered.load(std::memory_order_acquire);})) {
+    rig->failed.store(true, std::memory_order_release);
+    return;
+  }
+
+  // Give B's finalizer a chance to attempt rmw_context_fini while A still
+  // owns the strand. It must remain blocked on B's dispatch reference.
+  std::this_thread::sleep_for(std::chrono::milliseconds(100));
+  if (rig->finalizer_done.load(std::memory_order_acquire)) {
+    rig->finalizer_finished_while_a_active.store(true, std::memory_order_release);
+  }
+}
+
+}  // namespace
+
+class MddsEventTest : public ::testing::Test
+{
+protected:
+  void SetUp() override
+  {
+    options_ = rmw_get_zero_initialized_init_options();
+    ASSERT_EQ(RMW_RET_OK, rmw_init_options_init(&options_, rcutils_get_default_allocator()));
+    options_.enclave = rcutils_strdup("/", options_.allocator);
+    ASSERT_NE(nullptr, options_.enclave);
+    // Single-process tests: pin all traffic to the loopback UDP transport.
+    options_.discovery_options.automatic_discovery_range =
+      RMW_AUTOMATIC_DISCOVERY_RANGE_LOCALHOST;
+    context_ = rmw_get_zero_initialized_context();
+    ASSERT_EQ(RMW_RET_OK, rmw_init(&options_, &context_));
+    node_ = rmw_create_node(&context_, "mdds_event_test", "/");
+    ASSERT_NE(nullptr, node_);
+  }
+
+  void TearDown() override
+  {
+    if (node_ != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_destroy_node(node_));
+      node_ = nullptr;
+    }
+    if (context_.implementation_identifier != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_shutdown(&context_));
+      EXPECT_EQ(RMW_RET_OK, rmw_context_fini(&context_));
+      context_ = rmw_get_zero_initialized_context();
+    }
+    if (options_.implementation_identifier != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_init_options_fini(&options_));
+      options_ = rmw_get_zero_initialized_init_options();
+    }
+  }
+
+  rmw_subscription_t * make_sub(const char * topic)
+  {
+    rmw_subscription_options_t options = rmw_get_default_subscription_options();
+    return rmw_create_subscription(
+      node_, dummy_message_type_support(), topic, &rmw_qos_profile_default, &options);
+  }
+
+  rmw_publisher_t * make_pub(const char * topic)
+  {
+    rmw_publisher_options_t options = rmw_get_default_publisher_options();
+    return rmw_create_publisher(
+      node_, dummy_message_type_support(), topic, &rmw_qos_profile_default, &options);
+  }
+
+  /// Consume the matched-state change so the next half starts with no
+  /// pending state (a pending event would immediate-fire at set_callback).
+  void take_matched(const rmw_event_t * event)
+  {
+    rmw_matched_status_t status{};
+    bool taken = false;
+    EXPECT_EQ(RMW_RET_OK, rmw_take_event(event, &status, &taken));
+  }
+
+  /// One half of the cross-clear cycle. The clearer event's callback (run on
+  /// the clearer thread inside rmw_create_publisher, holding the context
+  /// strand) clears the victim event's callback while the victim's delivery
+  /// is blocked on the strand. After the clear returned, the victim's hit
+  /// count must never move again.
+  bool run_cross_clear_half(
+    CrossClearRig & rig, CrossClearData * data_a, CrossClearData * data_b, int phase)
+  {
+    rig.phase.store(phase, std::memory_order_release);
+    rig.clearer_inside.store(false, std::memory_order_release);
+    rig.victim_started.store(false, std::memory_order_release);
+    rig.choreo_error.store(false, std::memory_order_release);
+
+    if (rmw_event_set_callback(rig.event_a, cross_clear_cb, data_a) != RMW_RET_OK ||
+      rmw_event_set_callback(rig.event_b, cross_clear_cb, data_b) != RMW_RET_OK)
+    {
+      ADD_FAILURE() << "rmw_event_set_callback failed";
+      return false;
+    }
+
+    const bool a_clears = phase == 0;
+    const char * clearer_topic = a_clears ? kTopicXcA : kTopicXcB;
+    const char * victim_topic = a_clears ? kTopicXcB : kTopicXcA;
+    rmw_publisher_t * clearer_pub = nullptr;
+    rmw_publisher_t * victim_pub = nullptr;
+
+    std::thread clearer_thread([&] {clearer_pub = make_pub(clearer_topic);});
+    const bool clearer_ran =
+      wait_until([&rig] {return rig.clearer_inside.load(std::memory_order_acquire);});
+    // Always start the victim: it unblocks a late clearer callback waiting
+    // on victim_started.
+    std::thread victim_thread([&] {
+        rig.victim_started.store(true, std::memory_order_release);
+        victim_pub = make_pub(victim_topic);
+      });
+    clearer_thread.join();
+    victim_thread.join();
+
+    bool ok = true;
+    if (!clearer_ran) {
+      ADD_FAILURE() << "clearer callback never ran";
+      ok = false;
+    }
+    if (rig.choreo_error.load(std::memory_order_acquire)) {
+      ADD_FAILURE() << "cross-clear choreography failed";
+      ok = false;
+    }
+    if (clearer_pub == nullptr || victim_pub == nullptr) {
+      ADD_FAILURE() << "publisher creation failed";
+      ok = false;
+    }
+    if (ok) {
+      const std::atomic<uint64_t> & victim_hits = a_clears ? rig.hits_b : rig.hits_a;
+      const uint64_t at_clear =
+        rig.victim_hits_at_clear.load(std::memory_order_acquire);
+      EXPECT_EQ(at_clear, victim_hits.load(std::memory_order_acquire));
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+      EXPECT_EQ(at_clear, victim_hits.load(std::memory_order_acquire));
+    }
+
+    // Detach both callbacks before destroying the publishers, so the destroy
+    // notifications cannot re-enter either callback. Clearing from the main
+    // thread drains any leftover in-flight delivery first.
+    EXPECT_EQ(RMW_RET_OK, rmw_event_set_callback(rig.event_a, nullptr, nullptr));
+    EXPECT_EQ(RMW_RET_OK, rmw_event_set_callback(rig.event_b, nullptr, nullptr));
+    if (clearer_pub != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(node_, clearer_pub));
+    }
+    if (victim_pub != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(node_, victim_pub));
+    }
+    take_matched(rig.event_a);
+    take_matched(rig.event_b);
+    return ok;
+  }
+
+  rmw_init_options_t options_ = rmw_get_zero_initialized_init_options();
+  rmw_context_t context_ = rmw_get_zero_initialized_context();
+  rmw_node_t * node_ = nullptr;
+};
+
+class MddsEventCrossContextTest : public ::testing::Test
+{
+protected:
+  struct ContextNode
+  {
+    rmw_init_options_t options = rmw_get_zero_initialized_init_options();
+    rmw_context_t context = rmw_get_zero_initialized_context();
+    rmw_node_t * node = nullptr;
+  };
+
+  void SetUp() override
+  {
+    init_context(context_a_, "mdds_event_context_a");
+    if (HasFatalFailure()) {
+      return;
+    }
+    init_context(context_b_, "mdds_event_context_b");
+  }
+
+  void TearDown() override
+  {
+    fini_context(context_b_);
+    fini_context(context_a_);
+  }
+
+  void init_context(ContextNode & target, const char * name)
+  {
+    ASSERT_EQ(RMW_RET_OK, rmw_init_options_init(
+      &target.options, rcutils_get_default_allocator()));
+    target.options.enclave = rcutils_strdup("/", target.options.allocator);
+    ASSERT_NE(nullptr, target.options.enclave);
+    target.options.discovery_options.automatic_discovery_range =
+      RMW_AUTOMATIC_DISCOVERY_RANGE_LOCALHOST;
+    ASSERT_EQ(RMW_RET_OK, rmw_init(&target.options, &target.context));
+    target.node = rmw_create_node(&target.context, name, "/");
+    ASSERT_NE(nullptr, target.node);
+  }
+
+  void fini_context(ContextNode & target)
+  {
+    if (target.node != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_destroy_node(target.node));
+      target.node = nullptr;
+    }
+    if (target.context.implementation_identifier != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_shutdown(&target.context));
+      EXPECT_EQ(RMW_RET_OK, rmw_context_fini(&target.context));
+      target.context = rmw_get_zero_initialized_context();
+    }
+    if (target.options.implementation_identifier != nullptr) {
+      EXPECT_EQ(RMW_RET_OK, rmw_init_options_fini(&target.options));
+      target.options = rmw_get_zero_initialized_init_options();
+    }
+  }
+
+  rmw_subscription_t * make_sub(ContextNode & target, const char * topic)
+  {
+    rmw_subscription_options_t options = rmw_get_default_subscription_options();
+    return rmw_create_subscription(
+      target.node, dummy_message_type_support(), topic, &rmw_qos_profile_default, &options);
+  }
+
+  rmw_publisher_t * make_pub(ContextNode & target, const char * topic)
+  {
+    rmw_publisher_options_t options = rmw_get_default_publisher_options();
+    return rmw_create_publisher(
+      target.node, dummy_message_type_support(), topic, &rmw_qos_profile_default, &options);
+  }
+
+  void take_matched(const rmw_event_t * event)
+  {
+    rmw_matched_status_t status{};
+    bool taken = false;
+    EXPECT_EQ(RMW_RET_OK, rmw_take_event(event, &status, &taken));
+  }
+
+  ContextNode context_a_;
+  ContextNode context_b_;
+};
+
+TEST_F(MddsEventTest, cross_clear_ab)
+{
+  rmw_subscription_t * sub_a = make_sub(kTopicXcA);
+  ASSERT_NE(nullptr, sub_a);
+  rmw_subscription_t * sub_b = make_sub(kTopicXcB);
+  ASSERT_NE(nullptr, sub_b);
+  rmw_event_t event_a = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_a, sub_a, RMW_EVENT_SUBSCRIPTION_MATCHED));
+  rmw_event_t event_b = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_b, sub_b, RMW_EVENT_SUBSCRIPTION_MATCHED));
+
+  CrossClearRig rig;
+  rig.event_a = &event_a;
+  rig.event_b = &event_b;
+  CrossClearData data_a{&rig, true};
+  CrossClearData data_b{&rig, false};
+
+  constexpr int kIterations = 200;
+  for (int i = 0; i < kIterations; ++i) {
+    ASSERT_TRUE(run_cross_clear_half(rig, &data_a, &data_b, 0))
+      << "iteration " << i << " (A clears B)";
+    ASSERT_TRUE(run_cross_clear_half(rig, &data_a, &data_b, 1))
+      << "iteration " << i << " (B clears A)";
+  }
+  // Each clearer fired exactly once per own half; the victim never fired
+  // after its clear (strand fence), so the totals are exact.
+  EXPECT_EQ(static_cast<uint64_t>(kIterations), rig.hits_a.load());
+  EXPECT_EQ(static_cast<uint64_t>(kIterations), rig.hits_b.load());
+
+  // Final long settle: nothing may fire after the last clear.
+  const uint64_t final_a = rig.hits_a.load();
+  const uint64_t final_b = rig.hits_b.load();
+  std::this_thread::sleep_for(std::chrono::milliseconds(300));
+  EXPECT_EQ(final_a, rig.hits_a.load());
+  EXPECT_EQ(final_b, rig.hits_b.load());
+
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(node_, sub_a));
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(node_, sub_b));
+}
+
+TEST_F(MddsEventTest, clear_from_non_callback_then_destroy)
+{
+  rmw_subscription_t * sub = make_sub(kTopicClear);
+  ASSERT_NE(nullptr, sub);
+  rmw_event_t event = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event, sub, RMW_EVENT_SUBSCRIPTION_MATCHED));
+
+  std::atomic<uint64_t> shadow{0};
+  auto * data = new CountingData(&shadow);
+  ASSERT_EQ(RMW_RET_OK, rmw_event_set_callback(&event, counting_cb, data));
+
+  // First delivery, fired synchronously on this thread.
+  rmw_publisher_t * pub = make_pub(kTopicClear);
+  ASSERT_NE(nullptr, pub);
+  ASSERT_EQ(1u, shadow.load());
+
+  // Hammer matched changes from another thread while clearing: a delivery
+  // collected just before the clear must be fenced by the generation bump.
+  std::atomic<bool> stop{false};
+  std::thread toggler([&] {
+      while (!stop.load(std::memory_order_acquire)) {
+        rmw_publisher_t * p = make_pub(kTopicClear);
+        if (p != nullptr) {
+          const rmw_ret_t ret = rmw_destroy_publisher(node_, p);
+          static_cast<void>(ret);
+        }
+      }
+    });
+  std::this_thread::sleep_for(std::chrono::milliseconds(50));
+
+  // Non-callback clear: drains any in-flight delivery before returning...
+  ASSERT_EQ(RMW_RET_OK, rmw_event_set_callback(&event, nullptr, nullptr));
+  const uint64_t at_clear = shadow.load();
+  // ...so the freed user_data can never be touched again.
+  delete data;
+  std::this_thread::sleep_for(std::chrono::milliseconds(200));
+  EXPECT_EQ(at_clear, shadow.load());
+
+  stop.store(true, std::memory_order_release);
+  toggler.join();
+
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(node_, pub));
+  take_matched(&event);
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(node_, sub));
+}
+
+TEST_F(MddsEventTest, set_from_callback_deferred_fire)
+{
+  rmw_subscription_t * sub_a = make_sub(kTopicDeferA);
+  ASSERT_NE(nullptr, sub_a);
+  rmw_subscription_t * sub_b = make_sub(kTopicDeferB);
+  ASSERT_NE(nullptr, sub_b);
+  rmw_event_t event_a = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_a, sub_a, RMW_EVENT_SUBSCRIPTION_MATCHED));
+  rmw_event_t event_b = rmw_get_zero_initialized_event();
+  ASSERT_EQ(RMW_RET_OK,
+    rmw_subscription_event_init(&event_b, sub_b, RMW_EVENT_SUBSCRIPTION_MATCHED));
+
+  DeferredRig rig;
+  rig.event_b = &event_b;
+
+  // B's matched state becomes pending BEFORE any callback is installed on
+  // it: the set_callback from inside A's callback must immediate-fire, and
+  // from callback context that fire is deferred to the outermost unwind.
+  rmw_publisher_t * pub_b = make_pub(kTopicDeferB);
+  ASSERT_NE(nullptr, pub_b);
+  ASSERT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_a, deferred_a_cb, &rig));
+
+  // Fires A's callback inline on this thread; the deferred B fire runs at
+  // the unwind, still inside rmw_create_publisher.
+  rmw_publisher_t * pub_a = make_pub(kTopicDeferA);
+  ASSERT_NE(nullptr, pub_a);
+
+  EXPECT_EQ(1u, rig.hits_a.load());
+  EXPECT_FALSE(rig.set_failed.load());
+  // B's new callback fired exactly once, after A's callback fully returned.
+  EXPECT_EQ(1u, rig.hits_b.load());
+  EXPECT_EQ(1u, rig.b_last_count.load());
+  EXPECT_TRUE(rig.b_saw_a_returned.load());
+
+  // Nothing may re-fire afterwards.
+  std::this_thread::sleep_for(std::chrono::milliseconds(100));
+  EXPECT_EQ(1u, rig.hits_a.load());
+  EXPECT_EQ(1u, rig.hits_b.load());
+
+  EXPECT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_a, nullptr, nullptr));
+  EXPECT_EQ(RMW_RET_OK, rmw_event_set_callback(&event_b, nullptr, nullptr));
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(node_, pub_a));
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_publisher(node_, pub_b));
+  take_matched(&event_a);
+  take_matched(&event_b);
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(node_, sub_a));
+  EXPECT_EQ(RMW_RET_OK, rmw_destroy_subscription(node_, sub_b));
+}
