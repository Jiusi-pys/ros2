+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef MDDS_GATEWAY__SPIN_THREAD_GUARD_HPP_
+#define MDDS_GATEWAY__SPIN_THREAD_GUARD_HPP_
+
+#include <atomic>
+#include <exception>
+#include <thread>
+#include <type_traits>
+#include <utility>
+
+namespace mdds_gateway
+{
+
+/// Own a bounded-poll spin thread through every scope-exit path.
+///
+/// The associated worker must observe `stop` without waiting indefinitely
+/// (the gateway executor uses spin_once with a finite timeout).  cancel_fn is
+/// only a fast wake-up; its failure is reported to the explicit caller and is
+/// deliberately contained in the destructor so an exception never bypasses
+/// std::thread::join().
+template<typename CancelFn>
+class SpinThreadGuard
+{
+public:
+  SpinThreadGuard(
+    std::atomic<bool> & stop,
+    std::thread & spin_thread,
+    CancelFn && cancel_fn)
+  : stop_(stop), spin_thread_(spin_thread), cancel_fn_(std::forward<CancelFn>(cancel_fn))
+  {}
+
+  ~SpinThreadGuard() noexcept
+  {
+    (void)stop_and_join();
+  }
+
+  SpinThreadGuard(const SpinThreadGuard &) = delete;
+  SpinThreadGuard & operator=(const SpinThreadGuard &) = delete;
+
+  /// Request stop, best-effort wake the worker, and join it.
+  ///
+  /// Returns false only when the fast wake-up failed.  Joining remains safe:
+  /// the worker is required to observe stop_ after a bounded poll.  A failed
+  /// join would leave a thread referring to destroyed state, which has no safe
+  /// recovery path; terminate rather than detach into use-after-free.
+  bool stop_and_join() noexcept
+  {
+    stop_.store(true, std::memory_order_release);
+    bool cancel_succeeded = true;
+    if (!spin_thread_.joinable()) {
+      return cancel_succeeded;
+    }
+    try {
+      cancel_fn_();
+    } catch (...) {
+      cancel_succeeded = false;
+    }
+    try {
+      spin_thread_.join();
+    } catch (...) {
+      std::terminate();
+    }
+    return cancel_succeeded;
+  }
+
+private:
+  std::atomic<bool> & stop_;
+  std::thread & spin_thread_;
+  std::decay_t<CancelFn> cancel_fn_;
+};
+
+}  // namespace mdds_gateway
+
+#endif  // MDDS_GATEWAY__SPIN_THREAD_GUARD_HPP_
