+{
+public:
+  explicit C2mIngressQueue(C2mIngressLimits limits)
+  : limits_(limits) {}
+
+  C2mIngressQueue(const C2mIngressQueue &) = delete;
+  C2mIngressQueue & operator=(const C2mIngressQueue &) = delete;
+
+  C2mIngressPushResult push_copy(const uint8_t * data, size_t size)
+  {
+    if (data == nullptr || size > limits_.max_sample_bytes) {
+      return C2mIngressPushResult::SAMPLE_TOO_LARGE;
+    }
+    // Allocate before taking the queue mutex so the Cyclone executor never
+    // holds it across a potentially expensive copy.  Capacity is checked a
+    // second time while locked; this makes the decision correct if a future
+    // executor configuration has more than one producer.
+    std::vector<uint8_t> copy(data, data + size);
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (closed_) {
+      return C2mIngressPushResult::CLOSED;
+    }
+    if (queue_.size() >= limits_.max_samples) {
+      return C2mIngressPushResult::SAMPLE_LIMIT;
+    }
+    if (size > limits_.max_bytes - queued_bytes_) {
+      return C2mIngressPushResult::BYTE_LIMIT;
+    }
+    queued_bytes_ += size;
+    queue_.emplace_back(std::move(copy));
+    if (queue_.size() > high_water_samples_) {
+      high_water_samples_ = queue_.size();
+    }
+    if (queued_bytes_ > high_water_bytes_) {
+      high_water_bytes_ = queued_bytes_;
+    }
+    cv_.notify_one();
+    return C2mIngressPushResult::ACCEPTED;
+  }
+
+  /// Returns false on timeout or after close().  The caller can distinguish
+  /// those states via status().closed; shutdown deliberately abandons queued
+  /// samples because the owning bridge is being destroyed.
+  bool pop_for(std::vector<uint8_t> & out, std::chrono::milliseconds timeout)
+  {
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait_for(lock, timeout, [this] {return closed_ || !queue_.empty();});
+    if (closed_ || queue_.empty()) {
+      return false;
+    }
+    out = std::move(queue_.front());
+    queued_bytes_ -= out.size();
+    queue_.pop_front();
+    return true;
+  }
+
+  void close()
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    closed_ = true;
+    queue_.clear();
+    queued_bytes_ = 0;
+    cv_.notify_all();
+  }
+
+  C2mIngressQueueStatus status() const
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return C2mIngressQueueStatus{
+      queue_.size(), queued_bytes_, high_water_samples_, high_water_bytes_, closed_};
+  }
+
+private:
+  const C2mIngressLimits limits_;
+  mutable std::mutex mutex_;
+  std::condition_variable cv_;
+  std::deque<std::vector<uint8_t>> queue_;
+  size_t queued_bytes_ = 0;
+  size_t high_water_samples_ = 0;
+  size_t high_water_bytes_ = 0;
+  bool closed_ = false;
+};
+
+}  // namespace mdds_gateway
