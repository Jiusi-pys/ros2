+// A peer-down frees the active remote snapshot, but it must not free a GUID's
+// full identity binding. Here the canonical volatile reader intentionally
+// does not match `writer`; a same-QoS topic/type/birth rewrite would match it
+// after reconnect. If that rewrite were accepted, its existing (empty)
+// watermark record would skip creation of a new association boundary and an
+// ACKNACK could leak writer history published before that association.
+TEST(
+    DiscoveryAdmission,
+    EndpointIdentityLedgerRejectsTopicTypeBirthMutationAfterPeerDownReconnect) {
+  std::atomic<bool> leaked_prejoin_data{false};
+  mdds::Guid local_writer_guid{};
+  LocalEndpointEpochCapture local_writer_epoch_capture;
+  auto cfg = raw_admission_config();
+  cfg.test_send_hook = [&](const uint8_t *frame, size_t len) {
+    mdds::FrameHeader header;
+    if (!mdds::decode_header(frame, len, header)) {
+      return false;
+    }
+    if (header.type == mdds::FrameType::ANNOUNCE) {
+      local_writer_epoch_capture.observe_announce(frame, len);
+      return false; // raw peer needs the v8 session/ANNOUNCE handshake
+    }
+    if (header.type == mdds::FrameType::DATA) {
+      mdds::DataBody body;
+      if (mdds::decode_data(frame, len, body) &&
+          body.writer == local_writer_guid && body.seq == 1) {
+        leaked_prejoin_data.store(true, std::memory_order_relaxed);
+      }
+      return true; // deterministic loss for the leak observation
+    }
+    return false;
+  };
+  RawUdpPeer first_peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(first_peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  std::atomic<size_t> graph_callbacks{0};
+  auto *writer = target->create_writer("/qos_reconnect_new",
+                                       "test/QosLedgerNew", default_qos());
+  ASSERT_NE(writer, nullptr);
+  local_writer_guid = writer->guid();
+  local_writer_epoch_capture.watch(local_writer_guid);
+  target->set_graph_callback(
+      [&] { graph_callbacks.fetch_add(1, std::memory_order_relaxed); });
+
+  // seq=1 exists before this remote reader is associated with `writer`.
+  const uint8_t before_disconnect[] = {0x52, 0x31};
+  ASSERT_TRUE(writer->write(before_disconnect, sizeof(before_disconnect)));
+
+  auto canonical = raw_remote_snapshot(
+      0x46, {raw_remote_endpoint(0x46, mdds::EntityKind::READER, 1,
+                                 "/qos_reconnect_old", "test/QosLedgerOld")});
+  const mdds::Guid remote_reader_guid = canonical.endpoints.front().guid;
+  const mdds::Guid remote_reader_epoch = canonical.endpoints.front().epoch;
+  ASSERT_TRUE(
+      raw_announce(first_peer, cfg.domain_id, kTestBasePort5, canonical, 1));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        first_peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return target->graph_counts().remote_participants == 1 &&
+               writer->matched_count() == 0 &&
+               graph_callbacks.load(std::memory_order_relaxed) >= 1;
+      },
+      2s, 10ms));
+
+  first_peer.close();
+  ASSERT_TRUE(wait_until(
+      [&] {
+        return target->graph_counts().remote_participants == 0 &&
+               writer->matched_count() == 0;
+      },
+      2s, 10ms));
+  const size_t graph_before_mutation =
+      graph_callbacks.load(std::memory_order_relaxed);
+
+  RawUdpPeer reconnect_peer(kTestBasePort5 + 6);
+  ASSERT_TRUE(reconnect_peer.valid());
+  auto mutation = canonical;
+  mutation.endpoints.front().topic = "/qos_reconnect_new";
+  mutation.endpoints.front().type_name = "test/QosLedgerNew";
+  mutation.endpoints.front().birth_us = 0x46;
+  std::vector<uint8_t> mutation_frame;
+  ASSERT_TRUE(prepare_raw_announce_frame(reconnect_peer, cfg.domain_id,
+                                         kTestBasePort5, mutation, 1,
+                                         mutation_frame));
+  mdds::ParticipantSnapshot decoded_mutation;
+  uint64_t decoded_seq = 0;
+  ASSERT_TRUE(mdds::decode_announce(mutation_frame.data(),
+                                    mutation_frame.size(), decoded_mutation,
+                                    decoded_seq));
+  EXPECT_EQ(decoded_seq, 1u);
+  ASSERT_EQ(decoded_mutation.endpoints.size(), 1u);
+  EXPECT_TRUE(decoded_mutation.endpoints.front().qos ==
+              canonical.endpoints.front().qos);
+  EXPECT_EQ(decoded_mutation.endpoints.front().topic, "/qos_reconnect_new");
+  EXPECT_EQ(decoded_mutation.endpoints.front().type_name, "test/QosLedgerNew");
+  EXPECT_EQ(decoded_mutation.endpoints.front().birth_us, 0x46u);
+
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(reconnect_peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(reconnect_peer.send_frame(mutation_frame, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_EQ(target->graph_counts().remote_participants, 0u);
+  EXPECT_EQ(writer->matched_count(), 0u);
+  EXPECT_EQ(graph_callbacks.load(std::memory_order_relaxed),
+            graph_before_mutation);
+  // Keep the UDP source alive and re-inject long enough to distinguish a
+  // processed, rejected remote-reader mutation from a merely delayed packet.
+  // An implementation that accepted the rewrite would source-bind this
+  // ACKNACK and expose the pre-join seq=1 through test_send_hook above.
+  mdds::Guid local_writer_epoch;
+  ASSERT_TRUE(wait_until(
+      [&] { return local_writer_epoch_capture.get(local_writer_epoch); }, 2s,
+      5ms));
+  const auto acknack =
+      mdds::encode_acknack(remote_reader_guid, remote_reader_epoch,
+                           local_writer_guid, local_writer_epoch, 1, 0);
+  const auto ack_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < ack_deadline) {
+    ASSERT_TRUE(reconnect_peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(reconnect_peer.send_frame(acknack, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_FALSE(leaked_prejoin_data.load(std::memory_order_relaxed));
+
+  // Reusing seq=1 with the retained canonical identity is legal after the
+  // peer flap and proves that rejection did not create a new remote sequence
+  // epoch. The recovered reader remains on its original, non-matching topic.
+  auto recovered = canonical;
+  recovered.nodes.push_back({"/", "qos_reconnect_recovery"});
+  ASSERT_TRUE(raw_announce(reconnect_peer, cfg.domain_id, kTestBasePort5,
+                           recovered, 1));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        reconnect_peer.send_presence(cfg.domain_id, kTestBasePort5);
+        const auto remotes = target->remote_participants();
+        return remotes.size() == 1 && remotes.front().nodes.size() == 1 &&
+               remotes.front().endpoints.size() == 1 &&
+               remotes.front().endpoints.front().topic ==
+                   "/qos_reconnect_old" &&
+               writer->matched_count() == 0 &&
+               graph_callbacks.load(std::memory_order_relaxed) ==
+                   graph_before_mutation + 1;
+      },
+      2s, 10ms));
+  EXPECT_FALSE(leaked_prejoin_data.load(std::memory_order_relaxed));
+}
