+}
+
+MessageMember seq_empty_field()
+{
+  MessageMember member =
+    message_sequence_member<Empty>("items", offsetof(SeqEmptyMsg, items), &empty_ts);
+  member.resize_function = &seq_empty_resize_spy;
+  return member;
+}
+
+const MessageMember seq_empty_fields[] = {seq_empty_field()};
+const MessageMembers seq_empty_members =
+  members_of("SeqEmptyMsg", seq_empty_fields, 1, sizeof(SeqEmptyMsg));
+
+// The same zero-width sequence through the C introspection ABI: EmptyC
+// carries the one dummy member generated C structs use, and the sequence is
+// a raw realloc'd array exactly like generated C sequence code.
+using CMessageMember = rosidl_typesupport_introspection_c__MessageMember;
+using CMessageMembers = rosidl_typesupport_introspection_c__MessageMembers;
+
+struct EmptyC
+{
+  uint8_t structure_needs_at_least_one_member;
+};
+
+struct EmptyCSeq
+{
+  EmptyC * data;
+  size_t size;
+  size_t capacity;
+};
+
+struct EmptyCSeqMsg
+{
+  EmptyCSeq items;
+};
+
+size_t c_empty_seq_size(const void * field)
+{
+  return static_cast<const EmptyCSeq *>(field)->size;
+}
+
+const void * c_empty_seq_get_const(const void * field, size_t index)
+{
+  return static_cast<const EmptyCSeq *>(field)->data + index;
+}
+
+void * c_empty_seq_get(void * field, size_t index)
+{
+  return static_cast<EmptyCSeq *>(field)->data + index;
+}
+
+bool c_empty_seq_resize(void * field, size_t size)
+{
+  auto * seq = static_cast<EmptyCSeq *>(field);
+  if (size == 0) {
+    std::free(seq->data);
+    seq->data = nullptr;
+  } else {
+    auto * data = static_cast<EmptyC *>(std::realloc(seq->data, size * sizeof(EmptyC)));
+    if (data == nullptr) {
+      return false;
+    }
+    seq->data = data;
+  }
+  seq->size = size;
+  seq->capacity = size;
+  return true;
+}
+
+CMessageMembers c_members_of(
+  const char * name, const CMessageMember * fields, uint32_t count, size_t size_of)
+{
+  CMessageMembers members{};
+  members.message_namespace_ = "test__msg";
+  members.message_name_ = name;
+  members.member_count_ = count;
+  members.size_of_ = size_of;
+  members.members_ = fields;
+  return members;
+}
+
+const CMessageMembers empty_c_members = c_members_of("Empty", nullptr, 0, sizeof(EmptyC));
+const rosidl_message_type_support_t empty_c_ts =
+  {nullptr, &empty_c_members, nullptr, nullptr, nullptr, nullptr};
+
+CMessageMember c_empty_seq_field()
+{
+  CMessageMember member{};
+  member.name_ = "items";
+  member.type_id_ = kMessage;
+  member.is_array_ = true;
+  member.offset_ = offsetof(EmptyCSeqMsg, items);
+  member.members_ = &empty_c_ts;
+  member.size_function = &c_empty_seq_size;
+  member.get_const_function = &c_empty_seq_get_const;
+  member.get_function = &c_empty_seq_get;
+  member.resize_function = &c_empty_seq_resize;
+  return member;
+}
+
+const CMessageMember empty_c_seq_fields[] = {c_empty_seq_field()};
+const CMessageMembers empty_c_seq_members =
+  c_members_of("EmptyCSeqMsg", empty_c_seq_fields, 1, sizeof(EmptyCSeqMsg));
+
+// BigElem: one string member on the wire (packed minimum 5 bytes per
+// element) wrapped in a struct image of >= 512 bytes, modelling a generated
+// message whose in-memory size dwarfs its wire image (e.g. one holding a
+// fixed double[64]). The padding is deliberately not introspected so
+// size_of_ = sizeof(BigElem) while the wire minimum stays 5 — no honest
+// string-only struct beats the budget's 8-bytes-per-wire-byte slope.
+struct BigElem
+{
+  std::string s;
+  double oversized_image_[64];
+};
+
+const MessageMember big_elem_fields[] = {string_member("s", offsetof(BigElem, s), 0)};
+const MessageMembers big_elem_members =
+  members_of("BigElem", big_elem_fields, 1, sizeof(BigElem));
+const rosidl_message_type_support_t big_elem_ts =
+  {nullptr, &big_elem_members, nullptr, nullptr, nullptr, nullptr};
+
+struct BigSeqMsg
+{
+  std::vector<BigElem> items;
+};
+
+bool g_big_seq_resized = false;
+
+void big_seq_resize_spy(void * field, size_t size)
+{
+  g_big_seq_resized = true;
+  vec_resize<BigElem>(field, size);
+}
+
+MessageMember big_seq_field()
+{
+  MessageMember member =
+    message_sequence_member<BigElem>("items", offsetof(BigSeqMsg, items), &big_elem_ts);
+  member.resize_function = &big_seq_resize_spy;
+  return member;
+}
+
+const MessageMember big_seq_fields[] = {big_seq_field()};
+const MessageMembers big_seq_members =
+  members_of("BigSeqMsg", big_seq_fields, 1, sizeof(BigSeqMsg));
+
+// StrMsg { string s; } with bound 5 (and a bound-0 variant), WStrMsg {
+// wstring w; } with bound 3.
+struct StrMsg
+{
+  std::string s;
+};
+struct WStrMsg
+{
+  std::u16string w;
+};
+
+const MessageMember str5_fields[] = {string_member("s", offsetof(StrMsg, s), 5)};
+const MessageMembers str5_members = members_of("StrMsg", str5_fields, 1, sizeof(StrMsg));
+const MessageMember str0_fields[] = {string_member("s", offsetof(StrMsg, s), 0)};
+const MessageMembers str0_members = members_of("StrMsg", str0_fields, 1, sizeof(StrMsg));
+const MessageMember wstr3_fields[] = {wstring_member("w", offsetof(WStrMsg, w), 3)};
+const MessageMembers wstr3_members = members_of("WStrMsg", wstr3_fields, 1, sizeof(WStrMsg));
+
+// Rt: one honest message mixing every decode path that was hardened.
+struct RtInner
+{
+  int32_t x;
+  std::string s;
+};
+
+const MessageMember rt_inner_fields[] = {
+  scalar_member("x", kI32, offsetof(RtInner, x)),
+  string_member("s", offsetof(RtInner, s), 0),
+};
+const MessageMembers rt_inner_members = members_of("RtInner", rt_inner_fields, 2, sizeof(RtInner));
+const rosidl_message_type_support_t rt_inner_ts =
+  {nullptr, &rt_inner_members, nullptr, nullptr, nullptr, nullptr};
+
+struct Rt
+{
+  uint32_t u32;
+  double d;
+  std::string name;
+  std::string tag;
+  std::vector<uint64_t> samples;
+  std::vector<std::string> labels;
+  std::u16string wname;
+  RtInner inner;
+  std::vector<RtInner> inners;
+  bool flag;
+  uint8_t fixed3[3];
+};
+
+const void * rt_fixed3_get_const(const void * field, size_t index)
+{
+  return static_cast<const uint8_t *>(field) + index;
+}
+
+void * rt_fixed3_get(void * field, size_t index)
+{
+  return static_cast<uint8_t *>(field) + index;
+}
+
+MessageMember rt_fixed3_field()
+{
+  MessageMember member = fixed_array_member("fixed3", kU8, offsetof(Rt, fixed3), 3);
+  member.get_const_function = &rt_fixed3_get_const;
+  member.get_function = &rt_fixed3_get;
+  return member;
+}
+
+const MessageMember rt_fields[] = {
+  scalar_member("u32", kU32, offsetof(Rt, u32)),
+  scalar_member("d", kF64, offsetof(Rt, d)),
+  string_member("name", offsetof(Rt, name), 0),
+  string_member("tag", offsetof(Rt, tag), 10),
+  sequence_member<uint64_t>("samples", kU64, offsetof(Rt, samples)),
+  sequence_member<std::string>("labels", kString, offsetof(Rt, labels)),
+  scalar_member("wname", kWString, offsetof(Rt, wname)),
+  message_member("inner", offsetof(Rt, inner), &rt_inner_ts),
+  message_sequence_member<RtInner>("inners", offsetof(Rt, inners), &rt_inner_ts),
+  scalar_member("flag", kBool, offsetof(Rt, flag)),
+  rt_fixed3_field(),
+};
+const MessageMembers rt_members = members_of("Rt", rt_fields, 11, sizeof(Rt));
