+TEST(GuardConditionLifecycle, creation_after_context_shutdown_is_rejected)
+{
+  rmw_init_options_t options = rmw_get_zero_initialized_init_options();
+  ASSERT_EQ(RMW_RET_OK, rmw_init_options_init(&options, rcutils_get_default_allocator()));
+  options.enclave = rcutils_strdup("/", options.allocator);
+  ASSERT_NE(nullptr, options.enclave);
+  options.discovery_options.automatic_discovery_range =
+    RMW_AUTOMATIC_DISCOVERY_RANGE_LOCALHOST;
+
+  rmw_context_t context = rmw_get_zero_initialized_context();
+  ASSERT_EQ(RMW_RET_OK, rmw_init(&options, &context));
+  ASSERT_EQ(RMW_RET_OK, rmw_shutdown(&context));
+
+  EXPECT_EQ(nullptr, rmw_create_guard_condition(&context));
+  EXPECT_TRUE(rcutils_error_is_set());
+  rcutils_reset_error();
+
+  EXPECT_EQ(RMW_RET_OK, rmw_context_fini(&context));
+  EXPECT_EQ(RMW_RET_OK, rmw_init_options_fini(&options));
+}
