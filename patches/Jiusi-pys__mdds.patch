+#endif
+  }
+
+  bool send_presence(uint32_t domain_id, uint16_t target_port) const {
+    uint8_t packet[12] = {0x00, 'P', 'I', 'N', 'G'};
+    const uint32_t domain_be = htonl(domain_id);
+    std::memcpy(packet + 5, &domain_be, sizeof(domain_be));
+    return send(packet, sizeof(packet), target_port);
+  }
+
+  bool send_frame(const std::vector<uint8_t> &frame,
+                  uint16_t target_port) const {
+    return send(frame.data(), frame.size(), target_port);
+  }
+
+ private:
+  bool send(const uint8_t *data, size_t len, uint16_t target_port) const {
+    if (!valid() || data == nullptr || len > static_cast<size_t>(INT_MAX)) {
+      return false;
+    }
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    addr.sin_port = htons(target_port);
+    const int sent =
+        sendto(socket_, reinterpret_cast<const char *>(data),
+               static_cast<int>(len), 0, reinterpret_cast<const sockaddr *>(&addr),
+               sizeof(addr));
+    return sent == static_cast<int>(len);
+  }
+
+  raw_socket_t socket_ = kInvalidRawSocket;
+#ifdef _WIN32
+  bool wsa_started_ = false;
+#endif
+};
+
+std::array<uint8_t, 12> raw_remote_prefix(uint8_t discriminator) {
+  std::array<uint8_t, 12> prefix{};
+  prefix[0] = 0xD5;
+  prefix[1] = 0x50;
+  prefix[11] = discriminator;
+  return prefix;
+}
+
+mdds::EndpointRecord raw_remote_endpoint(uint8_t participant_id,
+                                         mdds::EntityKind kind,
+                                         uint32_t serial,
+                                         const std::string &topic,
+                                         const std::string &type) {
+  mdds::EndpointRecord endpoint;
+  endpoint.guid =
+      mdds::make_guid(raw_remote_prefix(participant_id), kind, serial);
+  endpoint.kind = kind;
+  endpoint.topic = topic;
+  endpoint.type_name = type;
+  endpoint.qos = default_qos();
+  return endpoint;
+}
+
+mdds::ParticipantSnapshot raw_remote_snapshot(
+    uint8_t participant_id, std::vector<mdds::EndpointRecord> endpoints,
+    std::vector<mdds::NodeInfo> nodes = {}) {
+  mdds::ParticipantSnapshot snapshot;
+  snapshot.participant_guid = mdds::make_guid(
+      raw_remote_prefix(participant_id), mdds::EntityKind::PARTICIPANT, 0);
+  snapshot.nodes = std::move(nodes);
+  snapshot.endpoints = std::move(endpoints);
+  return snapshot;
+}
+
+bool raw_announce(RawUdpPeer &peer, uint32_t domain_id, uint16_t target_port,
+                  const mdds::ParticipantSnapshot &snapshot, uint64_t seq) {
+  return peer.send_presence(domain_id, target_port) &&
+         peer.send_frame(mdds::encode_announce(snapshot, seq, 0), target_port);
+}
