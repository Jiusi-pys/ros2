+#ifndef RMW__GET_SERVICE_NAMES_AND_TYPES_H_
+#define RMW__GET_SERVICE_NAMES_AND_TYPES_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include "rmw/macros.h"
+#include "rmw/names_and_types.h"
+#include "rmw/types.h"
+#include "rmw/visibility_control.h"
+
+/// 返回 ROS 图中的所有服务名称和类型。
+/**
+ * 该函数返回 ROS 图中所有服务名称和类型的数组，
+ * 即给定本地节点到目前为止发现的存在服务器和/或客户端的服务。
+ *
+ * <hr>
+ * 属性          | 遵循情况
+ * ------------------ | -------------
+ * 分配内存   | 是
+ * 线程安全        | 是
+ * 使用原子操作       | 可能 [1]
+ * 无锁          | 可能 [1]
+ * <i>[1] 由 rmw 实现定义，请参阅实现文档</i>
+ *
+ * \par 运行时行为
+ *   查询 ROS 图是一个同步操作。
+ *   它也是非阻塞的，但不能保证无锁。
+ *   一般而言，实现可以使用锁来同步对内部资源的访问，
+ *   但不允许等待没有保证时间边界的事件（因操作系统调度导致的饥饿效应除外）。
+ *
+ * \par 线程安全性
+ *   节点是线程安全的对象，除了终结操作外，对节点的所有操作也都是线程安全的。
+ *   因此，使用同一个节点并发查询 ROS 图是安全的。
+ *   但在查询服务名称和类型时：
+ *   - 对名称和类型数组的访问不是同步的。
+ *     在 rmw_get_service_names_and_types() 使用 `service_names_and_types`
+ *     时读取或写入它是不安全的。
+ *   - 默认分配器是线程安全的对象，但任何自定义 `allocator` 可能不是。
+ *     请查阅分配器文档以获取更多参考。
+ *
+ * \pre 给定的 `node` 必须是有效的节点句柄，由 rmw_create_node() 返回。
+ * \pre 给定的 `services_names_and_types` 必须是零初始化的名称和类型数组，
+ *   由 rmw_get_zero_initialized_names_and_types() 返回。
+ *
+ * \param[in] node 用于查询 ROS 图的节点。
+ * \param[in] allocator 用于填充 `service_names_and_types` 数组的分配器。
+ * \param[out] service_names_and_types 服务名称及其类型的数组，
+ *   成功时填充，失败时保持不变。
+ *   如果已填充，调用者需稍后使用 rmw_names_and_types_fini()
+ *   终结此数组。
+ * \return 如果查询成功，返回 `RMW_RET_OK`，或者
+ * \return 如果 `node` 为 NULL，返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果 `allocator` 按照 rcutils_allocator_is_valid() 的定义无效，
+ *   返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果 `service_names_and_types` 为 NULL，返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果 `service_names_and_types` 不是零初始化的数组，
+ *   返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果 `node` 的实现标识符与此实现不匹配，
+ *   返回 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，或者
+ * \return 如果内存分配失败，返回 `RMW_RET_BAD_ALLOC`，或者
+ * \return 如果发生未指定的错误，返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_get_service_names_and_types(
+  const rmw_node_t * node,
+  rcutils_allocator_t * allocator,
+  rmw_names_and_types_t * service_names_and_types);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__GET_SERVICE_NAMES_AND_TYPES_H_
