+    stats_->writer_destroys.fetch_add(1, std::memory_order_relaxed);
+    delete writer;
+  }
+  void destroy_reader(mdds::Reader * reader) override
+  {
+    stats_->reader_destroys.fetch_add(1, std::memory_order_relaxed);
