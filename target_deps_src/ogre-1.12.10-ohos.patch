+#ifndef __OHOSEGLSupport_H__
+#define __OHOSEGLSupport_H__
+
+#include "OgreEGLSupport.h"
+
+namespace Ogre {
+    // OHOS (OpenHarmony) EGL support. There is no window system on the board
+    // (no X11/Wayland/fbdev/gbm), so contexts are created on PBuffer surfaces.
+    class _OgrePrivate OHOSEGLSupport : public EGLSupport
+    {
+    public:
+        OHOSEGLSupport();
+        virtual ~OHOSEGLSupport();
+
+        virtual void switchMode(uint& width, uint& height, short& frequency);
+
+        virtual RenderWindow* newWindow(const String& name,
+                                        unsigned int width, unsigned int height,
+                                        bool fullScreen,
+                                        const NameValuePairList *miscParams = 0);
+    };
+}
+
+#endif
