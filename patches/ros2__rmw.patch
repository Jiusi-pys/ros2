+  RMW_DECLARE_DEPRECATED(
+    RMW_QOS_POLICY_LIVELINESS_MANUAL_BY_NODE,
+    RMW_QOS_POLICY_LIVELINESS_MANUAL_BY_NODE_DEPRECATED_MSG) = 2,
+
+  /// 确立话题处于活跃状态的信号位于话题级别。只有在该话题上发布消息
+  /// 或来自应用显式断言该话题活跃度的信号才会将该话题标记为活跃。
+  // 为保持向后兼容而使用 `3`。
+  RMW_QOS_POLICY_LIVELINESS_MANUAL_BY_TOPIC = 3,
+
+  /// 活跃度策略尚未设置
+  RMW_QOS_POLICY_LIVELINESS_UNKNOWN = 4,
+
+  /// 将匹配大多数端点，并在可能的情况下使用按话题手动的策略
+  /**
+   * 策略将在创建订阅器或发布器时选择。
+   * 如果与所有已发现的端点匹配，则选择按话题手动的策略，否则选择自动策略。
+   *
+   * `rmw_subscription_get_actual_qos` 或 `rmw_publisher_get_actual_qos` 等函数报告的
+   * QoS 策略可能是 best available、automatic 或 manual by topic。
+   *
+   * 服务和客户端不受支持，默认使用 `rmw_qos_profile_services_default` 中的活跃度值。
+   *
+   * 中间件不期望在创建订阅器或发布器后更新策略，即使所选策略与新发现的端点不兼容。
+   * 因此，应谨慎使用此策略，因为与发现过程竞争可能导致非确定性行为。
+   */
+  RMW_QOS_POLICY_LIVELINESS_BEST_AVAILABLE = 5
+} rmw_qos_liveliness_policy_t;
