From 7fedffa0c647e0b80d7c072f1367d376876d1773 Mon Sep 17 00:00:00 2001
From: Yusheng Peng <jiusi0519@gmail.com>
Date: Sat, 29 Aug 2026 02:07:12 +0800
Subject: [PATCH] OHOS: prepend opt/gz_cmake_vendor to CMAKE_PREFIX_PATH in
 extras; copy instead of symlink patch

---
 gz_cmake_vendor-extras.cmake.in                 |  5 +++++
 patches/0002-copy-instead-of-symlink-ohos.patch | 12 ++++++++++++
 2 files changed, 17 insertions(+)
 create mode 100644 patches/0002-copy-instead-of-symlink-ohos.patch

diff --git a/gz_cmake_vendor-extras.cmake.in b/gz_cmake_vendor-extras.cmake.in
index d490202..3be5bd5 100644
--- a/gz_cmake_vendor-extras.cmake.in
+++ b/gz_cmake_vendor-extras.cmake.in
@@ -1 +1,6 @@
 list(PREPEND CMAKE_PREFIX_PATH "@CMAKE_INSTALL_PREFIX@/opt/@PROJECT_NAME@/extra_cmake")
+if(OHOS_CROSS_BUILD)
+  # The GLOBAL_HOOK CMAKE_PREFIX_PATH env propagation is unreliable from the
+  # Windows host; let downstream find_package(gz-cmake3) work from the extras.
+  list(PREPEND CMAKE_PREFIX_PATH "@CMAKE_INSTALL_PREFIX@/opt/@PROJECT_NAME@")
+endif()
diff --git a/patches/0002-copy-instead-of-symlink-ohos.patch b/patches/0002-copy-instead-of-symlink-ohos.patch
new file mode 100644
index 0000000..b28c6b2
--- /dev/null
+++ b/patches/0002-copy-instead-of-symlink-ohos.patch
@@ -0,0 +1,12 @@
+diff -urp gz_cmake_vendor.orig/CMakeLists.txt gz_cmake_vendor/CMakeLists.txt
+--- gz_cmake_vendor.orig/CMakeLists.txt
++++ gz_cmake_vendor/CMakeLists.txt
+@@ -185,7 +185,7 @@ foreach(cmake_file ${tick_tocked_cmake_f
+   file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/cmake")
+   set(ign_cmake_file_path "${PROJECT_BINARY_DIR}/cmake/${ign_cmake_file}")
+ 
+-  if (WIN32)  # Windows requires copy instead of symlink
++  if (WIN32 OR OHOS_CROSS_BUILD)  # OHOS: cross-compiled from Windows, which lacks symlink privilege
+     add_custom_command(OUTPUT ${ign_cmake_file_path}
+       COMMAND ${CMAKE_COMMAND} -E copy
+         ${PROJECT_SOURCE_DIR}/cmake/${cmake_file}  ${ign_cmake_file_path}
-- 
2.55.0.windows.5

