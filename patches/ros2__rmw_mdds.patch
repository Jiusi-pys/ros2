+TEST(SerdesBudget, message_sequence_charge_uses_real_sizeof)
+{
+  // BigElem's wire minimum is 5 bytes/element (one string) but size_of_ is
+  // sizeof(BigElem) >= 512. The 64 KiB payload gives budget
+  // 8*65536 + 4 MiB = 4718592 and leaves 65528 bytes after the count word.
+  // count = 10000 passes the wire check (10000 <= 65528/5 = 13105) but the
+  // pre-resize charge 10000 * sizeof(BigElem) >= 10000*512 = 5120000 exceeds
+  // the budget, so the throw must land BEFORE any resize.
+  g_big_seq_resized = false;
+  std::vector<uint8_t> buf = cdr_payload();
+  append_u32(buf, 10000);
+  buf.resize(64 * 1024, 0);
+  BigSeqMsg msg;
+  CdrReader reader(buf.data(), buf.size());
+  try {
+    read_members(reader, &big_seq_members, &msg);
+    FAIL() << "expected std::runtime_error";
+  } catch (const std::runtime_error & e) {
+    EXPECT_NE(std::string::npos, std::string(e.what()).find("budget"));
+  }
+  EXPECT_FALSE(g_big_seq_resized);
+}
