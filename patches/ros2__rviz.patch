diff --git a/rviz_rendering/ogre_media/materials/glsles/indexed_8bit_image.frag b/rviz_rendering/ogre_media/materials/glsles/indexed_8bit_image.frag
new file mode 100644
index 00000000..d8bbdf17
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/indexed_8bit_image.frag
@@ -0,0 +1,19 @@
+precision highp float;
+
+// Draws an 8-bit image using RGB values from a 256x1 palette texture.
+// GLES2 port: sampler1D/texture1D do not exist in GLSL ES, sample the 256x1
+// palette as a 2D texture at v=0.5 instead.
+
+varying vec2 UV;
+uniform sampler2D eight_bit_image;
+uniform sampler2D palette;
+uniform float alpha;
+
+void main()
+{
+  // The 0.999 multiply is needed because brightness value 255 comes
+  // out of texture2D() as 1.0, which wraps around to 0.0 in the
+  // palette texture.
+  vec4 color = texture2D( palette, vec2(0.999 * texture2D( eight_bit_image, UV ).x, 0.5) );
+  gl_FragColor = vec4( color.rgb, color.a * alpha );
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/indexed_8bit_image.vert b/rviz_rendering/ogre_media/materials/glsles/indexed_8bit_image.vert
