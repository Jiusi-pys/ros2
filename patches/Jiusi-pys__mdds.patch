+
+mdds::QosProfile dsoftbus_default_qos() {
+  mdds::QosProfile qos;
+  qos.reliability = mdds::Reliability::RELIABLE;
+  qos.history = mdds::History::KEEP_LAST;
+  qos.depth = 10;
+  return qos;
+}
