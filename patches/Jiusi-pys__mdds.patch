+// A malformed delivery target must fail closed. Treating any of these frames
+// as an ordinary DATA payload would widen targeted history/retries to every
+// local reader sharing this peer.
+TEST(DataFrame, RejectsTargetFlagTrailerMismatchAndMalformedTarget)
+{
+  const auto writer = make_test_guid(0x17);
+  const auto writer_epoch = make_test_guid(0x91);
+  mdds::DataTrailer trailer;
+  trailer.has_target_reader = true;
+  trailer.target_reader = make_test_guid(0x73);
+  trailer.target_reader_epoch = make_test_guid(0x92);
+  const auto directed = mdds::encode_data(
+    writer, writer_epoch, 7, 0, nullptr, 0, 0, &trailer);
+  ASSERT_FALSE(directed.empty());
+
+  mdds::DataBody body{};
+  auto missing_flag = directed;
+  mdds::encode_header(
+    missing_flag.data(), mdds::FrameType::DATA, 0,
+    static_cast<uint32_t>(missing_flag.size() - mdds::kHeaderSize));
+  EXPECT_FALSE(mdds::decode_data(missing_flag.data(), missing_flag.size(), body));
+
+  auto no_target = mdds::encode_data(writer, writer_epoch, 8, 0, nullptr, 0);
+  ASSERT_FALSE(no_target.empty());
+  mdds::encode_header(
+    no_target.data(), mdds::FrameType::DATA, mdds::kFlagTargetedReader,
+    static_cast<uint32_t>(no_target.size() - mdds::kHeaderSize));
