+  bool enqueue(MddsContext * context) noexcept
+  {
+    try {
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        pending_.push_back(context);
+      }
+      cv_.notify_one();
+      return true;
+    } catch (...) {
+      return false;
+    }
+  }
+
+private:
+  void run() noexcept
+  {
+    for (;;) {
+      MddsContext * context = nullptr;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        cv_.wait(lock, [this] {return !pending_.empty();});
+        context = pending_.back();
+        pending_.pop_back();
+      }
+      try {
+        {
+          std::unique_lock<std::mutex> lock(context->event_mutex);
+          context->event_cv.wait(
