+Reassembler::~Reassembler()
+{
+  // Return every held byte and metadata reservation to the global budget.
+  if (global_budget_ != nullptr) {
+    global_budget_->release(bytes_in_flight_);
+    for (size_t i = 0; i < partials_.size(); ++i) {
+      global_budget_->release_partial();
+    }
+  }
