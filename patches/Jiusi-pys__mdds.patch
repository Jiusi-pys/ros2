+// A Reader may retire itself while its callback is executing. The public
+// handle is detached immediately, but the callback frame keeps the object
+// alive until it unwinds. Keep all state on the heap in the timeout branch so
+// a regression that deadlocks cannot leave a detached worker touching stack
+// storage while the remaining test process reports the failure.
+TEST(ReaderCallback, DestroyOwnReaderRetiresThenUnwinds) {
+  struct State {
+    std::unique_ptr<mdds::Participant> participant;
+    mdds::Writer *writer = nullptr;
+    mdds::Reader *reader = nullptr;
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool destroy_returned = false;
+    bool release_callback = false;
+    std::atomic<uint64_t> callbacks{0};
+    std::atomic<bool> first_write_ok{false};
+  };
+
+  auto state = std::make_shared<State>();
+  state->participant = mdds::Participant::create(test_config_3());
+  ASSERT_NE(state->participant, nullptr);
+  state->writer = state->participant->create_writer(
+      "/destroy_self", "test/DestroySelf", default_qos());
+  state->reader = state->participant->create_reader(
+      "/destroy_self", "test/DestroySelf", default_qos());
+  ASSERT_NE(state->writer, nullptr);
+  ASSERT_NE(state->reader, nullptr);
+
+  state->reader->set_data_callback([state] {
+    state->callbacks.fetch_add(1, std::memory_order_relaxed);
+    state->participant->destroy_reader(state->reader);
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      state->destroy_returned = true;
+    }
+    state->cv.notify_all();
+    std::unique_lock<std::mutex> lock(state->mutex);
+    state->cv.wait(lock, [state] { return state->release_callback; });
+  });
+
+  std::thread publisher([state] {
+    const uint8_t first[] = {0x51};
+    state->first_write_ok = state->writer->write(first, sizeof(first));
+  });
+  bool returned = false;
+  {
+    std::unique_lock<std::mutex> lock(state->mutex);
+    returned = state->cv.wait_for(
+        lock, 5s, [&] { return state->destroy_returned; });
+  }
+  if (!returned) {
+    ADD_FAILURE() << "destroy_reader() self-callback path deadlocked";
+    std::abort();
+  }
+
+  // The callback is still deliberately blocked after destroy_reader() has
+  // returned. The map entry must already be gone and a subsequent write must
+  // not start another callback; fire_callback() owns the physical lifetime
+  // until this frame unwinds below.
+  EXPECT_EQ(state->participant->graph_counts().local_readers, 0u);
+  const uint8_t second[] = {0x52};
+  EXPECT_TRUE(state->writer->write(second, sizeof(second)));
+  EXPECT_EQ(state->callbacks.load(), 1u)
+      << "a logically retired reader received another callback";
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->release_callback = true;
+  }
+  state->cv.notify_all();
+  publisher.join();
+  EXPECT_TRUE(state->first_write_ok.load());
+}
+
