+
+/// 定义发布者/订阅事件
+typedef enum rmw_event_type_e
+{
+  // 订阅事件
+  RMW_EVENT_LIVELINESS_CHANGED,
+  RMW_EVENT_REQUESTED_DEADLINE_MISSED,
+  RMW_EVENT_REQUESTED_QOS_INCOMPATIBLE,
+  RMW_EVENT_MESSAGE_LOST,
+  RMW_EVENT_SUBSCRIPTION_INCOMPATIBLE_TYPE,
+  RMW_EVENT_SUBSCRIPTION_MATCHED,
+
+  // 发布者事件
+  RMW_EVENT_LIVELINESS_LOST,
+  RMW_EVENT_OFFERED_DEADLINE_MISSED,
+  RMW_EVENT_OFFERED_QOS_INCOMPATIBLE,
+  RMW_EVENT_PUBLISHER_INCOMPATIBLE_TYPE,
+  RMW_EVENT_PUBLICATION_MATCHED,
+
+  // 哨兵值
+  RMW_EVENT_INVALID
+} rmw_event_type_t;
+
+/// 封装 RMW 事件的实现、数据和类型。
+typedef struct RMW_PUBLIC_TYPE rmw_event_s
+{
+  /// 实现标识符，用于确保不会混合使用两个不同的实现。
+  const char * implementation_identifier;
+  /// 来自发布者或订阅者的、特定于此事件类型的数据。
+  void * data;
+  /// 发生的事件类型。
+  rmw_event_type_t event_type;
+} rmw_event_t;
+
+/// 返回一个零初始化的事件结构体。
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_event_t
+rmw_get_zero_initialized_event(void);
+
+/// 初始化一个 rmw 发布者事件。
+/**
+ * \param[inout] rmw_event 要初始化的事件
+ * \param[in] publisher 用于初始化的事件
+ * \param[inout] event_type 要初始化的事件类型
+ * \return 成功时返回 `RMW_RET_OK`，否则
+ * \return 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \return event_type 不受支持时返回 `RMW_RET_UNSUPPORTED`，否则
+ * \return 发生意外错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_publisher_event_init(
+  rmw_event_t * rmw_event,
+  const rmw_publisher_t * publisher,
+  rmw_event_type_t event_type);
+
+/// 初始化一个 rmw 订阅事件。
+/**
+ * \param[inout] rmw_event 要初始化的事件
+ * \param[in] subscription 用于初始化的事件
+ * \param[inout] event_type 要处理的事件类型
+ * \return 成功时返回 `RMW_RET_OK`，否则
+ * \return 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \return event_type 不受支持时返回 `RMW_RET_UNSUPPORTED`，否则
+ * \return 发生意外错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_subscription_event_init(
+  rmw_event_t * rmw_event,
+  const rmw_subscription_t * subscription,
+  rmw_event_type_t event_type);
+
+/// 从事件句柄中获取一个事件。
+/**
+ * \param[in] event_handle 要从中获取事件的事件对象
+ * \param[inout] event_info 用于写入获取到的数据的事件信息对象
+ * \param[out] taken 布尔标志，指示是否已获取事件
+ * \return 成功时返回 `RMW_RET_OK`，否则
+ * \return 内存分配失败时返回 `RMW_RET_BAD_ALLOC`，否则
+ * \return 发生意外错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_take_event(
+  const rmw_event_t * event_handle,
+  void * event_info,
+  bool * taken);
+
+/// 终结一个 rmw_event_t。
+/**
+ * \param[in] event 要终结的事件
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_event_fini(rmw_event_t * event);
+
+
+/// 检查 RMW 实现是否支持某种事件类型。
+/*
+ * \param[in] rmw_event_type 要检查的事件类型
+ * \return 如果支持该事件则返回 true，否则返回 false。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+bool
+rmw_event_type_is_supported(rmw_event_type_t rmw_event_type);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__EVENT_H_
