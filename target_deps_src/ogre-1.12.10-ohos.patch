+#ifndef __OHOSEGLWindow_H__
+#define __OHOSEGLWindow_H__
+
+#include "OgreEGLWindow.h"
+#include "OgreOHOSEGLSupport.h"
+
+namespace Ogre {
+    // Headless EGL "window" for OHOS: renders into an EGL PBuffer surface,
+    // no native windowing system involved.
+    class _OgrePrivate OHOSEGLWindow : public EGLWindow
+    {
+    private:
+        int mMaxBufferSize;
+        int mMinBufferSize;
+        int mMaxDepthSize;
+        int mMaxStencilSize;
+        int mMSAA;
+
+        void createPbufferSurface(uint width, uint height);
+
+    protected:
+        virtual void getLeftAndTopFromNativeWindow(int & left, int & top, uint width, uint height);
+        virtual void initNativeCreatedWindow(const NameValuePairList *miscParams);
+        virtual void createNativeWindow( int &left, int &top, uint &width, uint &height, String &title );
+        virtual void reposition(int left, int top);
+        virtual void resize(unsigned int width, unsigned int height);
+        virtual void windowMovedOrResized();
+        virtual void switchFullScreen(bool fullscreen);
+
+    public:
+        OHOSEGLWindow(OHOSEGLSupport* glsupport);
+        void create(const String& name, unsigned int width, unsigned int height,
+                    bool fullScreen, const NameValuePairList *miscParams);
+        void swapBuffers();
+    };
+}
+
+#endif
