diff --git a/rclcpp/test/rclcpp/test_signal_chaining.cpp b/rclcpp/test/rclcpp/test_signal_chaining.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..01144ff483dd61297e7dd65dda465288dfc1f347
--- /dev/null
+++ b/rclcpp/test/rclcpp/test_signal_chaining.cpp
@@ -0,0 +1,150 @@
+// Copyright 2026 Yusheng Peng
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include <signal.h>
+#include <unistd.h>
+#if defined(__OHOS__)
+#include <dlfcn.h>
+#include <cstdio>
+#include <cstring>
+#endif
+
+#include "gtest/gtest.h"
+#include "rclcpp/utilities.hpp"
+
+namespace
+{
+volatile sig_atomic_t calls = 0;
+volatile sig_atomic_t received_signal = 0;
+volatile sig_atomic_t received_info_signal = 0;
+volatile sig_atomic_t received_context = 0;
+
+void information_handler(int signum, siginfo_t * info, void * context)
+{
+  ++calls;
+  received_signal = signum;
+  received_info_signal = info == nullptr ? 0 : info->si_signo;
+  received_context = context == nullptr ? 0 : 1;
+}
+
+void legacy_handler(int signum)
+{
+  ++calls;
+  received_signal = signum;
+}
+
+// Run in a fresh subprocess: signal handlers and the rclcpp signal thread are
+// process-global. Fail before raising if the installed ABI is already wrong.
+int exercise(int signum, int disposition)
+{
+  rclcpp::uninstall_signal_handlers();
+  struct sigaction previous {};
+  sigemptyset(&previous.sa_mask);
+  sigaddset(&previous.sa_mask, SIGUSR1);
+  previous.sa_flags = disposition == 1 ? 0 : SA_SIGINFO;
+  if (disposition == 0) {
+    previous.sa_sigaction = information_handler;
+  } else {
+    previous.sa_handler = disposition == 1 ? legacy_handler :
+      (disposition == 2 ? SIG_IGN : SIG_DFL);
+  }
+  if (sigaction(signum, &previous, nullptr) != 0) {return 1;}
+  const auto options = signum == SIGINT ?
+    rclcpp::SignalHandlerOptions::SigInt : rclcpp::SignalHandlerOptions::SigTerm;
+  if (!rclcpp::install_signal_handlers(options)) {return 2;}
+  struct sigaction installed {};
+  if (sigaction(signum, nullptr, &installed) != 0) {return 3;}
+  if (disposition != 1 && !(installed.sa_flags & SA_SIGINFO)) {return 4;}
+  if (raise(signum) != 0) {return 5;}
+  const bool delivered = disposition == 0 ?
+    calls == 1 && received_signal == signum && received_info_signal == signum &&
+    received_context == 1 :
+    (disposition == 1 ? calls == 1 && received_signal == signum : calls == 0);
+  if (!rclcpp::uninstall_signal_handlers() || !delivered) {return 6;}
+  struct sigaction restored {};
+  if (sigaction(signum, nullptr, &restored) != 0) {return 7;}
+  if (sigismember(&restored.sa_mask, SIGUSR1) != 1) {return 8;}
+  if ((restored.sa_flags & SA_SIGINFO) != (previous.sa_flags & SA_SIGINFO)) {return 9;}
+  if (disposition == 0) {
+    if (restored.sa_sigaction != previous.sa_sigaction) {return 10;}
+  } else if (restored.sa_handler != previous.sa_handler) {
+    return 11;
+  }
+  return 0;
+}
+
+class SignalChainingDeathTest : public ::testing::Test
+{
+protected:
+  void SetUp() override {::testing::FLAGS_gtest_death_test_style = "threadsafe";}
+};
+}  // namespace
+
+TEST_F(SignalChainingDeathTest, PreservesSigintSiginfoArgumentsAndDisposition)
+{
+  ASSERT_EXIT(_exit(exercise(SIGINT, 0)), ::testing::ExitedWithCode(0), "");
+}
+
