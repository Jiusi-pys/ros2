+// discovery_enabled=false is a hard gate: no ANNOUNCE out, no ANNOUNCE
+// processing, no peer tracking — two discovery-OFF participants on the same
+// domain never learn of each other, never match and never exchange data,
+// and a discovery-ENABLED third participant cannot see them either (they
+// never announce themselves).
+TEST(DiscoveryGating, DiscoveryOffStaysIsolated) {
+  auto off_cfg = [] {
+    mdds::ParticipantConfig cfg = test_config_4();
+    cfg.discovery_enabled = false;
+    return cfg;
+  };
+  auto pa = mdds::Participant::create(off_cfg());
+  auto pb = mdds::Participant::create(off_cfg());
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+
+  auto *w = pa->create_writer("/off", "test/Off", default_qos());
+  auto *r = pb->create_reader("/off", "test/Off", default_qos());
+  ASSERT_NE(w, nullptr);
+  ASSERT_NE(r, nullptr);
+
+  // Well beyond three 50ms announce periods: the isolation must be total.
+  std::this_thread::sleep_for(400ms);
+  EXPECT_EQ(pa->graph_counts().remote_participants, 0u);
+  EXPECT_EQ(pb->graph_counts().remote_participants, 0u);
+  EXPECT_EQ(w->matched_count(), 0u);
+  EXPECT_EQ(r->matched_count(), 0u);
+
+  const char msg[] = "off";
+  ASSERT_TRUE(w->write(reinterpret_cast<const uint8_t *>(msg), sizeof(msg)));
+  std::this_thread::sleep_for(200ms);
+  EXPECT_EQ(r->available(), 0u);
+
+  // A discovery-enabled participant on the same domain does not see the
+  // discovery-OFF ones (they never announce), and stays unseen by them.
+  auto pc = mdds::Participant::create(test_config_4());
+  ASSERT_NE(pc, nullptr);
+  pc->create_writer("/probe", "test/Probe", default_qos());
+  std::this_thread::sleep_for(600ms);
+  EXPECT_EQ(pc->graph_counts().remote_participants, 0u);
+  EXPECT_EQ(pa->graph_counts().remote_participants, 0u);
+  EXPECT_EQ(pb->graph_counts().remote_participants, 0u);
+}
