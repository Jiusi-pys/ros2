+// A VOLATILE reader that joins late asks the writer for everything from 1;
+// the writer answers with a reader-addressed GAP over the pre-join prefix and
+// retransmits only post-join samples. The reader seeds its baseline from the
+// GAP: no pre-join replay, nothing counted lost.
+TEST(ReliabilityTest, VolatileLateJoinerSeededByGap) {
+  auto pa = mdds::Participant::create(test_config_3());
