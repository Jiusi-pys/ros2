+TEST_F(DsoftbusTransportFakeTest, UsesProbedNon1024ByteLimit) {
+  constexpr int32_t kPeerFd = 303;
+  constexpr uint32_t kProbedLimit = 65537;
+  fake().configure_option(SOFTBUS_OK, kProbedLimit);
+  fake().set_online_nodes({"fake-large-channel"});
+  RecordingListener listener;
+  auto transport = mdds::make_dsoftbus_transport();
+  ASSERT_TRUE(transport->start(config(), &listener));
+  ASSERT_TRUE(fake().wait_for_listener());
+
+  emit_bind(kPeerFd, "fake-large-channel");
+
+  const auto peers = listener.ups();
+  ASSERT_EQ(peers.size(), 1u);
+  EXPECT_EQ(transport->max_payload(peers.front()), kProbedLimit);
+  EXPECT_EQ(transport->status().peer_count, 1u);
+
+  // This is deliberately above the old 1024-byte fallback.  It must be
+  // accepted because the real per-channel DSoftBus limit was probed.
+  std::vector<uint8_t> frame(4097, 0x5a);
+  ASSERT_TRUE(transport->send(peers.front(), frame.data(), frame.size()));
+  ASSERT_TRUE(fake().wait_for_sends(1));
+  const auto sent = fake().sent();
+  ASSERT_EQ(sent.size(), 1u);
+  EXPECT_EQ(sent.front().first, kPeerFd);
+  EXPECT_EQ(sent.front().second, frame);
+
+  std::vector<uint8_t> too_large(kProbedLimit + 1, 0);
+  EXPECT_FALSE(
+      transport->send(peers.front(), too_large.data(), too_large.size()));
+  transport->stop();
+}
+
+TEST_F(DsoftbusTransportFakeTest,
+       ListenSocketShutdownIsTerminalAndReleasesRegistrySlot) {
+  // The first Socket() in start() is the listener. A listener shutdown cannot
+  // be healed by peer rebinds: the transport must fully stop so its health
+  // state is actionable and a replacement process/context can register.
+  constexpr int32_t kListenFd = 100;
+  RecordingListener listener;
+  auto transport = mdds::make_dsoftbus_transport();
+  ASSERT_TRUE(transport->start(config(), &listener));
+  ASSERT_TRUE(fake().wait_for_listener());
+
+  emit_shutdown(kListenFd, static_cast<ShutdownReason>(0));
+
+  const mdds::TransportStatus status = transport->status();
+  EXPECT_FALSE(status.running);
+  EXPECT_EQ(status.peer_count, 0u);
+  EXPECT_NE(status.detail.find("fatal=listen_socket_shutdown"),
+            std::string::npos);
+  EXPECT_NE(transport->last_error().find("fatal listen socket shutdown"),
+            std::string::npos);
+
+  // stop() ran from inside OnShutdown's DispatchFrame. Once it unwinds, the
+  // old registry generation must not black-hole a replacement transport.
+  RecordingListener replacement_listener;
+  auto replacement = mdds::make_dsoftbus_transport();
+  ASSERT_TRUE(replacement->start(config(), &replacement_listener));
+  replacement->stop();
+  transport->stop(); // idempotent after the terminal callback.
+}
