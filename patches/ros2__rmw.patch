+};
+
+static const rmw_qos_profile_t rmw_qos_profile_default =
+{
+  RMW_QOS_POLICY_HISTORY_KEEP_LAST,
+  10,
+  RMW_QOS_POLICY_RELIABILITY_RELIABLE,
+  RMW_QOS_POLICY_DURABILITY_VOLATILE,
+  RMW_QOS_DEADLINE_DEFAULT,
+  RMW_QOS_LIFESPAN_DEFAULT,
+  RMW_QOS_POLICY_LIVELINESS_SYSTEM_DEFAULT,
+  RMW_QOS_LIVELINESS_LEASE_DURATION_DEFAULT,
+  false
+};
+
+static const rmw_qos_profile_t rmw_qos_profile_services_default =
+{
+  RMW_QOS_POLICY_HISTORY_KEEP_LAST,
+  10,
+  RMW_QOS_POLICY_RELIABILITY_RELIABLE,
+  RMW_QOS_POLICY_DURABILITY_VOLATILE,
+  RMW_QOS_DEADLINE_DEFAULT,
+  RMW_QOS_LIFESPAN_DEFAULT,
+  RMW_QOS_POLICY_LIVELINESS_SYSTEM_DEFAULT,
+  RMW_QOS_LIVELINESS_LEASE_DURATION_DEFAULT,
+  false
+};
+
+static const rmw_qos_profile_t rmw_qos_profile_parameter_events =
+{
+  RMW_QOS_POLICY_HISTORY_KEEP_LAST,
+  1000,
+  RMW_QOS_POLICY_RELIABILITY_RELIABLE,
+  RMW_QOS_POLICY_DURABILITY_VOLATILE,
+  RMW_QOS_DEADLINE_DEFAULT,
+  RMW_QOS_LIFESPAN_DEFAULT,
+  RMW_QOS_POLICY_LIVELINESS_SYSTEM_DEFAULT,
+  RMW_QOS_LIVELINESS_LEASE_DURATION_DEFAULT,
+  false
+};
+
+static const rmw_qos_profile_t rmw_qos_profile_system_default =
+{
+  RMW_QOS_POLICY_HISTORY_SYSTEM_DEFAULT,
+  RMW_QOS_POLICY_DEPTH_SYSTEM_DEFAULT,
+  RMW_QOS_POLICY_RELIABILITY_SYSTEM_DEFAULT,
+  RMW_QOS_POLICY_DURABILITY_SYSTEM_DEFAULT,
+  RMW_QOS_DEADLINE_DEFAULT,
+  RMW_QOS_LIFESPAN_DEFAULT,
+  RMW_QOS_POLICY_LIVELINESS_SYSTEM_DEFAULT,
+  RMW_QOS_LIVELINESS_LEASE_DURATION_DEFAULT,
+  false
+};
+
+/// 在保持最高服务水平的同时，匹配当前可用的大多数端点
+/**
+ * 可靠性、耐久性、截止期限、活跃性以及活跃性租约期限策略将在创建订阅者或发布者时确定。
+ *
+ * 端点创建后，可以使用 `rmw_get_subscriptions_info_by_topic` 或 `rmw_get_publishers_info_by_topic`
+ * 获取实际的 QoS 策略。
+ *
+ * 中间件不希望在创建订阅者或发布者之后更新策略，即使一个或多个策略与新发现的端点不兼容。
+ * 因此，应谨慎使用此配置文件，因为与发现过程存在竞争可能导致非确定性行为。
+ */
+static const rmw_qos_profile_t rmw_qos_profile_best_available =
+{
+  RMW_QOS_POLICY_HISTORY_KEEP_LAST,
+  10,
+  RMW_QOS_POLICY_RELIABILITY_BEST_AVAILABLE,
+  RMW_QOS_POLICY_DURABILITY_BEST_AVAILABLE,
+  RMW_QOS_DEADLINE_BEST_AVAILABLE,
+  RMW_QOS_LIFESPAN_DEFAULT,
+  RMW_QOS_POLICY_LIVELINESS_BEST_AVAILABLE,
+  RMW_QOS_LIVELINESS_LEASE_DURATION_BEST_AVAILABLE,
+  false
+};
+
+static const rmw_qos_profile_t rmw_qos_profile_unknown =
+{
+  RMW_QOS_POLICY_HISTORY_UNKNOWN,
+  RMW_QOS_POLICY_DEPTH_SYSTEM_DEFAULT,
+  RMW_QOS_POLICY_RELIABILITY_UNKNOWN,
+  RMW_QOS_POLICY_DURABILITY_UNKNOWN,
+  RMW_QOS_DEADLINE_DEFAULT,
+  RMW_QOS_LIFESPAN_DEFAULT,
+  RMW_QOS_POLICY_LIVELINESS_UNKNOWN,
+  RMW_QOS_LIVELINESS_LEASE_DURATION_DEFAULT,
+  false
+};
+
+typedef enum RMW_PUBLIC_TYPE rmw_qos_compatibility_type_e
+{
+  /// QoS 策略兼容
+  RMW_QOS_COMPATIBILITY_OK = 0,
+
+  /// QoS 策略可能不兼容
+  RMW_QOS_COMPATIBILITY_WARNING,
+
+  /// QoS 策略不兼容
+  RMW_QOS_COMPATIBILITY_ERROR
+} rmw_qos_compatibility_type_t;
+
+
+/// 检查两个 QoS 配置文件是否兼容。
+/**
+ * 如果发布者和订阅者使用这些 QoS 策略可以相互通信，则两个 QoS 配置文件兼容。
+ *
+ * 如果任一配置文件策略的值为“system default”或“unknown”，则可能无法确定兼容性。
+ * 在这种情况下，输出参数 `compatibility` 被设置为 `RMW_QOS_COMPATIBILITY_WARNING`，并填充 `reason`。
+ *
+ * 如果存在兼容性警告或错误，并且为 `reason` 提供了缓冲区，则会将所有警告和错误的解释填充到缓冲区中，
+ * 以分号（`;`）分隔。
+ * 错误将出现在字符串缓冲区中警告之前。
+ * 如果提供的缓冲区不够大，此函数仍会向缓冲区写入，最多写入 `reason_size` 个字符。
+ * 因此，如果达到缓冲区大小限制，可能无法传达所有错误和警告。
+ * 缓冲区大小为 2048 应该足以捕获所有可能的错误和警告。
+ *
+ * <hr>
+ * 属性               | 遵循情况
+ * ------------------ | -------------
+ * 分配内存           | 否
+ * 线程安全           | 是
+ * 使用原子操作       | 否
+ * 无锁               | 是
+ *
+ * \param[in] publisher_profile: 发布者使用的 QoS 配置文件。
+ * \param[in] subscription_profile: 订阅者使用的 QoS 配置文件。
+ * \param[out] compatibility: 如果 QoS 配置文件兼容，则为 `RMW_QOS_COMPATIBILITY_OK`，或者
+ *   如果 QoS 配置文件可能兼容，则为 `RMW_QOS_COMPATIBILITY_WARNING`，或者
+ *   如果 QoS 配置文件不兼容，则为 `RMW_QOS_COMPATIBILITY_ERROR`。
+ * \param[out] reason: QoS 不兼容或潜在不兼容的详细原因。
+ *   必须由调用者预先分配。
+ *   此参数是可选的，如果不需要原因信息，可以设置为 `NULL`。
+ * \param[in] reason_size: 如果提供了字符串缓冲区 `reason`，则为其大小。
+ *   如果 `reason` 为 `nullptr`，则此参数必须为零。
+ * \return 如果检查成功，则返回 `RMW_RET_OK`，或者
+ * \return 如果 `compatibility` 为 `nullptr`，则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果 `reason` 为 `NULL` 且 `reason_size` 不为零，则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果发生意外错误，则返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_qos_profile_check_compatible(
+  const rmw_qos_profile_t publisher_profile,
+  const rmw_qos_profile_t subscription_profile,
+  rmw_qos_compatibility_type_t * compatibility,
+  char * reason,
+  size_t reason_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__QOS_PROFILES_H_
