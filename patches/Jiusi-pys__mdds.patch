+// The reverse direction verifies that an existing remote reader cannot mutate
+// from BEST_EFFORT to RELIABLE under one GUID and silently alter writer-side
+// routing. The hook observes a DATA frame after its target decision, then
+// returns true to simulate network loss invisible to the sender.
+TEST(DiscoveryAdmission, RawSameGuidReaderQosMutationIsRejectedAtomically) {
+  std::atomic<size_t> outgoing_data{0};
+  auto cfg = raw_admission_config();
+  cfg.test_send_hook = [&](const uint8_t *frame, size_t len) {
+    mdds::FrameHeader header;
+    if (!mdds::decode_header(frame, len, header)) {
+      return false;
+    }
+    if (header.type == mdds::FrameType::DATA) {
+      ++outgoing_data;
+      return true; // deterministic DATA loss only
+    }
+    return false; // preserve v8 SESSION_CHALLENGE and ANNOUNCE traffic
+  };
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  std::atomic<size_t> graph_callbacks{0};
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  target->set_graph_callback(
+      [&] { graph_callbacks.fetch_add(1, std::memory_order_relaxed); });
+
+  auto writer_qos = default_qos();
+  writer_qos.reliability = mdds::Reliability::BEST_EFFORT;
+  auto *writer =
+      target->create_writer("/qos_update_writer", "test/QosUpdate", writer_qos);
+  ASSERT_NE(writer, nullptr);
+  auto best_effort_reader = raw_remote_snapshot(
+      0x44, {raw_remote_endpoint(0x44, mdds::EntityKind::READER, 1,
+                                 "/qos_update_writer", "test/QosUpdate")});
+  best_effort_reader.endpoints.front().qos.reliability =
+      mdds::Reliability::BEST_EFFORT;
+  ASSERT_TRUE(
+      raw_announce(peer, cfg.domain_id, kTestBasePort5, best_effort_reader, 1));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return writer->matched_count() == 1 &&
+               graph_callbacks.load(std::memory_order_relaxed) >= 1;
+      },
+      2s, 10ms));
+
+  const uint8_t before[] = {0x42, 0x45};
+  ASSERT_TRUE(writer->write(before, sizeof(before)));
+  EXPECT_EQ(outgoing_data.load(std::memory_order_relaxed), 1u);
+
+  const size_t graph_before_mutation =
+      graph_callbacks.load(std::memory_order_relaxed);
+  auto mutation = best_effort_reader;
+  mutation.endpoints.front().qos.reliability = mdds::Reliability::RELIABLE;
+  std::vector<uint8_t> mutation_frame;
+  ASSERT_TRUE(prepare_raw_announce_frame(peer, cfg.domain_id, kTestBasePort5,
+                                         mutation, 2, mutation_frame));
+  mdds::ParticipantSnapshot decoded_mutation;
+  uint64_t decoded_seq = 0;
+  ASSERT_TRUE(mdds::decode_announce(mutation_frame.data(),
+                                    mutation_frame.size(), decoded_mutation,
+                                    decoded_seq));
+  EXPECT_EQ(decoded_seq, 2u);
+  ASSERT_EQ(decoded_mutation.endpoints.size(), 1u);
+  EXPECT_EQ(decoded_mutation.endpoints.front().qos.reliability,
+            mdds::Reliability::RELIABLE);
+
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(mutation_frame, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  const auto after_rejection = target->remote_participants();
+  ASSERT_EQ(after_rejection.size(), 1u);
+  ASSERT_EQ(after_rejection.front().endpoints.size(), 1u);
+  EXPECT_EQ(after_rejection.front().endpoints.front().qos.reliability,
+            mdds::Reliability::BEST_EFFORT);
+  EXPECT_EQ(writer->matched_count(), 1u);
+  EXPECT_EQ(graph_callbacks.load(std::memory_order_relaxed),
+            graph_before_mutation);
+
+  const uint8_t still_routed[] = {0x52, 0x4f, 0x55, 0x54, 0x45};
+  ASSERT_TRUE(writer->write(still_routed, sizeof(still_routed)));
+  EXPECT_EQ(outgoing_data.load(std::memory_order_relaxed), 2u);
+
+  auto recovered = best_effort_reader;
+  recovered.nodes.push_back({"/", "qos_reader_recovery"});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, recovered, 2));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        const auto remotes = target->remote_participants();
+        return remotes.size() == 1 && remotes.front().nodes.size() == 1 &&
+               remotes.front().nodes.front().name == "qos_reader_recovery" &&
+               writer->matched_count() == 1 &&
+               graph_callbacks.load(std::memory_order_relaxed) ==
+                   graph_before_mutation + 1;
+      },
+      2s, 10ms));
+  const uint8_t resumed[] = {0x42, 0x45, 0x32};
+  ASSERT_TRUE(writer->write(resumed, sizeof(resumed)));
+  EXPECT_EQ(outgoing_data.load(std::memory_order_relaxed), 3u);
+}
