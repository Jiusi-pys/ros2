+#ifndef DEFERRED_CALLBACK_GROUP_HPP_
+#define DEFERRED_CALLBACK_GROUP_HPP_
+
+#include <atomic>
+#include <stdexcept>
+
+#include "rclcpp/executor.hpp"
+#include "rclcpp/node.hpp"
+
+namespace mdds_gateway
+{
+
+/// Keep callbacks invisible to an already-running executor until their owner
+/// has finished construction.  DDS discovery and reader history remain live
+/// while the group is detached, so a pre-online reliable publisher's samples
+/// are taken after commit instead of being dropped in a constructor race.
+/// rclcpp serializes collection updates while an executor spins; this wrapper
+/// may therefore add/remove the group from the gateway's manager thread. The
+/// wrapper itself is single-owner: register_with(), prepare_commit(),
+/// deactivate(), and destruction must not run concurrently, and the executor
+/// must outlive it.
+class DeferredCallbackGroup
+{
+public:
+  explicit DeferredCallbackGroup(const rclcpp::Node::SharedPtr & node)
+  : node_base_(node->get_node_base_interface()),
+    group_(node->create_callback_group(
+        rclcpp::CallbackGroupType::MutuallyExclusive,
+      /*automatically_add_to_executor_with_node=*/false))
+  {
+    if (node_base_ == nullptr || group_ == nullptr) {
+      throw std::runtime_error("failed to create deferred callback group");
+    }
+    // Registration is not activation. Executor records the group before its
+    // fallible wake, so keep it untakeable throughout that partial window.
+    group_->can_be_taken_from().store(false, std::memory_order_release);
+  }
+
+  ~DeferredCallbackGroup()
+  {
+    deactivate();
+  }
+
+  DeferredCallbackGroup(const DeferredCallbackGroup &) = delete;
+  DeferredCallbackGroup & operator=(const DeferredCallbackGroup &) = delete;
+
+  rclcpp::CallbackGroup::SharedPtr group() const noexcept
+  {
+    return group_;
+  }
+
+  void register_with(rclcpp::Executor & executor)
+  {
+    if (executor_ != nullptr) {
+      throw std::logic_error("deferred callback group is already active");
+    }
+    executor_ = &executor;
+    // Leave executor_ set when this throws: add_callback_group() may already
+    // have recorded the group. The owner publishes CANCELLED before removal.
+    executor.add_callback_group(group_, node_base_);
+  }
+
+  /// Make a registered group selectable and request one final collection
+  /// rebuild while the owner's construction latch is still PENDING. A
+  /// callback selected in this window waits on that latch; a wake failure is
+  /// therefore still a construction failure which can be rolled back without
+  /// consuming or forwarding input.
+  void prepare_commit()
+  {
+    if (executor_ == nullptr) {
+      throw std::logic_error("deferred callback group is not registered");
+    }
+    group_->can_be_taken_from().store(true, std::memory_order_release);
+    try {
+      group_->trigger_notify_guard_condition();
+    } catch (...) {
+      group_->can_be_taken_from().store(false, std::memory_order_release);
+      throw;
+    }
+  }
+
+  /// Best-effort no-throw teardown. Executor stores only a weak group pointer,
+  /// so even an unexpected removal error cannot leave a dangling callback
+  /// group after this object is destroyed.
+  void deactivate() noexcept
+  {
+    group_->can_be_taken_from().store(false, std::memory_order_release);
+    rclcpp::Executor * executor = executor_;
+    if (executor == nullptr) {
+      return;
+    }
+    executor_ = nullptr;
+    try {
+      executor->remove_callback_group(group_);
+    } catch (...) {
+      // Destructors and constructor-failure cleanup must remain no-throw.
+    }
+  }
+
+private:
+  rclcpp::node_interfaces::NodeBaseInterface::SharedPtr node_base_;
+  rclcpp::CallbackGroup::SharedPtr group_;
+  // Non-owning by design: the gateway owns the executor outside every
+  // TopicBridge and its documented teardown order destroys all bridges first.
+  // Callers of this helper must preserve the same executor-outlives-group
+  // contract (the deterministic unit test does so explicitly).
+  rclcpp::Executor * executor_ = nullptr;
+};
+
+}  // namespace mdds_gateway
