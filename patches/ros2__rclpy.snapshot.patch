diff --git a/rclpy/cmake/ohos_python_extension.cmake b/rclpy/cmake/ohos_python_extension.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..b31e48575b37d84d5a99a8784c679ecb75b21df3
--- /dev/null
+++ b/rclpy/cmake/ohos_python_extension.cmake
@@ -0,0 +1,14 @@
+# Keep target extension naming independent of host pybind11 discovery.
+function(configure_ohos_python_extension target)
+  if(NOT OHOS_CROSS_BUILD)
+    return()
+  endif()
+  # pybind11 may overwrite PYTHON_MODULE_EXTENSION as an INTERNAL cache entry
+  # and shadow Python3_SOABI with the host value. The explicit cross-build
+  # Python3_SOABI cache entry still carries the verified target ABI.
+  get_property(target_soabi CACHE Python3_SOABI PROPERTY VALUE)
+  if(NOT target_soabi MATCHES "^cpython-[0-9]+-aarch64-linux-ohos$")
+    message(FATAL_ERROR "OHOS requires an explicit target Python3_SOABI cache entry")
+  endif()
+  set_target_properties(${target} PROPERTIES SUFFIX ".${target_soabi}.so")
+endfunction()
diff --git a/rclpy/test/test_ohos_extension_suffix.py b/rclpy/test/test_ohos_extension_suffix.py
