+// A permanent writer identity ledger rejects both a fresh GUID and a rewritten
+// same-GUID binding without disturbing the canonical writer's receive state.
+// In particular, an in-progress fragment may complete only in that original
+// canonical epoch; no rejected ANNOUNCE can reset or repurpose it.
+TEST(DiscoveryAdmission,
+     EndpointIdentityLedgerRejectsRebindingWithoutDisturbingWriterEpochState) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_endpoint_qos_history = 1;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  auto *reader = target->create_reader("/identity_epoch", "test/IdentityEpoch",
+                                       default_qos());
+  ASSERT_NE(reader, nullptr);
+
+  const auto original = raw_remote_snapshot(
+      0x49, {raw_remote_endpoint(0x49, mdds::EntityKind::WRITER, 1,
+                                 "/identity_epoch", "test/IdentityEpoch")});
+  const mdds::Guid writer_guid = original.endpoints.front().guid;
+  const mdds::Guid writer_epoch = original.endpoints.front().epoch;
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, original, 1));
+  ASSERT_TRUE(wait_reader_matched(reader, 1, 2s));
+
+  std::array<uint8_t, 128> old_fragment{};
+  old_fragment.fill(0x5a);
+  const auto old_fragment_first =
+      mdds::encode_data_frag(writer_guid, writer_epoch, 2, 0,
+                             static_cast<uint32_t>(old_fragment.size()), 0,
+                             old_fragment.data(), 64, mdds::kFlagReliable);
+  const auto old_fragment_tail =
+      mdds::encode_data_frag(writer_guid, writer_epoch, 2, 0,
+                             static_cast<uint32_t>(old_fragment.size()), 64,
+                             old_fragment.data() + 64, 64, mdds::kFlagReliable);
+  const uint8_t stale[] = {0x53, 0x54, 0x41, 0x4c, 0x45};
+  // Local UDP preserves one socket's packet order. Seeing seq=1 in the queue
+  // therefore proves the preceding offset-0 fragment has reached the real
+  // reassembler before the hostile ANNOUNCEs are considered.
+  ASSERT_TRUE(peer.send_frame(old_fragment_first, kTestBasePort5));
+  ASSERT_TRUE(
+      peer.send_frame(mdds::encode_data(writer_guid, writer_epoch, 1, 0, stale,
+                                        sizeof(stale), mdds::kFlagReliable),
+                      kTestBasePort5));
+  ASSERT_TRUE(wait_until([&] { return reader->available() == 1; }, 2s, 5ms));
+
+  const auto replacement = raw_remote_snapshot(
+      0x49, {raw_remote_endpoint(0x49, mdds::EntityKind::WRITER, 2,
+                                 "/identity_epoch_off", "test/IdentityEpoch")});
+  std::vector<uint8_t> replacement_frame;
+  ASSERT_TRUE(prepare_raw_announce_frame(peer, cfg.domain_id, kTestBasePort5,
+                                         replacement, 2, replacement_frame));
+  auto rebound = original;
+  rebound.endpoints.front().birth_us = 1;
+  std::vector<uint8_t> rebound_frame;
+  ASSERT_TRUE(prepare_raw_announce_frame(peer, cfg.domain_id, kTestBasePort5,
+                                         rebound, 2, rebound_frame));
+
+  // Keep the peer live while injecting both valid-session hostile frames. They
+  // must leave the accepted snapshot on the original GUID and cannot reset the
+  // reader's association or its partial reassembly.
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(replacement_frame, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(rebound_frame, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  const auto after_rejection = target->remote_participants();
+  ASSERT_EQ(after_rejection.size(), 1u);
+  ASSERT_EQ(after_rejection.front().endpoints.size(), 1u);
+  EXPECT_EQ(after_rejection.front().endpoints.front().guid, writer_guid);
+  EXPECT_EQ(after_rejection.front().endpoints.front().birth_us,
+            original.endpoints.front().birth_us);
+  EXPECT_EQ(reader->matched_count(), 1u);
+
+  // A canonical refresh can reuse the rejected seq=2, proving neither hostile
+  // ANNOUNCE advanced the remote announce sequence.
+  auto recovered = original;
+  recovered.nodes.push_back({"/", "identity_epoch_recovery"});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, recovered, 2));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        const auto remotes = target->remote_participants();
+        return remotes.size() == 1 && remotes.front().endpoints.size() == 1 &&
+               remotes.front().endpoints.front().guid == writer_guid &&
+               remotes.front().nodes.size() == 1 &&
+               remotes.front().nodes.front().name ==
+                   "identity_epoch_recovery" &&
+               reader->matched_count() == 1;
+      },
+      2s, 10ms));
+
+  ASSERT_TRUE(peer.send_frame(old_fragment_tail, kTestBasePort5));
+  ASSERT_TRUE(wait_until([&] { return reader->available() == 2; }, 2s, 5ms));
+  std::vector<std::vector<uint8_t>> received;
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  while (reader->take(out, info)) {
+    received.push_back(out);
+  }
+  ASSERT_EQ(received.size(), 2u);
+  EXPECT_EQ(received[0], std::vector<uint8_t>(stale, stale + sizeof(stale)));
+  EXPECT_EQ(received[1],
+            std::vector<uint8_t>(old_fragment.begin(), old_fragment.end()));
+}
