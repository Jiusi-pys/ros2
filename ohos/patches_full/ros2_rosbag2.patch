+    REQUEST_SENT = service_msgs::msg::ServiceEventInfo::REQUEST_SENT,
+    REQUEST_RECEIVED = service_msgs::msg::ServiceEventInfo::REQUEST_RECEIVED,
+    RESPONSE_SENT = service_msgs::msg::ServiceEventInfo::RESPONSE_SENT,
