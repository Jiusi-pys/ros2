+// These helpers deliberately build ordinary wire ANNOUNCE/DATA frames.  The
+// integration tests below inject them through the real fake C ABI rather than
+// exposing a Participant test hook, which exercises the full production chain:
+// ISocketListener::OnBytes -> DsoftbusEngine -> ListenerRelay -> Participant.
+mdds::ParticipantConfig dsoftbus_participant_config() {
+  mdds::ParticipantConfig config;
+  config.domain_id = 91;
+  config.use_udp_loopback = false;
+  config.use_dsoftbus = true;
+  config.strict_transports = true;
+  // No periodic self-ANNOUNCE is needed for a single deterministic ingress
+  // test. Peer-up still sends one immediate production ANNOUNCE.
+  config.announce_period_ms = 60 * 1000;
+  return config;
