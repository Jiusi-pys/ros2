+// The session nonce is a peer-generation fence.  After peer-down and a new
+// peer-up, a captured ANNOUNCE bearing the prior nonce is rejected; only the
+// fresh receiver-issued nonce can re-admit the same remote participant.
+TEST(DiscoverySessionChallenge,
+     ReconnectRejectsOldEchoAndAdmitsOnlyFreshReceiverNonce) {
+  auto cfg = raw_admission_config();
+  cfg.announce_period_ms = 60000;
+  cfg.udp_announce_ms = 25;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  const auto remote = raw_remote_snapshot(
+      0x83,
+      {raw_remote_endpoint(0x83, mdds::EntityKind::WRITER, 1,
+                           "/session_reconnect", "test/SessionReconnect")});
+
+  mdds::SessionChallengeBody first_challenge;
+  ASSERT_TRUE(peer.session_challenge(cfg.domain_id, kTestBasePort5,
+                                     first_challenge, true));
+  const auto old_announce = raw_announce_frame(remote, 1, first_challenge);
+  ASSERT_TRUE(peer.send_frame(old_announce, kTestBasePort5));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return target->graph_counts().remote_participants == 1;
+      },
+      2s, 10ms));
+
+  ASSERT_TRUE(wait_until(
+      [&] { return target->graph_counts().remote_participants == 0; }, 3s,
+      10ms));
+
+  // The raw socket still has the same source port, but peer-up creates a new
+  // transport session and must produce a distinct nonce.
+  mdds::SessionChallengeBody fresh_challenge;
+  ASSERT_TRUE(peer.session_challenge(cfg.domain_id, kTestBasePort5,
+                                     fresh_challenge, true));
+  ASSERT_NE(fresh_challenge.nonce, first_challenge.nonce);
+
+  ASSERT_TRUE(peer.send_frame(old_announce, kTestBasePort5));
+  const auto stale_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < stale_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_EQ(target->graph_counts().remote_participants, 0u);
+
+  const auto fresh_announce = raw_announce_frame(remote, 2, fresh_challenge);
+  ASSERT_TRUE(peer.send_frame(fresh_announce, kTestBasePort5));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return target->graph_counts().remote_participants == 1;
+      },
+      2s, 10ms));
+}
