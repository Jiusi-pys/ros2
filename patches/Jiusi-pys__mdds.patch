+/// Complete the raw-reader half of the reliable association handshake and
+/// return the exact writer-issued epoch.  Raw hostile-input tests used to send
+/// ACKNACK directly after ANNOUNCE; protocol v9 intentionally rejects that
+/// because a reader must first prove a current transport-session challenge.
+bool activate_raw_reliable_association(
+    RawUdpPeer &peer, uint16_t target_port,
+    const mdds::ParticipantSnapshot &remote_snapshot,
+    const mdds::Guid &reader_session_nonce, const mdds::Guid &writer,
+    const mdds::Guid &writer_epoch, const mdds::Guid &reader,
+    const mdds::Guid &reader_epoch, mdds::AssociationBody &association,
+    std::chrono::milliseconds timeout = 2s) {
+  const auto challenge = mdds::encode_session_challenge(
+      remote_snapshot.participant_guid, reader_session_nonce);
+  if (challenge.empty() || !peer.send_frame(challenge, target_port)) {
+    return false;
+  }
+
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  do {
+    const auto now = std::chrono::steady_clock::now();
+    if (now > deadline) {
+      return false;
+    }
+    const auto remaining =
+        std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now);
+    std::vector<uint8_t> frame;
+    if (!peer.receive_frame(frame, remaining)) {
+      return false;
+    }
+    mdds::AssociationBody candidate;
+    if (mdds::decode_association(frame.data(), frame.size(), candidate) &&
+        candidate.writer == writer && candidate.writer_epoch == writer_epoch &&
+        candidate.reader == reader && candidate.reader_epoch == reader_epoch &&
+        candidate.reader_session_nonce == reader_session_nonce) {
+      association = candidate;
+      return true;
+    }
+  } while (std::chrono::steady_clock::now() <= deadline);
+  return false;
+}
