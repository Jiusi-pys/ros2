+// A graph callback runs on a transport callback thread. The asynchronous
+// clear must immediately fence later callbacks, while the external drain
+// holds its admission/depth fence until that frame has completely unwound.
+// Only after that drain may an owner retire the Participant. The callback also
+// verifies the narrow lifecycle query consumed by rmw_mdds.
+TEST_F(ParticipantFixture, GraphCallbackClearDrainsBeforeExternalRetirement) {
+  struct State {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool entered = false;
+    bool release = false;
+    bool active_query_true = false;
+    std::atomic<uint64_t> hits{0};
+  };
+  auto state = std::make_shared<State>();
+
+  pb_->set_graph_callback([this, state] {
+    state->hits.fetch_add(1, std::memory_order_relaxed);
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      state->active_query_true = pb_->graph_callback_active_on_this_thread();
+      state->entered = true;
+    }
+    state->cv.notify_all();
+    std::unique_lock<std::mutex> lock(state->mutex);
+    state->cv.wait(lock, [state] { return state->release; });
+  });
+
+  auto *writer = pa_->create_writer(
+      "/graph_callback_retire", "test/GraphCallbackRetire", default_qos());
+  auto *reader = pb_->create_reader(
+      "/graph_callback_retire", "test/GraphCallbackRetire", default_qos());
+  ASSERT_NE(writer, nullptr);
+  ASSERT_NE(reader, nullptr);
+
+  bool entered = false;
+  {
+    std::unique_lock<std::mutex> lock(state->mutex);
+    entered = state->cv.wait_for(lock, 10s, [state] { return state->entered; });
+  }
+  if (!entered) {
+    FAIL() << "remote graph callback never entered";
+    return;
+  }
+
+  std::atomic<bool> clear_returned{false};
+  std::atomic<bool> drain_returned{false};
+  std::thread clearer([&] {
+    pb_->clear_graph_callback_async();
+    clear_returned.store(true, std::memory_order_release);
+  });
+  clearer.join();
+  std::thread drainer([&] {
+    pb_->wait_graph_callback_idle();
+    drain_returned.store(true, std::memory_order_release);
+  });
+  // The callback is deliberately still blocked. The asynchronous generation
+  // fence must return promptly, but the external physical-drain half cannot
+  // report a completed lifetime fence yet.
+  std::this_thread::sleep_for(100ms);
+  const bool drain_returned_early =
+      drain_returned.load(std::memory_order_acquire);
+
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->release = true;
+  }
+  state->cv.notify_all();
+  drainer.join();
+
+  EXPECT_TRUE(clear_returned.load(std::memory_order_acquire));
+  EXPECT_FALSE(drain_returned_early);
+  EXPECT_TRUE(drain_returned.load(std::memory_order_acquire));
+  EXPECT_TRUE(state->active_query_true);
+  EXPECT_EQ(state->hits.load(std::memory_order_acquire), 1u);
+
+  // A later remote graph change must not call the cleared user closure.
+  auto *writer2 = pa_->create_writer(
+      "/graph_callback_retire_second", "test/GraphCallbackRetire", default_qos());
+  auto *reader2 = pb_->create_reader(
+      "/graph_callback_retire_second", "test/GraphCallbackRetire", default_qos());
+  ASSERT_NE(writer2, nullptr);
+  ASSERT_NE(reader2, nullptr);
+  pa_->announce_now();
+  std::this_thread::sleep_for(300ms);
+  EXPECT_EQ(state->hits.load(std::memory_order_acquire), 1u);
+
+  // Move destruction to a thread outside the UDP receive callback. The clear
+  // above is the proof that no graph callback frame can still touch pb_.
+  auto retiring = std::move(pb_);
+  std::atomic<bool> destroyed{false};
+  std::thread reaper([participant = std::move(retiring), &destroyed]() mutable {
+    participant.reset();
+    destroyed.store(true, std::memory_order_release);
+  });
+  reaper.join();
+  EXPECT_TRUE(destroyed.load(std::memory_order_acquire));
+}
