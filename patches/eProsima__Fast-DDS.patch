From e66e90fd7b1e7a14d80129002474c68bc16da2bb Mon Sep 17 00:00:00 2001
From: Yusheng Peng <jiusi0519@gmail.com>
Date: Sat, 5 Sep 2026 12:14:31 +0800
Subject: [PATCH] fix(ohos): anchor topic RTTI and use matching bundled
 TinyXML2

Give TopicDescription an OHOS-only out-of-line key function so cross-DSO downcasts use provider-owned RTTI. Keep bundled TinyXML2 headers and implementation together. Add topic downcast and ELF ownership regressions.

Focused RK3588A tests passed: content filter 1/1, subscription 31/31, cpp and dynamic RMW 16/16 each, default-RMW cross-board pub/sub. Full clean SDK23 ROS build and release acceptance are still pending. Published through the ROS workspace patch snapshot; no direct upstream push.
---
 cmake/modules/FindTinyXML2.cmake              | 20 +++--
 .../fastdds/dds/topic/TopicDescription.hpp    |  8 ++
 src/cpp/CMakeLists.txt                        |  2 +-
 src/cpp/fastdds/topic/Topic.cpp               |  4 +
 test/ohos/check_topic_description_rtti.py     | 82 +++++++++++++++++++
 test/unittest/dds/topic/TopicTests.cpp        | 20 +++++
 6 files changed, 129 insertions(+), 7 deletions(-)
 create mode 100644 test/ohos/check_topic_description_rtti.py

diff --git a/cmake/modules/FindTinyXML2.cmake b/cmake/modules/FindTinyXML2.cmake
index 44b8e6457..20d1c9753 100644
--- a/cmake/modules/FindTinyXML2.cmake
+++ b/cmake/modules/FindTinyXML2.cmake
@@ -29,16 +29,24 @@ if(TinyXML2_FOUND AND NOT TINYXML2_FROM_THIRDPARTY)
         endif()
     endif()
 else()
-    if(TINYXML2_FROM_THIRDPARTY OR ANDROID)
+    if(TINYXML2_FROM_THIRDPARTY)
+        # The bundled implementation and header must always come from the same
+        # submodule.  A generic host-side find_path() can otherwise select a
+        # different TinyXML2 header while tinyxml2.cpp is taken from the
+        # submodule.  Besides being non-reproducible, mixing those versions in
+        # one Fast DDS library is an ABI violation because TinyXML2 classes are
+        # passed across that boundary.
+        set(TINYXML2_FROM_SOURCE ON)
+        set(TINYXML2_INCLUDE_DIR "${PROJECT_SOURCE_DIR}/thirdparty/tinyxml2"
+            CACHE PATH "Bundled TinyXML2 include directory" FORCE)
+        set(TINYXML2_SOURCE_DIR "${PROJECT_SOURCE_DIR}/thirdparty/tinyxml2"
+            CACHE PATH "Bundled TinyXML2 source directory" FORCE)
+    elseif(ANDROID)
         set(TINYXML2_FROM_SOURCE ON)
         find_path(TINYXML2_INCLUDE_DIR NAMES tinyxml2.h NO_CMAKE_FIND_ROOT_PATH)
-    else()
-        find_path(TINYXML2_INCLUDE_DIR NAMES tinyxml2.h)
-    endif()
-
-    if(TINYXML2_FROM_SOURCE)
         find_path(TINYXML2_SOURCE_DIR NAMES tinyxml2.cpp NO_CMAKE_FIND_ROOT_PATH)
     else()
+        find_path(TINYXML2_INCLUDE_DIR NAMES tinyxml2.h)
         find_library(TINYXML2_LIBRARY tinyxml2)
     endif()
 
diff --git a/include/fastdds/dds/topic/TopicDescription.hpp b/include/fastdds/dds/topic/TopicDescription.hpp
index 656e70b66..7b1aac488 100644
--- a/include/fastdds/dds/topic/TopicDescription.hpp
+++ b/include/fastdds/dds/topic/TopicDescription.hpp
@@ -77,9 +77,17 @@ protected:
     {
     }
 
+#if defined(__OHOS__)
+    // Keep a single RTTI definition in libfastrtps on OpenHarmony.  Its
+    // libc++abi does not merge the weak TopicDescription typeinfo emitted by
+    // different DSOs, so cross-DSO dynamic_casts otherwise fail even for a
+    // valid Topic instance.
+    virtual ~TopicDescription();
+#else
     virtual ~TopicDescription()
     {
     }
+#endif
 
 protected:
 
