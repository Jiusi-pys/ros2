+#include "runtime_health.hpp"
+
+namespace mdds_gateway
+{
+
+namespace
+{
+
+bool
+required_transport_healthy(
+  const char * name,
+  const std::vector<mdds::TransportStatus> & statuses,
+  std::string & reason)
+{
+  for (const mdds::TransportStatus & status : statuses) {
+    if (status.name != name) {
+      continue;
+    }
+    if (status.running) {
+      return true;
+    }
+
+    reason = "required mdds backend '" + std::string(name) + "' stopped";
+    if (!status.detail.empty()) {
+      reason += ": " + status.detail;
+    }
+    return false;
+  }
+
+  reason = "required mdds backend '" + std::string(name) + "' disappeared";
+  return false;
+}
+
+}  // namespace
+
+bool
+required_transports_healthy(
+  const GatewayConfig & config,
+  const std::vector<mdds::TransportStatus> & statuses,
+  std::string & reason)
+{
+  reason.clear();
+  if (config.mdds_udp && !required_transport_healthy("udp", statuses, reason)) {
+    return false;
+  }
+  if (config.mdds_dsoftbus && !required_transport_healthy("dsoftbus", statuses, reason)) {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace mdds_gateway
