+TEST(SerdesBudget, strings_charge_temporary_and_destination_storage)
+{
+  {
+    std::vector<uint8_t> buf = cdr_payload();
+    append_u32(buf, 4);  // three chars + NUL
+    append_bytes(buf, "abc", 3);
+    buf.push_back(0);
+    CdrReader reader(buf.data(), buf.size());
+    const size_t before = reader.budget_remaining();
+    std::string out;
+    ASSERT_NO_THROW(reader.get_string(out));
+    EXPECT_EQ(out, "abc");
+    // temporary string = 3 bytes, assigned field reserve = 4 bytes.
+    EXPECT_EQ(reader.budget_remaining(), before - 7u);
+  }
+  {
+    std::vector<uint8_t> buf = cdr_payload();
+    append_u32(buf, 3);
+    append_u32(buf, 'A');
+    append_u32(buf, 'B');
+    append_u32(buf, 'C');
+    CdrReader reader(buf.data(), buf.size());
+    const size_t before = reader.budget_remaining();
+    std::vector<uint16_t> out;
+    ASSERT_NO_THROW(reader.get_u16_string(out));
+    EXPECT_EQ(out.size(), 3u);
+    // temporary vector = 3 * 2; target u16 string reserve = (3 + NUL) * 2.
+    EXPECT_EQ(reader.budget_remaining(), before - 14u);
+  }
+}
