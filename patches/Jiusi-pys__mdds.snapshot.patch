 class ParticipantImpl;
 class ReaderImpl;
+class WriterImpl;
+
+// Concurrent writes on one Writer must not allocate seq N+1 and reach a local
+// reader before seq N.  The dynamic TLS stack also makes re-entry through a
+// sample filter or test send hook fail closed instead of self-deadlocking on
+// the per-writer publish mutex.  Different writers remain independent.
+struct WriterPublishFrame {
+  WriterImpl *writer = nullptr;
+  WriterPublishFrame *previous = nullptr;
+};
+
+thread_local WriterPublishFrame *t_writer_publishing = nullptr;
+
+bool writer_publish_frame_active_on_this_thread(
+    const WriterImpl *writer) noexcept {
+  for (const WriterPublishFrame *frame = t_writer_publishing; frame != nullptr;
+       frame = frame->previous) {
+    if (frame->writer == writer) {
+      return true;
+    }
+  }
+  return false;
+}
+
+class WriterPublishScope {
+public:
+  explicit WriterPublishScope(WriterImpl *writer) noexcept {
+    frame_.writer = writer;
+    frame_.previous = t_writer_publishing;
+    t_writer_publishing = &frame_;
+  }
+
+  ~WriterPublishScope() { t_writer_publishing = frame_.previous; }
+
+  WriterPublishScope(const WriterPublishScope &) = delete;
+  WriterPublishScope &operator=(const WriterPublishScope &) = delete;
+
+private:
+  WriterPublishFrame frame_;
+};
 
