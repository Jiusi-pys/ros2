+// strict_transports is fail-closed: creation fails when ANY requested
+// backend is unavailable, with the requested/active/failed breakdown in
+// init_error.
+TEST(TransportFail, StrictTransportFailsClosed) {
+#ifdef MDDS_WITH_DSOFTBUS
+  // Board: the backend IS compiled. One dsoftbus transport per process is
+  // enforced by the process-wide CallbackRegistry: while P1 owns the
+  // generation (and thereby the per-device DSoftBus session name
+  // com.kaihong.mdds.d<domain>), a second participant must fail closed
+  // immediately instead of hanging its rcl/rmw initialization. The gate
+  // reopens only after P1's stop() has drained callbacks, shut the sockets
+  // down and acked cleanup.
+  mdds::ParticipantConfig cfg;
+  cfg.domain_id = dsoftbus_test_domain();
+  cfg.use_udp_loopback = false;
+  cfg.use_dsoftbus = true;
+  cfg.strict_transports = true;
+
+  auto p1 = mdds::Participant::create(cfg);
+  ASSERT_NE(p1, nullptr);
+
+  std::string p2_err;
+  auto p2 = mdds::Participant::create(cfg, &p2_err);
+  EXPECT_EQ(p2, nullptr);
+  EXPECT_NE(p2_err.find("dsoftbus callback/session slot busy"),
+            std::string::npos)
+      << p2_err;
+  EXPECT_NE(p2_err.find("requested=[dsoftbus]"), std::string::npos) << p2_err;
+  EXPECT_NE(p2_err.find("active=[]"), std::string::npos) << p2_err;
+  EXPECT_NE(p2_err.find("failed=[dsoftbus:"), std::string::npos) << p2_err;
+
+  p1.reset(); // stop(): UnregisterAndDrain, Shutdown, MarkCleanupDone
+  // The session name is free again and the registry gate reopened, so the
+  // next participant now starts. Tolerate a brief SDK-side release lag of
+  // the session name after Shutdown by retrying.
+  auto deadline = std::chrono::steady_clock::now() + 10s;
+  while (p2 == nullptr && std::chrono::steady_clock::now() < deadline) {
+    p2_err.clear();
+    p2 = mdds::Participant::create(cfg, &p2_err);
+    if (p2 == nullptr) {
+      std::this_thread::sleep_for(200ms);
+    }
+  }
+  ASSERT_NE(p2, nullptr) << p2_err;
+#else
+  // Host build (MDDS_WITH_DSOFTBUS off): the requested dsoftbus backend is
+  // not compiled at all; strict_transports must fail closed and say why.
+  mdds::ParticipantConfig cfg;
+  cfg.domain_id = 42;
+  cfg.use_udp_loopback = false;
+  cfg.use_dsoftbus = true;
+  cfg.strict_transports = true;
+
+  std::string err;
+  EXPECT_EQ(mdds::Participant::create(cfg, &err), nullptr);
+  EXPECT_NE(err.find("not compiled"), std::string::npos) << err;
+  EXPECT_NE(err.find("requested=["), std::string::npos) << err;
+  EXPECT_NE(err.find("active=["), std::string::npos) << err;
+#endif
+}
+
+// The 257th concurrently active volatile reader is refused atomically. The
+// previously admitted 256-reader snapshot stays intact; once one of those
+// readers leaves, its now-inactive watermark may be reclaimed and the
+// formerly rejected endpoint is admitted by the next complete snapshot.
+TEST(ReliabilityTest, WatermarkLimitRejects257thThenReclaimsInactiveSlot) {
+  auto pa = mdds::Participant::create(test_config_4());
+  auto pb = mdds::Participant::create(test_config_4());
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+
+  auto *w = pa->create_writer("/wm", "test/Wm", default_qos());
+  ASSERT_NE(w, nullptr);
+
+  constexpr size_t kWatermarkCap = 256;
+  std::vector<mdds::Reader *> readers;
+  readers.reserve(kWatermarkCap + 1);
+  for (size_t i = 0; i < kWatermarkCap; ++i) {
+    auto *r = pb->create_reader("/wm", "test/Wm", default_qos());
+    ASSERT_NE(r, nullptr) << i;
+    readers.push_back(r);
+  }
+
+  ASSERT_TRUE(wait_matched(w, kWatermarkCap, 20s));
+  auto *overflow = pb->create_reader("/wm", "test/Wm", default_qos());
+  ASSERT_NE(overflow, nullptr);
+  const mdds::Guid overflow_guid = overflow->guid();
+
+  // Let the 257-endpoint ANNOUNCE arrive. It must not partially replace the
+  // prior 256-endpoint snapshot.
+  std::this_thread::sleep_for(500ms);
+  ASSERT_EQ(w->matched_count(), kWatermarkCap);
+  auto remotes = pa->remote_participants();
+  ASSERT_EQ(remotes.size(), 1u);
+  ASSERT_EQ(remotes.front().endpoints.size(), kWatermarkCap);
+  EXPECT_FALSE(snapshot_has_guid(remotes.front(), overflow_guid));
+
+  // The already-admitted state remains usable while the candidate is denied.
+  const char stable[] = "stable";
+  ASSERT_TRUE(w->write(reinterpret_cast<const uint8_t *>(stable), sizeof(stable)));
+  const auto stable_deadline = std::chrono::steady_clock::now() + 10s;
+  std::vector<bool> stable_received(kWatermarkCap, false);
+  size_t stable_count = 0;
+  while (std::chrono::steady_clock::now() < stable_deadline &&
+         stable_count < kWatermarkCap) {
+    for (size_t i = 0; i < readers.size(); ++i) {
+      if (stable_received[i]) {
+        continue;
+      }
+      std::vector<uint8_t> out;
+      mdds::MessageInfo info;
+      if (readers[i]->take(out, info) && info.seq == 1) {
+        stable_received[i] = true;
+        ++stable_count;
+      }
+    }
+    if (stable_count < kWatermarkCap) {
+      std::this_thread::sleep_for(5ms);
+    }
+  }
+  EXPECT_EQ(stable_count, kWatermarkCap)
+      << "the 257th ANNOUNCE must not disturb the already-admitted readers";
+
+  // Removing one old endpoint produces a legal 256-entry replacement that
+  // includes the former overflow GUID. The staged transaction first proves
+  // the old reader is inactive, then deterministically reclaims its tombstone.
+  pb->destroy_reader(readers.front());
+  const auto reclaim_deadline = std::chrono::steady_clock::now() + 15s;
+  bool reclaimed = false;
+  while (std::chrono::steady_clock::now() < reclaim_deadline) {
+    remotes = pa->remote_participants();
+    reclaimed = remotes.size() == 1 &&
+                remotes.front().endpoints.size() == kWatermarkCap &&
+                snapshot_has_guid(remotes.front(), overflow_guid);
+    if (reclaimed) {
+      break;
+    }
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_TRUE(reclaimed);
+}
+
+} // namespace
