+TEST(SerdesBudget, zero_width_sequence_huge_count_throws_on_budget)
+{
+  // sequence<Empty> has wire minimum 0, so check_count() skips its byte
+  // check and the budget is the only guard. Budget for the 8-byte payload is
+  // 8*8 + 4 MiB = 4194368; with Empty's size_of_ == 1 the forged count
+  // 0xFFFFFFFF exceeds it and must throw before any resize.
+  g_seq_empty_resized = false;
+  std::vector<uint8_t> buf = cdr_payload();
+  append_u32(buf, 0xFFFFFFFFu);
+  SeqEmptyMsg msg;
+  CdrReader reader(buf.data(), buf.size());
+  try {
+    read_members(reader, &seq_empty_members, &msg);
+    FAIL() << "expected std::runtime_error";
+  } catch (const std::runtime_error & e) {
+    EXPECT_NE(std::string::npos, std::string(e.what()).find("budget"));
+  }
+  EXPECT_FALSE(g_seq_empty_resized);
+}
+
+TEST(SerdesRoundtrip, honest_mixed_message_roundtrips)
+{
+  Rt in;
+  in.u32 = 42;
+  in.d = 3.25;
+  in.name = "ros";
+  in.tag = "hello";  // 5 chars, bound 10
+  in.samples = {1, 2, 3};
+  in.labels = {"a", "bc"};
+  in.wname = u"wide";
+  in.inner.x = -7;
+  in.inner.s = "nested";
+  RtInner extra;
+  extra.x = 9;
+  extra.s = "seq";
+  in.inners = {in.inner, extra};
+  in.flag = true;
+  in.fixed3[0] = 1;
+  in.fixed3[1] = 2;
+  in.fixed3[2] = 3;
+
+  std::vector<uint8_t> buf;
+  CdrWriter writer(buf);
+  write_members(writer, &rt_members, &in);
+
+  Rt out;
+  CdrReader reader(buf.data(), buf.size());
+  ASSERT_NO_THROW(read_members(reader, &rt_members, &out));
+  EXPECT_EQ(out.u32, 42u);
+  EXPECT_DOUBLE_EQ(out.d, 3.25);
+  EXPECT_EQ(out.name, "ros");
+  EXPECT_EQ(out.tag, "hello");
+  EXPECT_EQ(out.samples, std::vector<uint64_t>({1, 2, 3}));
+  EXPECT_EQ(out.labels, std::vector<std::string>({"a", "bc"}));
+  EXPECT_EQ(out.wname, u"wide");
+  EXPECT_EQ(out.inner.x, -7);
+  EXPECT_EQ(out.inner.s, "nested");
+  ASSERT_EQ(out.inners.size(), 2u);
+  EXPECT_EQ(out.inners[0].x, -7);
+  EXPECT_EQ(out.inners[1].s, "seq");
+  EXPECT_TRUE(out.flag);
+  EXPECT_EQ(out.fixed3[0], 1);
+  EXPECT_EQ(out.fixed3[1], 2);
+  EXPECT_EQ(out.fixed3[2], 3);
+}
+
+}  // namespace
