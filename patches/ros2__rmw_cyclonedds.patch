+#ifndef RMW_CYCLONEDDS_CPP__SUBSCRIPTION_RESOURCE_LIMITS_H_
+#define RMW_CYCLONEDDS_CPP__SUBSCRIPTION_RESOURCE_LIMITS_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+/// Stable marker for the CycloneDDS-only subscription payload below.
+#define RMW_CYCLONEDDS_CPP_SUBSCRIPTION_RESOURCE_LIMITS_MAGIC UINT64_C(0x524D574344444C52)
+#define RMW_CYCLONEDDS_CPP_SUBSCRIPTION_RESOURCE_LIMITS_VERSION UINT32_C(1)
+
+/// Optional value for rmw_subscription_options_t::rmw_specific_subscription_payload.
+/**
+ * This is deliberately an RMW-private, versioned C-layout payload instead of
+ * an extension to the portable ROS QoS ABI.  Callers must keep this object
+ * valid for the complete rmw_create_subscription() call.  The RMW copies the
+ * scalar limits into the CycloneDDS QoS before that call returns.
+ */
+typedef struct rmw_cyclonedds_cpp_subscription_resource_limits_s
+{
+  uint64_t magic;
+  uint32_t version;
+  uint32_t struct_size;
+  int32_t max_samples;
+  int32_t max_instances;
+  int32_t max_samples_per_instance;
+} rmw_cyclonedds_cpp_subscription_resource_limits_t;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW_CYCLONEDDS_CPP__SUBSCRIPTION_RESOURCE_LIMITS_H_
