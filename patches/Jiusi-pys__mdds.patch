+  errno = 0;
+  const unsigned long long parsed = std::strtoull(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0') {
+    return false;
+  }
+  out = static_cast<uint64_t>(parsed);
+  return true;
+}
+
+void
+print_usage(const char * program)
+{
+  std::cerr << "Usage: " << program
+            << " --topic <run-unique-topic> [--type std_msgs/msg/ByteMultiArray]"
+            << " [--domain 44] [--expected-samples 1024]"
+            << " [--timeout-seconds 120] --drop-acknack"
+            << std::endl;
+}
+
+bool
+parse_arguments(int argc, char ** argv, Arguments & out)
+{
+  bool drop_acknack = false;
+  for (int index = 1; index < argc; ++index) {
+    const std::string arg(argv[index]);
+    const auto next = [&]() -> const char * {
+        if (index + 1 >= argc) {
+          return nullptr;
+        }
+        return argv[++index];
+      };
+    if (arg == "--topic") {
+      const char * value = next();
+      if (value == nullptr) {
+        return false;
+      }
+      out.topic = value;
+    } else if (arg == "--type") {
+      const char * value = next();
+      if (value == nullptr) {
+        return false;
+      }
+      out.type = value;
+    } else if (arg == "--domain") {
+      const char * value = next();
+      if (!parse_u32(value, out.domain)) {
+        return false;
+      }
+    } else if (arg == "--expected-samples") {
+      const char * value = next();
+      if (!parse_u64(value, out.expected_samples)) {
+        return false;
+      }
+    } else if (arg == "--timeout-seconds") {
+      const char * value = next();
+      if (!parse_u32(value, out.timeout_seconds)) {
+        return false;
+      }
+    } else if (arg == "--drop-acknack") {
+      drop_acknack = true;
+    } else {
+      return false;
+    }
+  }
+  // The runner intentionally locks this helper to the deployed gateway cap;
+  // accepting arbitrary values would turn a release gate into a generic
+  // packet-drop tool.
+  return drop_acknack && is_safe_topic(out.topic) && is_safe_type(out.type) &&
+         out.type == kDefaultType &&
+         out.domain == kDefaultDomain &&
+         out.expected_samples == kDefaultExpectedSamples &&
+         out.timeout_seconds >= 30 && out.timeout_seconds <= 300;
+}
+
+}  // namespace
+
+int
+main(int argc, char ** argv)
+{
+  Arguments arguments;
+  if (!parse_arguments(argc, argv, arguments)) {
+    print_usage(argv[0]);
+    return 2;
+  }
+  std::signal(SIGINT, on_signal);
+  std::signal(SIGTERM, on_signal);
+
+  std::atomic<uint64_t> dropped_acknacks{0};
+  mdds::ParticipantConfig config;
+  config.domain_id = arguments.domain;
+  config.use_udp_loopback = false;
+  config.udp_cross_device = false;
+  config.use_dsoftbus = true;
+  config.strict_transports = true;
+  config.announce_period_ms = 500;
+  // The helper continuously drains its reader, but leave ample explicit
+  // delivery headroom so a scheduler burst cannot impersonate the writer's
+  // history limit that this gate is intended to prove.
+  config.max_delivery_samples_per_reader = 4096;
+  config.max_delivery_samples_total = 4096;
+  config.max_delivery_bytes_per_reader = 32 * 1024 * 1024;
+  config.max_delivery_bytes_total = 32 * 1024 * 1024;
+  config.test_send_hook = [&dropped_acknacks](const uint8_t * frame, size_t length) {
+      mdds::FrameHeader header{};
+      if (mdds::decode_header(frame, length, header) &&
+        header.type == mdds::FrameType::ACKNACK)
+      {
+        dropped_acknacks.fetch_add(1, std::memory_order_relaxed);
+        return true;
+      }
+      return false;
+    };
+
+  std::string init_error;
+  auto participant = mdds::Participant::create(config, &init_error);
+  if (participant == nullptr) {
+    std::cout << "GW11_CAP_PROBE_RESULT state=INIT_FAILED error="
+              << (init_error.empty() ? "unknown" : init_error) << std::endl;
+    return 3;
+  }
+  participant->add_node("/", "mdds_history_cap_probe");
+  mdds::QosProfile qos;
+  qos.history = mdds::History::KEEP_ALL;
+  qos.reliability = mdds::Reliability::RELIABLE;
+  mdds::Reader * reader = participant->create_reader(arguments.topic, arguments.type, qos);
+  if (reader == nullptr) {
+    std::cout << "GW11_CAP_PROBE_RESULT state=CREATE_READER_FAILED" << std::endl;
+    return 4;
+  }
+  participant->announce_now();
+  std::cout << "GW11_CAP_PROBE_READY domain=" << arguments.domain
+            << " topic=" << arguments.topic << " type=" << arguments.type
+            << " expected_samples=" << arguments.expected_samples
+            << " ack_mode=drop_all_acknack" << std::endl;
+
+  uint64_t received = 0;
+  bool reported_match = false;
+  bool reported_cap = false;
+  const auto deadline = std::chrono::steady_clock::now() +
+    std::chrono::seconds(arguments.timeout_seconds);
+  while (g_stop == 0 && std::chrono::steady_clock::now() < deadline) {
+    const size_t compatible = reader->compatible_matched_count();
+    if (!reported_match && compatible > 0) {
+      reported_match = true;
+      std::cout << "GW11_CAP_PROBE_ASSOCIATION compatible_writers=" << compatible
+                << " discovered_writers=" << reader->matched_count() << std::endl;
+    }
+
+    std::vector<uint8_t> data;
+    mdds::MessageInfo info;
+    bool took_any = false;
+    while (reader->take(data, info)) {
+      took_any = true;
+      ++received;
+      if (received == arguments.expected_samples) {
+        reported_cap = true;
+        std::cout << "GW11_CAP_PROBE_CAP_REACHED received=" << received
+                  << " expected=" << arguments.expected_samples
+                  << " acknack_dropped="
+                  << dropped_acknacks.load(std::memory_order_relaxed)
+                  << " reader_messages_lost=" << reader->messages_lost()
+                  << " state=HOLDING" << std::endl;
+      }
+      // The real gateway must reject the next (1025th) C2M input. Seeing more
+      // here would prove that the tested process was not honoring its 1024
+      // source-of-truth Writer cap.
+      if (received > arguments.expected_samples) {
+        std::cout << "GW11_CAP_PROBE_RESULT state=OVER_CAP_DELIVERY received="
+                  << received << " expected=" << arguments.expected_samples
+                  << " acknack_dropped="
+                  << dropped_acknacks.load(std::memory_order_relaxed)
+                  << std::endl;
+        participant->destroy_reader(reader);
+        return 5;
+      }
+    }
+    if (!took_any) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+  }
+
+  const uint64_t dropped = dropped_acknacks.load(std::memory_order_relaxed);
+  const uint64_t lost = reader->messages_lost();
+  const char * const state =
+    reported_cap && reported_match && dropped > 0 && lost == 0 ?
+    (g_stop != 0 ? "STOPPED_AFTER_CAP" : "TIMEOUT_AFTER_CAP") :
+    (g_stop != 0 ? "STOPPED_BEFORE_CAP" : "TIMEOUT_BEFORE_CAP");
+  std::cout << "GW11_CAP_PROBE_RESULT state=" << state
+            << " received=" << received
+            << " expected=" << arguments.expected_samples
+            << " acknack_dropped=" << dropped
+            << " reader_messages_lost=" << lost
+            << " compatible_writers=" << reader->compatible_matched_count()
+            << std::endl;
+  participant->destroy_reader(reader);
+  return reported_cap && reported_match && dropped > 0 && lost == 0 ? 0 : 6;
+}
