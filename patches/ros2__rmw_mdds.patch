+// ---- introspection fixtures ------------------------------------------------
+
+template<typename T>
+size_t vec_size(const void * field)
+{
+  return static_cast<const std::vector<T> *>(field)->size();
+}
+
+template<typename T>
+const void * vec_get_const(const void * field, size_t index)
+{
+  return &(*static_cast<const std::vector<T> *>(field))[index];
+}
+
+template<typename T>
+void * vec_get(void * field, size_t index)
+{
+  return &(*static_cast<std::vector<T> *>(field))[index];
+}
+
+template<typename T>
+void vec_resize(void * field, size_t size)
+{
+  static_cast<std::vector<T> *>(field)->resize(size);
+}
+
+MessageMember scalar_member(const char * name, uint8_t type_id, uint32_t offset)
+{
+  MessageMember member{};
+  member.name_ = name;
+  member.type_id_ = type_id;
+  member.offset_ = offset;
+  return member;
+}
+
+MessageMember string_member(const char * name, uint32_t offset, size_t bound)
+{
+  MessageMember member = scalar_member(name, kString, offset);
+  member.string_upper_bound_ = bound;
+  return member;
+}
+
+MessageMember wstring_member(const char * name, uint32_t offset, size_t bound)
+{
+  MessageMember member = scalar_member(name, kWString, offset);
+  member.string_upper_bound_ = bound;
+  return member;
+}
+
+template<typename T>
+MessageMember sequence_member(const char * name, uint8_t type_id, uint32_t offset)
+{
+  MessageMember member = scalar_member(name, type_id, offset);
+  member.is_array_ = true;
+  member.size_function = &vec_size<T>;
+  member.get_const_function = &vec_get_const<T>;
+  member.get_function = &vec_get<T>;
+  member.resize_function = &vec_resize<T>;
+  return member;
+}
+
+MessageMember message_member(
+  const char * name, uint32_t offset, const rosidl_message_type_support_t * ts)
+{
+  MessageMember member = scalar_member(name, kMessage, offset);
+  member.members_ = ts;
+  return member;
+}
+
+template<typename T>
+MessageMember message_sequence_member(
+  const char * name, uint32_t offset, const rosidl_message_type_support_t * ts)
+{
+  MessageMember member = sequence_member<T>(name, kMessage, offset);
+  member.members_ = ts;
+  return member;
+}
+
+MessageMember fixed_array_member(
+  const char * name, uint8_t type_id, uint32_t offset, size_t size)
+{
+  MessageMember member = scalar_member(name, type_id, offset);
+  member.is_array_ = true;
+  member.array_size_ = size;
+  return member;
+}
+
+// size_of is the in-memory image of the generated struct; the decoded
+// allocation budget charges it per element of a message sequence.
+MessageMembers members_of(
+  const char * name, const MessageMember * fields, uint32_t count, size_t size_of)
+{
+  MessageMembers members{};
+  members.message_namespace_ = "test__msg";
+  members.message_name_ = name;
+  members.member_count_ = count;
+  members.size_of_ = size_of;
+  members.members_ = fields;
+  return members;
+}
