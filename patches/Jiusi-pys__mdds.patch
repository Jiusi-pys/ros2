+// Fixed metadata budget: at most kMaxPartials open partials per peer. The
+// (kMaxPartials+1)-th distinct sample is dropped and counted; completing a
+// partial frees its slot for a new sample.
+TEST(Reassembler, PartialCountCap)
+{
+  mdds::Reassembler reasm;
+  auto w = make_test_guid(0x31);
+  std::vector<uint8_t> out;
+  uint8_t b[100] = {};
+
+  constexpr size_t kCap = mdds::Reassembler::kMaxPartials;
+  for (uint64_t seq = 1; seq <= kCap; ++seq) {
+    EXPECT_FALSE(reasm.add_fragment(w, seq, 1000, 0, b, sizeof(b), out)) << seq;
+  }
+  EXPECT_EQ(reasm.pending_count(), kCap);
+  const uint64_t dropped_before = reasm.dropped_over_budget();
+
+  // Distinct sample kCap+1 cannot open a partial.
+  EXPECT_FALSE(reasm.add_fragment(w, kCap + 1, 1000, 0, b, sizeof(b), out));
+  EXPECT_EQ(reasm.pending_count(), kCap);
+  EXPECT_EQ(reasm.dropped_over_budget(), dropped_before + 1);
+
+  // Completing one partial frees its slot...
+  std::vector<uint8_t> tail(900, 0x02);
+  EXPECT_TRUE(reasm.add_fragment(w, 1, 1000, 100, tail.data(), tail.size(), out));
+  EXPECT_EQ(out.size(), 1000u);
+  EXPECT_EQ(reasm.pending_count(), kCap - 1);
+
+  // ...so a new distinct sample opens a partial again (false = incomplete).
+  EXPECT_FALSE(reasm.add_fragment(w, kCap + 1, 1000, 0, b, sizeof(b), out));
+  EXPECT_EQ(reasm.pending_count(), kCap);
+}
