+// limitations under the License.
+
+#ifndef RMW__GET_TOPIC_ENDPOINT_INFO_H_
+#define RMW__GET_TOPIC_ENDPOINT_INFO_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include "rmw/topic_endpoint_info_array.h"
+#include "rmw/visibility_control.h"
+
+/// 检索指定主题的每个已知发布端点信息。
+/**
+ * 此函数返回由指定节点当前发现的、指定主题的每个发布端点信息数组。
+ * 端点信息包括发布端的节点名称和命名空间、关联的主题类型、发布端的 gid，以及发布端的 QoS 配置文件。
+ * 允许使用不存在的主题名称，此时将返回空数组。
+ *
+ * 根据所使用的 RMW 实现，发现过程可能是异步的。因此，创建发布端后立即调用此 API 可能不会立即显示新创建的发布端。
+ *
+ * \par 可正确读取的 QoS
+ * 返回的 QoS 配置文件可能包含某些无效字段。
+ * rmw 实现必须将无效字段设置为 `RMW_QOS_POLICY_*_UNKNOWN`。
+ * 对于基于 DDS 的实现，在发现过程中保证共享的 QoS 策略仅包括参与端点匹配的那些。
+ * 在当前可用的 QoS 设置中，基于 DDS 的实现不会共享 `history` 和 `history_depth`。
+ *
+ * <hr>
+ * Attribute          | Adherence
+ * ------------------ | -------------
+ * Allocates Memory   | Yes
+ * Thread-Safe        | Yes
+ * Uses Atomics       | Maybe [1]
+ * Lock-Free          | Maybe [1]
+ * <i>[1] rmw implementation defined, check the implementation documentation</i>
+ *
+ * \par 运行时行为
+ *   查询 ROS 图是一个同步操作。
+ *   它也是非阻塞的，但不保证无锁。
+ *   一般而言，实现可以使用锁来同步对内部资源的访问，但不得等待没有保证时间上限的事件（因操作系统调度导致饥饿的情况除外）。
+ *
+ * \par 线程安全
+ *   节点是线程安全对象，除终结（finalization）外，对节点的所有操作都是线程安全的。
+ *   因此，使用同一节点并发查询 ROS 图是安全的。
+ *   但是，在查询主题名称和类型时：
+ *   - 对主题端点信息数组的访问不是同步的。
+ *     在 rmw_get_publishers_info_by_topic() 使用 `publishers_info` 期间，读取或写入它是不安全的。
+ *   - 对 C 风格字符串参数的访问是只读的，但不是同步的。
+ *     并发读取 `topic_name` 是安全的，但并发读写是不安全的。
+ *   - 默认分配器是线程安全对象，但任何自定义 `allocator` 可能不是。
+ *     请查阅 allocator 文档以获取更多参考。
+ *
+ * \pre 给定的 `node` 必须是有效的节点句柄，由 rmw_create_node() 返回。
+ * \pre 给定的 `publishers_info` 必须是零初始化的端点信息数组，
+ *   由 rmw_get_zero_initialized_topic_endpoint_info_array() 返回。
+ *
+ * \param[in] node 用于查询 ROS 图的节点。
+ * \param[in] allocator 用于填充 `publishers_info` 数组的分配器。
+ * \param[in] topic_name 用于查找发布端的主题名称，通常是完整限定主题名称，但也不一定（参见 rmw_create_publisher()）。
+ * \param[in] no_mangle 在查找发布端之前是否不对主题名称进行改写（mangle）。
+ * \param[out] publishers_info 发布端信息数组，成功时填充，失败时保持不变。
+ *   如果已填充，调用者稍后需要负责终结此数组，
+ *   使用 rmw_topic_endpoint_info_array_fini()。
+ *   信息数组中的 QoS 配置文件将对无限持续时间使用 RMW_DURATION_INFINITE，
+ *   以避免暴露任何实现相关的值。
+ * \return 查询成功时返回 `RMW_RET_OK`，或
+ * \return `node` 为 NULL 时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `allocator` 无效时返回 `RMW_RET_INVALID_ARGUMENT`，
+ *   以 rcutils_allocator_is_valid() 的定义为准，或
+ * \return `topic_name` 为 NULL 时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `publishers_info` 为 NULL 时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `publishers_info` 不是零初始化数组时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `node` 实现标识符与此实现不匹配时返回 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，或
+ * \return 内存分配失败时返回 `RMW_RET_BAD_ALLOC`，或
+ * \return 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_get_publishers_info_by_topic(
+  const rmw_node_t * node,
+  rcutils_allocator_t * allocator,
+  const char * topic_name,
+  bool no_mangle,
+  rmw_topic_endpoint_info_array_t * publishers_info);
+
+/// 检索指定主题的每个已知订阅端点信息。
+/**
+ * 此函数返回由指定节点当前发现的、指定主题的每个订阅端点信息数组。
+ * 端点信息包括订阅端的节点名称和命名空间、关联的主题类型、订阅端的 gid，以及订阅端的 QoS 配置文件。
+ * 允许使用不存在的主题名称，此时将返回空数组。
+ *
+ * 根据所使用的 RMW 实现，发现过程可能是异步的。因此，创建订阅端后立即调用此 API 可能不会立即显示新创建的订阅端。
+ *
+ * \par 可正确读取的 QoS
+ * 并非所有 QoS 都能正确读取，详见 \sa rmw_get_publishers_info_by_topic()。
+ *
+ * <hr>
+ * Attribute          | Adherence
+ * ------------------ | -------------
+ * Allocates Memory   | Yes
+ * Thread-Safe        | Yes
+ * Uses Atomics       | Maybe [1]
+ * Lock-Free          | Maybe [1]
+ * <i>[1] rmw implementation defined, check the implementation documentation</i>
+ *
+ * \par 运行时行为
+ *   查询 ROS 图是一个同步操作。
+ *   它也是非阻塞的，但不保证无锁。
+ *   一般而言，实现可以使用锁来同步对内部资源的访问，但不得等待没有保证时间上限的事件（因操作系统调度导致饥饿的情况除外）。
+ *
+ * \par 线程安全
+ *   节点是线程安全对象，除终结（finalization）外，对节点的所有操作都是线程安全的。
+ *   因此，使用同一节点并发查询 ROS 图是安全的。
+ *   但是，在查询订阅端信息时：
+ *   - 对主题端点信息数组的访问不是同步的。
+ *     在 rmw_get_subscriptions_info_by_topic() 使用 `subscriptions_info` 期间，读取或写入它是不安全的。
+ *   - 默认分配器是线程安全对象，但任何自定义 `allocator` 可能不是。
+ *     请查阅 allocator 文档以获取更多参考。
+ *
+ * \pre 给定的 `node` 必须是有效的节点句柄，由 rmw_create_node() 返回。
+ * \pre 给定的 `subscriptions_info` 必须是零初始化的端点信息数组，
+ *   由 rmw_get_zero_initialized_topic_endpoint_info_array() 返回。
+ *
+ * \param[in] node 用于查询 ROS 图的节点。
+ * \param[in] allocator 用于填充 `subscriptions_info` 数组的分配器。
+ * \param[in] topic_name 用于查找订阅端的主题名称，通常是完整限定主题名称，但也不一定（参见 rmw_create_subscription()）。
+ * \param[in] no_mangle 在查找订阅端之前是否不对主题名称进行改写（mangle）。
+ * \param[out] subscriptions_info 订阅端信息数组，成功时填充，失败时保持不变。
+ *   如果已填充，调用者稍后需要负责终结此数组，
+ *   使用 rmw_topic_endpoint_info_array_fini()。
+ *   信息数组中的 QoS 配置文件将对无限持续时间使用 RMW_DURATION_INFINITE，
+ *   以避免暴露任何实现相关的值。
+ * \return 查询成功时返回 `RMW_RET_OK`，或
+ * \return `node` 为 NULL 时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `allocator` 无效时返回 `RMW_RET_INVALID_ARGUMENT`，
+ *   以 rcutils_allocator_is_valid() 的定义为准，或
+ * \return `topic_name` 为 NULL 时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `subscriptions_info` 为 NULL 时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `subscriptions_info` 不是零初始化数组时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \return `node` 实现标识符与此实现不匹配时返回 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，或
+ * \return 内存分配失败时返回 `RMW_RET_BAD_ALLOC`，或
+ * \return 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_get_subscriptions_info_by_topic(
+  const rmw_node_t * node,
+  rcutils_allocator_t * allocator,
+  const char * topic_name,
+  bool no_mangle,
+  rmw_topic_endpoint_info_array_t * subscriptions_info);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__GET_TOPIC_ENDPOINT_INFO_H_
