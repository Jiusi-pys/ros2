+std::vector<uint8_t> encode_session_challenge(
+  const Guid & challenger_participant, const Guid & nonce)
+{
+  if (!participant_guid_valid(challenger_participant) || nonce.is_zero()) {
+    return {};
+  }
+  std::vector<uint8_t> out(kHeaderSize + kSessionChallengeBodySize);
+  encode_header(out.data(), FrameType::SESSION_CHALLENGE, 0,
+                kSessionChallengeBodySize);
+  uint8_t * body = out.data() + kHeaderSize;
+  put_guid(body, challenger_participant);
+  put_guid(body + 16, nonce);
+  return out;
+}
+
+bool decode_session_challenge(
+  const uint8_t * buf, size_t len, SessionChallengeBody & out)
+{
+  FrameHeader hdr;
+  if (!decode_header(buf, len, hdr) || hdr.type != FrameType::SESSION_CHALLENGE ||
+      hdr.flags != 0 || hdr.body_len != kSessionChallengeBodySize) {
+    return false;
+  }
+  const uint8_t * body = buf + kHeaderSize;
+  get_guid(body, out.challenger_participant);
+  get_guid(body + 16, out.nonce);
+  return participant_guid_valid(out.challenger_participant) && !out.nonce.is_zero();
+}
