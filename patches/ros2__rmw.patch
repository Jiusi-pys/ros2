+/// 使用 rcutils 默认分配器的 allocate() 按指定字节数分配内存
+/**
+ * \param[in] size 要分配的字节数
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void *
+rmw_allocate(size_t size);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放内存
+/**
+ * \param[in] pointer 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_free(void * pointer);
+
+/// 使用 rcutils 默认分配器的 allocate() 为 `rmw_node_t` 分配内存
+/**
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+rmw_node_t *
+rmw_node_allocate(void);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放分配给该节点指针的内存
+/**
+ * \param[in] node 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_node_free(rmw_node_t * node);
+
+/// 使用 rcutils 默认分配器的 allocate() 为 `rmw_publisher_t` 分配内存
+/**
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+rmw_publisher_t *
+rmw_publisher_allocate(void);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放内存
+/**
+ * \param[in] publisher 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_publisher_free(rmw_publisher_t * publisher);
+
+/// 使用 rcutils 默认分配器的 allocate() 为 `rmw_subscription_t` 分配内存
+/**
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+rmw_subscription_t *
+rmw_subscription_allocate(void);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放内存
+/**
+ * \param[in] subscription 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_subscription_free(rmw_subscription_t * subscription);
+
+/// 使用 rcutils 默认分配器的 allocate() 为 `rmw_guard_condition_t` 分配内存
+/**
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+rmw_guard_condition_t *
+rmw_guard_condition_allocate(void);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放内存
+/**
+ * \param[in] guard_condition 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_guard_condition_free(rmw_guard_condition_t * guard_condition);
+
+/// 使用 rcutils 默认分配器的 allocate() 为 `rmw_client_t` 分配内存
+/**
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+rmw_client_t *
+rmw_client_allocate(void);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放内存
+/**
+ * \param[in] client 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_client_free(rmw_client_t * client);
+
+/// 使用 rcutils 默认分配器的 allocate() 为 `rmw_service_t` 分配内存
+/**
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+rmw_service_t *
+rmw_service_allocate(void);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放内存
+/**
+ * \param[in] service 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_service_free(rmw_service_t * service);
+
+/// 使用 rcutils 默认分配器的 allocate() 为 `rmw_wait_set_t` 分配内存
+/**
+ * \return 指向已分配内存的指针
+ */
+RMW_PUBLIC
+rmw_wait_set_t *
+rmw_wait_set_allocate(void);
+
+/// 使用 rcutils 默认分配器的 deallocate() 释放内存
+/**
+ * \param[in] wait_set 指向已分配内存的指针
+ */
+RMW_PUBLIC
+void
+rmw_wait_set_free(rmw_wait_set_t * wait_set);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__ALLOCATORS_H_
