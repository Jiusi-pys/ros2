+struct FakeStats
+{
+  std::atomic<size_t> writer_creates{0};
+  std::atomic<size_t> reader_creates{0};
+  std::atomic<size_t> writer_destroys{0};
+  std::atomic<size_t> reader_destroys{0};
+  std::atomic<size_t> mdds_writes{0};
+  std::atomic<size_t> mdds_takes{0};
+};
