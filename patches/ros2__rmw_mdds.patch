+        // Keep this context allocated rather than letting the worker unwind
+        // through a C++ thread or delete it without the required drain.
+        std::fprintf(stderr,
+          "[rmw_mdds] deferred context finalization leaked after teardown failure\n");
+      }
+    }
+  }
