+// A full permanent ledger never evicts a canonical endpoint identity. A fresh
+// GUID remains rejected after the active snapshot omits the old endpoint, while
+// a canonical refresh of the retained GUID can still recover normally.
+TEST(DiscoveryAdmission,
+     EndpointIdentityLedgerRejectsFreshGuidAfterCanonicalOmission) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_endpoint_qos_history = 1;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  std::atomic<size_t> graph_callbacks{0};
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  target->set_graph_callback(
+      [&] { graph_callbacks.fetch_add(1, std::memory_order_relaxed); });
+  const auto admitted = raw_remote_snapshot(
+      0x47, {raw_remote_endpoint(0x47, mdds::EntityKind::WRITER, 1,
+                                 "/qos_ledger_cap", "test/QosLedger")});
+  const mdds::Guid admitted_guid = admitted.endpoints.front().guid;
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, admitted, 1));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return target->graph_counts().remote_participants == 1 &&
+               graph_callbacks.load(std::memory_order_relaxed) >= 1;
+      },
+      2s, 10ms));
+  const size_t graph_before_rejection =
+      graph_callbacks.load(std::memory_order_relaxed);
+
+  const auto fresh = raw_remote_snapshot(
+      0x48, {raw_remote_endpoint(0x48, mdds::EntityKind::WRITER, 1,
+                                 "/qos_ledger_cap", "test/QosLedger")});
+  std::vector<uint8_t> fresh_frame;
+  ASSERT_TRUE(prepare_raw_announce_frame(peer, cfg.domain_id, kTestBasePort5,
+                                         fresh, 2, fresh_frame));
+  mdds::ParticipantSnapshot decoded_fresh;
+  uint64_t decoded_seq = 0;
+  ASSERT_TRUE(mdds::decode_announce(fresh_frame.data(), fresh_frame.size(),
+                                    decoded_fresh, decoded_seq));
+  EXPECT_EQ(decoded_seq, 2u);
+  ASSERT_EQ(decoded_fresh.endpoints.size(), 1u);
+  EXPECT_NE(decoded_fresh.endpoints.front().guid, admitted_guid);
+
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(fresh_frame, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  const auto after_rejection = target->remote_participants();
+  ASSERT_EQ(after_rejection.size(), 1u);
+  ASSERT_EQ(after_rejection.front().endpoints.size(), 1u);
+  EXPECT_EQ(after_rejection.front().endpoints.front().guid, admitted_guid);
+  EXPECT_EQ(graph_callbacks.load(std::memory_order_relaxed),
+            graph_before_rejection);
+
+  // Omit A from the prospective graph. Its identity remains in the permanent
+  // ledger, so B must remain rejected rather than reclaiming an inactive slot.
+  const auto omitted = raw_remote_snapshot(0x47, {});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, omitted, 2));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        const auto remotes = target->remote_participants();
+        return remotes.size() == 1 && remotes.front().endpoints.empty();
+      },
+      2s, 10ms));
+
+  // Reuse B's rejected seq=2 after A's omission. Rejection must remain
+  // side-effect-free: B is never admitted and cannot consume an identity slot.
+  ASSERT_TRUE(peer.send_frame(fresh_frame, kTestBasePort5));
+  const auto second_reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < second_reject_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(fresh_frame, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  const auto after_second_rejection = target->remote_participants();
+  ASSERT_EQ(after_second_rejection.size(), 1u);
+  EXPECT_EQ(after_second_rejection.front().participant_guid,
+            admitted.participant_guid);
+  EXPECT_TRUE(after_second_rejection.front().endpoints.empty());
+
+  // The retained canonical identity, unlike B, still has a legal recovery
+  // path. Reusing no rejected sequence is required: A accepted its omission
+  // at seq=2, so the refresh advances to seq=3.
+  auto recovered = admitted;
+  recovered.nodes.push_back({"/", "ledger_cap_recovery"});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, recovered, 3));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        const auto remotes = target->remote_participants();
+        return remotes.size() == 1 && remotes.front().endpoints.size() == 1 &&
+               remotes.front().endpoints.front().guid == admitted_guid &&
+               remotes.front().nodes.size() == 1 &&
+               remotes.front().nodes.front().name == "ledger_cap_recovery";
+      },
+      2s, 10ms));
+}
