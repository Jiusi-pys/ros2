+TEST_F(DsoftbusTransportFakeTest,
+       ConcurrentStopCancelsHeldListenAndLeavesRegistryRestartable) {
+  // start() has entered STARTING and is parked inside the fake Listen(). A
+  // concurrent stop must request cancellation, wait for that starter to close
+  // the pre-registration listen fd, then leave the process-wide registry
+  // immediately usable by a replacement transport.
+  constexpr int32_t kFirstListenFd = 100;
+  fake().hold_listen_until_released();
+  RecordingListener first_listener;
+  auto first = mdds::make_dsoftbus_transport();
+  std::atomic<bool> start_done{false};
+  std::atomic<bool> stop_done{false};
+  bool start_result = true;
+
+  std::thread starter([&] {
+    start_result = first->start(config(), &first_listener);
+    start_done.store(true, std::memory_order_release);
+  });
+  if (!fake().wait_for_listen_started()) {
+    fake().release_listen();
+    starter.join();
+    ADD_FAILURE() << "start() did not reach the deterministic Listen barrier";
+    return;
+  }
+
+  std::thread stopper([&] {
+    first->stop();
+    stop_done.store(true, std::memory_order_release);
+  });
+  const bool cancellation_observed = wait_until([&] {
+    return first->status().detail.find("start_cancel_requested=1") !=
+           std::string::npos;
+  });
+  if (!cancellation_observed) {
+    fake().release_listen();
+    starter.join();
+    stopper.join();
+    ADD_FAILURE() << "concurrent stop() did not cancel STARTING";
+    return;
+  }
+  EXPECT_FALSE(start_done.load(std::memory_order_acquire));
+  EXPECT_FALSE(stop_done.load(std::memory_order_acquire));
+
+  // The first starter still owns the pre-registration service-plane socket.
+  // A different context must fail closed instead of opening a same-name
+  // session before cancellation cleanup has closed that fd.
+  RecordingListener replacement_listener;
+  auto replacement = mdds::make_dsoftbus_transport();
+  EXPECT_FALSE(replacement->start(config(), &replacement_listener));
+  EXPECT_NE(replacement->last_error().find("startup transaction busy"),
+            std::string::npos);
+
+  fake().release_listen();
+  starter.join();
+  stopper.join();
+  EXPECT_FALSE(start_result);
+  EXPECT_TRUE(start_done.load(std::memory_order_acquire));
+  EXPECT_TRUE(stop_done.load(std::memory_order_acquire));
+  EXPECT_FALSE(first->status().running);
+  EXPECT_EQ(fake().shutdown_count(kFirstListenFd), 1u);
+
+  // This is the restart assertion: after the cancelled transaction has
+  // retired its fd, the same previously rejected context can start normally.
+  ASSERT_TRUE(replacement->start(config(), &replacement_listener));
+  replacement->stop();
+}
+
+TEST_F(DsoftbusTransportFakeTest,
+       ExternalStopOwnerMayRaceWithDispatchCallbackDestroyingHandle) {
+  // Regression for the stop-owner/self-drainer interleave:
+  //
+  //   A: stop() becomes the cleanup owner and waits for this OnBind frame.
+  //   B: the frame's listener callback calls stop(); reset().
+  //
+  // B cannot wait for A (A needs B to unwind), but A must still retain the
+  // engine after B deletes the public unique_ptr-facing Transport handle.
+  // Before the shared engine/pinned DispatchFrame fix, A resumed after B's
+  // Release(true) and dereferenced the freed DsoftbusTransport object.
+  constexpr int32_t kPeerFd = 304;
+  std::mutex gate_mutex;
+  std::condition_variable gate_cv;
+  bool callback_entered = false;
+  bool release_callback = false;
+  std::atomic<bool> owner_done{false};
+
+  RecordingListener listener;
+  auto transport = mdds::make_dsoftbus_transport();
+  listener.set_on_up_hook([&] {
+    {
+      std::unique_lock<std::mutex> lock(gate_mutex);
+      callback_entered = true;
+      gate_cv.notify_all();
+      gate_cv.wait(lock, [&] { return release_callback; });
+    }
+    transport->stop();
+    transport.reset();
+  });
+  ASSERT_TRUE(transport->start(config(), &listener));
+  ASSERT_TRUE(fake().wait_for_listener());
+
+  std::thread dispatch([&] { emit_bind(kPeerFd, "fake-stop-owner-race"); });
+  {
+    std::unique_lock<std::mutex> lock(gate_mutex);
+    if (!gate_cv.wait_for(lock, 2s, [&] { return callback_entered; })) {
+      release_callback = true;
+      gate_cv.notify_all();
+      lock.unlock();
+      dispatch.join();
+      ADD_FAILURE() << "OnBind callback did not enter the teardown gate";
+      return;
+    }
+  }
+
+  // The callback is now pinned but cannot destroy the handle.  Make the
+  // external caller the single-flight owner, then observe STOPPING before the
+  // callback is released.  State::STOPPING is deliberately reported as 2.
+  mdds::Transport *const raw = transport.get();
+  std::thread owner([&] {
+    raw->stop();
+    owner_done.store(true, std::memory_order_release);
+    gate_cv.notify_all();
+  });
+  bool owner_waiting = false;
+  for (size_t i = 0; i < 200; ++i) {
+    if (transport->status().detail.find("state=2") != std::string::npos) {
+      owner_waiting = true;
+      break;
+    }
+    std::this_thread::sleep_for(5ms);
+  }
+  if (!owner_waiting) {
+    // The two threads deliberately cannot be joined safely while the callback
+    // remains parked.  Abort this isolated gtest process rather than detach a
+    // live teardown thread and contaminate the next test.
+    ADD_FAILURE() << "external stop owner never reached STOPPING";
+    std::abort();
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(gate_mutex);
+    release_callback = true;
+  }
+  gate_cv.notify_all();
+  dispatch.join();
+
+  {
+    std::unique_lock<std::mutex> lock(gate_mutex);
+    if (!gate_cv.wait_for(lock, 2s, [&] {
+          return owner_done.load(std::memory_order_acquire);
+        })) {
+      // See the note above: a stuck cleanup owner is a process-level test
+      // failure, never a reason to leave a detached thread alive.
+      ADD_FAILURE() << "external cleanup owner did not return";
+      std::abort();
+    }
+  }
+  owner.join();
+  EXPECT_EQ(transport, nullptr);
+}
+
+TEST_F(DsoftbusTransportFakeTest,
+       ConcurrentSecondStopWaitsForFirstOwnerPollJoin) {
+  // Park the poll worker inside BindAsync(). The first stop moves the only
+  // joinable poll thread handle under state_mutex_ and blocks joining its local
+  // copy. A second external stop must wait for that owner; it must neither
+  // inspect the moved-from member nor race a second join/detach.
+  fake().set_online_nodes({"fake-second-stop-join"});
+  fake().hold_then_synchronously_bind();
+  RecordingListener listener;
+  auto transport = mdds::make_dsoftbus_transport();
+  ASSERT_TRUE(transport->start(config(), &listener));
+  ASSERT_TRUE(fake().wait_for_bind_started());
+
+  std::atomic<bool> first_stop_done{false};
+  std::atomic<bool> second_stop_entered{false};
+  std::atomic<bool> second_stop_done{false};
+  std::thread first_stopper([&] {
+    transport->stop();
+    first_stop_done.store(true, std::memory_order_release);
+  });
+  const bool first_owner_waiting = wait_until([&] {
+    return transport->status().detail.find("state=2") != std::string::npos;
+  });
+  if (!first_owner_waiting) {
+    fake().release_bind_callbacks();
+    first_stopper.join();
+    ADD_FAILURE() << "first stop() did not become the STOPPING owner";
+    return;
+  }
+
+  std::thread second_stopper([&] {
+    second_stop_entered.store(true, std::memory_order_release);
+    transport->stop();
+    second_stop_done.store(true, std::memory_order_release);
+  });
+  if (!wait_until([&] {
+        return second_stop_entered.load(std::memory_order_acquire);
+      })) {
+    fake().release_bind_callbacks();
+    first_stopper.join();
+    second_stopper.join();
+    ADD_FAILURE() << "second stop() thread did not start";
+    return;
+  }
+
+  // This is a state-lock observable, not a timing window: the second stopper
+  // has entered STOPPING and is blocked on the owner's state_cv_ completion,
+  // while BindAsync still keeps that owner in its local poll-thread join.
+  const bool second_waiting = wait_until([&] {
+    return transport->status().detail.find("stop_waiters=1") !=
+           std::string::npos;
+  });
+  if (!second_waiting) {
+    fake().release_bind_callbacks();
+    first_stopper.join();
+    second_stopper.join();
+    ADD_FAILURE() << "second stop() did not wait for the cleanup owner";
+    return;
+  }
+  EXPECT_FALSE(first_stop_done.load(std::memory_order_acquire));
+  EXPECT_FALSE(second_stop_done.load(std::memory_order_acquire));
+
+  fake().release_bind_callbacks();
+  first_stopper.join();
+  second_stopper.join();
+  EXPECT_TRUE(first_stop_done.load(std::memory_order_acquire));
+  EXPECT_TRUE(second_stop_done.load(std::memory_order_acquire));
+  EXPECT_FALSE(transport->status().running);
+}
+
+TEST_F(DsoftbusTransportFakeTest,
+       SynchronousPollBindCallbackMayStopAndDestroyTransport) {
+  // Hold BindAsync until start() has returned, then complete it synchronously
