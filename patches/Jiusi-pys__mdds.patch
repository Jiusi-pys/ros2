+// Replacing one remote snapshot must subtract its old charges before adding
+// the new ones. A rejected oversized snapshot is completely invisible, and a
+// later valid replacement still works under the same one-node/one-endpoint
+// and aggregate-byte caps.
+TEST(DiscoveryAdmission, SnapshotChurnRejectsOverLimitWithoutPartialReplace) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_participants = 1;
+  cfg.max_remote_participants_per_peer = 1;
+  cfg.max_remote_nodes_per_participant = 1;
+  cfg.max_remote_nodes_total = 1;
+  cfg.max_remote_endpoints_per_participant = 1;
+  cfg.max_remote_endpoints_total = 1;
+  cfg.max_remote_snapshot_bytes_per_participant = 512;
+  cfg.max_remote_snapshot_bytes_total = 512;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+
+  const auto make_snapshot = [](const std::string &topic,
+                                std::vector<mdds::NodeInfo> nodes) {
+    return raw_remote_snapshot(
+        0x21, {raw_remote_endpoint(0x21, mdds::EntityKind::WRITER, 1, topic,
+                                    "test/Churn")},
+        std::move(nodes));
+  };
+  auto current = make_snapshot("/churn-1", {{"/ns", "n1"}});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, current, 1));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    const auto remotes = target->remote_participants();
+    return remotes.size() == 1 && remotes.front().endpoints.size() == 1 &&
+           remotes.front().endpoints.front().topic == "/churn-1";
+  }, 2s, 10ms));
+
+  for (uint64_t seq = 2; seq <= 8; ++seq) {
+    const std::string topic = "/churn-" + std::to_string(seq);
+    current = make_snapshot(topic, {{"/ns", "n" + std::to_string(seq)}});
+    ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, current,
+                             seq));
+    ASSERT_TRUE(wait_until([&] {
+      peer.send_presence(cfg.domain_id, kTestBasePort5);
+      const auto remotes = target->remote_participants();
+      return remotes.size() == 1 &&
+             remotes.front().endpoints.front().topic == topic;
+    }, 2s, 10ms)) << topic;
+  }
+
+  const std::string last_valid_topic = current.endpoints.front().topic;
+  auto too_many_nodes = make_snapshot(
+      "/over-nodes", {{"/ns", "first"}, {"/ns", "second"}});
+  ASSERT_TRUE(
+      raw_announce(peer, cfg.domain_id, kTestBasePort5, too_many_nodes, 9));
+  const std::string huge_topic(600, 'x');
+  auto too_many_bytes = make_snapshot(huge_topic, {{"/ns", "one"}});
+  ASSERT_TRUE(
+      raw_announce(peer, cfg.domain_id, kTestBasePort5, too_many_bytes, 10));
+  // Both malformed-under-policy frames were queued behind known-good UDP
+  // frames from the same source. Keep the peer live long enough to process
+  // them before inspecting the old snapshot.
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  auto remotes = target->remote_participants();
+  ASSERT_EQ(remotes.size(), 1u);
+  ASSERT_EQ(remotes.front().nodes.size(), 1u);
+  ASSERT_EQ(remotes.front().endpoints.size(), 1u);
+  EXPECT_EQ(remotes.front().endpoints.front().topic, last_valid_topic);
+
+  const auto recovered = make_snapshot("/recovered", {{"/ns", "ok"}});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, recovered,
+                           11));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    const auto after = target->remote_participants();
+    return after.size() == 1 &&
+           after.front().endpoints.front().topic == "/recovered";
+  }, 2s, 10ms));
+}
+
+// Exercise the real UDP ingress boundary rather than only decode_announce().
+// An old raw ANNOUNCE from a second route may be well formed but disagree with
+// the admitted snapshot.  It must not replace discovery state merely because
+// its sender can reach the UDP port.
+TEST(DiscoveryAdmission, RawStaleAnnounceCannotReplaceAdmittedSnapshot) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_participants = 1;
+  cfg.max_remote_participants_per_peer = 1;
+  cfg.max_remote_routes_per_participant = 2;
+  // Keep raw source ports outside the participant's [base, base + count)
+  // receive pool, so the hostile senders cannot collide with the target.
+  RawUdpPeer admitted_peer(kTestBasePort5 + 8);
+  RawUdpPeer stale_peer(kTestBasePort5 + 9);
+  ASSERT_TRUE(admitted_peer.valid());
+  ASSERT_TRUE(stale_peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+
+  const auto admitted = raw_remote_snapshot(
+      0x41, {raw_remote_endpoint(0x41, mdds::EntityKind::WRITER, 1,
+                                  "/admitted", "test/RawAnnounce")});
+  ASSERT_TRUE(
+      raw_announce(admitted_peer, cfg.domain_id, kTestBasePort5, admitted, 2));
+  ASSERT_TRUE(wait_until([&] {
+    admitted_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    const auto remotes = target->remote_participants();
+    return remotes.size() == 1 && remotes.front().endpoints.size() == 1 &&
+           remotes.front().endpoints.front().topic == "/admitted";
+  }, 2s, 10ms));
+
+  // This is deliberately an otherwise valid raw wire frame from another UDP
+  // source.  It uses an older sequence and a different snapshot; the handler
+  // must reject it before snapshot replacement.
+  const auto stale = raw_remote_snapshot(
+      0x41, {raw_remote_endpoint(0x41, mdds::EntityKind::WRITER, 1,
+                                  "/stale", "test/RawAnnounce")});
+  ASSERT_TRUE(stale_peer.send_presence(cfg.domain_id, kTestBasePort5));
+  ASSERT_TRUE(stale_peer.send_frame(mdds::encode_announce(stale, 1, 0),
+                                    kTestBasePort5));
+
+  // Re-inject the same otherwise valid stale frame while both UDP sources stay
+  // present. This gives the asynchronous transport callback many scheduling
+  // turns to consume the hostile raw ingress rather than treating one
+  // successful sendto() as proof that a receiver thread observed it. A
+  // rejected ANNOUNCE must leave the last admitted snapshot intact.
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(admitted_peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(stale_peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(stale_peer.send_frame(mdds::encode_announce(stale, 1, 0),
+                                      kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  const auto remotes = target->remote_participants();
+  ASSERT_EQ(remotes.size(), 1u);
+  ASSERT_EQ(remotes.front().endpoints.size(), 1u);
+  EXPECT_EQ(remotes.front().endpoints.front().topic, "/admitted");
+
+  // Rejection is not a poisoned sequence state: a newer valid raw ANNOUNCE
+  // from the same peer can still replace the snapshot normally.
+  const auto recovered = raw_remote_snapshot(
+      0x41, {raw_remote_endpoint(0x41, mdds::EntityKind::WRITER, 1,
+                                  "/recovered", "test/RawAnnounce")});
+  ASSERT_TRUE(raw_announce(admitted_peer, cfg.domain_id, kTestBasePort5,
+                           recovered, 3));
+  ASSERT_TRUE(wait_until([&] {
+    admitted_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    const auto after = target->remote_participants();
+    return after.size() == 1 && after.front().endpoints.size() == 1 &&
+           after.front().endpoints.front().topic == "/recovered";
+  }, 2s, 10ms));
+}
+
+// Exercise the real raw UDP ingress boundary with a fresh-sequence malformed
+// ANNOUNCE.  The prior stale-frame test covers sequence/route admission; this
+// one proves an invalid QoS enum cannot bypass strict RxO/reliability gates by
+// replacing a previously admitted snapshot.
+TEST(DiscoveryAdmission, RawMalformedQosAnnounceCannotReplaceAdmittedSnapshot) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_participants = 1;
+  cfg.max_remote_participants_per_peer = 1;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+
+  auto * reader = target->create_reader(
+      "/admitted", "test/RawMalformedQos", default_qos());
+  ASSERT_NE(reader, nullptr);
+  const auto admitted = raw_remote_snapshot(
+      0x42, {raw_remote_endpoint(0x42, mdds::EntityKind::WRITER, 1,
+                                  "/admitted", "test/RawMalformedQos")});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, admitted, 1));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    const auto remotes = target->remote_participants();
+    return remotes.size() == 1 && remotes.front().endpoints.size() == 1 &&
+           remotes.front().endpoints.front().topic == "/admitted" &&
+           reader->matched_count() == 1;
+  }, 2s, 10ms));
+
+  auto malformed = admitted;
+  malformed.endpoints.front().topic = "/malformed";
+  malformed.endpoints.front().qos.reliability =
+      static_cast<mdds::Reliability>(2);
+  const auto malformed_frame = mdds::encode_announce(malformed, 2, 0);
+  mdds::ParticipantSnapshot decoded;
+  uint64_t decoded_seq = 0;
+  EXPECT_FALSE(mdds::decode_announce(
+      malformed_frame.data(), malformed_frame.size(), decoded, decoded_seq));
+
+  // Keep the peer present and re-inject its newer malformed frame long enough
+  // for the transport callback to consume it.  The admitted state and match
+  // must remain intact; a raw sendto() alone is not proof of ingress handling.
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(malformed_frame, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  const auto remotes = target->remote_participants();
+  ASSERT_EQ(remotes.size(), 1u);
+  ASSERT_EQ(remotes.front().endpoints.size(), 1u);
+  EXPECT_EQ(remotes.front().endpoints.front().topic, "/admitted");
+  EXPECT_EQ(remotes.front().endpoints.front().qos.reliability,
+            mdds::Reliability::RELIABLE);
+  EXPECT_EQ(reader->matched_count(), 1u);
+
+  // Rejecting seq=2 must not poison the sequence state: a later valid
+  // replacement remains admissible.
+  const auto recovered = raw_remote_snapshot(
+      0x42, {raw_remote_endpoint(0x42, mdds::EntityKind::WRITER, 1,
+                                  "/recovered", "test/RawMalformedQos")});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, recovered, 3));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    const auto after = target->remote_participants();
+    return after.size() == 1 && after.front().endpoints.size() == 1 &&
+           after.front().endpoints.front().topic == "/recovered" &&
+           reader->matched_count() == 0;
+  }, 2s, 10ms));
+}
+
+// This is the ingress form of the zero-byte resource attack: an actual raw
+// UDP peer first establishes PING/presence, announces a matching writer, then
+// sends a sequence of valid zero-length DATA frames.  The byte budgets are
+// deliberately disabled here; sample accounting alone must cap the queue and
+// report drops rather than allocating an unbounded deque of empty vectors.
+TEST(DeliveryBudgetTest, RawZeroLengthDataFloodStaysWithinSampleBudget) {
+  auto cfg = raw_admission_config();
+  cfg.max_delivery_bytes_per_reader = 0;
+  cfg.max_delivery_bytes_total = 0;
+  cfg.max_delivery_samples_per_reader = 2;
+  cfg.max_delivery_samples_total = 2;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  auto qos = default_qos();
+  qos.history = mdds::History::KEEP_ALL;
+  auto *reader = target->create_reader("/raw_zero_budget", "test/RawZeroBudget", qos);
+  ASSERT_NE(reader, nullptr);
+  const auto remote = raw_remote_snapshot(
+      0x61, {raw_remote_endpoint(0x61, mdds::EntityKind::WRITER, 1,
+                                  "/raw_zero_budget", "test/RawZeroBudget")});
+  const mdds::Guid writer_guid = remote.endpoints.front().guid;
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, remote, 1));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return reader->matched_count() == 1;
+  }, 2s, 10ms));
+
+  for (uint64_t seq = 1; seq <= 8; ++seq) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(
+        mdds::encode_data(writer_guid, seq, 0, nullptr, 0,
+                          mdds::kFlagReliable),
+        kTestBasePort5));
+  }
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return reader->available() == 2 && reader->resource_limit_drops() >= 6;
+  }, 2s, 5ms));
+  EXPECT_EQ(reader->available(), 2u);
+  EXPECT_GE(reader->resource_limit_drops(), 6u);
+  EXPECT_GE(reader->messages_lost(), 6u);
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  size_t taken = 0;
+  while (reader->take(out, info)) {
+    EXPECT_TRUE(out.empty());
+    EXPECT_EQ(info.writer_guid, writer_guid);
+    ++taken;
+  }
+  EXPECT_EQ(taken, 2u);
+}
