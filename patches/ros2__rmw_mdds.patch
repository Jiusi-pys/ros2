+
+/// In-memory size of one sequence element of the given type, charged against
+/// the decoded allocation budget immediately before the resize: the exact
+/// value size for primitives, sizeof(std::string) /
+/// sizeof(rosidl_runtime_c__String) for strings (whichever ABI the
+/// introspection decodes into), including wstrings. MESSAGE elements never
+/// reach this helper: read_field_impl() charges the sub-message size_of_,
+/// the real per-element struct size, instead.
+inline size_t
+elem_alloc_size(uint8_t type_id, bool is_cpp)
+{
+  switch (type_id) {
+    case rosidl_typesupport_introspection_c__ROS_TYPE_BOOLEAN:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_OCTET:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT8:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_CHAR:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT8:
+      return 1;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_WCHAR:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT16:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT16:
+      return 2;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT32:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT32:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_FLOAT:
+      return 4;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT64:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT64:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_DOUBLE:
+      return 8;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_LONG_DOUBLE:
+      return sizeof(long double);
+    case rosidl_typesupport_introspection_c__ROS_TYPE_STRING:
+      return is_cpp ? sizeof(std::string) : sizeof(rosidl_runtime_c__String);
+    case rosidl_typesupport_introspection_c__ROS_TYPE_WSTRING:
+      return is_cpp ? sizeof(std::u16string) : sizeof(rosidl_runtime_c__U16String);
+    default:
+      return 1;
+  }
+}
+
+// Recursion guard for the minimum-wire-size helpers below: local type
+// metadata is acyclic by construction, so the cap only stops a corrupted
+// typesupport pointer from recursing forever.
+constexpr uint32_t kMaxTypeDepth = 64;
+
+template<typename MembersType>
+size_t
+packed_message_wire_size(const MembersType * members, uint32_t depth);
+
+/// Minimum wire bytes of one member, NOT counting alignment padding. CDR
+/// padding only ever adds bytes, so the packed size is the sound lower bound
+/// for a length-prefix check: an alignment-aware per-element size would
+/// overestimate consecutive sequence elements (their leading padding varies
+/// with the absolute stream offset) and could reject valid payloads.
+template<typename MembersType, typename MemberT>
+size_t
+packed_member_wire_size(const MemberT * member, uint32_t depth)
+{
+  const bool is_fixed_array =
+    member->is_array_ && member->array_size_ != 0 && !member->is_upper_bound_;
+  if (member->type_id_ == rosidl_typesupport_introspection_c__ROS_TYPE_MESSAGE) {
+    const auto * sub_members = static_cast<const MembersType *>(member->members_->data);
+    const size_t nested = packed_message_wire_size(sub_members, depth + 1);
+    if (!member->is_array_) {
+      return nested;
+    }
+    return is_fixed_array ? nested * member->array_size_ : 4;
+  }
+  if (!member->is_array_) {
+    return elem_min_wire_size(member->type_id_);
+  }
+  // Sequence members can be empty on the wire: just the 32-bit count.
+  return is_fixed_array ? elem_min_wire_size(member->type_id_) * member->array_size_ : 4;
+}
+
+template<typename MembersType>
+size_t
+packed_message_wire_size(const MembersType * members, uint32_t depth)
+{
+  if (depth > kMaxTypeDepth) {
+    throw std::runtime_error("cdr: message type nesting too deep");
+  }
+  size_t total = 0;
+  for (uint32_t i = 0; i < members->member_count_; ++i) {
+    total += packed_member_wire_size<MembersType>(members->members_ + i, depth);
+  }
+  return total;
+}
+
+/// Minimum payload bytes one element of a sequence<MESSAGE> occupies on the
+/// wire, computed once per member (not per element). This is the true packed
+/// size — 0 for an empty message, in which case CdrReader::check_count()
+/// skips its remaining-bytes check and the decoded allocation budget alone
+/// bounds the element count.
+template<typename MembersType>
+size_t
+min_message_wire_size(const MembersType * members)
+{
+  return packed_message_wire_size(members, 0);
+}
+
+class CdrWriter
+{
+public:
+  explicit CdrWriter(std::vector<uint8_t> & out)
+  : out_(out)
+  {
+    out_.clear();
+    out_.resize(kHeaderSize, 0);
+    // representation id: PLAIN_CDR; options: 0
+    out_[1] = host_is_little_endian() ? 1 : 0;
+    pos_ = kHeaderSize;
+  }
+
+  void align(size_t a)
+  {
+    const size_t off = pos_ - kHeaderSize;
+    const size_t pad = (a - (off % a)) % a;
+    if (pad != 0) {
+      out_.insert(out_.end(), pad, 0);
+      pos_ += pad;
+    }
+  }
+
+  void put(const void * data, size_t n)
+  {
+    const uint8_t * bytes = static_cast<const uint8_t *>(data);
+    out_.insert(out_.end(), bytes, bytes + n);
+    pos_ += n;
+  }
+
+  template<typename T>
+  void put_pod(const T & value)
+  {
+    align(cdr_align(sizeof(T)));
+    put(&value, sizeof(T));
+  }
+
+  void put_u32(uint32_t value)
+  {
+    put_pod(value);
+  }
+
+  void put_bool(bool value)
+  {
+    const uint8_t b = value ? 1 : 0;
+    put(&b, 1);
+  }
+
+  void put_string(const char * data, size_t size)
+  {
+    put_u32(static_cast<uint32_t>(size) + 1);
+    put(data, size);
+    const char nul = '\0';
+    put(&nul, 1);
+  }
+
+  void put_u16_string(const uint16_t * data, size_t size)
+  {
+    // legacy CDR: element count (no terminator), one 32-bit word per char
+    put_u32(static_cast<uint32_t>(size));
+    for (size_t i = 0; i < size; ++i) {
+      put_u32(static_cast<uint32_t>(data[i]));
+    }
+  }
+
+private:
+  std::vector<uint8_t> & out_;
+  size_t pos_ = 0;
+};
+
+class CdrReader
+{
+public:
+  CdrReader(const uint8_t * data, size_t size)
+  : data_(data), lim_(size), pos_(kHeaderSize)
+  {
+    if (size < kHeaderSize) {
+      throw std::runtime_error("cdr: payload smaller than encapsulation header");
+    }
+    // Strict encapsulation check: only legacy PLAIN_CDR (0x0000 BE /
+    // 0x0001 LE) is implemented — PLAIN_CDR2 / D_PLAIN / XCDR variants have
+    // different layouts and must be rejected instead of misdecoded.
+    if (data_[0] != 0 || data_[1] > 1) {
+      throw std::runtime_error("cdr: unsupported encapsulation (not PLAIN_CDR)");
+    }
+    const bool source_little = data_[1] == 1;
+    swap_bytes_ = source_little != host_is_little_endian();
+    // Decoded allocation budget: the total heap growth this one payload may
+    // drive. Decoded content normally tracks the payload size, so the budget
+    // scales with it, with a floor for tiny payloads and a hard cap. The
+    // per-count minimum-wire-width checks bound each single allocation; this
+    // budget bounds their SUM, which is what stops forged nested length
+    // prefixes from compounding (each level's allocation passes its own
+    // byte check while the total grows quadratically).
+    alloc_budget_ = kBudgetCap;
+    if (size < (kBudgetCap - kBudgetBase) / 8) {
+      alloc_budget_ = 8 * size + kBudgetBase;
+    }
+  }
+
+  void align(size_t a)
+  {
+    const size_t off = pos_ - kHeaderSize;
+    const size_t pad = (a - (off % a)) % a;
+    if (pad > lim_ - pos_) {
+      throw std::runtime_error("cdr: alignment padding overruns payload");
+    }
+    pos_ += pad;
+  }
+
+  template<typename T>
+  T get_pod()
+  {
+    align(cdr_align(sizeof(T)));
+    if (sizeof(T) > lim_ - pos_) {
+      throw std::runtime_error("cdr: payload truncated");
+    }
+    T value;
+    memcpy(&value, data_ + pos_, sizeof(T));
+    pos_ += sizeof(T);
+    if (swap_bytes_ && sizeof(T) > 1) {
+      uint8_t * bytes = reinterpret_cast<uint8_t *>(&value);
+      for (size_t i = 0; i < sizeof(T) / 2; ++i) {
+        const uint8_t tmp = bytes[i];
+        bytes[i] = bytes[sizeof(T) - 1 - i];
+        bytes[sizeof(T) - 1 - i] = tmp;
+      }
+    }
+    return value;
+  }
+
+  uint32_t get_u32()
+  {
+    return get_pod<uint32_t>();
+  }
+
+  bool get_bool()
+  {
+    return get_pod<uint8_t>() != 0;
+  }
+
+  /// Reject a wire element count that cannot fit in the remaining payload:
+  /// every counted item occupies at least elem_min_wire bytes. The division
+  /// form avoids a count * elem_min_wire overflow.
+  void check_count(size_t count, size_t elem_min_wire)
+  {
+    if (elem_min_wire > 0 && count > (lim_ - pos_) / elem_min_wire) {
+      throw std::runtime_error("cdr: element count overruns payload");
+    }
+  }
+
+  /// Charge a pending allocation of count * width bytes against the decoded
+  /// allocation budget (overflow-safe) and throw once it is exceeded.
+  void spend_budget(size_t count, size_t width)
+  {
+    if (width > 0 && count > alloc_budget_ / width) {
+      throw std::runtime_error("cdr: decoded allocation exceeds budget");
+    }
+    alloc_budget_ -= width > 0 ? count * width : 0;
+  }
+
+  size_t budget_remaining() const
+  {
+    return alloc_budget_;
+  }
+
+  void get_string(std::string & out, size_t bound = 0)
+  {
+    const uint32_t size = get_u32();
+    check_count(size, 1);
+    // IDL bound on the content length (the wire size includes the NUL
+    // terminator), enforced BEFORE anything is allocated for the string.
+    if (bound != 0 && size > 0 && size - 1 > bound) {
+      throw std::runtime_error("cdr: string exceeds its IDL bound");
+    }
+    if (size == 0) {
+      out.clear();
+      return;
+    }
+    if (data_[pos_ + size - 1] != '\0') {
+      throw std::runtime_error("cdr: string is not NUL-terminated");
+    }
+    // Decoding first materializes a temporary std::string, then read_single()
+    // assigns it into the generated C++/C field. Charge both independent
+    // allocations before either is made (the destination conservatively
+    // includes a terminator).
+    spend_budget(size - 1, 1);
+    spend_budget(size, 1);
+    out.assign(reinterpret_cast<const char *>(data_ + pos_), size - 1);
+    pos_ += size;
+  }
+
+  void get_u16_string(std::vector<uint16_t> & out, size_t bound = 0)
+  {
+    const uint32_t size = get_u32();
+    check_count(size, 4);
+    // IDL bound on the element count, enforced before the resize.
+    if (bound != 0 && size > bound) {
+      throw std::runtime_error("cdr: wstring exceeds its IDL bound");
+    }
+    // As with narrow strings, this vector is a temporary. The caller then
+    // assigns into std::u16string or rosidl_runtime_c__U16String, creating a
+    // second allocation. Charge both before resize()/assignn() so a valid wire
+    // payload cannot drive unbudgeted heap growth through a wide-string field.
+    spend_budget(size, sizeof(uint16_t));
+    spend_budget(size + 1, sizeof(uint16_t));
+    out.resize(size);
+    for (size_t i = 0; i < size; ++i) {
+      out[i] = static_cast<uint16_t>(get_u32());
+    }
+  }
+
+private:
+  static constexpr size_t kBudgetBase = 4u * 1024u * 1024u;    // 4 MiB
+  static constexpr size_t kBudgetCap = 256u * 1024u * 1024u;   // 256 MiB
+
+  const uint8_t * data_;
+  size_t lim_;
+  size_t pos_;
+  bool swap_bytes_;
+  size_t alloc_budget_ = 0;
+};
+
+inline bool
+resize_member(const rosidl_typesupport_introspection_c__MessageMember * member, void * field,
+  size_t size)
+{
+  if (member->resize_function == nullptr) {
+    return false;
+  }
+  return member->resize_function(field, size);
+}
+
+inline bool
+resize_member(const rosidl_typesupport_introspection_cpp::MessageMember * member, void * field,
+  size_t size)
+{
+  if (member->resize_function == nullptr) {
+    return false;
+  }
+  member->resize_function(field, size);
+  return true;
+}
+
+inline void
+assign_c_string(void * field, const std::string & value)
+{
+  auto * str = static_cast<rosidl_runtime_c__String *>(field);
+  if (!rosidl_runtime_c__String__assignn(str, value.data(), value.size())) {
+    throw std::runtime_error("failed to assign rosidl_runtime_c__String");
+  }
+}
+
+inline void
+assign_c_u16_string(void * field, const std::vector<uint16_t> & value)
+{
+  auto * str = static_cast<rosidl_runtime_c__U16String *>(field);
+  if (!rosidl_runtime_c__U16String__assignn(str, value.data(), value.size())) {
+    throw std::runtime_error("failed to assign rosidl_runtime_c__U16String");
+  }
+}
+
+template<typename MembersType>
+void
+write_members(CdrWriter & writer, const MembersType * members, const void * data);
+
+inline void
+write_single(
+  CdrWriter & writer, uint8_t type_id,
+  const void * field, bool is_cpp)
+{
+  switch (type_id) {
+    case rosidl_typesupport_introspection_c__ROS_TYPE_BOOLEAN:
+      writer.put_bool(*static_cast<const bool *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_OCTET:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT8:
+      writer.put_pod(*static_cast<const uint8_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_CHAR:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT8:
+      writer.put_pod(*static_cast<const int8_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_WCHAR:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT16:
+      writer.put_pod(*static_cast<const uint16_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT16:
+      writer.put_pod(*static_cast<const int16_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT32:
+      writer.put_pod(*static_cast<const uint32_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT32:
+      writer.put_pod(*static_cast<const int32_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT64:
+      writer.put_pod(*static_cast<const uint64_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT64:
+      writer.put_pod(*static_cast<const int64_t *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_FLOAT:
+      writer.put_pod(*static_cast<const float *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_DOUBLE:
+      writer.put_pod(*static_cast<const double *>(field));
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_LONG_DOUBLE:
+      {
+        // CDR long double is 16 bytes on the wire regardless of host size.
+        std::vector<uint8_t> bytes(16, 0);
+        memcpy(bytes.data(), field, sizeof(long double) < 16 ? sizeof(long double) : 16);
+        writer.align(8);
+        writer.put(bytes.data(), 16);
+      }
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_STRING:
+      if (is_cpp) {
+        const auto & str = *static_cast<const std::string *>(field);
+        writer.put_string(str.data(), str.size());
+      } else {
+        const auto * str = static_cast<const rosidl_runtime_c__String *>(field);
+        if (str->data == nullptr) {
+          writer.put_string("", 0);
+        } else {
+          writer.put_string(str->data, str->size);
+        }
+      }
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_WSTRING:
+      if (is_cpp) {
+        const auto & str = *static_cast<const std::u16string *>(field);
+        writer.put_u16_string(
+          reinterpret_cast<const uint16_t *>(str.data()), str.size());
+      } else {
+        const auto * str = static_cast<const rosidl_runtime_c__U16String *>(field);
+        if (str->data == nullptr) {
+          writer.put_u16_string(nullptr, 0);
+        } else {
+          writer.put_u16_string(str->data, str->size);
+        }
+      }
+      return;
+    default:
+      throw std::runtime_error(
+        "cdr: write_single called for non-primitive type (type_id=" +
+        std::to_string(static_cast<unsigned>(type_id)) + ")");
+  }
+}
+
+template<typename MembersType, typename MemberT>
+void
+write_field_impl(CdrWriter & writer, const MemberT * member, const void * field, bool is_cpp)
+{
+  if (member->type_id_ == rosidl_typesupport_introspection_c__ROS_TYPE_MESSAGE) {
+    const auto * sub_members = static_cast<const MembersType *>(member->members_->data);
+    if (!member->is_array_) {
+      write_members(writer, sub_members, field);
+      return;
+    }
+    size_t count = 0;
+    if (member->array_size_ != 0 && !member->is_upper_bound_) {
+      count = member->array_size_;
+    } else {
+      count = member->size_function(field);
+      writer.put_u32(static_cast<uint32_t>(count));
+    }
+    for (size_t i = 0; i < count; ++i) {
+      write_members(writer, sub_members, member->get_const_function(field, i));
+    }
+    return;
+  }
+
+  if (!member->is_array_) {
+    write_single(writer, member->type_id_, field, is_cpp);
+    return;
+  }
+  size_t count = 0;
+  if (member->array_size_ != 0 && !member->is_upper_bound_) {
+    count = member->array_size_;
+  } else {
+    count = member->size_function(field);
+    writer.put_u32(static_cast<uint32_t>(count));
+  }
+  for (size_t i = 0; i < count; ++i) {
+    if (member->get_const_function != nullptr) {
+      write_single(writer, member->type_id_, member->get_const_function(field, i), is_cpp);
+    } else {
+      // cpp std::vector<bool> style sequences have no direct element accessor;
+      // elements go through fetch/assign.
+      bool value = false;
+      member->fetch_function(field, i, &value);
+      write_single(writer, member->type_id_, &value, is_cpp);
+    }
+  }
+}
+
+template<typename MembersType>
+void
+write_members(CdrWriter & writer, const MembersType * members, const void * data)
+{
+  constexpr bool is_cpp = std::is_same<
+    MembersType, rosidl_typesupport_introspection_cpp::MessageMembers>::value;
+  for (uint32_t i = 0; i < members->member_count_; ++i) {
+    const auto * member = members->members_ + i;
+    const void * field = static_cast<const char *>(data) + member->offset_;
+    try {
+      write_field_impl<MembersType>(writer, member, field, is_cpp);
+    } catch (const std::exception & e) {
+      throw std::runtime_error(
+        std::string(members->message_name_) + "." + member->name_ + ": " + e.what());
+    }
+  }
+}
+
+template<typename MembersType>
+void
+read_members(CdrReader & reader, const MembersType * members, void * data);
+
+inline void
+read_single(CdrReader & reader, uint8_t type_id, void * field, bool is_cpp,
+  size_t string_bound = 0)
+{
+  switch (type_id) {
+    case rosidl_typesupport_introspection_c__ROS_TYPE_BOOLEAN:
+      *static_cast<bool *>(field) = reader.get_bool();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_OCTET:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT8:
+      *static_cast<uint8_t *>(field) = reader.get_pod<uint8_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_CHAR:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT8:
+      *static_cast<int8_t *>(field) = reader.get_pod<int8_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_WCHAR:
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT16:
+      *static_cast<uint16_t *>(field) = reader.get_pod<uint16_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT16:
+      *static_cast<int16_t *>(field) = reader.get_pod<int16_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT32:
+      *static_cast<uint32_t *>(field) = reader.get_pod<uint32_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT32:
+      *static_cast<int32_t *>(field) = reader.get_pod<int32_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_UINT64:
+      *static_cast<uint64_t *>(field) = reader.get_pod<uint64_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_INT64:
+      *static_cast<int64_t *>(field) = reader.get_pod<int64_t>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_FLOAT:
+      *static_cast<float *>(field) = reader.get_pod<float>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_DOUBLE:
+      *static_cast<double *>(field) = reader.get_pod<double>();
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_LONG_DOUBLE:
+      {
+        std::vector<uint8_t> bytes(16, 0);
+        reader.align(8);
+        for (size_t i = 0; i < 16; ++i) {
+          bytes[i] = reader.get_pod<uint8_t>();
+        }
+        memcpy(field, bytes.data(), sizeof(long double) < 16 ? sizeof(long double) : 16);
+      }
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_STRING:
+      {
+        // The IDL bound is enforced inside get_string(), before allocation.
+        std::string value;
+        reader.get_string(value, string_bound);
+        if (is_cpp) {
+          *static_cast<std::string *>(field) = std::move(value);
+        } else {
+          assign_c_string(field, value);
+        }
+      }
+      return;
+    case rosidl_typesupport_introspection_c__ROS_TYPE_WSTRING:
+      {
+        std::vector<uint16_t> value;
+        reader.get_u16_string(value, string_bound);
+        if (is_cpp) {
+          auto & str = *static_cast<std::u16string *>(field);
+          str.assign(reinterpret_cast<const char16_t *>(value.data()), value.size());
+        } else {
+          assign_c_u16_string(field, value);
+        }
+      }
+      return;
+    default:
+      throw std::runtime_error(
+        "cdr: read_single called for non-primitive type (type_id=" +
+        std::to_string(static_cast<unsigned>(type_id)) + ")");
+  }
+}
+
+template<typename MembersType, typename MemberT>
+void
+read_field_impl(CdrReader & reader, const MemberT * member, void * field, bool is_cpp)
+{
+  if (member->type_id_ == rosidl_typesupport_introspection_c__ROS_TYPE_MESSAGE) {
+    const auto * sub_members = static_cast<const MembersType *>(member->members_->data);
+    if (!member->is_array_) {
+      read_members(reader, sub_members, field);
+      return;
+    }
+    size_t count = 0;
+    if (member->array_size_ != 0 && !member->is_upper_bound_) {
+      count = member->array_size_;
+    } else {
+      count = reader.get_u32();
+      // IDL bound first (a bounded sequence must never resize past it), then
+      // the minimum-wire-width guard against forged length prefixes, then
+      // the allocation budget — all before the resize happens.
+      if (member->is_upper_bound_ && count > member->array_size_) {
+        throw std::runtime_error("cdr: message sequence exceeds its IDL bound");
+      }
+      // Computed once per member, not per element: the minimum payload bytes
+      // one element must occupy. It is 0 for an empty message, leaving the
+      // element count bounded by the budget alone.
+      reader.check_count(count, min_message_wire_size(sub_members));
+      // size_of_ IS the real per-element allocation: vector<T>::resize()
+      // allocates count * sizeof(T), a C resize_function count C structs.
+      reader.spend_budget(count, sub_members->size_of_);
+      if (!resize_member(member, field, count)) {
+        throw std::runtime_error("cdr: failed to resize message sequence");
+      }
+    }
+    for (size_t i = 0; i < count; ++i) {
+      read_members(reader, sub_members, member->get_function(field, i));
+    }
+    return;
+  }
+
+  if (!member->is_array_) {
+    read_single(reader, member->type_id_, field, is_cpp, member->string_upper_bound_);
+    return;
+  }
+  size_t count = 0;
+  if (member->array_size_ != 0 && !member->is_upper_bound_) {
+    count = member->array_size_;
+  } else {
+    count = reader.get_u32();
+    if (member->is_upper_bound_ && count > member->array_size_) {
+      throw std::runtime_error("cdr: sequence exceeds its IDL bound");
+    }
+    reader.check_count(count, elem_min_wire_size(member->type_id_));
+    reader.spend_budget(count, elem_alloc_size(member->type_id_, is_cpp));
+    if (!resize_member(member, field, count)) {
+      throw std::runtime_error("cdr: failed to resize sequence");
+    }
+  }
+  for (size_t i = 0; i < count; ++i) {
+    if (member->get_function != nullptr) {
+      read_single(reader, member->type_id_, member->get_function(field, i), is_cpp,
+        member->string_upper_bound_);
+    } else {
+      // cpp std::vector<bool> style sequences have no direct element accessor;
+      // elements go through fetch/assign.
+      bool value = false;
+      read_single(reader, member->type_id_, &value, is_cpp);
+      member->assign_function(field, i, &value);
+    }
+  }
+}
+
+template<typename MembersType>
+void
+read_members(CdrReader & reader, const MembersType * members, void * data)
+{
+  constexpr bool is_cpp = std::is_same<
+    MembersType, rosidl_typesupport_introspection_cpp::MessageMembers>::value;
+  for (uint32_t i = 0; i < members->member_count_; ++i) {
+    const auto * member = members->members_ + i;
+    void * field = static_cast<char *>(data) + member->offset_;
+    try {
+      read_field_impl<MembersType>(reader, member, field, is_cpp);
+    } catch (const std::exception & e) {
+      throw std::runtime_error(
+        std::string(members->message_name_) + "." + member->name_ + ": " + e.what());
+    }
+  }
+}
+
+}  // namespace serdes_internal
+
+}  // namespace rmw_mdds
+
+#endif  // SERDES_INTERNAL_HPP_
