+      "/destroy_outer_a", "test/DestroyOuter", default_qos());
+  state->writer_b = state->participant->create_writer(
+      "/destroy_outer_b", "test/DestroyOuter", default_qos());
+  state->reader_b = state->participant->create_reader(
+      "/destroy_outer_b", "test/DestroyOuter", default_qos());
+  ASSERT_NE(state->writer_a, nullptr);
+  ASSERT_NE(state->reader_a, nullptr);
+  ASSERT_NE(state->writer_b, nullptr);
+  ASSERT_NE(state->reader_b, nullptr);
+
+  state->reader_a->set_data_callback([state] {
+    state->callbacks_a.fetch_add(1, std::memory_order_relaxed);
+    const uint8_t nested[] = {0x61};
+    state->write_b_ok = state->writer_b->write(nested, sizeof(nested));
+  });
+  state->reader_b->set_data_callback([state] {
+    state->callbacks_b.fetch_add(1, std::memory_order_relaxed);
+    state->participant->destroy_reader(state->reader_a);
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      state->destroy_returned = true;
+    }
+    state->cv.notify_all();
+  });
+
+  std::thread publisher([state] {
+    const uint8_t first[] = {0x60};
+    state->write_a_ok = state->writer_a->write(first, sizeof(first));
+  });
+  bool returned = false;
+  {
+    std::unique_lock<std::mutex> lock(state->mutex);
+    returned = state->cv.wait_for(
+        lock, 5s, [&] { return state->destroy_returned; });
+  }
+  if (!returned) {
+    ADD_FAILURE() << "nested callback destroyed its active outer reader deadlocked";
+    std::abort();
+  }
+  publisher.join();
+
+  EXPECT_TRUE(state->write_a_ok.load());
+  EXPECT_TRUE(state->write_b_ok.load());
+  EXPECT_EQ(state->callbacks_a.load(), 1u);
+  EXPECT_EQ(state->callbacks_b.load(), 1u);
+  EXPECT_EQ(state->participant->graph_counts().local_readers, 1u);
+  state->participant->destroy_reader(state->reader_b);
+  EXPECT_EQ(state->participant->graph_counts().local_readers, 0u);
+}
