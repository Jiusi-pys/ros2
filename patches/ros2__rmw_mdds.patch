+// CycloneDDS 2.2.4 exponentially backs periodic reliable-writer heartbeats
+// off to an 8 s ceiling.  A lost ACK can therefore legitimately remain
+// invisible beyond the old 5 s gateway fence even while the reader stays
+// matched and has already received the sample.  Keep several full heartbeat
+// opportunities inside the terminal deadline: this remains bounded and
+// fail-closed, while avoiding a false terminal failure before Cyclone can
+// solicit a replacement ACK.
+inline constexpr std::chrono::milliseconds kCycloneHeartbeatBackoffCeiling{8000};
+inline constexpr AckFencePolicy kCycloneAckPolicy{
+  std::chrono::milliseconds(200), std::chrono::seconds(30)};
+static_assert(
+  kCycloneAckPolicy.deadline > 3 * kCycloneHeartbeatBackoffCeiling,
+  "Cyclone ACK fence must cover at least three maximum heartbeat intervals");
