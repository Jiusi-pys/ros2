+set(OROCOS_KDL_VENDOR_VCS_URL "" CACHE STRING "Override VCS URL for orocos_kinematics_dynamics")
+set(OROCOS_KDL_VENDOR_VCS_VERSION "" CACHE STRING "Override VCS revision for orocos_kinematics_dynamics")
+
