+#ifndef RMW__MESSAGE_SEQUENCE_H_
+#define RMW__MESSAGE_SEQUENCE_H_
+
+#include <stddef.h>
+
+#include "rmw/macros.h"
+#include "rmw/visibility_control.h"
+#include "rmw/types.h"
+
+#if __cplusplus
+extern "C"
+{
+#endif
+
+/// 用于保存 ROS 消息序列的结构体。
+typedef struct RMW_PUBLIC_TYPE rmw_message_sequence_s
+{
+  /// 指向 ROS 消息的指针数组。
+  void ** data;
+  /// `data` 中有效条目的数量。
+  size_t size;
+  /// 数据数组的总分配容量。
+  size_t capacity;
+  /// 用于分配数据数组的分配器。
+  rcutils_allocator_t * allocator;
+} rmw_message_sequence_t;
+
+/// 用于保存消息信息序列的结构体。
+typedef struct RMW_PUBLIC_TYPE rmw_message_info_sequence_s
+{
+  /// 消息信息数组。
+  rmw_message_info_t * data;
+  /// data 中有效条目的数量。
+  size_t size;
+  /// 数据数组的总分配容量。
+  size_t capacity;
+  /// 用于分配数据数组的分配器。
+  rcutils_allocator_t * allocator;
+} rmw_message_info_sequence_t;
+
+/// 返回一个成员初始化为 `NULL` 的 rmw_message_sequence_t 结构体
+RMW_PUBLIC
+rmw_message_sequence_t
+rmw_get_zero_initialized_message_sequence(void);
+
+/// 初始化一个 rmw_message_sequence_t 对象。
+/**
+ * \param[inout] sequence 要初始化的序列对象。
+ * \param[in] size 要分配的序列容量。
+ * \param[in] allocator 用于分配内存的分配器。
+ */
+RMW_PUBLIC
+rmw_ret_t
+rmw_message_sequence_init(
+  rmw_message_sequence_t * sequence,
+  size_t size,
+  rcutils_allocator_t * allocator);
+
+/// 结束一个 rmw_message_sequence_t 对象。
+/**
+ * rmw_message_sequence_t 结构体具有一些成员，在设置值之前需要为它们分配内存。
+ * 此函数回收对象内所有已分配的资源，并将所有其他成员清零。
+ *
+ * 注意：这不会调用 `fini`，也不会释放底层消息结构。
+ *
+ * \param[inout] sequence 要结束的序列对象。
+ */
+RMW_PUBLIC
+rmw_ret_t
+rmw_message_sequence_fini(rmw_message_sequence_t * sequence);
+
+/// 返回一个成员初始化为 `NULL` 的 rmw_message_info_sequence_t 结构体
+RMW_PUBLIC
+rmw_message_info_sequence_t
+rmw_get_zero_initialized_message_info_sequence(void);
+
+/// 初始化一个 rmw_message_info_sequence_t 对象。
+/**
+ * \param[inout] sequence 要初始化的序列对象。
+ * \param[in] size 要分配的序列容量。
+ * \param[in] allocator 用于分配内存的分配器。
+ */
+RMW_PUBLIC
+rmw_ret_t
+rmw_message_info_sequence_init(
+  rmw_message_info_sequence_t * sequence,
+  size_t size,
+  rcutils_allocator_t * allocator);
+
+/// 结束一个 rmw_message_sequence_t 对象。
+/**
+ * rmw_message_sequence_t 结构体具有一些成员，在设置值之前需要为它们分配内存。
+ * 此函数回收对象内所有已分配的资源，并将所有其他成员清零。
+ *
+ * \param[inout] sequence 要结束的序列对象。
+ */
+RMW_PUBLIC
+rmw_ret_t
