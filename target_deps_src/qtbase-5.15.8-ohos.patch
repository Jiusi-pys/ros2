@@ -9,10 +9,17 @@ win32: EXTENSION = .exe
 
 !build_pass {
     qmake_exe.target = $$OUT_PWD/qmake$$EXTENSION
-    qmake_exe.commands = $(MAKE) binary
+    qmake_exe.commands = $(MAKE) -f $(MAKEFILE) binary
