+TEST_F(DsoftbusTransportFakeTest,
+       CAbiDispatchContainsThrowingListenerCallbacks) {
+  constexpr int32_t kPeerFd = 306;
+  fake().set_online_nodes({"fake-throwing-listener"});
+  RecordingListener listener;
+  auto transport = mdds::make_dsoftbus_transport();
+  ASSERT_TRUE(transport->start(config(), &listener));
+  ASSERT_TRUE(fake().wait_for_listener());
+
+  listener.set_on_up_hook([] { throw std::runtime_error("up"); });
+  EXPECT_NO_THROW(emit_bind(kPeerFd, "fake-throwing-listener"));
+  // The transport state was completed before the listener call, but the C
+  // entry point returned normally rather than unwinding through DSoftBus.
+  EXPECT_EQ(transport->status().peer_count, 1u);
+
+  listener.set_on_up_hook({});
+  listener.set_on_bytes_hook([] { throw std::runtime_error("bytes"); });
+  const uint8_t byte = 0x5a;
+  EXPECT_NO_THROW(emit_bytes(kPeerFd, &byte, 1));
+
+  listener.set_on_down_hook([] { throw std::runtime_error("down"); });
+  fake().configure_option(-77, 64 * 1024); // make OnShutdown genuine
+  EXPECT_NO_THROW(emit_shutdown(kPeerFd, static_cast<ShutdownReason>(0)));
+  EXPECT_EQ(transport->status().peer_count, 0u);
+
+  // dispatch_on_error has the same noexcept/catch barrier; its handler has no
+  // user callback, so exercise the ABI entry directly for the no-throw case.
+  const ISocketListener *const socket_listener = fake().listener();
+  ASSERT_NE(socket_listener, nullptr);
+  ASSERT_NE(socket_listener->OnError, nullptr);
+  EXPECT_NO_THROW(socket_listener->OnError(999, -1));
+
+  transport->stop();
+}
