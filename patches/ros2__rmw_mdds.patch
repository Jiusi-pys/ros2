+#include <atomic>
+#include <chrono>
+#include <stdexcept>
+
+#include <gtest/gtest.h>
+
+#include "ack_fence.hpp"
+
+namespace mdds_gateway
+{
+namespace
+{
+
+TEST(AckFence, AcknowledgedOnFirstPoll)
+{
+  std::atomic<bool> running{true};
+  size_t calls = 0;
+  const AckFencePolicy policy{std::chrono::milliseconds(1), std::chrono::milliseconds(10)};
+  const AckFenceResult result = wait_for_ack_fence(
+    running, policy,
+    [&calls](std::chrono::milliseconds timeout) {
+      ++calls;
+      EXPECT_EQ(timeout, std::chrono::milliseconds(1));
+      return true;
+    });
+  EXPECT_EQ(result, AckFenceResult::ACKED);
+  EXPECT_EQ(calls, 1u);
+}
+
+TEST(AckFence, DoesNotWaitAfterShutdown)
+{
+  std::atomic<bool> running{false};
+  size_t calls = 0;
+  const AckFencePolicy policy{std::chrono::milliseconds(1), std::chrono::milliseconds(10)};
+  EXPECT_EQ(
+    wait_for_ack_fence(
+      running, policy,
+      [&calls](std::chrono::milliseconds) {
+        ++calls;
+        return true;
+      }),
+    AckFenceResult::STOPPED);
+  EXPECT_EQ(calls, 0u);
+}
+
+TEST(AckFence, TimesOutWithoutAck)
+{
+  std::atomic<bool> running{true};
+  size_t calls = 0;
+  // A zero deadline makes this deterministic without a sleep: the first
+  // non-acknowledging poll observes the already-expired deadline.
+  const AckFencePolicy policy{std::chrono::milliseconds(0), std::chrono::milliseconds(0)};
+  EXPECT_EQ(
+    wait_for_ack_fence(
+      running, policy,
+      [&calls](std::chrono::milliseconds) {
+        ++calls;
+        return false;
+      }),
+    AckFenceResult::TIMED_OUT);
+  EXPECT_EQ(calls, 1u);
+}
+
+TEST(AckFence, PropagatesRmwErrorToCaller)
+{
+  std::atomic<bool> running{true};
+  const AckFencePolicy policy{std::chrono::milliseconds(1), std::chrono::milliseconds(10)};
+  EXPECT_THROW(
+    wait_for_ack_fence(
+      running, policy,
+      [](std::chrono::milliseconds) -> bool {
+        throw std::runtime_error("rmw error");
+      }),
+    std::runtime_error);
+}
+
+}  // namespace
+}  // namespace mdds_gateway
