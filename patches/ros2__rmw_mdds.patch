+TEST(C2mIngressQueue, PreservesAll4096SamplesInFifoOrder)
+{
+  mdds_gateway::C2mIngressQueue queue({4096, 4096 * 4, 4});
+  for (uint32_t value = 0; value < 4096; ++value) {
+    const uint8_t sample[] = {
+      static_cast<uint8_t>(value >> 24), static_cast<uint8_t>(value >> 16),
+      static_cast<uint8_t>(value >> 8), static_cast<uint8_t>(value)};
+    EXPECT_EQ(
+      queue.push_copy(sample, sizeof(sample)),
+      mdds_gateway::C2mIngressPushResult::ACCEPTED);
+  }
+  const mdds_gateway::C2mIngressQueueStatus full = queue.status();
+  EXPECT_EQ(full.queued_samples, 4096u);
+  EXPECT_EQ(full.queued_bytes, 4096u * 4u);
+  EXPECT_EQ(full.high_water_samples, 4096u);
+
+  for (uint32_t expected = 0; expected < 4096; ++expected) {
+    std::vector<uint8_t> sample;
+    ASSERT_TRUE(queue.pop_for(sample, std::chrono::milliseconds(0)));
+    ASSERT_EQ(sample.size(), 4u);
+    const uint32_t actual =
+      (static_cast<uint32_t>(sample[0]) << 24) |
+      (static_cast<uint32_t>(sample[1]) << 16) |
+      (static_cast<uint32_t>(sample[2]) << 8) |
+      static_cast<uint32_t>(sample[3]);
+    EXPECT_EQ(actual, expected);
+  }
+  const mdds_gateway::C2mIngressQueueStatus drained = queue.status();
+  EXPECT_EQ(drained.queued_samples, 0u);
+  EXPECT_EQ(drained.queued_bytes, 0u);
+  EXPECT_EQ(drained.high_water_samples, 4096u);
+}
+
+TEST(C2mIngressQueue, RefusesCapacityAndOversizeWithoutEviction)
+{
+  const uint8_t one[] = {1};
+  const uint8_t three[] = {1, 2, 3};
+  const uint8_t four[] = {1, 2, 3, 4};
+
+  mdds_gateway::C2mIngressQueue sample_bound({1, 8, 8});
+  ASSERT_EQ(sample_bound.push_copy(one, sizeof(one)), mdds_gateway::C2mIngressPushResult::ACCEPTED);
+  EXPECT_EQ(sample_bound.push_copy(one, sizeof(one)), mdds_gateway::C2mIngressPushResult::SAMPLE_LIMIT);
+  std::vector<uint8_t> out;
+  ASSERT_TRUE(sample_bound.pop_for(out, std::chrono::milliseconds(0)));
+  ASSERT_EQ(out.size(), 1u);
+  EXPECT_EQ(out[0], 1u);
+
+  mdds_gateway::C2mIngressQueue byte_bound({4, 5, 5});
+  ASSERT_EQ(byte_bound.push_copy(three, sizeof(three)), mdds_gateway::C2mIngressPushResult::ACCEPTED);
+  EXPECT_EQ(byte_bound.push_copy(three, sizeof(three)), mdds_gateway::C2mIngressPushResult::BYTE_LIMIT);
+  ASSERT_TRUE(byte_bound.pop_for(out, std::chrono::milliseconds(0)));
+  EXPECT_EQ(out, std::vector<uint8_t>(three, three + sizeof(three)));
+
+  mdds_gateway::C2mIngressQueue sample_bound_size({4, 8, 3});
+  EXPECT_EQ(
+    sample_bound_size.push_copy(four, sizeof(four)),
+    mdds_gateway::C2mIngressPushResult::SAMPLE_TOO_LARGE);
+  EXPECT_EQ(sample_bound_size.status().queued_samples, 0u);
+}
+
+TEST(C2mIngressQueue, CloseWakesAndRejectsFutureAdmissions)
+{
+  const uint8_t sample[] = {7};
+  mdds_gateway::C2mIngressQueue queue({2, 8, 8});
+  ASSERT_EQ(queue.push_copy(sample, sizeof(sample)), mdds_gateway::C2mIngressPushResult::ACCEPTED);
+  queue.close();
+  EXPECT_TRUE(queue.status().closed);
+  EXPECT_EQ(queue.status().queued_samples, 0u);
+  EXPECT_EQ(queue.push_copy(sample, sizeof(sample)), mdds_gateway::C2mIngressPushResult::CLOSED);
+  std::vector<uint8_t> out;
+  EXPECT_FALSE(queue.pop_for(out, std::chrono::milliseconds(0)));
+}
+
