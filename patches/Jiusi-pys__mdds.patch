+// Reassemblers that share a global budget cannot collectively exceed it.
+TEST(Reassembler, GlobalBudgetSharedAcrossPeers)
+{
+  // Declared before the reassemblers so it outlives them (destructors return
+  // their held bytes to the budget).
+  mdds::ReassemblyBudget global(8192);
+  mdds::Reassembler reasm_a(std::chrono::milliseconds(5000), 4096, 8192, &global);
+  mdds::Reassembler reasm_b(std::chrono::milliseconds(5000), 4096, 8192, &global);
+  auto wa = make_test_guid(1);
+  auto wb = make_test_guid(2);
+  std::vector<uint8_t> out;
+  uint8_t b[100] = {};
+
+  EXPECT_FALSE(reasm_a.add_fragment(wa, 1, 4000, 0, b, sizeof(b), out));
+  EXPECT_FALSE(reasm_b.add_fragment(wb, 1, 4000, 0, b, sizeof(b), out));
+  EXPECT_EQ(global.used.load(), 8000u);
+
+  EXPECT_FALSE(reasm_a.add_fragment(wa, 2, 4000, 0, b, sizeof(b), out));
+  EXPECT_FALSE(reasm_b.add_fragment(wb, 2, 4000, 0, b, sizeof(b), out));
+  EXPECT_EQ(reasm_a.dropped_over_budget(), 1u);
+  EXPECT_EQ(reasm_b.dropped_over_budget(), 1u);
+
+  // drop_writer returns both the peer and the global share.
+  reasm_a.drop_writer(wa);
+  EXPECT_EQ(reasm_a.bytes_in_flight(), 0u);
+  EXPECT_EQ(global.used.load(), 4000u);
+  EXPECT_FALSE(reasm_a.add_fragment(wa, 2, 4000, 0, b, sizeof(b), out));
+}
