+// A global budget shared by two reassemblers is enforced by atomic
+// reservation: used never exceeds the limit, rejected reservations charge
+// nothing, and every release path (completion, timeout sweep, destruction)
+// returns its bytes.
+TEST(Reassembler, GlobalBudgetReservation)
+{
+  // Declared before the reassemblers so it outlives them (destructors return
+  // their held bytes to the budget).
+  mdds::ReassemblyBudget global(8192);
+  uint8_t b[100] = {};
+  {
+    mdds::Reassembler ra(std::chrono::milliseconds(100), 4096, 8192, &global);
+    mdds::Reassembler rb(std::chrono::milliseconds(100), 4096, 8192, &global);
+    auto wa = make_test_guid(0x32);
+    auto wb = make_test_guid(0x33);
+    std::vector<uint8_t> out;
+
+    // Fill the global budget from both reassemblers.
+    EXPECT_FALSE(ra.add_fragment(wa, 1, 4000, 0, b, sizeof(b), out));
+    EXPECT_FALSE(rb.add_fragment(wb, 1, 4000, 0, b, sizeof(b), out));
+    EXPECT_EQ(global.used.load(), 8000u);
+    EXPECT_LE(global.used.load(), global.limit);
+
+    // The next reservation from EITHER side would exceed the shared limit.
+    EXPECT_FALSE(ra.add_fragment(wa, 2, 4000, 0, b, sizeof(b), out));
+    EXPECT_FALSE(rb.add_fragment(wb, 2, 4000, 0, b, sizeof(b), out));
+    EXPECT_EQ(ra.dropped_over_budget(), 1u);
+    EXPECT_EQ(rb.dropped_over_budget(), 1u);
+    EXPECT_EQ(global.used.load(), 8000u);  // rejected reservations charge nothing
+
+    // Completion returns ra's reservation.
+    std::vector<uint8_t> tail(3900, 0x02);
+    EXPECT_TRUE(ra.add_fragment(wa, 1, 4000, 100, tail.data(), tail.size(), out));
+    EXPECT_EQ(out.size(), 4000u);
+    EXPECT_EQ(global.used.load(), 4000u);
+
+    // Timeout sweep returns rb's reservation.
+    EXPECT_EQ(
+      rb.sweep_expired(mdds::Reassembler::Clock::now() + std::chrono::seconds(10)), 1u);
+    EXPECT_EQ(global.used.load(), 0u);
+
+    // The freed budget is reusable on both sides.
+    EXPECT_FALSE(ra.add_fragment(wa, 3, 4000, 0, b, sizeof(b), out));
+    EXPECT_FALSE(rb.add_fragment(wb, 3, 4000, 0, b, sizeof(b), out));
+    EXPECT_EQ(global.used.load(), 8000u);
+  }
+  // Destruction returns whatever is still held.
+  EXPECT_EQ(global.used.load(), 0u);
+}
