+// State for the test-only lifecycle hook. The hook runs after a callback slot
+// has been snapshotted but before it commits execution, so this test can put
+// clear() precisely between those two phases without copying a user target
+// under ReaderImpl's queue mutex.
+struct CallbackLifecycleState {
+  std::mutex mutex;
+  std::condition_variable cv;
+  size_t snapshots = 0;
+  size_t invocations = 0;
+  bool first_entered = false;
+  bool release_first = false;
+  bool second_snapshotted = false;
+  bool release_second_snapshot = false;
+  bool retired = false;
+};
+
+struct BlockingDataCallback {
+  explicit BlockingDataCallback(std::shared_ptr<CallbackLifecycleState> s)
+      : state(std::move(s)) {}
+
+  void operator()() const {
+    std::unique_lock<std::mutex> lock(state->mutex);
+    ++state->invocations;
+    if (state->invocations == 1) {
+      state->first_entered = true;
+      state->cv.notify_all();
+      state->cv.wait(lock, [this] { return state->release_first; });
+    }
+  }
+
+  std::shared_ptr<CallbackLifecycleState> state;
+};
+
+// Re-enter Reader lifecycle from the stored callback target's destructor.
+// Replacing/clearing the slot must destroy the target after queue_mutex_ is
+// released; otherwise this re-entry self-deadlocks on that mutex.
+struct ReentrantRetirementState {
+  mdds::Reader *reader = nullptr;
+  std::atomic<bool> arm{false};
+  std::atomic<bool> reentered{false};
+};
+
+struct ReentrantRetirementCallback {
+  explicit ReentrantRetirementCallback(
+      std::shared_ptr<ReentrantRetirementState> state_in)
+      : state(std::move(state_in)) {}
+
+  ~ReentrantRetirementCallback() {
+    if (state && state->arm.exchange(false, std::memory_order_acq_rel)) {
+      state->reader->set_data_callback(nullptr);
+      state->reentered.store(true, std::memory_order_release);
+    }
+  }
+
+  void operator()() const {}
+
+  std::shared_ptr<ReentrantRetirementState> state;
+};
+
+// A post-install copy of either target re-enters the same lifecycle lock.
+// The production callback paths must snapshot only shared ownership handles,
+// never copy these arbitrary targets while their Reader/Participant mutex is
+// held. The timeout regressions below deterministically deadlock the former
+// implementation and complete without making a post-arm target copy.
+struct CopyReentryDataState {
+  mdds::Reader *reader = nullptr;
+  std::atomic<bool> arm{false};
+  std::atomic<uint64_t> post_arm_copies{0};
+  std::atomic<bool> reentered{false};
+  std::atomic<uint64_t> invocations{0};
+};
+
+struct CopyReentryDataCallback {
+  explicit CopyReentryDataCallback(std::shared_ptr<CopyReentryDataState> s)
+      : state(std::move(s)) {}
+
+  CopyReentryDataCallback(const CopyReentryDataCallback &other)
+      : state(other.state) {
+    if (state && state->arm.exchange(false, std::memory_order_acq_rel)) {
+      ++state->post_arm_copies;
+      state->reader->set_data_callback(nullptr);
+      state->reentered.store(true, std::memory_order_release);
+    }
+  }
+
+  CopyReentryDataCallback(CopyReentryDataCallback &&) noexcept = default;
+  CopyReentryDataCallback &operator=(const CopyReentryDataCallback &) = default;
+  CopyReentryDataCallback &operator=(CopyReentryDataCallback &&) noexcept = default;
+
+  void operator()() const { ++state->invocations; }
+
+  std::shared_ptr<CopyReentryDataState> state;
+};
+
+struct CopyReentryGraphState {
+  mdds::Participant *participant = nullptr;
+  std::atomic<bool> arm{false};
+  std::atomic<uint64_t> post_arm_copies{0};
+  std::atomic<bool> reentered{false};
+  std::atomic<uint64_t> invocations{0};
+};
+
+struct CopyReentryGraphCallback {
+  explicit CopyReentryGraphCallback(std::shared_ptr<CopyReentryGraphState> s)
+      : state(std::move(s)) {}
+
+  CopyReentryGraphCallback(const CopyReentryGraphCallback &other)
+      : state(other.state) {
+    if (state && state->arm.exchange(false, std::memory_order_acq_rel)) {
+      ++state->post_arm_copies;
+      state->participant->clear_graph_callback_async();
+      state->reentered.store(true, std::memory_order_release);
+    }
+  }
+
+  CopyReentryGraphCallback(CopyReentryGraphCallback &&) noexcept = default;
+  CopyReentryGraphCallback &operator=(const CopyReentryGraphCallback &) = default;
+  CopyReentryGraphCallback &operator=(CopyReentryGraphCallback &&) noexcept = default;
+
+  void operator()() const { ++state->invocations; }
+
+  std::shared_ptr<CopyReentryGraphState> state;
+};
+
+// Participant teardown must retire callbacks/filters while both the Reader
+// and Participant still exist. These target destructors deliberately re-enter
+// both objects; create_reader() must reject teardown-time re-entry rather
+// than adding a fresh endpoint after the destructor drained its tables.
+struct ParticipantTeardownReentryState {
+  mdds::Participant *participant = nullptr;
+  mdds::Reader *reader = nullptr;
+  std::atomic<bool> arm{false};
+  std::atomic<bool> callback_reentered{false};
+  std::atomic<bool> filter_reentered{false};
+  std::atomic<bool> create_rejected{false};
+};
+
+struct ParticipantTeardownCallback {
+  explicit ParticipantTeardownCallback(
+      std::shared_ptr<ParticipantTeardownReentryState> s)
+      : state(std::move(s)) {}
+
+  ~ParticipantTeardownCallback() {
+    if (state && state->arm.load(std::memory_order_acquire)) {
+      state->reader->set_data_callback(nullptr);
+      state->callback_reentered.store(true, std::memory_order_release);
+    }
+  }
+
+  void operator()() const {}
+  std::shared_ptr<ParticipantTeardownReentryState> state;
+};
+
+struct ParticipantTeardownFilter {
+  explicit ParticipantTeardownFilter(
+      std::shared_ptr<ParticipantTeardownReentryState> s)
+      : state(std::move(s)) {}
+
+  ~ParticipantTeardownFilter() {
+    if (state && state->arm.load(std::memory_order_acquire)) {
+      state->reader->set_sample_filter(nullptr);
+      auto *extra = state->participant->create_reader(
+          "/teardown_reentry", "test/TeardownReentry", default_qos());
+      if (extra == nullptr) {
+        state->create_rejected.store(true, std::memory_order_release);
+      } else {
+        state->participant->destroy_reader(extra);
+      }
+      state->filter_reentered.store(true, std::memory_order_release);
+    }
+  }
+
+  bool operator()(const uint8_t *, size_t) const { return true; }
+  std::shared_ptr<ParticipantTeardownReentryState> state;
+};
+
+struct ReentrantSampleFilterState {
+  mdds::Reader *reader = nullptr;
+  std::atomic<bool> arm{false};
+  std::atomic<bool> reentered{false};
+};
+
+struct ReentrantSampleFilter {
+  explicit ReentrantSampleFilter(std::shared_ptr<ReentrantSampleFilterState> s)
+      : state(std::move(s)) {}
+
+  bool operator()(const uint8_t *, size_t) const {
+    if (state && state->arm.exchange(false, std::memory_order_acq_rel)) {
+      state->reader->set_sample_filter(nullptr);
+      state->reentered.store(true, std::memory_order_release);
+    }
+    return true;
+  }
+
+  std::shared_ptr<ReentrantSampleFilterState> state;
+};
