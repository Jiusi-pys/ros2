+        return remotes.size() == 1 && remotes.front().endpoints.empty() &&
+               reader->matched_count() == 0 &&
+               graph_callbacks.load(std::memory_order_relaxed) >= 2;
+      },
+      2s, 10ms));
+  const size_t graph_before_mutation =
+      graph_callbacks.load(std::memory_order_relaxed);
