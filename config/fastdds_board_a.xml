<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast-DDS fallback profile for board A (192.168.77.201).
     Use only if multicast discovery between the boards fails:
     export FASTRTPS_DEFAULT_PROFILES_FILE=/data/local/tmp/ros2/fastdds.xml -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="ohos_board_a" is_default_profile="true">
    <rtps>
      <builtin>
        <metatrafficUnicastLocatorList>
          <locator>
            <udpv4>
              <address>192.168.77.201</address>
            </udpv4>
          </locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>192.168.77.202</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
