diff --git a/rviz_rendering/ogre_media/materials/glsles/point.vert b/rviz_rendering/ogre_media/materials/glsles/point.vert
new file mode 100644
index 00000000..697521d2
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/point.vert
@@ -0,0 +1,36 @@
+// Generic vertex shader for point sprites (GLES2 port:
+// gl_Vertex -> vertex, gl_Color -> colour, gl_FrontColor -> frontColour;
+// pass_depth.vert inlined under WITH_DEPTH - glsles has no `attach`)
+// sets position and point size.
+// Works for perspective and orthographic projection.
+
+uniform mat4 worldviewproj_matrix;
+uniform vec4 size;
+
+attribute vec4 vertex;
+attribute vec4 colour;
+
+varying vec4 frontColour;
+
+#ifdef WITH_DEPTH
+uniform mat4 worldview_matrix;
+
+varying float depth;
+
+void passDepth( vec4 pos )
+{
+  vec4 pos_rel_view = worldview_matrix * pos;
+  depth = -pos_rel_view.z;
+}
+#endif
+
+void main()
+{
+  gl_Position = worldviewproj_matrix * vertex;
+  frontColour = colour;
+  gl_PointSize = size.x;
+
+#ifdef WITH_DEPTH
+  passDepth( vertex );
+#endif
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/shaded_circle.frag b/rviz_rendering/ogre_media/materials/glsles/shaded_circle.frag
new file mode 100644
index 00000000..1e14f41f
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/shaded_circle.frag
@@ -0,0 +1,25 @@
+precision highp float;
+
+// rasterizes a circle that is darker at the borders than in the center
+// GLES2 port: gl_Color -> frontColour, gl_TexCoord[0] -> texCoord0
+
+uniform vec4 highlight;
+uniform float alpha;
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+void main()
+{
+  float ax = texCoord0.x-0.5;
+  float ay = texCoord0.y-0.5;
+
+  float rsquared = ax*ax+ay*ay;
+  float a = (0.25 - rsquared) * 4.0;
+
+  vec3 col = mix(vec3(0.8, 0.8, 0.8) * frontColour.xyz, frontColour.xyz, a);
+
+  col = col + col * highlight.xyz;
+
+  gl_FragColor = vec4(col, alpha * ceil(a) * frontColour.a);
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/smooth_square.frag b/rviz_rendering/ogre_media/materials/glsles/smooth_square.frag
new file mode 100644
index 00000000..ccec0a93
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/smooth_square.frag
@@ -0,0 +1,29 @@
+precision highp float;
+
+// rasterizes a smooth square with ax,ay in [-0.5..0.5]
+// GLES2 port: gl_Color -> frontColour, gl_TexCoord[0] -> texCoord0
+
+uniform vec4 highlight;
+uniform float alpha;
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+void main()
+{
+  float ax = texCoord0.x-0.5;
+  float ay = texCoord0.y-0.5;
+
+  float blend = smoothstep(-0.48, -0.45, ay) * (1.0 - smoothstep(0.45, 0.48, ay)) *
+                smoothstep(-0.48, -0.45, ax) * (1.0 - smoothstep(0.45, 0.48, ax));
+
+  float inv_blend = 1.0 - blend;
+  vec3 col = blend * frontColour.xyz + (sign(0.5 - length(vec3(frontColour.xyz))) * vec3(0.2, 0.2, 0.2) + frontColour.xyz) * inv_blend;
