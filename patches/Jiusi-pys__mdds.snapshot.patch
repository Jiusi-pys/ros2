+
+// Board-only executable used by the release gate to prove that starting and
+// stopping libmdds does not mutate the caller's OpenHarmony process token.
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <string>
+
+#include "mdds/participant.hpp"
+#include "token_setproc.h"
+
+namespace {
+
+enum class ExpectedStart { FAILURE, SUCCESS };
+
+bool parse_domain(const char *raw, uint32_t &domain) {
+  if (raw == nullptr || *raw == '\0') {
+    return false;
+  }
+  char *end = nullptr;
+  errno = 0;
+  const unsigned long value = std::strtoul(raw, &end, 10);
+  if (errno != 0 || end == raw || *end != '\0' ||
+      value > std::numeric_limits<uint32_t>::max()) {
+    return false;
+  }
+  domain = static_cast<uint32_t>(value);
+  return true;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 3 ||
+      (std::strcmp(argv[1], "success") != 0 &&
+       std::strcmp(argv[1], "failure") != 0)) {
+    std::fprintf(stderr,
+                 "usage: mdds_token_boundary_probe success|failure DOMAIN\n");
+    return 2;
+  }
+  const ExpectedStart expected = std::strcmp(argv[1], "success") == 0
+                                     ? ExpectedStart::SUCCESS
+                                     : ExpectedStart::FAILURE;
+  uint32_t domain = 0;
+  if (!parse_domain(argv[2], domain)) {
+    std::fprintf(stderr, "mdds_token_boundary_probe: invalid domain: %s\n",
+                 argv[2]);
+    return 2;
+  }
+
+  const uint64_t before = GetSelfTokenID();
+  mdds::ParticipantConfig config;
+  config.domain_id = domain;
+  config.use_udp_loopback = false;
+  config.udp_cross_device = false;
+  config.use_dsoftbus = true;
+  config.strict_transports = true;
+  std::string init_error;
+  std::unique_ptr<mdds::Participant> participant =
+      mdds::Participant::create(config, &init_error);
+  const bool started = participant != nullptr;
+  participant.reset();
+  const uint64_t after = GetSelfTokenID();
+
+  const bool expected_start = expected == ExpectedStart::SUCCESS;
+  const std::string expected_socket_failure =
+      "dsoftbus: Socket(name=com.kaihong.mdds.d" + std::to_string(domain) +
+      ")=-";
+  // The negative leg must fail at the real DSoftBus Socket authorization
+  // boundary, not at generic Participant validation or a later Listen/bind
+  // stage. Its paired positive leg runs this same binary and domain through
+  // the launcher-under-test, excluding a domain/session configuration error.
+  const bool socket_rejected =
+      init_error.find("active=[]") != std::string::npos &&
+      init_error.find(expected_socket_failure) != std::string::npos &&
+      init_error.find("process token must be provisioned") != std::string::npos;
+  const bool failure_reason_ok = expected_start || socket_rejected;
+  const bool passed =
+      before == after && started == expected_start && failure_reason_ok;
+  std::printf(
+      "MDDS_TOKEN_BOUNDARY V=1 BEFORE=%llu AFTER=%llu START=%s EXPECT=%s "
+      "FAILURE_STAGE=%s RESULT=%s\n",
+      static_cast<unsigned long long>(before),
+      static_cast<unsigned long long>(after), started ? "SUCCESS" : "FAILURE",
+      expected_start ? "SUCCESS" : "FAILURE",
+      expected_start ? "NOT_APPLICABLE"
+                     : (socket_rejected ? "DSOFTBUS_SOCKET_REJECTED"
+                                        : "UNEXPECTED"),
+      passed ? "PASS" : "FAIL");
+  if (!init_error.empty()) {
+    std::fprintf(stderr, "mdds_token_boundary_probe: init_error=%s\n",
+                 init_error.c_str());
+  }
+  return passed ? 0 : 1;
+}
