+// Once UDP has reported peer-down, old bytes from that source must remain
+// entirely below Participant discovery: a valid old ANNOUNCE echo and a raw
+// SESSION_CHALLENGE cannot recreate a route or consume remote state before a
+// new peer-up event.
+TEST(DiscoverySessionChallenge,
+     PeerDownMakesUnboundAnnounceAndChallengeIngressSideEffectFree) {
+  auto cfg = raw_admission_config();
+  cfg.announce_period_ms = 60000;
+  cfg.udp_announce_ms = 25;
+  std::atomic<size_t> outbound_frames{0};
+  cfg.test_send_hook = [&](const uint8_t *, size_t) {
+    outbound_frames.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  };
+
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  const auto remote = raw_remote_snapshot(
+      0x82,
+      {raw_remote_endpoint(0x82, mdds::EntityKind::WRITER, 1,
+                           "/session_peer_down", "test/SessionPeerDown")});
+
+  mdds::SessionChallengeBody first_challenge;
+  ASSERT_TRUE(peer.session_challenge(cfg.domain_id, kTestBasePort5,
+                                     first_challenge, true));
+  const auto old_announce = raw_announce_frame(remote, 1, first_challenge);
+  ASSERT_TRUE(peer.send_frame(old_announce, kTestBasePort5));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return target->graph_counts().remote_participants == 1;
+      },
+      2s, 10ms));
+
+  // No presence after this point: UDP expires the route after 4 periods.
+  ASSERT_TRUE(wait_until(
+      [&] { return target->graph_counts().remote_participants == 0; }, 3s,
+      10ms));
+  const auto frames_after_down =
+      outbound_frames.load(std::memory_order_relaxed);
+
+  const auto old_remote_challenge = mdds::encode_session_challenge(
+      remote.participant_guid, raw_challenge_nonce(0x92));
+  ASSERT_FALSE(old_remote_challenge.empty());
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(peer.send_frame(old_announce, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(old_remote_challenge, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_EQ(target->graph_counts().remote_participants, 0u);
+  EXPECT_EQ(outbound_frames.load(std::memory_order_relaxed), frames_after_down);
+}
