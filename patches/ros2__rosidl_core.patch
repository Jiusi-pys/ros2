From 686ecfc0fb44749313f39c97004eaef98583b037 Mon Sep 17 00:00:00 2001
From: Yusheng Peng <jiusi0519@gmail.com>
Date: Thu, 27 Aug 2026 17:03:08 +0800
Subject: [PATCH 1/2] rosidl_core: drop rosidl_generator_rs and group_depends
 for OpenHarmony cross build

- rosidl_core_generators: rosidl_generator_rs removed (no target Rust
  toolchain); the group_depends are removed because the skipped generator
  is a group member and would be pulled back into colcon's dependency
  check. Generator selection at CMake time uses the ament index, so only
  actually-built generators run.
- rosidl_core_runtime: group_depends removed for the same reason.
  rosidl_generator_py and the fastrtps typesupport deps are kept - the
  Python stack and Fast-DDS typesupport ARE part of the OHOS port.
---
 rosidl_core_generators/package.xml | 10 ++++++----
 rosidl_core_runtime/package.xml    |  7 ++++---
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/rosidl_core_generators/package.xml b/rosidl_core_generators/package.xml
index 421aacb..743d6ad 100644
--- a/rosidl_core_generators/package.xml
+++ b/rosidl_core_generators/package.xml
@@ -18,12 +18,15 @@
   <buildtool_export_depend>rosidl_cmake</buildtool_export_depend>
 
   <!-- Bloom does not support group_depend, so this unrolls rosidl_generator_packages -->
+  <!-- OHOS cross build: rosidl_generator_rs removed (no target Rust toolchain).
+       Generator selection at CMake time uses the ament index, so only
+       actually-built generators run. -->
   <buildtool_export_depend>rosidl_generator_c</buildtool_export_depend>
   <buildtool_export_depend>rosidl_generator_cpp</buildtool_export_depend>
   <buildtool_export_depend>rosidl_generator_py</buildtool_export_depend>
-  <buildtool_export_depend>rosidl_generator_rs</buildtool_export_depend>
 
   <!-- Bloom does not support group_depend, so this unrolls rosidl_typesupport_c_packages -->
+  <!-- OHOS cross build: only generator_rs is skipped (see above). -->
   <buildtool_export_depend>rosidl_typesupport_c</buildtool_export_depend>
   <buildtool_export_depend>rosidl_typesupport_fastrtps_c</buildtool_export_depend>
   <buildtool_export_depend>rosidl_typesupport_introspection_c</buildtool_export_depend>
@@ -36,9 +39,8 @@
   <test_depend>ament_lint_auto</test_depend>
   <test_depend>ament_lint_common</test_depend>
 
-  <group_depend>rosidl_generator_packages</group_depend>
-  <group_depend>rosidl_typesupport_c_packages</group_depend>
-  <group_depend>rosidl_typesupport_cpp_packages</group_depend>
+  <!-- OHOS cross build: group_depend entries removed; the skipped generator /
+       typesupport packages above are group members and would be pulled back in. -->
 
   <export>
     <build_type>ament_cmake</build_type>
diff --git a/rosidl_core_runtime/package.xml b/rosidl_core_runtime/package.xml
index f7250b0..a1b8bb1 100644
--- a/rosidl_core_runtime/package.xml
+++ b/rosidl_core_runtime/package.xml
@@ -20,6 +20,7 @@
   <build_export_depend>rosidl_generator_py</build_export_depend>
 
   <!-- Bloom does not support group_depend, so this unrolls rosidl_typesupport_c_packages -->
+  <!-- OHOS cross build: fastrtps typesupport IS ported. -->
   <build_export_depend>rosidl_typesupport_c</build_export_depend>
   <build_export_depend>rosidl_typesupport_fastrtps_c</build_export_depend>
   <build_export_depend>rosidl_typesupport_introspection_c</build_export_depend>
@@ -32,9 +33,9 @@
   <test_depend>ament_lint_auto</test_depend>
   <test_depend>ament_lint_common</test_depend>
 
-  <group_depend>rosidl_runtime_packages</group_depend>
-  <group_depend>rosidl_typesupport_c_packages</group_depend>
-  <group_depend>rosidl_typesupport_cpp_packages</group_depend>
+  <!-- OHOS cross build: group_depends removed; some group members (generator_rs etc.) are not ported -->
+
+
 
   <export>
     <build_type>ament_cmake</build_type>
-- 
2.55.0.windows.5


From cdcbea15b84962b3b4a96eeadd4922cb7a00ce5e Mon Sep 17 00:00:00 2001
From: Yusheng Peng <jiusi0519@gmail.com>
Date: Sat, 29 Aug 2026 02:07:12 +0800
Subject: [PATCH 2/2] package.xml: dependency unrolls for the OHOS cross
 workspace

---
 rosidl_core_generators/package.xml | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/rosidl_core_generators/package.xml b/rosidl_core_generators/package.xml
index 743d6ad..c42c636 100644
--- a/rosidl_core_generators/package.xml
+++ b/rosidl_core_generators/package.xml
@@ -18,15 +18,16 @@
   <buildtool_export_depend>rosidl_cmake</buildtool_export_depend>
 
   <!-- Bloom does not support group_depend, so this unrolls rosidl_generator_packages -->
-  <!-- OHOS cross build: rosidl_generator_rs removed (no target Rust toolchain).
-       Generator selection at CMake time uses the ament index, so only
+  <!-- OHOS cross build: rosidl_generator_dds_idl (Connext-only) stays out;
+       generator selection at CMake time uses the ament index, so only
        actually-built generators run. -->
   <buildtool_export_depend>rosidl_generator_c</buildtool_export_depend>
   <buildtool_export_depend>rosidl_generator_cpp</buildtool_export_depend>
   <buildtool_export_depend>rosidl_generator_py</buildtool_export_depend>
+  <buildtool_export_depend>rosidl_generator_rs</buildtool_export_depend>
 
   <!-- Bloom does not support group_depend, so this unrolls rosidl_typesupport_c_packages -->
-  <!-- OHOS cross build: only generator_rs is skipped (see above). -->
+  <!-- OHOS cross build: only Connext typesupport is skipped. -->
   <buildtool_export_depend>rosidl_typesupport_c</buildtool_export_depend>
   <buildtool_export_depend>rosidl_typesupport_fastrtps_c</buildtool_export_depend>
   <buildtool_export_depend>rosidl_typesupport_introspection_c</buildtool_export_depend>
-- 
2.55.0.windows.5

