+  auto prefix = raw_remote_prefix(discriminator);
+  prefix[8] = 0xc1;
+  prefix[9] = static_cast<uint8_t>(0x40 | (discriminator & 0x3f));
+  return mdds::make_guid(prefix, mdds::EntityKind::PARTICIPANT,
+                         0x71000000U | discriminator);
+}
+
+bool wait_for_announce_echo(RawUdpPeer &peer,
+                            const mdds::AnnounceChallengeEcho &expected,
+                            std::chrono::milliseconds timeout = 2s) {
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  do {
+    const auto now = std::chrono::steady_clock::now();
+    if (now > deadline) {
+      return false;
+    }
+    const auto remaining =
+        std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now);
+    std::vector<uint8_t> frame;
+    if (!peer.receive_frame(frame, remaining)) {
+      return false;
+    }
+    mdds::ParticipantSnapshot snapshot;
+    uint64_t seq = 0;
+    mdds::AnnounceChallengeEcho actual;
+    if (mdds::decode_announce(frame.data(), frame.size(), snapshot, seq,
+                              nullptr, nullptr, &actual) &&
+        actual.present == expected.present &&
+        actual.challenger_participant == expected.challenger_participant &&
+        actual.nonce == expected.nonce) {
+      return true;
+    }
+  } while (std::chrono::steady_clock::now() <= deadline);
+  return false;
+}
