+// Host-side deterministic DSoftBus transport test.
+//
+// The production DSoftBus libraries only exist on OpenHarmony, so this target
+// compiles transport_dsoftbus.cpp against the vendored public C headers and
+// supplies the small Socket/Bytes ABI surface below.  In particular it locks
+// down the fail-closed rule for GetSessionOption(MAX_SENDBYTES): a channel
+// whose actual limit cannot be obtained must never become a live MDDS peer.
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+#include "mdds/transport.hpp"
