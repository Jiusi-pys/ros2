diff --git a/src/mdds_token_exec.cpp b/src/mdds_token_exec.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9f889353dff3dab506545d7317658db468ed27ed
--- /dev/null
+++ b/src/mdds_token_exec.cpp
@@ -0,0 +1,84 @@
+// Copyright 2026 Yusheng Peng
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Explicit OpenHarmony command-line identity launcher for MDDS/DSoftBus.
+//
+// Usage: mdds_token_exec -- PROGRAM [ARG ...]
+//
+// The identity mutation intentionally happens in this short-lived process
+// before exec.  libmdds itself never mutates the process token, which keeps a
+// composable ROS process from changing the identity of unrelated nodes merely
+// because one component loads the DSoftBus transport.
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+
+#include <unistd.h>
+
+#include "nativetoken_kit.h"
+#include "softbus_error_code.h"
+#include "token_setproc.h"
+
+namespace {
+
+constexpr const char *kProcessName = "com.kaihong.mdds";
+constexpr int kUsageExit = 2;
+constexpr int kLaunchFailureExit = 126;
+
+int fail(const char *step, long long value) {
+  std::fprintf(stderr, "mdds_token_exec: %s failed (%lld)\n", step, value);
+  return kLaunchFailureExit;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  if (argc < 3 || std::strcmp(argv[1], "--") != 0 || argv[2][0] == '\0') {
+    std::fprintf(stderr,
+                 "usage: mdds_token_exec -- PROGRAM [ARG ...]\n");
+    return kUsageExit;
+  }
+
+  const char *permissions[] = {
+      "ohos.permission.DISTRIBUTED_DATASYNC",
+      "ohos.permission.DISTRIBUTED_SOFTBUS_CENTER",
+  };
+  NativeTokenInfoParams info{};
+  info.permsNum = static_cast<int32_t>(sizeof(permissions) /
+                                       sizeof(permissions[0]));
+  info.perms = permissions;
+  info.processName = kProcessName;
+  info.aplStr = "system_basic";
+
+  const uint64_t token_id = GetAccessTokenId(&info);
+  if (token_id == 0) {
+    return fail("GetAccessTokenId", 0);
+  }
+  const int32_t set_result = SetSelfTokenID(token_id);
+  if (set_result != SOFTBUS_OK) {
+    return fail("SetSelfTokenID", set_result);
+  }
+  const uint64_t installed_token = GetSelfTokenID();
+  if (installed_token != token_id) {
+    return fail("GetSelfTokenID verification",
+                static_cast<long long>(installed_token));
+  }
+
+  ::execvp(argv[2], argv + 2);
+  const int saved_errno = errno;
+  std::fprintf(stderr, "mdds_token_exec: execvp(%s) failed: %s (%d)\n",
+               argv[2], std::strerror(saved_errno), saved_errno);
+  return kLaunchFailureExit;
+}
