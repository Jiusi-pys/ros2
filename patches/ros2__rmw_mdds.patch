+TEST(SerdesBudget, forged_nested_prefixes_exhaust_budget)
+{
+  // Every level's count passes its own minimum-wire-width check (Mid's
+  // minimum element size is 4, Empty's is 0 and thus unchecked, and the
+  // 64 KiB payload is large enough for each individual count), but the
+  // allocations compound quadratically — only the cumulative budget can stop
+  // that.
+  std::vector<uint8_t> buf = cdr_payload();
+  append_u32(buf, 16000);  // outer count
+  for (unsigned i = 0; i < 16000; ++i) {
+    append_u32(buf, 60000);  // one forged inner count per element
+  }
+  buf.resize(64 * 1024, 0);
+  Outer msg;
+  CdrReader reader(buf.data(), buf.size());
+  try {
+    read_members(reader, &outer_members, &msg);
+    FAIL() << "expected std::runtime_error";
+  } catch (const std::runtime_error & e) {
+    EXPECT_NE(std::string::npos, std::string(e.what()).find("budget"));
+  }
+}
