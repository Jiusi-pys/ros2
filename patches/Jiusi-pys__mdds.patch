+         it != inbound_associations_.end();) {
+      const Guid &writer = std::get<0>(it->first);
+      const Guid &writer_epoch = std::get<1>(it->first);
+      if (it->second.remote_participant == remote_participant &&
+          !snapshot_has_writer_instance(snapshot, writer, writer_epoch)) {
+        it = inbound_associations_.erase(it);
