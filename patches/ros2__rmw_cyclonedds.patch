+      RMW_SET_ERROR_MSG("invalid CycloneDDS subscription resource-limits payload size");
+      goto fail_qos;
+    case rmw_cyclonedds_cpp::SubscriptionResourceLimitsResult::BAD_VALUE:
+      RMW_SET_ERROR_MSG("invalid CycloneDDS subscription resource-limits values");
