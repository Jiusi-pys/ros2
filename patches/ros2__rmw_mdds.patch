+bool
+event_callback_active_on_this_thread()
+{
+  return t_delivering_event != nullptr;
+}
+
+/// Invoke `cb(user_data, 1)` for `event` with NO lock held across the user
+/// call, under two fences:
+/// - Per event: waits (CV, releasing event_mutex) until no other thread is
+///   delivering this event, then validates the generation and (callback,
+///   user_data) snapshot — a pair swapped/cleared while this invocation
+///   waited is never fired.
+/// - Process-wide: after releasing event_mutex the delivery acquires the
+///   process-wide event callback strand and RE-VALIDATES the snapshot under
+///   event_mutex before invoking. The strand serializes all event callback
+///   executions across every rmw_context, so a clear/replace from inside an
+///   A-context callback always lands (generation bump) while a competing
+///   B-context delivery is still blocked here; the post-acquire check then
+///   fences the stale pair, which is why such a clear can skip the drain
+///   without ever firing the old pair afterwards.
+/// deliver_depth is incremented BEFORE the strand wait, so a non-callback
+/// rmw_event_set_callback drain outlasts strand-blocked deliveries too.
+/// Lock order: event_mutex is never held while acquiring the process-wide
+/// strand; the strand IS held while re-acquiring event_mutex for the
+/// re-validation (strand -> event_mutex is the only nesting).
+/// Same-thread re-entry (a fire of this same event requested from inside its
+/// own callback, e.g. via a local graph change) skips both waits: the thread
+/// already holds the strand and this event's depth. A fire of a DIFFERENT
+/// event from callback context, including an event in another rmw_context, is
+/// deferred to the unwind (see t_deferred_fires).
+/// The outermost frame on a thread drains t_deferred_fires before returning,
+/// strictly AFTER the strand is released — each deferred fire re-enters this
+/// function and acquires the strand itself. A deferred snapshot holds a
+/// context event-dispatch reference, so context fini cannot free its raw
+/// MddsEvent pointer before the generation re-check completes.
+void
+deliver_event_callback(
+  MddsEvent & event, rmw_event_callback_t cb, const void * user_data, uint64_t gen)
+{
+  MddsContext * context = event.context;
+  if (t_delivering_event != nullptr && t_delivering_event != &event) {
+    // Cross-event fire requested from inside any event callback: the
+    // process-wide strand is already held by this thread, so defer to the
+    // outermost unwind instead of self-deadlocking on it. This includes
+    // events owned by a different rmw_context.
+    enqueue_deferred_event_fire(event, cb, user_data, gen);
+    return;
+  }
+  const bool outermost = t_delivering_event == nullptr;
+  const bool self_reentry = t_delivering_event == &event;
+  bool fire = false;
+  {
+    std::unique_lock<std::mutex> lock(context->event_mutex);
+    if (context->event_fini_pending) {
+      return;
+    }
+    if (!self_reentry) {
+      context->event_cv.wait(lock, [&event] {return event.deliver_depth == 0;});
+      if (!context->event_fini_pending && event.cb_generation == gen && event.callback == cb &&
+        event.user_data == user_data)
+      {
+        fire = true;
+      }  // swapped or cleared while waiting: never fire a stale pair
+    } else {
+      fire = true;
+    }
+    if (fire) {
+      ++event.deliver_depth;
+    }
+  }
+  if (fire) {
+    if (self_reentry) {
+      cb(user_data, 1);
+    } else {
+      std::lock_guard<std::mutex> strand_lock(event_callback_strand());
+      {
+        std::lock_guard<std::mutex> lock(context->event_mutex);
+        fire = !context->event_fini_pending && event.cb_generation == gen && event.callback == cb &&
+          event.user_data == user_data;
+      }  // cleared/replaced while blocked on the strand: never fire
+      if (fire) {
+        MddsEvent * prev = t_delivering_event;
+        t_delivering_event = &event;
+        cb(user_data, 1);
+        t_delivering_event = prev;
+      }
+    }
+    {
+      std::lock_guard<std::mutex> lock(context->event_mutex);
+      --event.deliver_depth;
+      // A deferred context reaper is allowed to destroy the context as soon
+      // as it observes the final depth transition.  Notify while the mutex
+      // still protects the context so this frame performs no context access
+      // after releasing the last lifetime fence.
+      context->event_cv.notify_all();
+    }
+  }
+  if (outermost && !t_draining_deferred) {
+    t_draining_deferred = true;
+    while (!t_deferred_fires.empty()) {
+      std::vector<PendingEventFire> batch;
+      batch.swap(t_deferred_fires);
+      for (const auto & item : batch) {
+        deliver_event_callback(
+          *item.event, item.callback, item.user_data, item.generation);
+        release_event_dispatch(item.context);
+      }
+    }
+    t_draining_deferred = false;
+  }
+}
+
+bool
+begin_context_event_fini(MddsContext * context)
+{
+  std::unique_lock<std::mutex> lock(context->event_mutex);
+  context->event_fini_pending = true;
+  // Prevent a queued or strand-blocked snapshot from invoking user memory
+  // after rmw_context_fini returns. Existing deliveries re-check this state
+  // after acquiring the strand; any callback already executing is protected
+  // by the global strand and completes before a non-callback fini returns.
+  for (auto * event : context->events) {
+    event->callback = nullptr;
+    event->user_data = nullptr;
+    ++event->cb_generation;
+  }
+
+  if (t_delivering_event != nullptr) {
+    if (std::find(
+        t_deferred_context_fini.begin(), t_deferred_context_fini.end(), context) ==
+      t_deferred_context_fini.end())
+    {
+      t_deferred_context_fini.push_back(context);
