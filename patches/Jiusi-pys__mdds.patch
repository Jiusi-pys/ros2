 src/transport_dsoftbus.cpp            | 29 +++++++++++++++++----------
 test/test_transport_dsoftbus_fake.cpp |  8 ++++++--
 3 files changed, 27 insertions(+), 13 deletions(-)

diff --git a/include/mdds/transport.hpp b/include/mdds/transport.hpp
index 61babf7..edc1fb1 100644
--- a/include/mdds/transport.hpp
+++ b/include/mdds/transport.hpp
@@ -98,6 +98,9 @@ struct TransportConfig
   // Deterministic timeout seam for a blocked synchronous SendBytes in the
   // host-side DSoftBus fake. Zero selects the production watchdog interval.
   uint32_t test_dsoftbus_stuck_send_timeout_ms = 0;
+  // Deterministic timeout seam for delayed passive recovery takeover in the
+  // host-side DSoftBus fake. Zero selects the production recovery interval.
+  uint32_t test_dsoftbus_passive_recovery_takeover_ms = 0;
 };
 
 /// Point-in-time backend state for health reporting. One per started
diff --git a/src/transport_dsoftbus.cpp b/src/transport_dsoftbus.cpp
index c34e4e6..3bafb76 100644
--- a/src/transport_dsoftbus.cpp
+++ b/src/transport_dsoftbus.cpp
@@ -126,19 +126,20 @@ constexpr uint32_t kPeerPollMs = 2000;
 // the detection timestamps (60 s TTL) expire between probes.
 constexpr uint32_t kBindRetryMs = 10000;
 constexpr uint32_t kBindDeniedBackoffMs = 65000;
-// Normally the lexical networkId order selects exactly one dialer.  A channel
-// shutdown is not guaranteed to be reported symmetrically by DSoftBus,
-// however: the passive endpoint can lose its fd while the designated dialer
-// still sees its local fd as alive.  After two complete peer polls, let the
-// endpoint which observed the genuine shutdown take over the dial.  The delay
-// gives a designated peer which also observed the shutdown the first chance to
-// reconnect and keeps ordinary steady-state discovery single-dialer.
-constexpr uint32_t kPassiveRecoveryTakeoverMs = 2 * kPeerPollMs;
 // SendBytes on the KaihongOS TCP-direct channel waits internally for an ACK
 // for at most 20 seconds.  If the call is still in flight after an additional
 // grace period, the local SDK has failed to surface the peer's receive-side
 // shutdown. Retire the stale channel so the designated dialer can reconnect.
 constexpr uint32_t kStuckSendTimeoutMs = 25000;
+// Normally the lexical networkId order selects exactly one dialer. A channel
+// shutdown is not guaranteed to be reported symmetrically by DSoftBus,
+// however: the passive endpoint can lose its fd while the designated dialer
+// still sees its local fd as alive. Give the designated side one complete
+// stuck-send recovery window before allowing the endpoint which observed the
+// genuine shutdown to take over. This preserves single-dialer behavior across
+// an ordinary restart while retaining bounded recovery from an asymmetric
+// black hole.
+constexpr uint32_t kPassiveRecoveryTakeoverMs = kStuckSendTimeoutMs;
 // Lane backpressure budgets (kaihong values): per-peer queue and one shared
 // ceiling across all peers of this transport. A full 8 MiB ROS payload is
 // serialized as MDDS frames, so its wire footprint is slightly greater than
@@ -742,6 +743,12 @@ private:
     }
   }
 
+  uint32_t passive_recovery_takeover_ms() const noexcept {
+    return config_.test_dsoftbus_passive_recovery_takeover_ms != 0
+               ? config_.test_dsoftbus_passive_recovery_takeover_ms
+               : kPassiveRecoveryTakeoverMs;
+  }
+
   static void stop_lane_noexcept(const std::shared_ptr<SendLane> &lane) noexcept {
     if (!lane) {
       return;
@@ -1455,7 +1462,7 @@ private:
             st.recovery_dial_allowed = true;
             st.recovery_dial_not_before =
                 std::chrono::steady_clock::now() +
-                std::chrono::milliseconds(kPassiveRecoveryTakeoverMs);
+                std::chrono::milliseconds(passive_recovery_takeover_ms());
           }
         } else if (st.pending_fd == fd) {
           st.pending_fd = -1;
@@ -1530,7 +1537,7 @@ private:
           peer_id = detach_channel_locked(st, stuck_lane);
           st.recovery_dial_allowed = true;
           st.recovery_dial_not_before =
-              now + std::chrono::milliseconds(kPassiveRecoveryTakeoverMs);
+              now + std::chrono::milliseconds(passive_recovery_takeover_ms());
           st.next_bind_at = now;
           break;
         }
@@ -1584,7 +1591,7 @@ private:
         st.recovery_dial_allowed = true;
         st.recovery_dial_not_before =
             std::chrono::steady_clock::now() +
-            std::chrono::milliseconds(kPassiveRecoveryTakeoverMs);
+            std::chrono::milliseconds(passive_recovery_takeover_ms());
         if (lane) {
           lanes.push_back(std::move(lane));
         }
