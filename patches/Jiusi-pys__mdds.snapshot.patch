+// Per-writer and participant-global reorder caps are hostile-input hard limits,
+// not license to cumulatively ACK a recoverable hole.  Swallow every ACK and
+// HEARTBEAT until seq 3 has produced a fresh base-2 ACK, so writer-side retry
+// cannot heal seq 2 first and bypass the rejection path.  The rejected copy is
+// then requested again after seq 2 heals and arrives contiguously without a
+// reorder allocation.
+TEST(ReliabilityTest, ReorderBudgetRejectionRetriesWithoutCumulativeAck) {
+  struct BudgetCase {
+    const char *name;
+    size_t per_writer;
+    size_t total;
+  };
+  constexpr size_t kPayloadBytes = 4;
+  for (const BudgetCase budget : {
+           BudgetCase{"per_writer", kPayloadBytes - 1, kPayloadBytes * 2},
+           BudgetCase{"participant_global", kPayloadBytes,
+                      kPayloadBytes - 1},
+       }) {
+    SCOPED_TRACE(budget.name);
+    std::atomic<bool> release_seq2{false};
+    std::atomic<size_t> seq2_sends{0};
+    std::atomic<size_t> seq3_sends{0};
+    std::atomic<size_t> acks_at_base2{0};
+    std::atomic<uint64_t> max_ack_base_before_release{0};
+
+    auto writer_config = test_config_3();
+    writer_config.test_send_hook = [&](const uint8_t *frame, size_t len) {
+      mdds::FrameHeader header{};
+      if (mdds::decode_header(frame, len, header) &&
+          header.type == mdds::FrameType::HEARTBEAT &&
+          !release_seq2.load(std::memory_order_acquire)) {
+        return true;
+      }
+      if (is_data_seq(frame, len, 2)) {
+        seq2_sends.fetch_add(1, std::memory_order_relaxed);
+        return !release_seq2.load(std::memory_order_acquire);
+      }
+      if (is_data_seq(frame, len, 3)) {
+        seq3_sends.fetch_add(1, std::memory_order_relaxed);
+      }
+      return false;
+    };
+    auto reader_config = test_config_3();
+    reader_config.max_reorder_bytes_per_writer = budget.per_writer;
+    reader_config.max_reorder_bytes_total = budget.total;
+    reader_config.test_send_hook = [&](const uint8_t *frame, size_t len) {
+      mdds::AckNackBody body{};
+      if (!mdds::decode_acknack(frame, len, body)) {
+        return false;
+      }
+      if (body.base_seq == 2) {
+        acks_at_base2.fetch_add(1, std::memory_order_relaxed);
+      }
+      if (!release_seq2.load(std::memory_order_acquire)) {
+        uint64_t observed =
+            max_ack_base_before_release.load(std::memory_order_relaxed);
+        while (observed < body.base_seq &&
+               !max_ack_base_before_release.compare_exchange_weak(
+                   observed, body.base_seq, std::memory_order_relaxed)) {
+        }
+        return true;
+      }
+      return false;
+    };
+
+    auto publisher = mdds::Participant::create(writer_config);
+    auto subscriber = mdds::Participant::create(reader_config);
+    ASSERT_NE(publisher, nullptr);
+    ASSERT_NE(subscriber, nullptr);
+    auto qos = default_qos();
+    qos.history = mdds::History::KEEP_ALL;
+    auto *writer = publisher->create_writer(
+        "/reorder_budget_retry_" + std::string(budget.name),
+        "test/ReorderBudgetRetry", qos);
+    auto *reader = subscriber->create_reader(
+        "/reorder_budget_retry_" + std::string(budget.name),
+        "test/ReorderBudgetRetry", qos);
+    ASSERT_NE(writer, nullptr);
+    ASSERT_NE(reader, nullptr);
+    ASSERT_TRUE(wait_matched(writer, 1));
+    ASSERT_TRUE(wait_reader_matched(reader, 1));
+    ASSERT_TRUE(wait_until(
+        [&] { return writer->history_status().active_associations == 1; }, 5s,
+        5ms));
+
+    const uint8_t payload[kPayloadBytes] = {0xA1, 0xB2, 0xC3, 0xD4};
+    ASSERT_TRUE(writer->write(payload, sizeof(payload))); // seq 1
+    std::vector<uint8_t> out;
+    mdds::MessageInfo info;
+    ASSERT_TRUE(wait_until([&] { return reader->take(out, info); }, 5s, 5ms));
+    ASSERT_EQ(info.seq, 1u);
+    ASSERT_TRUE(wait_until([&] { return acks_at_base2.load() >= 1; }, 5s, 5ms));
+
+    const size_t acks_before =
+        acks_at_base2.load(std::memory_order_acquire);
+    ASSERT_TRUE(writer->write(payload, sizeof(payload))); // seq 2: dropped
+    ASSERT_TRUE(writer->write(payload, sizeof(payload))); // seq 3: rejected
+    ASSERT_TRUE(wait_until(
+        [&] {
+          return acks_at_base2.load(std::memory_order_acquire) > acks_before;
+        },
+        5s, 5ms));
+    EXPECT_EQ(max_ack_base_before_release.load(), 2u)
