   SOURCE_SUBDIR orocos_kdl
   GLOBAL_HOOK
   CMAKE_ARGS
@@ -25,6 +26,41 @@ ament_vendor(orocos_kdl_vendor
   PATCHES patches
 )
 
+if(DEFINED ROS2_OHOS_COMMAND_LINE_TOOLS_ROOT)
+  list(APPEND orocos_kdl_vendor_args
+    CMAKE_ARGS
+      -DROS2_OHOS_COMMAND_LINE_TOOLS_ROOT:PATH=${ROS2_OHOS_COMMAND_LINE_TOOLS_ROOT})
+endif()
+
+if(DEFINED OHOS_ARCH)
+  list(APPEND orocos_kdl_vendor_args
+    CMAKE_ARGS
+      -DOHOS_ARCH:STRING=${OHOS_ARCH})
+endif()
+
+if(DEFINED EIGEN3_INCLUDE_DIR)
+  list(APPEND orocos_kdl_vendor_args
+    CMAKE_ARGS
+      -DEIGEN3_INCLUDE_DIR:PATH=${EIGEN3_INCLUDE_DIR})
+endif()
+
+if(OROCOS_KDL_VENDOR_VCS_URL)
+  list(APPEND orocos_kdl_vendor_args
+    VCS_URL "${OROCOS_KDL_VENDOR_VCS_URL}")
+  if(OROCOS_KDL_VENDOR_VCS_VERSION)
+    list(APPEND orocos_kdl_vendor_args
+      VCS_VERSION "${OROCOS_KDL_VENDOR_VCS_VERSION}")
+  endif()
+else()
+  list(APPEND orocos_kdl_vendor_args
+    VCS_URL https://github.com/orocos/orocos_kinematics_dynamics.git
+    VCS_VERSION ce4bcb65a050615b6d7f21bc60fbb2656515791b)
+endif()
+
+ament_vendor(orocos_kdl_vendor
+  ${orocos_kdl_vendor_args}
+)
