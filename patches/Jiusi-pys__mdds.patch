+/// A stop issued from INSIDE a dispatched callback must still wait for
+/// callbacks executing on OTHER threads of the same generation — only its
+/// own frame is tolerated. This is the UAF the round-2 drain skip allowed.
+TEST_F(CallbackRegistryTest, SelfDrainWaitsForOtherHandlers)
+{
+  FakeInstance inst;
+  const uint64_t gen = registry_.Register(&inst);
+  ASSERT_NE(gen, 0u);
+
+  std::atomic<bool> drain_returned{false};
+
+  // Thread "parked": pins the registry and blocks inside its handler until
+  // the main thread opens the gate.
+  std::thread parked([this, &inst] {
+      if (registry_.Acquire() == nullptr) {
+        return;
+      }
+      inst.mark_entered();
+      inst.wait_gate("parked-leave");
+      registry_.Release();
+    });
+
+  inst.wait_entered(1);  // `parked` holds its pin before any drain can start
+
+  // Thread "self_stopper": pins the registry (its own dispatch frame), then
+  // issues the stop-from-callback. It must block until `parked` Releases.
+  std::thread self_stopper([this, &inst, gen, &drain_returned] {
+      FakeInstance * pin = registry_.Acquire();
+      if (pin == nullptr) {
+        return;
+      }
+      inst.mark_entered();
+      registry_.UnregisterAndDrain(pin, gen, true);
+      inst.log("drain-returned");
+      drain_returned.store(true);
+      registry_.Release(true);
+    });
+
+  inst.wait_entered(2);
+  // Give the self-drain a chance to (incorrectly) return early.
+  std::this_thread::sleep_for(50ms);
+  EXPECT_FALSE(drain_returned.load())
+    << "self-drain returned while another handler was still in flight";
+
+  inst.open_gate();
+  parked.join();
+  self_stopper.join();
+
+  const std::vector<std::string> events = inst.snapshot();
+  const auto it_leave = std::find(events.begin(), events.end(), "parked-leave");
+  const auto it_drain = std::find(events.begin(), events.end(), "drain-returned");
+  ASSERT_TRUE(it_leave != events.end());
+  ASSERT_TRUE(it_drain != events.end());
+  EXPECT_LT(it_leave, it_drain)
+    << "drain returned before the parked handler left";
+  EXPECT_EQ(registry_.Acquire(), nullptr);
+  registry_.MarkCleanupDone(gen);
+}
+
+/// A self-draining callback may finish owner cleanup before its C dispatch
+/// stub has executed Release(). That old Release must never be allowed to
+/// decrement a newly registered generation. Registration therefore stays
+/// blocked until the self frame actually unwinds.
+TEST_F(CallbackRegistryTest, SelfDrainReleasePrecedesNextGeneration)
+{
+  FakeInstance a;
+  FakeInstance b;
+  const uint64_t gen_a = registry_.Register(&a);
+  ASSERT_NE(gen_a, 0u);
+
+  FakeInstance * pin = registry_.Acquire();
+  ASSERT_EQ(pin, &a);
+  ASSERT_TRUE(registry_.UnregisterAndDrain(pin, gen_a, true));
+  registry_.MarkCleanupDone(gen_a);
+
+  std::atomic<bool> registered{false};
+  uint64_t gen_b = 0;
+  std::thread next([this, &b, &registered, &gen_b] {
+      gen_b = registry_.Register(&b);
+      registered.store(true);
+    });
+
+  std::this_thread::sleep_for(200ms);
+  EXPECT_FALSE(registered.load())
+    << "new generation registered before the old self-dispatch Released";
+
+  // This mirrors the dispatch stub unwinding after stop()/owner cleanup.
+  registry_.Release(true);
+  next.join();
+
+  ASSERT_TRUE(registered.load());
+  ASSERT_GT(gen_b, gen_a);
+  EXPECT_EQ(registry_.Acquire(), &b);
+  registry_.Release();
+  registry_.UnregisterAndDrain(&b, gen_b, false);
+  registry_.MarkCleanupDone(gen_b);
