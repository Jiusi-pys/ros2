diff --git a/rviz_rendering/ogre_media/materials/glsles/pass_color_circle.frag b/rviz_rendering/ogre_media/materials/glsles/pass_color_circle.frag
new file mode 100644
index 00000000..f1bf34b9
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/pass_color_circle.frag
@@ -0,0 +1,21 @@
+precision highp float;
+
+// Draws a circle in the fragment color
+// GLES2 port: gl_Color -> frontColour, gl_TexCoord[0] -> texCoord0;
+// circle_impl.frag inlined (glsles has no `attach`)
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+// rasterizes a circle of radius 0.5
+void circleImpl( vec4 color, float ax, float ay )
+{
+  float rsquared = ax*ax+ay*ay;
+  float a = (0.25 - rsquared) * 4.0;
+  gl_FragColor = vec4(color.rgb, color.a * ceil(a));
+}
+
+void main()
+{
+  circleImpl( frontColour, texCoord0.x-0.5, texCoord0.y-0.5 );
+}
