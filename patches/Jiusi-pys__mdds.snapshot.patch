+// Two filters on different Participants must not each hold one writer's
+// publish mutex and then wait forever for the other. Every filter-stack write
+// is rejected before any participant/publish mutex is acquired.
+TEST(WriterConcurrency, CrossParticipantFilterPublishCannotFormAbbaDeadlock) {
+  auto participant_a = mdds::Participant::create(test_config_3());
+  auto participant_b = mdds::Participant::create(test_config_3());
+  ASSERT_NE(participant_a, nullptr);
