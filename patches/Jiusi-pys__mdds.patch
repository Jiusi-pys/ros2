+// set_data_callback(nullptr) is a callback-context retirement point, not just
+// a future-notification toggle. The second write stops after a safe shared
+// callback-slot snapshot; clear then advances the generation before that
+// snapshot is allowed to commit execution.
+TEST(ReaderCallback, ClearDrainsAndFencesSnapshottedSharedSlot) {
+  auto cfg = test_config_3();
+  auto state = std::make_shared<CallbackLifecycleState>();
+  std::atomic<bool> lifecycle_armed{false};
+  cfg.test_data_callback_lifecycle_hook = [state, &lifecycle_armed](
+      const char *stage) {
+    if (!lifecycle_armed.load(std::memory_order_acquire)) {
+      return;
+    }
+    std::unique_lock<std::mutex> lock(state->mutex);
+    if (std::strcmp(stage, "snapshotted") == 0) {
+      ++state->snapshots;
+      if (state->snapshots == 2) {
+        state->second_snapshotted = true;
+        state->cv.notify_all();
+        state->cv.wait(lock, [state] { return state->release_second_snapshot; });
+      }
+    } else if (std::strcmp(stage, "retired") == 0) {
+      state->retired = true;
+      state->cv.notify_all();
+    }
+  };
+  auto p = mdds::Participant::create(cfg);
+  ASSERT_NE(p, nullptr);
+  auto *w =
+      p->create_writer("/cb_retire", "test/CallbackRetire", default_qos());
+  auto *r =
+      p->create_reader("/cb_retire", "test/CallbackRetire", default_qos());
+  ASSERT_NE(w, nullptr);
+  ASSERT_NE(r, nullptr);
+
+  r->set_data_callback(BlockingDataCallback{state});
+  lifecycle_armed.store(true, std::memory_order_release);
+  const uint8_t sample[] = {0x42};
+
+  std::atomic<bool> first_write_ok{false};
+  std::thread first_writer(
+      [&] { first_write_ok = w->write(sample, sizeof(sample)); });
+  bool first_entered = false;
+  {
+    std::unique_lock<std::mutex> lock(state->mutex);
+    first_entered =
+        state->cv.wait_for(lock, 5s, [&] { return state->first_entered; });
+  }
+  if (!first_entered) {
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      state->release_first = true;
+    }
+    state->cv.notify_all();
+    first_writer.join();
+    FAIL() << "first callback never entered";
+    return;
+  }
+
+  std::atomic<bool> second_write_ok{false};
+  std::thread second_writer(
+      [&] { second_write_ok = w->write(sample, sizeof(sample)); });
+  bool old_slot_snapshotted = false;
+  {
+    std::unique_lock<std::mutex> lock(state->mutex);
+    old_slot_snapshotted = state->cv.wait_for(
+        lock, 5s, [&] { return state->second_snapshotted; });
+  }
+  if (!old_slot_snapshotted) {
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      state->release_first = true;
+    }
+    state->cv.notify_all();
+    first_writer.join();
+    second_writer.join();
+    FAIL() << "second delivery never snapshotted the old callback slot";
+    return;
+  }
+
+  std::atomic<bool> clear_returned{false};
+  std::thread clearer([&] {
+    r->set_data_callback(nullptr);
+    clear_returned = true;
+  });
+  bool retired = false;
+  {
+    std::unique_lock<std::mutex> lock(state->mutex);
+    retired = state->cv.wait_for(lock, 5s, [&] { return state->retired; });
+  }
+  if (!retired) {
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      state->release_second_snapshot = true;
+      state->release_first = true;
+    }
+    state->cv.notify_all();
+    first_writer.join();
+    second_writer.join();
+    clearer.join();
+    FAIL() << "clear did not retire the callback generation";
+    return;
+  }
+  // clear() has fenced the snapshotted stale slot, but cannot return until
+  // the first active old invocation drains.
+  EXPECT_FALSE(clear_returned.load());
+
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->release_second_snapshot = true;
+  }
+  state->cv.notify_all();
+
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->release_first = true;
+  }
+  state->cv.notify_all();
+  first_writer.join();
+  second_writer.join();
+  clearer.join();
+
+  EXPECT_TRUE(first_write_ok.load());
+  EXPECT_TRUE(second_write_ok.load());
+  EXPECT_TRUE(clear_returned.load());
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    EXPECT_EQ(state->invocations, 1u)
+        << "the copied old closure ran after clear() retired it";
+  }
+
+  ASSERT_TRUE(w->write(sample, sizeof(sample)));
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    EXPECT_EQ(state->invocations, 1u) << "cleared callback ran on later data";
+  }
+}
