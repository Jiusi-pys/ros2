+// A response-lane filter is application code. It must be able to retire
+// itself from inside operator() without attempting to take queue_mutex_ a
+// second time. The old implementation called the filter while holding that
+// mutex and deterministically deadlocked here.
+TEST(ReaderCallback, SampleFilterMayClearItselfOutsideQueueMutex) {
+  auto p = mdds::Participant::create(test_config_3());
+  ASSERT_NE(p, nullptr);
+  auto *w = p->create_writer(
+      "/filter_reentry", "test/FilterReentry", default_qos());
+  auto *r = p->create_reader(
+      "/filter_reentry", "test/FilterReentry", default_qos());
+  ASSERT_NE(w, nullptr);
+  ASSERT_NE(r, nullptr);
+
+  auto state = std::make_shared<ReentrantSampleFilterState>();
+  state->reader = r;
+  r->set_sample_filter(ReentrantSampleFilter{state});
+  state->arm.store(true, std::memory_order_release);
+  ASSERT_TRUE(wait_matched(w, 1));
+
+  const uint8_t sample[] = {0x7A};
+  std::atomic<bool> write_done{false};
+  std::atomic<bool> write_ok{false};
+  std::thread writer([&] {
+    write_ok.store(w->write(sample, sizeof(sample)), std::memory_order_release);
+    write_done.store(true, std::memory_order_release);
+  });
+  if (!wait_until([&] { return write_done.load(std::memory_order_acquire); },
+                  5s, 5ms)) {
+    ADD_FAILURE() << "sample filter re-entered queue mutex";
+    std::abort();
+  }
+  writer.join();
+
+  EXPECT_TRUE(write_ok.load(std::memory_order_acquire));
+  EXPECT_TRUE(state->reentered.load(std::memory_order_acquire));
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  EXPECT_TRUE(r->take(out, info));
+  EXPECT_EQ(out, (std::vector<uint8_t>{0x7A}));
+}
+
+// Entitlement is CAUSAL: the boundary is the writer-side association moment
+// (the writer's seq when discovery first shows it the reader), never a wall
+// clock. The reader's device clock runs +1h ahead (test_clock_offset_us
+// shifts every timestamp it stamps) and the sample is written during a
+// discovery blackout — after the reader's birth, before the writer could
+// learn of it. None of that matters: the sample predates the association,
+// so the writer answers the reader's NACK with a silent PRE-JOIN GAP
+// (flags=0) and never retransmits it; only post-association samples arrive,
+// and nothing is counted lost.
+TEST(ReliabilityTest, PreAssociationSampleIsPreJoinDespiteClockSkew) {
+  std::atomic<bool> block_announce{true};
+  std::atomic<bool> saw_prejoin_gap{false};
+  auto cfg_b = test_config_3();
+  cfg_b.test_clock_offset_us = 3600LL * 1000000; // reader clock +1h ahead
+  cfg_b.test_send_hook = [&](const uint8_t *f, size_t n) {
+    mdds::FrameHeader hdr{};
+    if (block_announce.load() && mdds::decode_header(f, n, hdr) &&
+        hdr.type == mdds::FrameType::ANNOUNCE) {
+      return true; // the writer must not discover the reader yet
+    }
+    return false;
+  };
+  auto cfg_a = test_config_3();
+  cfg_a.test_send_hook = [&](const uint8_t *f, size_t n) {
+    mdds::FrameHeader hdr{};
+    if (!mdds::decode_header(f, n, hdr) || hdr.type != mdds::FrameType::GAP) {
+      return false;
+    }
+    mdds::GapBody g{};
+    if (mdds::decode_gap(f, n, g) && g.gap_start == 1 && g.flags == 0) {
+      saw_prejoin_gap = true;
+    }
+    return false;
+  };
+  auto pa = mdds::Participant::create(cfg_a);
+  auto pb = mdds::Participant::create(cfg_b);
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+
+  auto *r =
+      pb->create_reader("/skew", "test/Skew", default_qos()); // born first
+  auto *w = pa->create_writer("/skew", "test/Skew", default_qos());
+  ASSERT_TRUE(wait_reader_matched(r, 1)); // pa->pb direction is not blocked
+  std::this_thread::sleep_for(500ms);     // blackout: the writer stays blind
+  ASSERT_EQ(w->matched_count(), 0u);
+
+  // Pre-association: published before the writer could discover the reader.
+  const char msg[] = "gray";
+  ASSERT_TRUE(w->write(reinterpret_cast<const uint8_t *>(msg), sizeof(msg)));
+
+  block_announce.store(false); // writer discovers the reader (watermark = 1)
+  ASSERT_TRUE(wait_matched(w, 1));
+
+  // Post-association sample: the only one the reader is entitled to.
+  const char msg2[] = "post";
+  ASSERT_TRUE(w->write(reinterpret_cast<const uint8_t *>(msg2), sizeof(msg2)));
+
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  auto deadline = std::chrono::steady_clock::now() + 10s;
+  while (std::chrono::steady_clock::now() < deadline) {
+    if (r->take(out, info)) {
+      break;
+    }
+    std::this_thread::sleep_for(5ms);
+  }
+  ASSERT_FALSE(out.empty()) << "post-association sample never arrived";
+  EXPECT_EQ(info.seq, 2u);
+  EXPECT_EQ(out.size(), sizeof(msg2));
+  std::this_thread::sleep_for(500ms); // let any late replay/GAP settle
+  EXPECT_FALSE(r->take(out, info));   // seq 1 is never delivered
+  EXPECT_EQ(r->messages_lost(), 0u);  // PRE-JOIN GAP seeds silently
+  EXPECT_TRUE(saw_prejoin_gap.load());
+}
+
+// GAP throttling is scoped to the concrete writer-reader route. Two local
+// reliable writers on one peer can both have pre-join history for the same
+// newly discovered reader; suppressing the first writer's GAP must never
+// leave the second writer's receive baseline in a perpetual NACK loop.
+TEST(ReliabilityTest, PreJoinGapIsIndependentPerWriter) {
+  std::mutex gap_mutex;
+  std::set<mdds::Guid> gap_writers;
+  auto cfg_a = test_config_3();
+  cfg_a.test_send_hook = [&](const uint8_t *f, size_t n) {
+    mdds::FrameHeader hdr{};
+    if (!mdds::decode_header(f, n, hdr) || hdr.type != mdds::FrameType::GAP) {
+      return false;
+    }
+    mdds::GapBody gap{};
+    if (mdds::decode_gap(f, n, gap) && gap.gap_start == 1 && gap.flags == 0) {
+      std::lock_guard<std::mutex> lock(gap_mutex);
+      gap_writers.insert(gap.writer);
+    }
+    return false;
+  };
+  auto pa = mdds::Participant::create(cfg_a);
+  auto pb = mdds::Participant::create(test_config_3());
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+
+  auto *w1 = pa->create_writer("/gap-two", "test/GapTwo", default_qos());
+  auto *w2 = pa->create_writer("/gap-two", "test/GapTwo", default_qos());
+  ASSERT_NE(w1, nullptr);
+  ASSERT_NE(w2, nullptr);
+  const char pre[] = "pre";
+  ASSERT_TRUE(w1->write(reinterpret_cast<const uint8_t *>(pre), sizeof(pre)));
+  ASSERT_TRUE(w2->write(reinterpret_cast<const uint8_t *>(pre), sizeof(pre)));
+
+  auto *r = pb->create_reader("/gap-two", "test/GapTwo", default_qos());
+  ASSERT_NE(r, nullptr);
+  ASSERT_TRUE(wait_matched(w1, 1));
+  ASSERT_TRUE(wait_matched(w2, 1));
+
+  const auto deadline = std::chrono::steady_clock::now() + 10s;
+  while (std::chrono::steady_clock::now() < deadline) {
+    bool both = false;
+    {
+      std::lock_guard<std::mutex> lock(gap_mutex);
+      both = gap_writers.count(w1->guid()) != 0 &&
+             gap_writers.count(w2->guid()) != 0;
+    }
+    if (both) {
+      break;
+    }
+    std::this_thread::sleep_for(10ms);
+  }
+  {
+    std::lock_guard<std::mutex> lock(gap_mutex);
+    EXPECT_EQ(gap_writers.count(w1->guid()), 1u);
+    EXPECT_EQ(gap_writers.count(w2->guid()), 1u);
+  }
+  EXPECT_EQ(r->messages_lost(), 0u);
+}
