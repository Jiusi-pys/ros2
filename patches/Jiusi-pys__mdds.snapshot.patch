+      "/filter_abba_a", "test/FilterAbbaA", default_qos());
+  auto *reader_a = participant_a->create_reader(
+      "/filter_abba_a", "test/FilterAbbaA", default_qos());
+  auto *writer_b = participant_b->create_writer(
+      "/filter_abba_b", "test/FilterAbbaB", default_qos());
+  auto *reader_b = participant_b->create_reader(
+      "/filter_abba_b", "test/FilterAbbaB", default_qos());
+  ASSERT_NE(writer_a, nullptr);
+  ASSERT_NE(reader_a, nullptr);
+  ASSERT_NE(writer_b, nullptr);
+  ASSERT_NE(reader_b, nullptr);
+  ASSERT_TRUE(wait_matched(writer_a, 1));
+  ASSERT_TRUE(wait_matched(writer_b, 1));
+
+  std::mutex barrier_mutex;
+  std::condition_variable barrier_cv;
+  size_t filters_entered = 0;
+  std::atomic<bool> nested_a_result{true};
+  std::atomic<bool> nested_b_result{true};
+  auto wait_for_both_filters = [&] {
+    std::unique_lock<std::mutex> lock(barrier_mutex);
+    ++filters_entered;
+    barrier_cv.notify_all();
+    barrier_cv.wait(lock, [&] { return filters_entered == 2; });
+  };
+  reader_a->set_sample_filter([&](const uint8_t *, size_t) {
+    wait_for_both_filters();
+    const uint8_t nested = 0xB1;
+    nested_a_result.store(writer_b->write(&nested, sizeof(nested)),
+                          std::memory_order_release);
+    return true;
+  });
+  reader_b->set_sample_filter([&](const uint8_t *, size_t) {
+    wait_for_both_filters();
+    const uint8_t nested = 0xA1;
+    nested_b_result.store(writer_a->write(&nested, sizeof(nested)),
+                          std::memory_order_release);
+    return true;
+  });
+
+  std::atomic<size_t> writes_done{0};
+  std::atomic<bool> outer_a_ok{false};
+  std::atomic<bool> outer_b_ok{false};
+  const uint8_t sample_a = 0xA0;
+  const uint8_t sample_b = 0xB0;
+  std::thread thread_a([&] {
+    outer_a_ok.store(writer_a->write(&sample_a, sizeof(sample_a)),
+                     std::memory_order_release);
+    writes_done.fetch_add(1, std::memory_order_release);
+  });
+  std::thread thread_b([&] {
+    outer_b_ok.store(writer_b->write(&sample_b, sizeof(sample_b)),
+                     std::memory_order_release);
+    writes_done.fetch_add(1, std::memory_order_release);
+  });
+  if (!wait_until(
+          [&] { return writes_done.load(std::memory_order_acquire) == 2; }, 5s,
+          5ms)) {
+    ADD_FAILURE() << "cross-writer sample-filter publish deadlocked";
+    std::abort();
+  }
+  thread_a.join();
+  thread_b.join();
+  EXPECT_TRUE(outer_a_ok.load(std::memory_order_acquire));
+  EXPECT_TRUE(outer_b_ok.load(std::memory_order_acquire));
+  EXPECT_FALSE(nested_a_result.load(std::memory_order_acquire));
+  EXPECT_FALSE(nested_b_result.load(std::memory_order_acquire));
+}
