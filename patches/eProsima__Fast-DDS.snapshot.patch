diff --git a/test/ohos/check_topic_description_rtti.py b/test/ohos/check_topic_description_rtti.py
new file mode 100644
index 0000000000000000000000000000000000000000..3ca6a17edcf05c0d5fbf32e34466b0dc340ab819
--- /dev/null
+++ b/test/ohos/check_topic_description_rtti.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+
+"""Verify the OpenHarmony cross-DSO TopicDescription RTTI ownership contract."""
+
+import argparse
+import hashlib
+import pathlib
+import subprocess
+import sys
+
+
+TYPEINFO_SYMBOLS = (
+    "_ZTIN8eprosima7fastdds3dds16TopicDescriptionE",
+    "_ZTIN8eprosima7fastdds3dds5TopicE",
+)
+KEY_FUNCTION_SYMBOL = "_ZN8eprosima7fastdds3dds16TopicDescriptionD1Ev"
+
+
+def read_symbols(readelf: pathlib.Path, library: pathlib.Path) -> list[str]:
+    result = subprocess.run(
+        [str(readelf), "--syms", "--wide", str(library)],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return result.stdout.splitlines()
+
+
+def symbol_lines(lines: list[str], symbol: str) -> list[str]:
+    return [line for line in lines if symbol in line]
+
+
+def is_undefined(line: str) -> bool:
+    return " UND " in f" {line} "
+
+
+def sha256(path: pathlib.Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--readelf", required=True, type=pathlib.Path)
+    parser.add_argument("--provider", required=True, type=pathlib.Path)
+    parser.add_argument("--consumer", required=True, type=pathlib.Path)
+    args = parser.parse_args()
+
+    provider_lines = read_symbols(args.readelf, args.provider)
+    consumer_lines = read_symbols(args.readelf, args.consumer)
+    failures: list[str] = []
+
+    for symbol in TYPEINFO_SYMBOLS:
+        provider_matches = symbol_lines(provider_lines, symbol)
+        consumer_matches = symbol_lines(consumer_lines, symbol)
+        if not provider_matches or all(is_undefined(line) for line in provider_matches):
+            failures.append(f"provider does not define {symbol}")
+        if not consumer_matches:
+            failures.append(f"consumer does not reference {symbol}")
+        elif any(not is_undefined(line) for line in consumer_matches):
+            failures.append(f"consumer unexpectedly defines {symbol}")
+
+    key_function_matches = symbol_lines(provider_lines, KEY_FUNCTION_SYMBOL)
+    if not key_function_matches or all(is_undefined(line) for line in key_function_matches):
+        failures.append(f"provider does not define key function {KEY_FUNCTION_SYMBOL}")
+
+    if failures:
+        for failure in failures:
+            print(f"FAIL: {failure}", file=sys.stderr)
+        return 1
+
+    print("TOPIC_DESCRIPTION_RTTI_CONTRACT=PASS")
+    print(f"PROVIDER_SHA256={sha256(args.provider)}")
+    print(f"CONSUMER_SHA256={sha256(args.consumer)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
