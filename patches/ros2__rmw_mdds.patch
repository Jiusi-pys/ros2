diff --git a/rmw_mdds/src/init.cpp b/rmw_mdds/src/init.cpp
index f180225..92f47e6 100644
--- a/rmw_mdds/src/init.cpp
+++ b/rmw_mdds/src/init.cpp
@@ -69,6 +69,33 @@ parse_transport_env(mdds::ParticipantConfig & config)
   return true;
 }
 
+// MDDS_UDP_PEER_ALLOW restricts cross-device UDP traffic to the given
+// comma-separated IPv4 CIDRs (e.g. "192.168.77.0/24"). Multi-homed devices
+// use it to pin mdds traffic to one network (loopback is always allowed).
+// Unset or empty allows all subnets.
+void
+parse_peer_allow_env(mdds::ParticipantConfig & config)
+{
+  const char * env = std::getenv("MDDS_UDP_PEER_ALLOW");
+  if (env == nullptr || env[0] == '\0') {
+    return;
+  }
+  std::string spec(env);
+  size_t start = 0;
+  while (start <= spec.size()) {
+    const size_t comma = spec.find(',', start);
+    const std::string token = spec.substr(
+      start, comma == std::string::npos ? std::string::npos : comma - start);
+    if (!token.empty()) {
+      config.udp_peer_allow_cidrs.push_back(token);
+    }
+    if (comma == std::string::npos) {
+      break;
+    }
+    start = comma + 1;
+  }
+}
+
 }  // namespace
 
 extern "C" rmw_ret_t
@@ -196,6 +223,7 @@ rmw_init(const rmw_init_options_t * options, rmw_context_t * context)
     delete impl;
     return RMW_RET_ERROR;
   }
+  parse_peer_allow_env(config);
   impl->participant = mdds::Participant::create(config);
   if (impl->participant == nullptr) {
     RMW_SET_ERROR_MSG("failed to create mdds participant");
