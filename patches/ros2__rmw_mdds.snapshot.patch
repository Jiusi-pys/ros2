+  CdrWriter writer(opposite_endian);
+  write_members(writer, &long_double_members, &original);
+  ASSERT_EQ(20u, opposite_endian.size());
+  opposite_endian[1] = opposite_endian[1] == 1 ? 0 : 1;
+
+#if defined(__SIZEOF_FLOAT128__) && __SIZEOF_FLOAT128__ == 16
+  constexpr bool uses_full_width = sizeof(long double) < 16 || sizeof(long double) == 16;
+#else
+  constexpr bool uses_full_width = sizeof(long double) == 16;
+#endif
+  if constexpr (uses_full_width) {
+    std::reverse(opposite_endian.begin() + 4, opposite_endian.end());
+  } else {
