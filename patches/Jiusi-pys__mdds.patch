+  /// Stage every new writer->reader reliable obligation required by a
+  /// candidate ANNOUNCE.  Staging map nodes before the discovery commit makes
+  /// the endpoint visible and its history debt appear together: an accepted
+  /// reader can never receive live data without an already-reserved bounded
+  /// association record.  A missing remote challenge creates PENDING debt;
+  /// it is activated only when the challenge arrives, but it still prevents
+  /// unsafe history reclamation in the meantime.
+  bool stage_reliable_associations_for_snapshot_locked(
+      const Guid &remote_participant, PeerId peer,
+      const ParticipantSnapshot &candidate,
+      std::map<AssociationKey, ReliableAssociation> &staged) {
+    for (const auto &ep : candidate.endpoints) {
+      if (ep.kind != EntityKind::READER ||
+          ep.qos.reliability != Reliability::RELIABLE) {
+        continue;
+      }
+      for (const auto &writer_kv : writers_) {
+        WriterImpl *w = writer_kv.first;
+        if (w->qos_.reliability != Reliability::RELIABLE ||
+            ep.topic != w->topic_ || ep.type_name != w->type_ ||
+            !qos_compatible(ep.qos, w->qos_)) {
+          continue;
+        }
+        const AssociationKey key = association_key(
+            w->guid_, w->epoch_, ep.guid, ep.epoch);
+        if (reliable_associations_.count(key) != 0 ||
+            staged.count(key) != 0) {
+          continue;
+        }
+        if (reliable_associations_.size() + staged.size() >=
+            config_.max_reliable_associations) {
+          return false;
+        }
+        ReliableAssociation association;
+        association.remote_participant = remote_participant;
+        association.peer = peer;
+        // A volatile reader joins at the writer's current frontier. A durable
+        // reader may be entitled to retained history, but that history is
+        // never ACK-reclaimed in the TRANSIENT_LOCAL branch below.
+        association.entitlement_first_seq =
+            ep.qos.durability == Durability::TRANSIENT_LOCAL
+                ? 1
+                : w->seq_.load() + 1;
+        association.acked_through = association.entitlement_first_seq - 1;
+        Guid nonce;
+        if (reader_session_nonce_locked(peer, remote_participant, nonce)) {
+          association.reader_session_nonce = nonce;
+          association.association_epoch = generate_endpoint_epoch();
+          association.state = ReliableAssociationState::ACTIVE;
+        }
