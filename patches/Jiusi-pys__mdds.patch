+TEST(Qos, WireRejectsInvalidProfileWithoutOverwritingOutput)
+{
+  const auto valid = mdds::QosProfile::preset_default();
+  std::array<uint8_t, mdds::kQosWireSize> wire{};
+  mdds::encode_qos(wire.data(), valid);
+
+  const auto sentinel = mdds::QosProfile::preset_sensor_data();
+  std::array<uint8_t, mdds::kQosWireSize> sentinel_wire{};
+  mdds::encode_qos(sentinel_wire.data(), sentinel);
+
+  const auto expect_rejected_without_mutation = [&](const auto & invalid_wire) {
+      auto decoded = sentinel;
+      EXPECT_FALSE(mdds::decode_qos(
+          invalid_wire.data(), invalid_wire.size(), decoded));
+      std::array<uint8_t, mdds::kQosWireSize> decoded_wire{};
+      mdds::encode_qos(decoded_wire.data(), decoded);
+      EXPECT_EQ(decoded_wire, sentinel_wire);
+    };
+
+  // Every enum is a two-value wire enum. Values outside that range must be
+  // rejected rather than leaking into RxO/reliability state machines. Test a
+  // nearby invalid value and the full-width hostile byte for every field.
+  for (size_t enum_offset = 0; enum_offset < 4; ++enum_offset) {
+    for (const uint8_t invalid_value : {static_cast<uint8_t>(2),
+                                        static_cast<uint8_t>(0xff)}) {
+      auto invalid = wire;
+      invalid[enum_offset] = invalid_value;
+      expect_rejected_without_mutation(invalid);
+    }
+  }
+
+  // KEEP_LAST with depth zero is invalid too, even though all enum bytes are
+  // otherwise legal.
+  auto zero_depth = wire;
+  zero_depth[4] = 0;
+  zero_depth[5] = 0;
+  zero_depth[6] = 0;
+  zero_depth[7] = 0;
+  expect_rejected_without_mutation(zero_depth);
+}
+
+TEST(Qos, CompatibilityFailsClosedOnInvalidProfile)
+{
+  const auto valid = mdds::QosProfile::preset_default();
+  auto invalid = valid;
+  invalid.reliability = static_cast<mdds::Reliability>(0xff);
+  EXPECT_FALSE(mdds::qos_compatible(valid, invalid));
+  EXPECT_FALSE(mdds::qos_compatible(invalid, valid));
+}
+
 }  // namespace
