+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef CONSTRUCTION_LATCH_HPP_
+#define CONSTRUCTION_LATCH_HPP_
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace mdds_gateway
+{
+
+/// One shared decision for every asynchronous path created by TopicBridge.
+/// No worker may consume input, and no executor callback may hand input off,
+/// until construction reaches COMMITTED. Any failed constructor publishes
+/// CANCELLED before waking and joining its workers.
+class ConstructionLatch
+{
+public:
+  enum class Phase : uint8_t
+  {
+    PENDING,
+    COMMITTED,
+    CANCELLED,
+  };
+
+  ConstructionLatch() = default;
+  ConstructionLatch(const ConstructionLatch &) = delete;
+  ConstructionLatch & operator=(const ConstructionLatch &) = delete;
+
+  bool commit() noexcept
+  {
+    bool committed = false;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      Phase expected = Phase::PENDING;
+      committed = phase_.compare_exchange_strong(
+        expected, Phase::COMMITTED, std::memory_order_release, std::memory_order_acquire);
+    }
+    cv_.notify_all();
+    return committed;
+  }
+
+  void cancel() noexcept
+  {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      phase_.store(Phase::CANCELLED, std::memory_order_release);
+    }
+    cv_.notify_all();
+  }
+
+  bool wait_for_commit() noexcept
+  {
+    std::unique_lock<std::mutex> lock(mutex_);
+    cv_.wait(lock, [this] {
+        return phase_.load(std::memory_order_acquire) != Phase::PENDING;
+      });
+    return phase_.load(std::memory_order_acquire) == Phase::COMMITTED;
+  }
+
+  bool is_committed() const noexcept
+  {
+    return phase_.load(std::memory_order_acquire) == Phase::COMMITTED;
+  }
+
+private:
+  std::atomic<Phase> phase_{Phase::PENDING};
+  std::mutex mutex_;
+  std::condition_variable cv_;
+};
+
+}  // namespace mdds_gateway
+
+#endif  // CONSTRUCTION_LATCH_HPP_
