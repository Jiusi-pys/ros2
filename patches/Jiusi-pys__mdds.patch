+bool snapshot_has_guid(const mdds::ParticipantSnapshot &snapshot,
+                       const mdds::Guid &guid) {
+  return std::any_of(snapshot.endpoints.begin(), snapshot.endpoints.end(),
+                     [&](const mdds::EndpointRecord &endpoint) {
+                       return endpoint.guid == guid;
+                     });
+}
+
+// One UDP peer is allowed to represent a bounded number of processes, not
+// exactly one (DSoftBus and a gateway can legitimately multiplex them). Once
+// that bounded GUID table is full, a flood cannot evict already-admitted
+// snapshots or grow the global participant table.
+TEST(DiscoveryAdmission, SinglePeerGuidFloodPreservesAdmittedSnapshots) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_participants = 2;
+  cfg.max_remote_participants_per_peer = 2;
+  cfg.max_remote_routes_per_participant = 2;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+
+  const auto first = raw_remote_snapshot(
+      0x11, {raw_remote_endpoint(0x11, mdds::EntityKind::WRITER, 1,
+                                  "/flood", "test/Flood")});
+  const auto second = raw_remote_snapshot(
+      0x12, {raw_remote_endpoint(0x12, mdds::EntityKind::WRITER, 1,
+                                  "/flood", "test/Flood")});
+  const auto overflow = raw_remote_snapshot(
+      0x13, {raw_remote_endpoint(0x13, mdds::EntityKind::WRITER, 1,
+                                  "/flood", "test/Flood")});
+
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, first, 1));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return target->graph_counts().remote_participants == 1;
+  }, 2s, 10ms));
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, second, 1));
+  ASSERT_TRUE(wait_until([&] {
+    peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return target->graph_counts().remote_participants == 2;
+  }, 2s, 10ms));
+
+  ASSERT_TRUE(
+      raw_announce(peer, cfg.domain_id, kTestBasePort5, overflow, 1));
+  // Keep the route live for several transport turns so this checks an actual
+  // rejected ANNOUNCE, rather than a peer timeout removing all evidence.
+  const auto settle_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < settle_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+
+  const auto remotes = target->remote_participants();
+  ASSERT_EQ(remotes.size(), 2u);
+  EXPECT_TRUE(std::any_of(remotes.begin(), remotes.end(), [&](const auto &snap) {
+    return snap.participant_guid == first.participant_guid;
+  }));
+  EXPECT_TRUE(std::any_of(remotes.begin(), remotes.end(), [&](const auto &snap) {
+    return snap.participant_guid == second.participant_guid;
+  }));
+  EXPECT_FALSE(std::any_of(remotes.begin(), remotes.end(), [&](const auto &snap) {
+    return snap.participant_guid == overflow.participant_guid;
+  }));
+}
