+// The per-peer budget caps the sum of declared partial sizes. Completing a
+// sample returns its budget, so a well-behaved peer keeps making progress.
+TEST(Reassembler, PerPeerBudgetCapsTotalPartialBytes)
+{
+  mdds::Reassembler reasm(std::chrono::milliseconds(5000), 4096, 8192);
+  auto w = make_test_guid(0x0c);
+  std::vector<uint8_t> out;
+  uint8_t b[100] = {};
+
+  EXPECT_FALSE(reasm.add_fragment(w, 1, 4000, 0, b, sizeof(b), out));
+  EXPECT_FALSE(reasm.add_fragment(w, 2, 4000, 0, b, sizeof(b), out));
+  EXPECT_EQ(reasm.bytes_in_flight(), 8000u);
+  // 8000 + 4000 would exceed the 8192 per-peer budget.
+  EXPECT_FALSE(reasm.add_fragment(w, 3, 4000, 0, b, sizeof(b), out));
+  EXPECT_EQ(reasm.dropped_over_budget(), 1u);
+
+  // Additional fragments for an already-pending sample are not double-counted.
+  EXPECT_FALSE(reasm.add_fragment(w, 1, 4000, 3900, b, sizeof(b), out));
+  EXPECT_EQ(reasm.bytes_in_flight(), 8000u);
+
+  // Complete sample 1: budget is returned and the third sample fits again.
+  std::vector<uint8_t> frag(2000, 0x02);
+  EXPECT_FALSE(reasm.add_fragment(w, 1, 4000, 0, frag.data(), frag.size(), out));
+  EXPECT_TRUE(reasm.add_fragment(w, 1, 4000, 2000, frag.data(), frag.size(), out));
+  EXPECT_EQ(out.size(), 4000u);
+  EXPECT_EQ(reasm.bytes_in_flight(), 4000u);
+  EXPECT_FALSE(reasm.add_fragment(w, 3, 4000, 0, b, sizeof(b), out));
+  EXPECT_EQ(reasm.pending_count(), 2u);
+}
