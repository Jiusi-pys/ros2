+
+  const auto original = raw_remote_snapshot(
+      0x45, {raw_remote_endpoint(0x45, mdds::EntityKind::WRITER, 1,
+                                 "/qos_omission_reader", "test/QosLedger")});
+  const mdds::Guid writer_guid = original.endpoints.front().guid;
+  const mdds::Guid writer_epoch = original.endpoints.front().epoch;
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, original, 1));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return reader->matched_count() == 1 &&
+               graph_callbacks.load(std::memory_order_relaxed) >= 1;
+      },
+      2s, 10ms));
+
+  const uint8_t before_omission[] = {0x4c, 0x45, 0x44, 0x31};
+  ASSERT_TRUE(peer.send_frame(
