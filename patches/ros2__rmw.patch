+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef RMW__IMPL__CPP__DEMANGLE_HPP_
+#define RMW__IMPL__CPP__DEMANGLE_HPP_
+
+#ifndef _WIN32
+// 用于 abi::__cxa_demangle 的头文件包含。
+#include <cxxabi.h>
+#include <cstdlib>
+#include <memory>
+#endif
+#include <iostream>
+#include <string>
+
+#include "rmw/impl/config.h"
+
+namespace rmw
+{
+namespace impl
+{
+namespace cpp
+{
+
+/// 返回类型为 T 的实例的 demangle 名称。
+template<typename T>
+std::string
+demangle(const T & instance)
+{
+  (void)instance;
+// 如果在 Windows 上或希望避免内存分配，则无法进行 demangle。
+#if !defined(_WIN32) || RMW_AVOID_MEMORY_ALLOCATION
+  int status = 0;
+  std::string mangled_typeid_name = typeid(T).name();
+
+  std::unique_ptr<char, void (*)(void *)> res {
+    abi::__cxa_demangle(mangled_typeid_name.c_str(), NULL, NULL, &status),
+    std::free
+  };
+
+  return (status == 0) ? res.get() : mangled_typeid_name;
+#else
+  return typeid(T).name();
+#endif
+}
+
+}  // cpp 命名空间
+}  // impl 命名空间
+}  // rmw 命名空间
+
+#endif  // RMW__IMPL__CPP__DEMANGLE_HPP_
diff --git a/rmw/include/rmw/init_zh.h b/rmw/include/rmw/init_zh.h
new file mode 100644
index 0000000..9320962
--- /dev/null
+++ b/rmw/include/rmw/init_zh.h
@@ -0,0 +1,166 @@
+// Copyright 2014-2018 Open Source Robotics Foundation, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef RMW__INIT_H_
+#define RMW__INIT_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include <stdint.h>
+
+#include "rmw/init_options.h"
+#include "rmw/macros.h"
+#include "rmw/ret_types.h"
+#include "rmw/visibility_control.h"
+
+/// 由 rmw_init() 返回的实现定义上下文结构。
+/**
+ * 应由 rmw 实现定义。
+ */
+typedef struct rmw_context_impl_s rmw_context_impl_t;
+
+/// 用于存储初始化相关信息的初始化上下文结构。
+typedef struct RMW_PUBLIC_TYPE rmw_context_s
+{
+  /// 表示本次初始化/关闭周期的本地（进程本地）唯一 ID。
+  uint64_t instance_id;
+  /// 实现标识符，用于确保不会混用两个不同的实现。
+  const char * implementation_identifier;
+  /// 用于初始化上下文的选项。
+  rmw_init_options_t options;
+  /// 正在使用的域 ID。
+  size_t actual_domain_id;
+  /// 实现定义的上下文信息。
+  /** 如果没有实现定义的上下文信息，可能为 NULL。 */
+  rmw_context_impl_t * impl;
+} rmw_context_t;
+
+/// 返回一个零初始化的上下文结构。
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_context_t
+rmw_get_zero_initialized_context(void);
+
+/// 使用给定选项初始化中间件，并生成一个上下文。
+/**
+ * 此函数成功执行后，上下文将填充中间件特定的数据。
+ * 该上下文在初始化节点和守护条件等实体时使用，也是正确调用 `rmw_shutdown()` 所必需的。
+ *
+ * \pre 给定的选项必须已经初始化，
+ *   即已对其调用 `rmw_init_options_init()` 并设置了 enclave。
+ * \pre 给定的上下文必须为零初始化。
+ *
+ * \post 如果初始化失败，上下文将保持零初始化状态。
+ * \post `context->actual_domain_id` 将被设置为 rmw 实现正在使用的域 ID。
+ *  如果 `options->domain_id` 不是 `RMW_DEFAULT_DOMAIN_ID`，则与之相同。
+ *  否则，该值取决于 rmw 实现。
+ *
+ * \remarks 如果选项是零初始化的，则返回 `RMW_RET_INVALID_ARGUMENT`。
+ *   如果选项已初始化但未提供 enclave，则返回 `RMW_RET_INVALID_ARGUMENT`。
+ *   如果上下文已经初始化（已对其调用 `rmw_init()`），则返回
+ *   `RMW_RET_INVALID_ARGUMENT`。
+ *
+ * <hr>
+ * Attribute          | Adherence
+ * ------------------ | -------------
+ * Allocates Memory   | Yes
+ * Thread-Safe        | No
+ * Uses Atomics       | No
+ * Lock-Free          | Yes
+ *
+ * 应由 rmw 实现定义。
+ *
+ * \param[in] options 初始化期间使用的初始化选项
+ * \param[out] context 生成的上下文结构体
+ * \return 如果成功则返回 `RMW_RET_OK`，或者
+ * \return 如果任何参数无效则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果实现标识符不匹配则返回 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，或者
+ * \return 如果发生意外错误则返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_init(const rmw_init_options_t * options, rmw_context_t * context);
+
+/// 关闭给定上下文的中间件。
+/**
+ * \pre 给定的上下文必须是通过 `rmw_init()` 初始化的有效上下文。
+ *
+ * \remarks 如果上下文是零初始化的，则返回 `RMW_RET_INVALID_ARGUMENT`。
+ *   如果上下文已经失效（已对其调用 `rmw_shutdown()`），则此函数不执行任何
+ *   操作并返回 `RMW_RET_OK`。
+ *
+ * <hr>
+ * Attribute          | Adherence
+ * ------------------ | -------------
+ * Allocates Memory   | Yes
+ * Thread-Safe        | No
+ * Uses Atomics       | No
+ * Lock-Free          | Yes
+ *
+ * 应由 rmw 实现定义。
+ *
+ * \param[in] context 生成的上下文结构体
+ * \return 如果成功则返回 `RMW_RET_OK`，或者
+ * \return 如果任何参数无效则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果实现标识符不匹配则返回 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，或者
+ * \return 如果发生意外错误则返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_shutdown(rmw_context_t * context);
+
+/// 完成一个上下文。
+/**
+ * 如果出现逻辑错误，例如 `RMW_RET_INVALID_ARGUMENT`
+ * 或 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，此函数将提前返回，并保持给定上下文不变。
+ * 否则，即使有错误也会继续执行，尽可能释放资源并将给定上下文零初始化。
+ *
+ * \pre 要完成的上下文必须先前已通过 `rmw_init()` 初始化，
+ *   随后通过 `rmw_shutdown()` 失效。
+ *
+ * \remarks 如果上下文是零初始化的，则返回 `RMW_RET_INVALID_ARGUMENT`。
+ *   如果上下文已初始化且有效（未对其调用 `rmw_shutdown()`），则返回
+ *   `RMW_RET_INVALID_ARGUMENT`。
+ *
+ * <hr>
+ * Attribute          | Adherence
+ * ------------------ | -------------
+ * Allocates Memory   | Yes
+ * Thread-Safe        | No
+ * Uses Atomics       | Yes
+ * Lock-Free          | Yes [1]
+ * <i>[1] 如果 `atomic_is_lock_free()` 对 `atomic_uint_least64_t` 返回 true</i>
+ *
+ * 应由 rmw 实现定义。
+ *
+ * \return 如果成功则返回 `RMW_RET_OK`，或者
+ * \return 如果任何参数无效则返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \return 如果实现标识符不匹配则返回 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，或者
+ * \return 如果发生未指明的错误则返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_context_fini(rmw_context_t * context);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__INIT_H_
