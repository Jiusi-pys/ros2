+TEST(TopicBridgeConstruction, partial_executor_registration_is_cancelled_without_external_io)
+{
+  auto context = std::make_shared<rclcpp::Context>();
+  auto peer_context = std::make_shared<rclcpp::Context>();
+  context->init(0, nullptr);
+  peer_context->init(0, nullptr);
+  rclcpp::NodeOptions options;
+  options.context(context);
+  auto gateway_node = std::make_shared<rclcpp::Node>("transaction_gateway", options);
+  rclcpp::NodeOptions peer_options;
+  peer_options.context(peer_context);
+  auto peer_node = std::make_shared<rclcpp::Node>("transaction_peer", peer_options);
+
+  rclcpp::ExecutorOptions executor_options;
+  executor_options.context = context;
+  ThrowAfterRegistrationExecutor executor(executor_options);
+  executor.add_node(gateway_node);
+  rclcpp::ExecutorOptions peer_executor_options;
+  peer_executor_options.context = peer_context;
+  rclcpp::executors::SingleThreadedExecutor peer_executor(peer_executor_options);
+  peer_executor.add_node(peer_node);
+
+  std::atomic<bool> spin_stop{false};
+  std::thread spin_thread([&]() {
+      while (!spin_stop.load(std::memory_order_acquire)) {
+        executor.spin_once(20ms);
+      }
+    });
+  auto cancel_executor = [&executor]() {executor.cancel();};
+  mdds_gateway::SpinThreadGuard<decltype(cancel_executor)> spin_guard(
+    spin_stop, spin_thread, std::move(cancel_executor));
+  std::atomic<bool> peer_spin_stop{false};
+  std::thread peer_spin_thread([&]() {
+      while (!peer_spin_stop.load(std::memory_order_acquire)) {
+        peer_executor.spin_once(20ms);
+      }
+    });
+  auto cancel_peer_executor = [&peer_executor]() {peer_executor.cancel();};
+  mdds_gateway::SpinThreadGuard<decltype(cancel_peer_executor)> peer_spin_guard(
+    peer_spin_stop, peer_spin_thread, std::move(cancel_peer_executor));
+
+  const std::string topic = "/mdds_gateway_construction_transaction";
+  const std::string type = "std_msgs/msg/String";
+  auto cyclone_writer = peer_node->create_publisher<std_msgs::msg::String>(
+    topic, rclcpp::QoS(10).reliable());
+  std::atomic<size_t> cyclone_reads{0};
+  auto cyclone_reader = peer_node->create_generic_subscription(
+    topic, type, rclcpp::QoS(10).reliable(),
+    [&cyclone_reads](std::shared_ptr<rclcpp::SerializedMessage> serialized) {
+      // Count only the MDDS-origin payload. The peer's own Cyclone-origin
+      // sample uses this topic too and is intentionally ignored here.
+      std_msgs::msg::String message;
+      rclcpp::Serialization<std_msgs::msg::String> serializer;
+      serializer.deserialize_message(serialized.get(), &message);
+      if (message.data == "preloaded-mdds") {
+        cyclone_reads.fetch_add(1, std::memory_order_relaxed);
+      }
+    });
+
+  auto stats = std::make_shared<FakeStats>();
+  FakeParticipant participant(stats, serialize_string("preloaded-mdds"));
+  executor.after_registration = [&](size_t attempt) {
+      if (!wait_until([&]() {return cyclone_writer->get_subscription_count() >= 1;})) {
+        throw std::runtime_error("gateway Cyclone subscription did not match");
+      }
+      std_msgs::msg::String message;
+      message.data = attempt == 1 ? "preloaded-failed-attempt" : "preloaded-retry";
+      cyclone_writer->publish(message);
+      // Give the already-spinning executor a deterministic opportunity to
+      // select work from the partially registered group.
+      std::this_thread::sleep_for(150ms);
+    };
+
+  EXPECT_THROW(
+    mdds_gateway::TopicBridge(topic, type, gateway_node, executor, &participant, nullptr),
+    std::runtime_error);
+  EXPECT_EQ(1u, executor.registration_attempts.load());
+  EXPECT_TRUE(executor.registration_was_untakeable.load());
+  EXPECT_EQ(0u, stats->mdds_writes.load());
+  EXPECT_EQ(0u, stats->mdds_takes.load());
+  EXPECT_EQ(0u, cyclone_reads.load());
+  EXPECT_EQ(1u, stats->writer_destroys.load());
+  EXPECT_EQ(1u, stats->reader_destroys.load());
+  EXPECT_TRUE(executor.get_manually_added_callback_groups().empty());
+
+  // The manager's next tick performs exactly one retry. Both samples queued
+  // during this second registration are released only after COMMITTED.
+  {
+    mdds_gateway::TopicBridge retry(
+      topic, type, gateway_node, executor, &participant, nullptr);
+    ASSERT_TRUE(wait_until([&]() {return stats->mdds_writes.load() == 1;}));
+    ASSERT_TRUE(wait_until([&]() {return cyclone_reads.load() == 1;}));
+  }
+  EXPECT_EQ(2u, executor.registration_attempts.load());
+  EXPECT_EQ(1u, stats->mdds_writes.load());
+  EXPECT_EQ(1u, stats->mdds_takes.load());
+  EXPECT_EQ(1u, cyclone_reads.load());
+  EXPECT_EQ(2u, stats->writer_creates.load());
+  EXPECT_EQ(2u, stats->reader_creates.load());
+  EXPECT_EQ(2u, stats->writer_destroys.load());
+  EXPECT_EQ(2u, stats->reader_destroys.load());
+  EXPECT_TRUE(executor.get_manually_added_callback_groups().empty());
+
+  EXPECT_TRUE(spin_guard.stop_and_join());
+  EXPECT_TRUE(peer_spin_guard.stop_and_join());
+  cyclone_reader.reset();
+  cyclone_writer.reset();
+  peer_executor.remove_node(peer_node);
+  executor.remove_node(gateway_node);
+  peer_node.reset();
+  gateway_node.reset();
+  EXPECT_TRUE(context->shutdown("construction transaction test complete"));
+  EXPECT_TRUE(peer_context->shutdown("construction transaction peer test complete"));
+}
