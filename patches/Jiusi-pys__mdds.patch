+std::vector<uint8_t>
+dsoftbus_admitted_announce(const mdds::ParticipantSnapshot &snapshot,
+                           uint64_t seq,
+                           const mdds::AnnounceChallengeEcho &echo) {
+  if (!echo.present) {
+    return {};
+  }
+  return mdds::encode_announce(snapshot, seq, 0, &echo);
+}
