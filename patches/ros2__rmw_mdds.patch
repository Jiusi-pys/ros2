+#include "transport_config.hpp"
+
+#include <cstring>
+
+namespace rmw_mdds
+{
+
+namespace
+{
+
+void
+set_error(std::string * error, const std::string & value)
+{
+  if (error != nullptr) {
+    *error = value;
+  }
+}
+
+}  // namespace
+
+bool
+configure_transport_selection(
+  mdds::ParticipantConfig & config,
+  const char * deployment_profile,
+  const char * transport_spec,
+  TransportSelection * selection,
+  std::string * error)
+{
+  if (selection == nullptr) {
+    set_error(error, "transport selection output is null");
+    return false;
+  }
+  *selection = TransportSelection{};
+  if (error != nullptr) {
+    error->clear();
+  }
+
+  // Keep legacy applications unchanged: with neither variable set, mdds
+  // retains its development defaults (currently UDP) and remains tolerant of
+  // an unavailable optional backend. Production must opt in explicitly.
+  if (deployment_profile == nullptr) {
+    if (transport_spec == nullptr) {
+      return true;
+    }
+    // Any legacy selector is an explicit operator choice. Starting only a
+    // subset after a requested backend failed would be a silent downgrade.
+    config.strict_transports = true;
+    if (transport_spec[0] == '\0') {
+      return true;
+    }
+
+    config.use_udp_loopback = false;
+    config.use_dsoftbus = false;
+    std::string spec(transport_spec);
+    size_t start = 0;
+    while (start <= spec.size()) {
+      const size_t comma = spec.find(',', start);
+      const std::string token = spec.substr(
+        start, comma == std::string::npos ? std::string::npos : comma - start);
+      if (token == "udp") {
+        config.use_udp_loopback = true;
+      } else if (token == "dsoftbus") {
+        config.use_dsoftbus = true;
+      } else if (!token.empty()) {
+        set_error(
+          error,
+          "MDDS_TRANSPORT: unknown transport '" + token +
+          "' (expected udp and/or dsoftbus)");
+        return false;
+      }
+      if (comma == std::string::npos) {
+        break;
+      }
+      start = comma + 1;
+    }
+    if (!config.use_udp_loopback && !config.use_dsoftbus) {
+      set_error(error, "MDDS_TRANSPORT selects no transport");
+      return false;
+    }
+    return true;
+  }
+
+  // A profile is the entire transport policy. Reject a simultaneously set
+  // legacy selector rather than making a precedence rule that can hide a
+  // deployment typo. Explicitly empty profile values fail for the same reason.
+  if (std::strcmp(deployment_profile, "ohos_dsoftbus") != 0) {
+    set_error(
+      error,
+      "MDDS_DEPLOYMENT_PROFILE: unknown profile '" +
+      std::string(deployment_profile) + "' (expected ohos_dsoftbus)");
+    return false;
+  }
+  if (transport_spec != nullptr) {
+    set_error(
+      error,
+      "MDDS_DEPLOYMENT_PROFILE=ohos_dsoftbus conflicts with MDDS_TRANSPORT; "
+      "unset MDDS_TRANSPORT");
+    return false;
+  }
+
+  // This profile is deliberately DSoftBus-only: no UDP loopback, no
+  // cross-device UDP, and no fallback if DSoftBus cannot initialize.
+  config.use_udp_loopback = false;
+  config.udp_cross_device = false;
+  config.use_dsoftbus = true;
+  config.strict_transports = true;
+  selection->ohos_dsoftbus_profile = true;
+  return true;
+}
+
+bool
+validate_transport_selection(
+  const TransportSelection & selection,
+  rmw_localhost_only_t localhost_only,
+  rmw_automatic_discovery_range_t automatic_discovery_range,
+  std::string * error)
+{
+  if (!selection.ohos_dsoftbus_profile) {
+    return true;
+  }
+  if (localhost_only == RMW_LOCALHOST_ONLY_ENABLED ||
+    automatic_discovery_range != RMW_AUTOMATIC_DISCOVERY_RANGE_SYSTEM_DEFAULT)
+  {
+    set_error(
+      error,
+      "MDDS_DEPLOYMENT_PROFILE=ohos_dsoftbus requires "
+      "ROS_AUTOMATIC_DISCOVERY_RANGE=SYSTEM_DEFAULT and ROS_LOCALHOST_ONLY unset");
+    return false;
+  }
+  return true;
+}
+
+}  // namespace rmw_mdds
