+/// Budget shared by every Reassembler of one participant: a global ceiling
+/// on declared reassembly bytes PLUS a fixed cap on open partial records.
+/// The latter reserves the map/interval metadata that byte-only accounting
+/// cannot see when an attacker opens many tiny legal first fragments.
+struct ReassemblyBudget
+{
+  explicit ReassemblyBudget(size_t limit)
+  : limit(limit) {}
+
+  /// Atomically reserve `bytes` BEFORE the corresponding allocation happens
+  /// (CAS loop: the check and the charge are one atomic step, so concurrent
+  /// reassemblers cannot slip between them). Returns false — nothing
+  /// charged — when the reservation would exceed the limit.
+  bool try_reserve(size_t bytes)
+  {
+    size_t cur = used.load(std::memory_order_relaxed);
+    for (;; ) {
+      if (bytes > limit || cur > limit - bytes) {
+        return false;  // also covers cur + bytes overflowing size_t
+      }
+      if (used.compare_exchange_weak(cur, cur + bytes, std::memory_order_acq_rel)) {
+        return true;
+      }
+    }
+  }
+
+  /// Return a reservation made by try_reserve().
+  void release(size_t bytes)
+  {
+    used.fetch_sub(bytes, std::memory_order_acq_rel);
+  }
+
+  /// Fixed participant-wide metadata reservation. Each open Partial can own
+  /// one map node and up to Reassembler::kMaxIntervalsPerPartial merged
+  /// intervals, so this cap bounds metadata independently of declared byte
+  /// sizes and peer-ID churn. It is intentionally conservative but large
+  /// enough for normal concurrent fragmented streams.
+  static constexpr size_t kMaxOpenPartials = 1024;
+
+  bool try_reserve_partial()
+  {
+    size_t cur = partials_used.load(std::memory_order_relaxed);
+    for (;;) {
+      if (cur >= kMaxOpenPartials) {
+        return false;
+      }
+      if (partials_used.compare_exchange_weak(cur, cur + 1, std::memory_order_acq_rel)) {
+        return true;
+      }
+    }
+  }
+
+  void release_partial()
+  {
+    partials_used.fetch_sub(1, std::memory_order_acq_rel);
+  }
+
+  const size_t limit;
+  std::atomic<size_t> used{0};
+  std::atomic<size_t> partials_used{0};
+};
+
 /// Splits a serialized sample into frames that each fit within max_payload
 /// bytes on the wire. Small samples produce a single DATA frame; larger ones
 /// produce DATA_FRAG frames.
@@ -47,20 +112,66 @@ public:
 /// Reassembles DATA_FRAG sequences back into complete samples. Coverage is
 /// tracked with exact merged byte intervals, so arbitrarily overlapping or
 /// misaligned fragments are handled correctly.
+///
+/// Reassembly memory is bounded at four levels, all enforced BEFORE any
+/// allocation: a per-sample cap (max_sample_bytes, applied to the declared
+/// total_size), a per-Reassembler (i.e. per-peer) cap on the sum of all
+/// partial buffers (max_bytes), and an optional participant-global budget
+/// shared across peers, plus a participant-global cap on the number of open
+/// partial records (and hence their map/interval metadata). A wire peer can
+/// declare an arbitrary total_size in
+/// its first fragment; without these caps a single frame could force a
+/// multi-GiB allocation (remote OOM). Over-budget fragments are dropped and
+/// counted (dropped_over_budget()); the affected sample simply never
+/// completes and its partial state is swept after the timeout.
 /// Thread-safety: not internally synchronized; callers must serialize access.
 class Reassembler
 {
 public:
   using Clock = std::chrono::steady_clock;
 
+  static constexpr size_t kDefaultMaxSampleBytes = 16 * 1024 * 1024;   // per sample
+  static constexpr size_t kDefaultMaxBytes = 32 * 1024 * 1024;         // per peer
+  /// A non-final fragment must carry at least this many payload bytes.
+  /// Legitimate producers (Fragmenter) emit near-max_payload chunks; tiny or
+  /// empty fragments only serve to flood the interval list — unbounded
+  /// metadata plus O(n^2) merge work per fragment — while staying inside the
+  /// byte budgets (which account the declared buffer, not the intervals).
+  static constexpr uint32_t kMinFragPayload = 64;
+  /// Merged-interval ceiling per partial; beyond it the partial is dropped.
+  static constexpr size_t kMaxIntervalsPerPartial = 256;
+  /// Ceiling on simultaneously open partials per Reassembler (per peer).
+  /// Together with kMaxIntervalsPerPartial this is the fixed metadata budget:
+  /// at most kMaxPartials map nodes + kMaxPartials*kMaxIntervalsPerPartial
+  /// interval pairs, independent of how hostile the fragment stream is.
+  static constexpr size_t kMaxPartials = 64;
+
   explicit Reassembler(
-    std::chrono::milliseconds timeout = std::chrono::milliseconds(5000))
-  : timeout_(timeout) {}
+    std::chrono::milliseconds timeout = std::chrono::milliseconds(5000),
