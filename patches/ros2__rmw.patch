diff --git a/rmw/include/rmw/error_handling_zh.h b/rmw/include/rmw/error_handling_zh.h
new file mode 100644
index 0000000..3b32160
--- /dev/null
+++ b/rmw/include/rmw/error_handling_zh.h
@@ -0,0 +1,186 @@
+// Copyright 2014 Open Source Robotics Foundation, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+/**
+ * @file error_handling.h
+ * @brief 用于与错误处理机制交互的函数和宏
+ *
+ * 此逻辑本质上重命名了许多 `rcutils` 函数和宏。有关更多信息，也请查看该包的文档。
+ */
+
+#ifndef RMW__ERROR_HANDLING_H_
+#define RMW__ERROR_HANDLING_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include <rcutils/error_handling.h>
+
+/// 封装固定大小 C 字符串的结构体，用于返回格式化后的错误字符串。
+typedef rcutils_error_string_t rmw_error_string_t;
+
+/// 封装由 RMW_SET_ERROR_MSG() 设置的错误状态的结构体。
+typedef rcutils_error_state_t rmw_error_state_t;
+
+/// 限制 `fwrite` 调用中的缓冲区大小，以在 `msg` 非空终止时为缓冲区溢出设置上限。
+#define RMW_SAFE_FWRITE_TO_STDERR RCUTILS_SAFE_FWRITE_TO_STDERR
+
+/// 如果在新创建的线程中调用，则强制初始化线程本地存储。
+/**
+ * 如果事先未调用此函数，则在首次设置错误状态或首次检索错误消息时，
+ * 将使用默认分配器来分配线程本地存储。
+ *
+ * 此函数可能会也可能不会分配内存。
+ * 系统的线程本地存储实现可能需要分配内存，
+ * 因为通常如果不了解将创建多少线程，就无法知道需要多少存储空间。
+ * 大多数实现（例如 C11、C++11 和 pthread）无法指定如何分配此内存，
+ * 但如果实现允许，将使用传递给此函数的分配器，否则该分配器不被使用。
+ * 这种情况只在线程创建和销毁时发生，可通过在线程池中复用线程来避免
+ * 处于“稳定”状态时发生。
+ *
+ * 值得考虑的是，反复创建和销毁线程会导致重复分配内存，并可能导致
+ * 内存碎片。
+ * 通常通过使用线程池来避免此问题。
+ *
+ * 如果返回码指示出错，则不会设置任何错误消息。
+ *
+ * 如果在线程中多次调用此函数，或者在通过设置错误状态隐式初始化之后调用，
+ * 即使给定的分配器无效，它仍将返回 `RCUTILS_RET_OK`。
+ * 从本质上讲，如果线程本地存储已经被调用过，此函数不执行任何操作。
+ * 如果已经初始化，则忽略给定的分配器，即使它与最初用于初始化
+ * 线程本地存储的分配器不匹配。
+ *
+ * \return 成功时返回 `RCUTILS_RET_OK`，或
+ * \return 分配器无效时返回 `RCUTILS_RET_INVALID_ARGUMENT`，或
+ * \return 内存分配失败时返回 `RCUTILS_RET_BAD_ALLOC`，或
+ * \return 发生未指定错误时返回 `RCUTILS_RET_ERROR`。
+ */
+#define rmw_initialize_error_handling_thread_local_storage \
+  rcutils_initialize_error_handling_thread_local_storage
+
+/// 设置错误消息，以及错误发生所在的文件和行号。
+/**
+ * 这不应该直接使用，而应通过 RMW_SET_ERROR_MSG(msg) 宏使用。
+ *
+ * error_msg 参数被复制到内部错误存储中，必须以空字符结尾。
+ * file 参数被复制到内部错误存储中，必须以空字符结尾。
+ *
+ * \param[in] error_string 要设置的错误消息。
+ * \param[in] file 错误发生的文件路径。
+ * \param[in] line_number 错误发生的行号。
+ */
+#define rmw_set_error_state rcutils_set_error_state
+
+/// 检查参数是否为空值。
+/**
+ * 如果参数的值为 `NULL`，则设置相应的错误消息并返回 `error_return_type`。
+ *
+ * \param[in] argument 要测试的参数。
+ * \param[in] error_return_type 如果参数为 `NULL` 时返回的类型。
+ */
+#define RMW_CHECK_ARGUMENT_FOR_NULL(argument, error_return_type) \
+  RCUTILS_CHECK_ARGUMENT_FOR_NULL(argument, error_return_type)
+
+/// 检查值是否为空，并附带错误消息和错误语句。
+/**
+ * 如果 `value` 为 `NULL`，则在设置错误消息后执行错误语句。
+ *
+ * \param[in] value 要测试的值。
+ * \param[in] msg `value` 为 `NULL` 时的错误消息。
+ * \param[in] error_statement `value` 为 `NULL` 时执行的语句。
+ */
+#define RMW_CHECK_FOR_NULL_WITH_MSG(value, msg, error_statement) \
+  RCUTILS_CHECK_FOR_NULL_WITH_MSG(value, msg, error_statement)
+
+/// 设置错误消息，并追加当前文件和行号。
+/**
+ * 如果此前已设置错误消息，且之后未调用 rmw_reset_error()，
+ * 并且构建本库时开启了 RCUTILS_REPORT_ERROR_HANDLING_ERRORS，
+ * 则此前设置的错误消息将被打印到 stderr。
+ * 错误状态存储是线程本地的，因此所有与错误相关的函数也是线程本地的。
+ *
+ * \param[in] msg 要设置的错误消息。
+ */
+#define RMW_SET_ERROR_MSG(msg) RCUTILS_SET_ERROR_MSG(msg)
+
+/// 使用格式字符串和格式参数设置错误消息。
+/**
+ * 此函数使用给定的格式字符串设置错误消息。
+ * 生成的格式化字符串将在 RCUTILS_ERROR_MESSAGE_MAX_LENGTH 处静默截断。
+ *
+ * \param[in] format_string 用作错误消息格式的字符串。
+ * \param[in] ... 格式字符串的参数。
+ */
+#define RMW_SET_ERROR_MSG_WITH_FORMAT_STRING(format_string, ...) \
+  RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING(format_string, __VA_ARGS__)
+
+/// 如果错误已设置则返回 `true`，否则返回 `false`。
+/**
+ * 当前被定义为 `rcutils_error_is_set`
+ */
+#define rmw_error_is_set rcutils_error_is_set
+
+/// 返回一个由 rcutils_set_error_state() 设置的 rcutils_error_state_t。
+/**
+ * 如果本线程中未设置任何错误，则返回的指针将为 NULL。
+ *
+ * 返回的指针一直有效，直到在同一线程中调用 RCUTILS_SET_ERROR_MSG、
+ * rcutils_set_error_state 或 rcutils_reset_error。
+ *
+ * \return 指向当前错误状态结构体的指针。
+ */
+#define rmw_get_error_state rcutils_get_error_state
+
+/// 如果错误已设置，则返回错误消息并附加 `, at <file>:<line>`，否则返回 "error not set"。
+/**
+ * 此函数是“安全的”，因为它返回当前错误字符串的副本；
+ * 如果未设置错误，则返回包含字符串 "error not set" 的副本。
+ * 这可确保该副本归调用线程所有，因此不会因其他错误处理调用而失效，
+ * 并且其中的 C 字符串始终有效且以空字符结尾。
+ *
+ * \return 当前错误字符串，包含文件和行号；如果未设置错误，则返回 "error not set"。
+ */
+#define rmw_get_error_string rcutils_get_error_string
+
+/// 通过清除任何先前设置的错误状态来重置错误状态。
+#define rmw_reset_error rcutils_reset_error
+
+/// 使用 RCUTILS_SET_ERROR_MSG 设置错误消息，并追加之前的错误。
+/**
+ * 如果没有之前的错误，则与 RCUTILS_SET_ERROR_MSG 行为相同。
+ * \param[in] msg 要设置的错误消息。
+ */
+#define RMW_SET_ERROR_MSG_AND_APPEND_PREV_ERROR(msg) \
+  RCUTILS_SET_ERROR_MSG_AND_APPEND_PREV_ERROR(msg)
+
+/// 使用 RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING 设置错误消息，并追加之前的错误。
+/**
+ * 此函数使用给定的格式字符串设置错误消息，并追加并重置最新的错误字符串。
+ * 生成的格式化字符串将在 RCUTILS_ERROR_MESSAGE_MAX_LENGTH 处静默截断。
+ *
+ * 如果没有之前的错误，则与 RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING 行为相同。
+ *
+ * \param[in] format_string 用作错误消息格式的字符串。
+ * \param[in] ... 格式字符串的参数。
+ */
+#define RMW_SET_ERROR_MSG_WITH_FORMAT_STRING_AND_APPEND_PREV_ERROR(format_string, ...) \
+  RCUTILS_SET_ERROR_MSG_WITH_FORMAT_STRING_AND_APPEND_PREV_ERROR(format_string, __VA_ARGS__)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__ERROR_HANDLING_H_
