       cmake_policy(SET CMP0072 NEW)
     endif()
-    find_package(OpenGL REQUIRED)
-    list(APPEND _extra_interface_link_libraries ${OPENGL_LIBRARIES})
-    list(APPEND _extra_interface_link_libraries ${CMAKE_DL_LIBS})
-    if(UNIX AND NOT APPLE)
-      find_package(X11 REQUIRED)
-      list(APPEND _extra_interface_link_libraries ${X11_LIBRARIES} ${X11_Xt_LIB} ${X11_Xrandr_LIB})
-      find_library(XAW_LIBRARY NAMES Xaw Xaw7 PATHS ${DEP_LIB_SEARCH_DIR} ${X11_LIB_SEARCH_PATH})
-      list(APPEND _extra_interface_link_libraries ${XAW_LIBRARY})
-    endif()
-    if(APPLE)
-      list(APPEND _extra_interface_link_libraries "-framework Cocoa")
+    if(OHOS_CROSS_BUILD)
+      # No desktop OpenGL/X11 on OpenHarmony: link the GLES2/EGL stack from
+      # the OHOS sysroot (RenderSystem_GLES2 + EGL/pbuffer GLSupport).
+      find_library(OHOS_EGL_LIBRARY NAMES EGL REQUIRED)
+      find_library(OHOS_GLESV2_LIBRARY NAMES GLESv2 REQUIRED)
+      list(APPEND _extra_interface_link_libraries ${OHOS_EGL_LIBRARY})
+      list(APPEND _extra_interface_link_libraries ${OHOS_GLESV2_LIBRARY})
+      list(APPEND _extra_interface_link_libraries ${CMAKE_DL_LIBS})
+    else()
+      find_package(OpenGL REQUIRED)
+      list(APPEND _extra_interface_link_libraries ${OPENGL_LIBRARIES})
+      list(APPEND _extra_interface_link_libraries ${CMAKE_DL_LIBS})
+      if(UNIX AND NOT APPLE)
+        find_package(X11 REQUIRED)
+        list(APPEND _extra_interface_link_libraries ${X11_LIBRARIES} ${X11_Xt_LIB} ${X11_Xrandr_LIB})
