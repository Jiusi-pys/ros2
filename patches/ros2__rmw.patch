+#ifndef RMW__VALIDATE_NODE_NAME_H_
+#define RMW__VALIDATE_NODE_NAME_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include "rmw/macros.h"
+#include "rmw/types.h"
+
+#define RMW_NODE_NAME_VALID 0
+#define RMW_NODE_NAME_INVALID_IS_EMPTY_STRING 1
+#define RMW_NODE_NAME_INVALID_CONTAINS_UNALLOWED_CHARACTERS 2
+#define RMW_NODE_NAME_INVALID_STARTS_WITH_NUMBER 3
+#define RMW_NODE_NAME_INVALID_TOO_LONG 4
+
+#define RMW_NODE_NAME_MAX_NAME_LENGTH 255 /* 任意约束 */
+
+/// 判断节点名称是否有效。
+/**
+ * 节点名称必须遵循以下规则：
+ *
+ * - 不能为空字符串
+ * - 只能包含字母数字字符和下划线（a-z|A-Z|0-9|_）
+ * - 不能以数字开头
+ *
+ * 如果节点名称 C 字符串或 validation_result 指针任一为空，则返回
+ * `RMW_RET_INVALID_ARGUMENT`。
+ * node_name 应为有效的、以空字符结尾的 C 字符串。
+ * validation_result 整型指针应指向有效内存，以便作为输出变量存储结果。
+ * invalid_index size_t 指针应指向 NULL 或有效内存，以便在发生验证错误时，
+ * 将输入字符串中的位置存储其中。
+ * 如果为 invalid_index 传入 NULL，则不会设置该值。
+ *
+ * 如果节点名称有效，则不会为 invalid_index 赋值。
+ *
+ * validation_result 所指向的整型将存储以下可能的宏定义结果值之一：
+ *
+ * - RMW_NODE_NAME_VALID
+ * - RMW_NODE_NAME_INVALID_IS_EMPTY_STRING
+ * - RMW_NODE_NAME_INVALID_CONTAINS_UNALLOWED_CHARACTERS
+ * - RMW_NODE_NAME_INVALID_STARTS_WITH_NUMBER
+ * - RMW_NODE_NAME_INVALID_TOO_LONG
+ *
+ * 可以使用 rmw_node_name_validation_result_string() 函数将结果值转换为描述。
+ *
+ * `RMW_NODE_NAME_INVALID_TOO_LONG` 保证最后被检查，因此如果得到该结果，
+ * 则可以假定所有其他检查均已通过。
+ * 这样做是为了在需要时可以将长度限制视为警告而非错误。
+ *
+ * \param[in] node_name 待验证的节点名称
+ * \param[out] validation_result 存储检查结果的整型
+ * \param[out] invalid_index 输入字符串中发生错误的位置 size_t 索引
+ * \returns 成功运行检查时返回 `RMW_RET_OK`，或者
+ * \returns 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_validate_node_name(
+  const char * node_name,
+  int * validation_result,
+  size_t * invalid_index);
+
+/// Deterimine if a given node name is valid.
+/**
+ * 这是一个重载版本，增加了一个用于指定 node_name 长度的参数。
+ *
+ * \sa rmw_validate_node_name(const char *, int *, size_t *)
+ *
+ * \param[in] node_name 待验证的节点名称
+ * \param[in] node_name_length node_name 中的字符数
+ * \param[out] validation_result 存储检查结果的整型
+ * \param[out] invalid_index 输入字符串中发生错误的位置 size_t 索引
+ * \returns 成功运行检查时返回 `RMW_RET_OK`，或者
+ * \returns 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，或者
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_validate_node_name_with_size(
+  const char * node_name,
+  size_t node_name_length,
+  int * validation_result,
+  size_t * invalid_index);
+
+/// 返回验证结果描述，如果为 RMW_NODE_NAME_VALID 则返回 NULL。
+/**
+ * \param[in] validation_result 验证结果
+ * \returns 如果验证结果为 `RMW_NODE_NAME_VALID` 则返回 `NULL`，或者
+ * \returns 表示验证结果的字符串。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+const char *
+rmw_node_name_validation_result_string(int validation_result);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__VALIDATE_NODE_NAME_H_
