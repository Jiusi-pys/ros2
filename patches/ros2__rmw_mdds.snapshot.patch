+TEST(DeferredCallbackGroup, publisher_first_sample_waits_for_explicit_activation)
+{
+  auto context = std::make_shared<rclcpp::Context>();
+  context->init(0, nullptr);
+  rclcpp::NodeOptions node_options;
+  node_options.context(context);
+  auto publisher_node = std::make_shared<rclcpp::Node>("deferred_group_pub", node_options);
+  auto subscriber_node = std::make_shared<rclcpp::Node>("deferred_group_sub", node_options);
+
+  rclcpp::ExecutorOptions executor_options;
+  executor_options.context = context;
+  rclcpp::executors::SingleThreadedExecutor executor(executor_options);
+  executor.add_node(publisher_node);
+  executor.add_node(subscriber_node);
+
+  std::atomic<bool> spin_stop{false};
+  std::thread spin_thread([&]() {
+      while (!spin_stop.load(std::memory_order_acquire)) {
+        executor.spin_once(20ms);
+      }
+    });
+  auto cancel_executor = [&executor]() {executor.cancel();};
+  mdds_gateway::SpinThreadGuard<decltype(cancel_executor)> spin_guard(
+    spin_stop, spin_thread, std::move(cancel_executor));
+
+  // The publisher exists first, matching the gateway race that originally
+  // let a subscription callback run while TopicBridge was still constructing.
+  const std::string topic = "/mdds_gateway_deferred_callback_group";
+  auto publisher = publisher_node->create_publisher<std_msgs::msg::String>(
+    topic, rclcpp::QoS(10).reliable());
+  mdds_gateway::DeferredCallbackGroup callbacks(subscriber_node);
+  rclcpp::SubscriptionOptions subscription_options;
+  subscription_options.callback_group = callbacks.group();
+  std::atomic<size_t> callback_count{0};
+  std::mutex value_mutex;
+  std::string received;
+  auto subscription = subscriber_node->create_subscription<std_msgs::msg::String>(
+    topic, rclcpp::QoS(10).reliable(),
+    [&](std_msgs::msg::String::ConstSharedPtr message) {
+      {
+        std::lock_guard<std::mutex> lock(value_mutex);
+        received = message->data;
+      }
+      callback_count.fetch_add(1, std::memory_order_release);
+    },
+    subscription_options);
+
+  ASSERT_TRUE(wait_until([&]() {return publisher->get_subscription_count() == 1;}));
+  std_msgs::msg::String message;
+  message.data = "published-before-callback-group-activation";
+  publisher->publish(message);
+
+  // Discovery/RHC are live, but no executor may take the queued sample while
+  // the bridge's callback group remains detached.
+  std::this_thread::sleep_for(250ms);
+  EXPECT_EQ(0u, callback_count.load(std::memory_order_acquire));
+
+  callbacks.register_with(executor);
+  callbacks.prepare_commit();
+  ASSERT_TRUE(wait_until([&]() {return callback_count.load(std::memory_order_acquire) == 1;}));
+  {
+    std::lock_guard<std::mutex> lock(value_mutex);
+    EXPECT_EQ(message.data, received);
+  }
+  EXPECT_EQ(1u, callback_count.load(std::memory_order_acquire));
+
+  callbacks.deactivate();
+  EXPECT_TRUE(spin_guard.stop_and_join());
+  subscription.reset();
+  publisher.reset();
+  executor.remove_node(subscriber_node);
+  executor.remove_node(publisher_node);
+  subscriber_node.reset();
+  publisher_node.reset();
+  EXPECT_TRUE(context->shutdown("deferred callback group test complete"));
+}
