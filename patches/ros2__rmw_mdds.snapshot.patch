+class ThrowAfterRegistrationExecutor final : public rclcpp::executors::SingleThreadedExecutor
+{
+public:
+  using SingleThreadedExecutor::SingleThreadedExecutor;
+
+  std::function<void(size_t)> after_registration;
+  std::atomic<size_t> registration_attempts{0};
+  std::atomic<bool> registration_was_untakeable{true};
+
+  void add_callback_group(
+    rclcpp::CallbackGroup::SharedPtr group,
+    rclcpp::node_interfaces::NodeBaseInterface::SharedPtr node,
+    bool notify = true) override
+  {
+    SingleThreadedExecutor::add_callback_group(group, node, notify);
+    if (group->can_be_taken_from().load(std::memory_order_acquire)) {
+      registration_was_untakeable.store(false, std::memory_order_release);
+    }
+    const size_t attempt = registration_attempts.fetch_add(1) + 1;
+    if (after_registration) {
+      after_registration(attempt);
+    }
+    if (attempt == 1) {
+      throw std::runtime_error("injected wake failure after collector registration");
+    }
+  }
+};
+
+std::vector<uint8_t> serialize_string(const std::string & value)
+{
+  std_msgs::msg::String message;
+  message.data = value;
+  rclcpp::SerializedMessage serialized;
+  rclcpp::Serialization<std_msgs::msg::String> serializer;
+  serializer.serialize_message(&message, &serialized);
+  const auto & raw = serialized.get_rcl_serialized_message();
+  return std::vector<uint8_t>(raw.buffer, raw.buffer + raw.buffer_length);
+}
