+// Empty fragments and sub-kMinFragPayload non-final fragments are rejected
+// before any state is created (sparse-fragment flood defense); a tiny FINAL
+// fragment is exempt so a short tail chunk still completes the sample.
+TEST(Reassembler, EmptyAndTinyFragmentsRejected)
+{
+  mdds::Reassembler reasm;
+  auto w = make_test_guid(0x11);
+  std::vector<uint8_t> out;
+  uint8_t b[64] = {};
+
+  // Zero-length fragment: no progress, no state, no budget churn.
+  EXPECT_FALSE(reasm.add_fragment(w, 1, 1000, 0, b, 0, out));
+  EXPECT_EQ(reasm.pending_count(), 0u);
+  EXPECT_EQ(reasm.bytes_in_flight(), 0u);
+
+  // 1-byte and 63-byte NON-final fragments: below the floor, rejected and
+  // counted, still no state created.
+  EXPECT_FALSE(reasm.add_fragment(w, 1, 1000, 0, b, 1, out));
+  EXPECT_FALSE(reasm.add_fragment(w, 1, 1000, 63, b, 63, out));
+  EXPECT_EQ(reasm.dropped_over_budget(), 2u);
+  EXPECT_EQ(reasm.pending_count(), 0u);
+
+  // A 64-byte non-final fragment is accepted; the 1-byte FINAL fragment is
+  // exempt and completes the sample.
+  EXPECT_FALSE(reasm.add_fragment(w, 2, 65, 0, b, 64, out));
+  EXPECT_EQ(reasm.pending_count(), 1u);
+  EXPECT_TRUE(reasm.add_fragment(w, 2, 65, 64, b, 1, out));
+  EXPECT_EQ(out.size(), 65u);
+  EXPECT_EQ(reasm.pending_count(), 0u);
+  EXPECT_EQ(reasm.bytes_in_flight(), 0u);
+}
+
+// The merged-interval ceiling drops a flooded partial wholesale and returns
+// its bytes to the accounting, instead of letting metadata grow unbounded.
+TEST(Reassembler, IntervalCapDropsPartial)
+{
+  mdds::Reassembler reasm(
+    std::chrono::milliseconds(5000),
+    mdds::Reassembler::kDefaultMaxSampleBytes, 4 * 1024 * 1024);
+  auto w = make_test_guid(0x12);
+  std::vector<uint8_t> out;
+  uint8_t b[64] = {};
+
+  // Disjoint 64-byte islands at stride 128 never merge; the buffer holds
+  // room for one more island than the cap.
+  constexpr size_t kCap = mdds::Reassembler::kMaxIntervalsPerPartial;
+  const uint32_t total = static_cast<uint32_t>(128 * (kCap + 1));
+  for (size_t i = 0; i < kCap; ++i) {
+    EXPECT_FALSE(
+      reasm.add_fragment(w, 1, total, static_cast<uint32_t>(i * 128), b, 64, out)) << i;
+  }
+  EXPECT_EQ(reasm.pending_count(), 1u);
+  const uint64_t dropped_before = reasm.dropped_over_budget();
+
+  // Island kCap+1 exceeds the ceiling: the whole partial is dropped.
+  EXPECT_FALSE(
+    reasm.add_fragment(w, 1, total, static_cast<uint32_t>(kCap * 128), b, 64, out));
+  EXPECT_EQ(reasm.pending_count(), 0u);
+  EXPECT_EQ(reasm.bytes_in_flight(), 0u);
+  EXPECT_EQ(reasm.dropped_over_budget(), dropped_before + 1);
+
+  // The writer can start the sample over after the drop.
+  EXPECT_FALSE(reasm.add_fragment(w, 1, total, 0, b, 64, out));
+  EXPECT_EQ(reasm.pending_count(), 1u);
+}
+
+// Every inbound allocation sits behind a budget reservation. A failure after
+// that reservation must be a clean drop: no exception may escape the caller,
+// no partial remains reachable, and both byte and metadata budget are fully
+// returned for a later legitimate sample.
+TEST(Reassembler, AllocationFailureRollsBackPartialAndIntervalReservations)
+{
+  mdds::ReassemblyBudget global(2048);
+  bool fail_partial_map = true;
+  mdds::Reassembler map_fail(
+    std::chrono::milliseconds(5000), 1024, 1024, &global,
+    [&fail_partial_map](const char * operation) {
+      return fail_partial_map && std::strcmp(operation, "partial_map") == 0;
+    });
+  const auto writer = make_test_guid(0x58);
+  std::vector<uint8_t> out;
+  uint8_t first[64] = {};
+
+  EXPECT_NO_THROW(EXPECT_FALSE(map_fail.add_fragment(writer, 1, 512, 0, first, sizeof(first), out)));
+  EXPECT_EQ(map_fail.pending_count(), 0u);
+  EXPECT_EQ(map_fail.bytes_in_flight(), 0u);
+  EXPECT_EQ(global.used.load(), 0u);
+  EXPECT_EQ(global.partials_used.load(), 0u);
+
+  fail_partial_map = false;
+  EXPECT_FALSE(map_fail.add_fragment(writer, 1, 512, 0, first, sizeof(first), out));
+  EXPECT_EQ(map_fail.pending_count(), 1u);
+  EXPECT_EQ(global.used.load(), 512u);
+  EXPECT_EQ(global.partials_used.load(), 1u);
+  map_fail.drop_writer(writer);
+  EXPECT_EQ(global.used.load(), 0u);
+  EXPECT_EQ(global.partials_used.load(), 0u);
+
+  bool fail_interval = true;
+  mdds::Reassembler interval_fail(
+    std::chrono::milliseconds(5000), 1024, 1024, &global,
+    [&fail_interval](const char * operation) {
+      return fail_interval && std::strcmp(operation, "interval_merge") == 0;
+    });
+  EXPECT_NO_THROW(EXPECT_FALSE(
+      interval_fail.add_fragment(writer, 2, 512, 0, first, sizeof(first), out)));
+  EXPECT_EQ(interval_fail.pending_count(), 0u);
+  EXPECT_EQ(interval_fail.bytes_in_flight(), 0u);
+  EXPECT_EQ(global.used.load(), 0u);
+  EXPECT_EQ(global.partials_used.load(), 0u);
+
+  fail_interval = false;
+  EXPECT_FALSE(interval_fail.add_fragment(writer, 2, 512, 0, first, sizeof(first), out));
+  EXPECT_EQ(interval_fail.pending_count(), 1u);
+  EXPECT_EQ(global.used.load(), 512u);
+  interval_fail.drop_writer(writer);
+  EXPECT_EQ(global.used.load(), 0u);
+  EXPECT_EQ(global.partials_used.load(), 0u);
+}
