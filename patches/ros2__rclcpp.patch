+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Isolate the GNU dladdr declaration from the rest of rclcpp's feature macros.
+#if defined(__OHOS__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE 1
+#endif
+
+#if defined(__OHOS__)
+#include <dlfcn.h>
+#include <cstring>
+#endif
+
+namespace rclcpp
+{
+namespace detail
+{
+
+// Called only during signal-handler installation, never from signal context.
+bool is_ohos_ffrt_signal_dispatcher(const void * handler) noexcept
+{
+#if defined(__OHOS__)
+  Dl_info origin {};
+  if (!dladdr(handler, &origin) || origin.dli_fname == nullptr) {
+    return false;
+  }
+  // The SDK's fault dispatcher restores its saved action and requeues the
+  // signal. It is not a returnable application callback. Limit this treatment
+  // to the system NDK copies; unrelated/user handlers remain chainable.
+  return std::strcmp(origin.dli_fname, "/system/lib64/ndk/libffrt.so") == 0 ||
+         std::strcmp(origin.dli_fname, "/system/lib/ndk/libffrt.so") == 0;
+#else
+  (void)handler;
+  return false;
+#endif
+}
+
+}  // namespace detail
+}  // namespace rclcpp
