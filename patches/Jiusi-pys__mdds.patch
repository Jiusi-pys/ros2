+// Writer and Reader deliberately expose only their stable DDS GUID.  Raw wire
+// control-frame tests also need the current opaque endpoint incarnation, so
+// observe the normal outbound ANNOUNCE rather than adding a test-only
+// production accessor.  The capture is synchronized because the hook runs on
+// transport threads while the test thread later builds an ACKNACK.
+class LocalEndpointEpochCapture {
+public:
+  void watch(const mdds::Guid &guid) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    guid_ = guid;
+    epoch_ = {};
+  }
+
+  void observe_announce(const uint8_t *frame, size_t len) {
+    mdds::ParticipantSnapshot snapshot;
+    uint64_t seq = 0;
+    if (!mdds::decode_announce(frame, len, snapshot, seq)) {
+      return;
+    }
+    mdds::Guid watched;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      watched = guid_;
+    }
+    if (watched.is_zero()) {
+      return;
+    }
+    for (const auto &endpoint : snapshot.endpoints) {
+      if (endpoint.guid == watched) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        epoch_ = endpoint.epoch;
+        return;
+      }
+    }
+  }
+
+  bool get(mdds::Guid &epoch) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (epoch_.is_zero()) {
+      return false;
+    }
+    epoch = epoch_;
+    return true;
+  }
+
+private:
+  mutable std::mutex mutex_;
+  mdds::Guid guid_;
+  mdds::Guid epoch_;
+};
