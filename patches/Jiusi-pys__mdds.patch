+TEST(UdpLoopback, MalformedAllowCidrFailsStart)
+{
+  RecordingListener la;
+  auto ta = mdds::make_udp_loopback_transport();
+  auto cfg = test_config();
+  cfg.udp_peer_allow_cidrs.push_back("not-a-cidr");
+  EXPECT_FALSE(ta->start(cfg, &la));
+}
+
+TEST(UdpLoopback, AllowlistKeepsLoopbackTraffic)
+{
+  // An allowlist matching no local interface must not cut same-host traffic:
+  // loopback peers are always permitted, only cross-device subnets filter.
+  RecordingListener la, lb;
+  auto ta = mdds::make_udp_loopback_transport();
+  auto tb = mdds::make_udp_loopback_transport();
+  auto cfg = test_config();
+  cfg.udp_peer_allow_cidrs.push_back("203.0.113.0/24");  // TEST-NET-3, never local
+  ASSERT_TRUE(ta->start(cfg, &la));
+  ASSERT_TRUE(tb->start(cfg, &lb));
+  ASSERT_TRUE(la.wait_for_peer_up(1));
+  ASSERT_TRUE(lb.wait_for_peer_up(1));
+  const mdds::PeerId peer_of_b = la.ups().front();
+
+  const char msg[] = "loopback still works";
+  ASSERT_TRUE(
+    ta->send(peer_of_b, reinterpret_cast<const uint8_t *>(msg), sizeof(msg)));
+  ASSERT_TRUE(lb.wait_for_bytes(1));
+
+  tb->stop();
+  ta->stop();
+}
+
 }  // namespace
