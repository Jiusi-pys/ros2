+// Byte ceilings alone do not bound map/interval metadata: a hostile fleet of
+// peer IDs could otherwise open one tiny legal partial in each Reassembler.
+// The participant-global partial cap must reject the next one before it can
+// allocate another map node, while all admitted partials remain independent.
+TEST(Reassembler, GlobalMetadataCapSharedAcrossPeers)
+{
+  constexpr size_t kCap = mdds::ReassemblyBudget::kMaxOpenPartials;
+  mdds::ReassemblyBudget global((kCap + 1) * 128);
+  std::vector<std::unique_ptr<mdds::Reassembler>> peers;
+  peers.reserve(kCap + 1);
+  std::vector<uint8_t> out;
+  uint8_t first[64] = {};
+  const auto writer = make_test_guid(0x2f);
+
+  for (size_t i = 0; i < kCap; ++i) {
+    peers.emplace_back(std::make_unique<mdds::Reassembler>(
+      std::chrono::milliseconds(5000), 128, 128, &global));
+    EXPECT_FALSE(peers.back()->add_fragment(writer, i + 1, 128, 0, first, sizeof(first), out)) << i;
+  }
+  EXPECT_EQ(global.partials_used.load(), kCap);
+
+  mdds::Reassembler overflow(std::chrono::milliseconds(5000), 128, 128, &global);
+  EXPECT_FALSE(overflow.add_fragment(writer, 9999, 128, 0, first, sizeof(first), out));
+  EXPECT_EQ(overflow.pending_count(), 0u);
+  EXPECT_EQ(overflow.dropped_over_budget(), 1u);
+  EXPECT_EQ(global.partials_used.load(), kCap);
+}
