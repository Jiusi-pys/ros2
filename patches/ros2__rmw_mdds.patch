@@ -0,0 +1,20 @@
+# OpenHarmony production profile for the two-RK3588A topology:
+#   board B (rmw_mdds) -- DSoftBus Socket/Bytes --> board A gateway
+#   board A gateway -- CycloneDDS --> Windows PC
+#
+# The MDDS side is deliberately DSoftBus-only.  A startup or runtime
+# DSoftBus failure is terminal; it must never silently fall back to UDP.
+
+cyclone_domain_id = 0
+mdds_domain_id = 0
+mdds_announce_period_ms = 500
+mdds_transport = dsoftbus
+
+# Single active gateway is the supported topology.  Retain identical payloads
+# from one legitimate publisher; loop prevention is handled by bridge origin
+# metadata rather than content-only deduplication.
+dedup_mode = off
+dedup_ttl_ms = 5000
+dedup_capacity = 4096
+
+topic = /chatter
