+// ACK loss must preserve every sample for retransmission and enforce the real
+// window cap.  A later positive ACK (from the periodic heartbeat) releases the
+// same entries and lets the writer resume; this is not a process-lifetime cap.
+TEST(ReliabilityHistory, LostAcksPreserveHistoryUntilPositiveAckThenRecover) {
+  std::atomic<bool> drop_acks{true};
+  auto cfg_writer = test_config_3();
+  cfg_writer.max_keep_all_writer_history_samples = 4;
+  cfg_writer.max_keep_all_writer_history_bytes = 1024;
+  auto cfg_reader = test_config_3();
+  cfg_reader.test_send_hook = [&](const uint8_t *frame, size_t len) {
+    mdds::FrameHeader header{};
+    return drop_acks.load(std::memory_order_relaxed) &&
+           mdds::decode_header(frame, len, header) &&
+           header.type == mdds::FrameType::ACKNACK;
+  };
+  auto pa = mdds::Participant::create(cfg_writer);
+  auto pb = mdds::Participant::create(cfg_reader);
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+  auto qos = default_qos();
+  qos.history = mdds::History::KEEP_ALL;
+  auto *w = pa->create_writer("/ack_loss", "test/History", qos);
+  auto *r = pb->create_reader("/ack_loss", "test/History", default_qos());
+  ASSERT_NE(w, nullptr);
+  ASSERT_NE(r, nullptr);
+  ASSERT_TRUE(wait_matched(w, 1));
+  ASSERT_TRUE(wait_reader_matched(r, 1));
+  ASSERT_TRUE(wait_until(
+      [&] { return w->history_status().active_associations == 1; }, 5s, 5ms));
+
+  const uint8_t payload = 0x42;
+  for (int i = 0; i < 4; ++i) {
+    ASSERT_TRUE(w->write(&payload, sizeof(payload)));
+  }
+  ASSERT_TRUE(wait_until(
+      [&] { return w->history_status().retained_samples == 4; }, 2s, 5ms));
+  EXPECT_FALSE(w->write(&payload, sizeof(payload)));
+
+  drop_acks.store(false, std::memory_order_relaxed);
+  ASSERT_TRUE(wait_until(
+      [&] {
+        const auto status = w->history_status();
+        return status.retained_samples == 0 &&
+               status.ack_reclaimed_samples == 4;
+      },
+      5s, 5ms));
+  EXPECT_TRUE(w->write(&payload, sizeof(payload)));
+}
+
+// GW-11 uses the same 1024-sample cap as the production C2M writer.  Dropping
+// every initial ACKNACK must fill that *actual* Writer history, reject sample
+// 1025 without evicting a retransmit candidate, then recover all retained
+// samples once the current reader can acknowledge again.  Drop the original
+// sequence one DATA too: recovery therefore proves retransmission, not just
+// a counter returning to zero after an unobserved local delivery.
+TEST(ReliabilityHistory, GatewaySizedLostAcksRetain1024AndRecoverByAckNack) {
+  std::atomic<bool> drop_acks{true};
+  // Keep the reader at its initial contiguous baseline while the real writer
+  // fills.  Dropping only seq 1 lets a 1024-frame burst outrun ReaderImpl's
+  // deliberately bounded 64-sample reorder window; that correctly turns the
+  // far-ahead frames into loss, but makes this ACK-recovery test ask for an
+  // impossible all-1024 delivery.  Dropping the initial DATA burst instead
+  // makes recovery proceed solely through the writer's retained history and
+  // its bounded 64-bit ACKNACK windows.
+  std::atomic<bool> drop_initial_data{true};
+  std::atomic<size_t> dropped_initial_data{0};
+  std::atomic<size_t> seq1_sends{0};
+  auto cfg_writer = test_config_3();
+  cfg_writer.max_keep_all_writer_history_samples = 1024;
+  cfg_writer.max_keep_all_writer_history_bytes = 2 * 1024 * 1024;
+  cfg_writer.test_send_hook = [&](const uint8_t * frame, size_t length) {
+      mdds::FrameHeader header{};
+      if (!mdds::decode_header(frame, length, header) ||
+          header.type != mdds::FrameType::DATA) {
+        return false;
+      }
+      mdds::DataBody body{};
+      if (mdds::decode_data(frame, length, body) && body.seq == 1) {
+        ++seq1_sends;
+      }
+      if (drop_initial_data.load(std::memory_order_relaxed)) {
+        ++dropped_initial_data;
+        return true;
+      }
+      return false;
+    };
+  auto cfg_reader = test_config_3();
+  cfg_reader.max_delivery_samples_per_reader = 2048;
+  cfg_reader.max_delivery_samples_total = 2048;
+  cfg_reader.test_send_hook = [&](const uint8_t * frame, size_t length) {
+      mdds::FrameHeader header{};
+      return drop_acks.load(std::memory_order_relaxed) &&
+             mdds::decode_header(frame, length, header) &&
+             header.type == mdds::FrameType::ACKNACK;
+    };
+  auto pa = mdds::Participant::create(cfg_writer);
+  auto pb = mdds::Participant::create(cfg_reader);
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+  auto qos = default_qos();
+  qos.history = mdds::History::KEEP_ALL;
+  auto * writer = pa->create_writer("/gateway_sized_ack_loss", "test/History", qos);
+  auto reader_qos = default_qos();
+  reader_qos.history = mdds::History::KEEP_ALL;
+  reader_qos.depth = 1024;
+  auto * reader = pb->create_reader("/gateway_sized_ack_loss", "test/History", reader_qos);
+  ASSERT_NE(writer, nullptr);
+  ASSERT_NE(reader, nullptr);
+  ASSERT_TRUE(wait_matched(writer, 1));
+  ASSERT_TRUE(wait_reader_matched(reader, 1));
+  ASSERT_TRUE(wait_until(
+      [&] { return writer->history_status().active_associations == 1; }, 5s, 5ms));
+
+  const uint8_t payload = 0x73;
+  for (uint64_t index = 0; index < 1024; ++index) {
+    ASSERT_TRUE(writer->write(&payload, sizeof(payload))) << index;
+  }
+  ASSERT_TRUE(wait_until(
+      [&] {
+        const auto status = writer->history_status();
+        return status.retained_samples == 1024 &&
+               status.ack_reclaimed_samples == 0;
+      },
+      5s, 5ms));
+  EXPECT_FALSE(writer->write(&payload, sizeof(payload)));
+  EXPECT_EQ(dropped_initial_data.load(), 1024u);
+  EXPECT_EQ(reader->available(), 0u);
+
+  drop_initial_data.store(false, std::memory_order_relaxed);
+  drop_acks.store(false, std::memory_order_relaxed);
+  std::set<uint64_t> received;
+  ASSERT_TRUE(wait_until(
+      [&] {
+        std::vector<uint8_t> out;
+        mdds::MessageInfo info;
+        while (reader->take(out, info)) {
+          received.insert(info.seq);
+        }
+        const auto status = writer->history_status();
+        return received.size() == 1024 && status.retained_samples == 0 &&
+               status.ack_reclaimed_samples == 1024;
+      },
+      20s, 5ms));
+  EXPECT_EQ(*received.begin(), 1u);
+  EXPECT_EQ(*received.rbegin(), 1024u);
+  EXPECT_EQ(reader->messages_lost(), 0u);
+  EXPECT_GE(seq1_sends.load(), 2u);
+  EXPECT_TRUE(writer->write(&payload, sizeof(payload)));
+}
