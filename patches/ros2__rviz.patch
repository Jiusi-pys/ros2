index 00000000..7525abd1
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/indexed_8bit_image.vert
@@ -0,0 +1,15 @@
+// Draws an 8-bit image using RGB values from a 256x1 palette texture.
+// This vertex shader just passes through the UV texture coordinates.
+// GLES2 port: ftransform() -> worldviewproj_matrix * vertex
+
+uniform mat4 worldviewproj_matrix;
+
+attribute vec4 vertex;
+attribute vec4 uv0;
+varying vec2 UV;
+
+void main()
+{
+  gl_Position = worldviewproj_matrix * vertex;
+  UV = vec2(uv0);
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/nogp/billboard.vert b/rviz_rendering/ogre_media/materials/glsles/nogp/billboard.vert
new file mode 100644
index 00000000..31d4df8a
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/nogp/billboard.vert
@@ -0,0 +1,60 @@
+// Computes the position of a billboard vertex so
+// the resulting quad will face the camera.
+// Texture coords are used to determine which corner
+// of the billboard we compute.
+// GLES2 port: gl_Vertex -> vertex, gl_Color -> colour,
+// gl_MultiTexCoord0 -> uv0, gl_TexCoord[0] -> texCoord0,
+// gl_FrontColor -> frontColour; pass_depth.vert inlined under WITH_DEPTH
+// (glsles has no `attach`)
+
+uniform mat4 worldviewproj_matrix;
+uniform vec4 camera_pos;
+uniform vec4 size;
+uniform vec4 auto_size;
+
+attribute vec4 vertex;
+attribute vec4 colour;
+attribute vec4 uv0;
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+#ifdef WITH_DEPTH
+uniform mat4 worldview_matrix;
+
+varying float depth;
+
+void passDepth( vec4 pos )
+{
+  vec4 pos_rel_view = worldview_matrix * pos;
+  depth = -pos_rel_view.z;
+}
+#endif
+
+void main()
+{
+  vec3 at = camera_pos.xyz - vertex.xyz;
+  at = normalize(at);
+  vec3 right = cross(vec3( 0.0, 1.0, 0.0 ), at);
+  vec3 up = cross(at, right);
+  right = normalize(right);
+  up = normalize(up);
+
+  // if auto_size == 1, then size_factor == size*vertex.z
+  // if auto_size == 0, then size_factor == size
+  vec4 size_factor = (1.0-auto_size.x+(auto_size.x*vertex.z))*size;
+
+  vec4 s = uv0 * (size_factor);
+  vec3 r = s.xxx * right;
+  vec3 u = s.yyy * up;
+
+  vec4 pos = vertex + vec4( r + u, 0.0 );
+
+  gl_Position = worldviewproj_matrix * pos;
+  texCoord0 = uv0 + vec4(0.5,0.5,0.0,0.0);
+  frontColour = colour;
+
+#ifdef WITH_DEPTH
+  passDepth( pos );
+#endif
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/nogp/billboard_tile.vert b/rviz_rendering/ogre_media/materials/glsles/nogp/billboard_tile.vert
new file mode 100644
index 00000000..b532643e
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/nogp/billboard_tile.vert
@@ -0,0 +1,51 @@
+// Computes the position of a billboard vertex so
+// the resulting quad will face a given direction given by up & normal.
+// Texture coords are used to determine which corner
+// of the billboard we compute.
+// GLES2 port: gl_Vertex -> vertex, gl_Color -> colour,
+// gl_MultiTexCoord0 -> uv0, gl_TexCoord[0] -> texCoord0,
+// gl_FrontColor -> frontColour; pass_depth.vert inlined under WITH_DEPTH
+// (glsles has no `attach`)
+
+uniform mat4 worldviewproj_matrix;
+uniform vec4 size;
+uniform vec4 normal;
+uniform vec4 up;
+
+attribute vec4 vertex;
+attribute vec4 colour;
+attribute vec4 uv0;
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+#ifdef WITH_DEPTH
+uniform mat4 worldview_matrix;
+
+varying float depth;
+
+void passDepth( vec4 pos )
+{
+  vec4 pos_rel_view = worldview_matrix * pos;
+  depth = -pos_rel_view.z;
+}
+#endif
+
+void main()
+{
+  vec3 right = cross(up.xyz, normal.xyz);
+
+  vec4 s = uv0 * size;
+  vec3 r = s.xxx * right;
+  vec3 u = s.yyy * up.xyz;
+
+  vec4 pos = vertex + vec4( r + u, 0.0 );
+
+  gl_Position = worldviewproj_matrix * pos;
+  texCoord0 = uv0 + vec4(0.5,0.5,0.0,0.0);
+  frontColour = colour;
+
+#ifdef WITH_DEPTH
+  passDepth( pos );
+#endif
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/nogp/box.frag b/rviz_rendering/ogre_media/materials/glsles/nogp/box.frag
new file mode 100644
index 00000000..bda29832
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/nogp/box.frag
@@ -0,0 +1,74 @@
+precision highp float;
+
+// rasterizes a smooth square on any face of a box
+// and creates a fake lighting effect
+// x,y,z texture coords must be in the interval (-0.5...0.5)
+// GLES2 port: gl_Color -> frontColour, gl_TexCoord[0] -> texCoord0;
+// the const float[] array constructor is desktop-only, use an if-chain.
+
+uniform vec4 highlight;
+uniform float alpha;
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+void main()
+{
+  float ax;
+  float ay;
+  float l;
+
+  if ( texCoord0.z > 0.4999 )
+  {
+    ax = texCoord0.x;
+    ay = texCoord0.y;
+    l = 0.9;
+  }
+  else if ( texCoord0.z < -0.4999 )
+  {
+    ax = texCoord0.x;
+    ay = texCoord0.y;
+    l = 0.5;
+  }
+  else if ( texCoord0.x > 0.4999 )
+  {
+    ax = texCoord0.y;
+    ay = texCoord0.z;
+    l = 0.6;
+  }
+  else if ( texCoord0.x < -0.4999 )
+  {
+    ax = texCoord0.y;
+    ay = texCoord0.z;
+    l = 0.6;
+  }
+  else if ( texCoord0.y > 0.4999 )
+  {
+    ax = texCoord0.x;
+    ay = texCoord0.z;
+    l = 1.0;
+  }
+  else
+  {
+    ax = texCoord0.x;
+    ay = texCoord0.z;
+    l = 0.4;
+  }
+
+  float blend = smoothstep(-0.48, -0.45, ay) * (1.0 - smoothstep(0.45, 0.48, ay)) *
+                smoothstep(-0.48, -0.45, ax) * (1.0 - smoothstep(0.45, 0.48, ax));
+
+  float inv_blend = 1.0 - blend;
+
+  //vec3 col = blend * frontColour.xyz + (sign(0.5 - length(vec3(frontColour.xyz))) * vec3(0.2, 0.2, 0.2) + frontColour.xyz) * inv_blend;
+
+  //alternative version: make color at edge darker
+  vec3 col = (0.5 + 0.5*blend) * frontColour.xyz;
+
+  col = col * l;
+
+  col = col + col * highlight.xyz;
+
+
+  gl_FragColor = vec4(col.r, col.g, col.b, alpha * frontColour.a );
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/nogp/box.vert b/rviz_rendering/ogre_media/materials/glsles/nogp/box.vert
new file mode 100644
index 00000000..9d34bca6
--- /dev/null
+++ b/rviz_rendering/ogre_media/materials/glsles/nogp/box.vert
@@ -0,0 +1,47 @@
+// Computes the position of a box vertex from its texture coords.
+// Used in case that geometry shaders are not supported.
+// GLES2 port: gl_Vertex -> vertex, gl_Color -> colour,
+// gl_MultiTexCoord0 -> uv0, gl_TexCoord[0] -> texCoord0,
+// gl_FrontColor -> frontColour; pass_depth.vert inlined under WITH_DEPTH
+// (glsles has no `attach`)
+
+uniform mat4 worldviewproj_matrix;
+uniform vec4 camera_pos;
+uniform vec4 size;
+uniform vec4 auto_size;
+
+attribute vec4 vertex;
+attribute vec4 colour;
+attribute vec4 uv0;
+
+varying vec4 frontColour;
+varying vec4 texCoord0;
+
+#ifdef WITH_DEPTH
+uniform mat4 worldview_matrix;
+
+varying float depth;
+
+void passDepth( vec4 pos )
+{
+  vec4 pos_rel_view = worldview_matrix * pos;
+  depth = -pos_rel_view.z;
+}
+#endif
+
+void main()
+{
+  // if auto_size == 1, then size_factor == size*vertex.z
+  // if auto_size == 0, then size_factor == size
+  vec4 size_factor = (1.0-auto_size.x+(auto_size.x*vertex.z))*size;
+
+  vec4 s = uv0 * size_factor;
+  vec4 pos = vertex - s;
+  gl_Position = worldviewproj_matrix * pos;
+  texCoord0 = uv0;
+  frontColour = colour;
+
+#ifdef WITH_DEPTH
+  passDepth( pos );
+#endif
+}
diff --git a/rviz_rendering/ogre_media/materials/glsles/nogp/nogp.program b/rviz_rendering/ogre_media/materials/glsles/nogp/nogp.program
