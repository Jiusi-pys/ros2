+// Peer-down must return the exact snapshot/writer-liveliness charges. With a
+// one-participant global cap, a different peer can then use the recovered slot
+// and deliver DATA; otherwise a departed remote would permanently poison the
+// discovery table.
+TEST(DiscoveryAdmission, PeerDownReclaimsStateAndAllowsLaterCommunication) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_participants = 1;
+  cfg.max_remote_participants_per_peer = 1;
+  RawUdpPeer first_peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(first_peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  auto *reader =
+      target->create_reader("/reclaim", "test/Reclaim", default_qos());
+  ASSERT_NE(reader, nullptr);
+
+  const auto first = raw_remote_snapshot(
+      0x41, {raw_remote_endpoint(0x41, mdds::EntityKind::WRITER, 1,
+                                  "/reclaim", "test/Reclaim")});
+  const mdds::Guid first_writer = first.endpoints.front().guid;
+  ASSERT_TRUE(
+      raw_announce(first_peer, cfg.domain_id, kTestBasePort5, first, 1));
+  ASSERT_TRUE(wait_until([&] {
+    first_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return reader->matched_count() >= 1;
+  }, 2s, 10ms));
+
+  ASSERT_TRUE(first_peer.send_frame(
+      mdds::encode_heartbeat(first_writer, 1, 1), kTestBasePort5));
+  uint64_t observed = 0;
+  ASSERT_TRUE(wait_until([&] {
+    first_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return target->remote_writer_last_seen_ms(first_writer, observed);
+  }, 2s, 10ms));
+
+  first_peer.close();
+  ASSERT_TRUE(wait_until([&] {
+    return target->graph_counts().remote_participants == 0 &&
+           reader->matched_count() == 0;
+  }, 3s, 20ms));
+  EXPECT_FALSE(target->remote_writer_last_seen_ms(first_writer, observed));
+
+  RawUdpPeer second_peer(kTestBasePort5 + 6);
+  ASSERT_TRUE(second_peer.valid());
+  const auto second = raw_remote_snapshot(
+      0x42, {raw_remote_endpoint(0x42, mdds::EntityKind::WRITER, 1,
+                                  "/reclaim", "test/Reclaim")});
+  const mdds::Guid second_writer = second.endpoints.front().guid;
+  ASSERT_TRUE(
+      raw_announce(second_peer, cfg.domain_id, kTestBasePort5, second, 1));
+  ASSERT_TRUE(wait_until([&] {
+    second_peer.send_presence(cfg.domain_id, kTestBasePort5);
+    return target->graph_counts().remote_participants == 1 &&
+           reader->matched_count() == 1;
+  }, 2s, 10ms));
+
+  const uint8_t payload[] = {0x52, 0x45, 0x43};
+  ASSERT_TRUE(second_peer.send_frame(
+      mdds::encode_data(second_writer, 1, 0, payload, sizeof(payload),
+                        mdds::kFlagReliable),
+      kTestBasePort5));
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  ASSERT_TRUE(wait_until([&] { return reader->take(out, info); }, 2s, 5ms));
+  EXPECT_EQ(out, (std::vector<uint8_t>{0x52, 0x45, 0x43}));
+  EXPECT_EQ(info.writer_guid, second_writer);
+}
