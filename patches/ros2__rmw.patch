@@ -0,0 +1,131 @@
+// Copyright 2017 Open Source Robotics Foundation, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#ifndef RMW__VALIDATE_NAMESPACE_H_
+#define RMW__VALIDATE_NAMESPACE_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include "rmw/macros.h"
+#include "rmw/types.h"
+#include "rmw/validate_full_topic_name.h"
+
+#define RMW_NAMESPACE_VALID 0
+#define RMW_NAMESPACE_INVALID_IS_EMPTY_STRING 1
+#define RMW_NAMESPACE_INVALID_NOT_ABSOLUTE 2
+#define RMW_NAMESPACE_INVALID_ENDS_WITH_FORWARD_SLASH 3
+#define RMW_NAMESPACE_INVALID_CONTAINS_UNALLOWED_CHARACTERS 4
+#define RMW_NAMESPACE_INVALID_CONTAINS_REPEATED_FORWARD_SLASH 5
+#define RMW_NAMESPACE_INVALID_NAME_TOKEN_STARTS_WITH_NUMBER 6
+#define RMW_NAMESPACE_INVALID_TOO_LONG 7
+
+// 额外保留 2 个字符给最短可能的主题，例如 '/X'。
+#define RMW_NAMESPACE_MAX_LENGTH (RMW_TOPIC_MAX_NAME_LENGTH - 2U)
+
+/// 判断给定的命名空间是否有效。
+/** 命名空间的有效性基于此处定义的主题规则：
+ *
+ *   http://design.ros2.org/articles/topic_and_service_names.html
+ *
+ * 注意，此函数期望不存在上述文档中描述的可用于主题和服务的 URL 后缀。
+ *
+ * 如果 C 字符串或 validation_result 指针为 null，则将返回 `RMW_RET_INVALID_ARGUMENT`。
+ * namespace_ 应为一个有效的、以空字符结尾的 C 字符串。
+ * validation_result 整型指针应指向有效内存，以便将结果作为输出变量存储其中。
+ * invalid_index size_t 指针应指向 NULL 或有效内存，以便在发生验证错误时，
+ * 将输入字符串中的位置存储其中。
+ * 如果为 invalid_index 传入 NULL，则不会对其进行设置。
+ *
+ * 如果命名空间有效，则不会为 invalid_index 赋值。
+ *
+ * validation_result 指向的整型将存储以下可能的几种结果值之一（以宏定义）：
+ *
+ * - RMW_NAMESPACE_VALID
+ * - RMW_NAMESPACE_INVALID_IS_EMPTY_STRING
+ * - RMW_NAMESPACE_INVALID_NOT_ABSOLUTE
+ * - RMW_NAMESPACE_INVALID_ENDS_WITH_FORWARD_SLASH
+ * - RMW_NAMESPACE_INVALID_CONTAINS_UNALLOWED_CHARACTERS
+ * - RMW_NAMESPACE_INVALID_CONTAINS_REPEATED_FORWARD_SLASH
+ * - RMW_NAMESPACE_INVALID_NAME_TOKEN_STARTS_WITH_NUMBER
+ * - RMW_NAMESPACE_INVALID_TOO_LONG
+ *
+ * 可以使用 rmw_namespace_validation_result_string() 函数将结果值转换为描述。
+ *
+ * ``RMW_NAMESPACE_INVALID_ENDS_WITH_FORWARD_SLASH`` 验证结果不适用于 ``"/"``，
+ * 因为 ``"/"`` 是一个有效的命名空间。
+ *
+ * ``RMW_NAMESPACE_INVALID_TOO_LONG`` 保证最后检查，
+ * 因此如果你得到该结果，则可以假设所有其他检查均已通过。
+ * 这样做是为了在需要时可以将长度限制视为警告而非错误。
+ *
+ * 如果返回非 RMW_RET_OK 的返回值，则将设置 RMW 错误消息。
+ *
+ * \param[in] namespace_ 要验证的命名空间
+ * \param[out] validation_result 用于存储检查结果的 int
+ * \param[out] invalid_index 输入字符串中发生错误的位置索引
+ * \returns 成功运行检查时返回 `RMW_RET_OK`，或
+ * \returns 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_validate_namespace(
+  const char * namespace_,
+  int * validation_result,
+  size_t * invalid_index);
+
+/// 判断给定的命名空间是否有效。
+/**
+ * 这是带有 namespace_ 长度额外参数的重载。
+ * 如果返回非 RMW_RET_OK 的返回值，则将设置 RMW 错误消息。
+ *
+ * \sa rmw_validate_namespace(const char *, int *, size_t *)
+ *
+ * \param[in] namespace_ 要验证的命名空间
+ * \param[in] namespace_length namespace_ 中的字符数。
+ * \param[out] validation_result 用于存储检查结果的 int
+ * \param[out] invalid_index 输入字符串中发生错误的位置索引
+ * \returns 成功运行检查时返回 `RMW_RET_OK`，或
+ * \returns 参数无效时返回 `RMW_RET_INVALID_ARGUMENT`，或
+ * \returns 发生未指定错误时返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_validate_namespace_with_size(
+  const char * namespace_,
+  size_t namespace_length,
+  int * validation_result,
+  size_t * invalid_index);
+
+/// 返回验证结果描述，如果为 RMW_NAMESPACE_VALID 则返回 NULL。
+/**
+ * \param[in] validation_result 验证结果
+ * \returns 如果验证结果为 `RMW_NAMESPACE_VALID`，则返回 `NULL`，或
+ * \returns 表示验证结果的字符串。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+const char *
+rmw_namespace_validation_result_string(int validation_result);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__VALIDATE_NAMESPACE_H_
