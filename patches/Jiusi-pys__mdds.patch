+// The reassembly key includes the writer's endpoint epoch, and a partial
+// rejects an altered target trailer. These checks prevent a delayed previous
+// endpoint incarnation or targetless fragment from completing a new directed
+// history message.
+TEST(Reassembler, EndpointEpochAndTrailerBindPartialIdentity)
+{
+  const auto writer = make_test_guid(0x22);
+  const auto epoch_a = make_test_guid(0x92);
+  const auto epoch_b = make_test_guid(0x93);
+  const auto target_reader = make_test_guid(0x32);
+  const auto target_epoch_a = make_test_guid(0xa2);
+  const auto target_epoch_b = make_test_guid(0xa3);
+  uint8_t bytes[64] = {};
+  std::vector<uint8_t> out;
+
+  mdds::DataTrailer target_a;
+  target_a.has_target_reader = true;
+  target_a.target_reader = target_reader;
+  target_a.target_reader_epoch = target_epoch_a;
+  mdds::DataTrailer target_b = target_a;
+  target_b.target_reader_epoch = target_epoch_b;
+
+  mdds::Reassembler epochs;
+  EXPECT_FALSE(epochs.add_fragment(
+    writer, epoch_a, 7, 128, 0, bytes, sizeof(bytes), out, &target_a,
+    nullptr, 1000));
+  EXPECT_FALSE(epochs.add_fragment(
+    writer, epoch_b, 7, 128, 0, bytes, sizeof(bytes), out, &target_a,
+    nullptr, 1000));
+  EXPECT_EQ(epochs.pending_count(), 2u);
+
+  mdds::Reassembler mismatch;
+  EXPECT_FALSE(mismatch.add_fragment(
+    writer, epoch_a, 8, 128, 0, bytes, sizeof(bytes), out, &target_a,
+    nullptr, 2000));
+  EXPECT_FALSE(mismatch.add_fragment(
+    writer, epoch_a, 8, 128, 64, bytes, sizeof(bytes), out, &target_b,
+    nullptr, 2000));
+  EXPECT_EQ(mismatch.pending_count(), 0u);
+
+  mdds::Reassembler complete;
+  mdds::DataTrailer completed_trailer;
+  uint64_t completed_pub_time = 0;
+  EXPECT_FALSE(complete.add_fragment(
+    writer, epoch_a, 9, 128, 0, bytes, sizeof(bytes), out, &target_a,
+    nullptr, 3000));
+  EXPECT_TRUE(complete.add_fragment(
+    writer, epoch_a, 9, 128, 64, bytes, sizeof(bytes), out, &target_a,
+    &completed_trailer, 3000, &completed_pub_time));
+  EXPECT_EQ(completed_trailer, target_a);
+  EXPECT_EQ(completed_pub_time, 3000u);
+}
