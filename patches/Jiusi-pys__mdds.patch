+// A payload admission filter (service response routing, see rmw service.cpp)
+// rejects samples BEFORE they occupy queue depth — but the rejected samples
+// still count as RECEIVED for sequencing: the reliable stream keeps order,
+// filtered seqs are neither NACKed forever nor counted lost, and a filtered
+// seq sitting in the reorder window slides away cleanly once the real hole
+// ahead of it is healed.
+TEST(ReliabilityTest, SampleFilterKeepsSequenceAndSkipsDelivery) {
+  std::atomic<bool> dropped_once{false};
+  auto cfg_a = test_config_3();
+  cfg_a.test_send_hook = [&](const uint8_t *f, size_t n) {
+    if (is_data_seq(f, n, 3) && !dropped_once.exchange(true)) {
+      return true; // drop the first copy of seq 3: hole behind filtered seqs
+    }
+    return false;
+  };
+  auto pa = mdds::Participant::create(cfg_a);
+  auto pb = mdds::Participant::create(test_config_3());
+  ASSERT_NE(pa, nullptr);
+  ASSERT_NE(pb, nullptr);
+
+  auto *w = pa->create_writer("/filt", "test/Filt", default_qos());
+  auto *r = pb->create_reader("/filt", "test/Filt", default_qos());
+  ASSERT_NE(w, nullptr);
+  ASSERT_NE(r, nullptr);
+  // Admit only payloads NOT starting with 'x'.
+  r->set_sample_filter([](const uint8_t *data, size_t len) {
+    return len == 0 || data[0] != 'x';
+  });
+  ASSERT_TRUE(wait_matched(w, 1));
+  ASSERT_TRUE(wait_reader_matched(r, 1));
+
+  const char *msgs[] = {"a1", "x2", "a3", "x4", "a5"};
+  for (const char *m : msgs) {
+    ASSERT_TRUE(w->write(reinterpret_cast<const uint8_t *>(m), 3));
+  }
+
+  std::vector<uint64_t> order;
+  auto deadline = std::chrono::steady_clock::now() + 10s;
+  while (std::chrono::steady_clock::now() < deadline && order.size() < 3) {
+    std::vector<uint8_t> out;
+    mdds::MessageInfo info;
+    if (r->take(out, info)) {
+      order.push_back(info.seq);
+    } else {
+      std::this_thread::sleep_for(5ms);
+    }
+  }
+  EXPECT_EQ(order, (std::vector<uint64_t>{1, 3, 5})); // filtered seqs skipped
+  std::this_thread::sleep_for(500ms); // let heartbeats/NACKs settle
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  EXPECT_FALSE(r->take(out, info));  // nothing else ever shows up
+  EXPECT_EQ(r->messages_lost(), 0u); // filtered samples are received, not lost
+}
+
+// Same filter on the LOCAL (same-participant) delivery path: the admission
+// check lives in the reader's enqueue, shared by local and remote delivery.
+TEST_F(ParticipantFixture, SampleFilterAppliesToLocalDelivery) {
