+#ifndef RMW__GET_TOPIC_NAMES_AND_TYPES_H_
+#define RMW__GET_TOPIC_NAMES_AND_TYPES_H_
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+#include "rmw/macros.h"
+#include "rmw/names_and_types.h"
+#include "rmw/types.h"
+#include "rmw/visibility_control.h"
+
+/// 返回 ROS 图中的所有主题名称和类型。
+/**
+ * 该函数返回 ROS 图中所有主题名称和类型的数组，即由给定本地节点截至目前发现的、
+ * 存在发布器和/或订阅器的主题。
+ *
+ * 除非 `no_demangle` 为 true，否则在按照中间件实现列出主题时可能会进行一些还原（demangle）和过滤。
+ * 是否进行还原以及如何还原，取决于底层实现。
+ * 有关如何在基于 DDS 和 RTPS 的实现中使用，请参见 http://design.ros2.org/articles/topic_and_service_names.html。
+ *
+ * <hr>
+ * 属性          | 遵循情况
+ * ------------------ | -------------
+ * 分配内存   | 是
+ * 线程安全        | 是
+ * 使用原子操作       | 可能 [1]
+ * 无锁          | 可能 [1]
+ * <i>[1] 由 rmw 实现定义，请参阅实现文档</i>
+ *
+ * \par 运行时行为
+ *   查询 ROS 图是一个同步操作。
+ *   它也是非阻塞的，但不保证无锁。
+ *   一般而言，实现可以使用锁来同步对内部资源的访问，但不允许等待没有保证时间边界的事件
+ *   （因操作系统调度导致饥饿的情况除外）。
+ *
+ * \par 线程安全性
+ *   节点是线程安全的对象，除终结操作外，对节点的所有操作也都是线程安全的。
+ *   因此，使用同一节点并发查询 ROS 图是安全的。
+ *   但是，在查询主题名称和类型时：
+ *   - 对名称和类型数组的访问未同步。
+ *     在 rmw_get_topic_names_and_types() 使用 `topic_names_and_types` 期间读取或写入它是不安全的。
+ *   - 默认分配器是线程安全的对象，但任何自定义 `allocator` 可能并非如此。
+ *     请查阅分配器文档以获取更多参考。
+ *
+ * \pre 给定的 `node` 必须是有效的节点句柄，即由 rmw_create_node() 返回的句柄。
+ * \pre 给定的 `topic_names_and_types` 必须是零初始化的名称和类型数组，
+ *   即由 rmw_get_zero_initialized_names_and_types() 返回的数组。
+ *
+ * \param[in] node 用于查询 ROS 图的节点。
+ * \param[in] allocator 填充 `topic_names_and_types` 数组时使用的分配器。
+ * \param[in] no_demangle 是否按照 ROS 约定对所有主题名称进行还原。
+ * \param[out] topic_names_and_types 主题名称及其类型的数组，成功时填充，失败时保持不变。
+ *   如果已填充，调用者需稍后使用 rmw_names_and_types_fini() 终结该数组。
+ * \return 如果查询成功，返回 `RMW_RET_OK`，否则
+ * \return 如果 `node` 为 NULL，返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \return 如果 `allocator` 按照 rcutils_allocator_is_valid() 的定义无效，返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \return 如果 `topic_names_and_types` 为 NULL，返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \return 如果 `topic_names_and_types` 不是零初始化的数组，返回 `RMW_RET_INVALID_ARGUMENT`，否则
+ * \return 如果 `node` 的实现标识符与此实现不匹配，返回 `RMW_RET_INCORRECT_RMW_IMPLEMENTATION`，否则
+ * \return 如果内存分配失败，返回 `RMW_RET_BAD_ALLOC`，否则
+ * \return 如果发生未指明的错误，返回 `RMW_RET_ERROR`。
+ */
+RMW_PUBLIC
+RMW_WARN_UNUSED
+rmw_ret_t
+rmw_get_topic_names_and_types(
+  const rmw_node_t * node,
+  rcutils_allocator_t * allocator,
+  bool no_demangle,
+  rmw_names_and_types_t * topic_names_and_types);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // RMW__GET_TOPIC_NAMES_AND_TYPES_H_
diff --git a/rmw/include/rmw/impl/cpp/demangle_zh.hpp b/rmw/include/rmw/impl/cpp/demangle_zh.hpp
new file mode 100644
index 0000000..d7d0807
--- /dev/null
+++ b/rmw/include/rmw/impl/cpp/demangle_zh.hpp
@@ -0,0 +1,62 @@
+// Copyright 2015 Open Source Robotics Foundation, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
