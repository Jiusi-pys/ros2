+using namespace std::chrono_literals;
+
+class FakeDsoftbus {
+public:
+  enum class BindCallbackMode {
+    NONE,
+    HOLD_THEN_SYNCHRONOUS,
+  };
+
+  void reset() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    next_socket_ = 100;
+    listener_ = nullptr;
+    option_result_ = SOFTBUS_OK;
+    option_limit_ = 64 * 1024;
+    shutdown_calls_.clear();
+    sent_.clear();
+    online_nodes_.clear();
+    socket_network_ids_.clear();
+    hold_listen_ = false;
+    release_listen_ = false;
+    listen_started_ = 0;
+    bind_callback_mode_ = BindCallbackMode::NONE;
+    release_bind_callbacks_ = false;
+    bind_calls_ = 0;
+    bind_started_ = 0;
+    bind_returned_ = 0;
+    get_nodes_calls_ = 0;
+  }
+
+  int32_t socket(SocketInfo info) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const int32_t fd = next_socket_++;
+    if (info.peerNetworkId != nullptr) {
+      socket_network_ids_[fd] = info.peerNetworkId;
+    }
+    return fd;
+  }
+
+  void hold_listen_until_released() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    hold_listen_ = true;
+    release_listen_ = false;
+    listen_started_ = 0;
+  }
+
+  bool wait_for_listen_started(size_t count = 1,
+                               std::chrono::milliseconds timeout = 2s) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return listen_started_ >= count; });
+  }
+
+  void release_listen() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    release_listen_ = true;
+    cv_.notify_all();
+  }
+
+  void listen(const ISocketListener *listener) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    listener_ = listener;
+    ++listen_started_;
+    cv_.notify_all();
+    if (hold_listen_) {
+      cv_.wait(lock, [this] { return release_listen_; });
+    }
+  }
+
+  const ISocketListener *listener() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return listener_;
+  }
+
+  bool wait_for_listener(std::chrono::milliseconds timeout = 1s) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout, [this] { return listener_ != nullptr; });
+  }
+
+  void configure_option(int32_t result, uint32_t limit) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    option_result_ = result;
+    option_limit_ = limit;
+  }
+
+  void set_online_nodes(const std::vector<std::string> &network_ids) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    online_nodes_.clear();
+    online_nodes_.reserve(network_ids.size());
+    for (const std::string &network_id : network_ids) {
+      NodeBasicInfo info{};
+      std::snprintf(info.networkId, sizeof(info.networkId), "%s",
+                    network_id.c_str());
+      online_nodes_.push_back(info);
+    }
+  }
+
+  int32_t get_nodes(NodeBasicInfo **nodes, int32_t *count) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++get_nodes_calls_;
+    if (nodes != nullptr) {
+      if (online_nodes_.empty()) {
+        *nodes = nullptr;
+      } else {
+        auto *copy = new NodeBasicInfo[online_nodes_.size()];
+        for (size_t i = 0; i < online_nodes_.size(); ++i) {
+          copy[i] = online_nodes_[i];
+        }
+        *nodes = copy;
+      }
+    }
+    if (count != nullptr) {
+      *count = static_cast<int32_t>(online_nodes_.size());
+    }
+    cv_.notify_all();
+    return SOFTBUS_OK;
+  }
+
+  void hold_then_synchronously_bind() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    bind_callback_mode_ = BindCallbackMode::HOLD_THEN_SYNCHRONOUS;
+    release_bind_callbacks_ = false;
+    bind_calls_ = 0;
+    bind_started_ = 0;
+    bind_returned_ = 0;
+  }
+
+  bool wait_for_bind_started(size_t count = 1,
+                             std::chrono::milliseconds timeout = 2s) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return bind_started_ >= count; });
+  }
+
+  void release_bind_callbacks() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    release_bind_callbacks_ = true;
+    cv_.notify_all();
+  }
+
+  bool wait_for_bind_returned(size_t count = 1,
+                              std::chrono::milliseconds timeout = 2s) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return bind_returned_ >= count; });
+  }
+
+  size_t bind_call_count() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return bind_calls_;
+  }
+
+  bool wait_for_bind_calls(size_t count,
+                           std::chrono::milliseconds timeout = 2s) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return bind_calls_ >= count; });
+  }
+
+  bool wait_for_node_queries(size_t count,
+                             std::chrono::milliseconds timeout = 4s) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return get_nodes_calls_ >= count; });
+  }
+
+  int32_t bind_async(int32_t fd, const ISocketListener *listener) {
+    std::string network_id;
+    bool call_synchronously = false;
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      ++bind_calls_;
+      cv_.notify_all();
+      if (bind_callback_mode_ == BindCallbackMode::HOLD_THEN_SYNCHRONOUS) {
+        ++bind_started_;
+        cv_.notify_all();
+        cv_.wait(lock, [this] { return release_bind_callbacks_; });
+        const auto it = socket_network_ids_.find(fd);
+        if (it != socket_network_ids_.end()) {
+          network_id = it->second;
+          call_synchronously = true;
+        }
+      }
+    }
+    if (call_synchronously && listener != nullptr &&
+        listener->OnBind != nullptr) {
+      PeerSocketInfo info{};
+      info.networkId = const_cast<char *>(network_id.c_str());
+      listener->OnBind(fd, info);
+    }
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      ++bind_returned_;
+      cv_.notify_all();
+    }
+    return SOFTBUS_OK;
+  }
+
+  int32_t get_option(void *value, uint32_t value_size) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (option_result_ != SOFTBUS_OK) {
+      return option_result_;
+    }
+    if (value == nullptr || value_size != sizeof(option_limit_)) {
+      return -1;
+    }
+    *static_cast<uint32_t *>(value) = option_limit_;
+    return SOFTBUS_OK;
+  }
+
+  void shutdown(int32_t fd) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++shutdown_calls_[fd];
+    cv_.notify_all();
+  }
+
+  size_t shutdown_count(int32_t fd) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto it = shutdown_calls_.find(fd);
+    return it == shutdown_calls_.end() ? 0 : it->second;
+  }
+
+  void send(int32_t fd, const void *data, uint32_t len) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto *first = static_cast<const uint8_t *>(data);
+    sent_.emplace_back(fd, std::vector<uint8_t>(first, first + len));
+    cv_.notify_all();
+  }
+
+  bool wait_for_sends(size_t count, std::chrono::milliseconds timeout = 2s) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return sent_.size() >= count; });
+  }
+
+  std::vector<std::pair<int32_t, std::vector<uint8_t>>> sent() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return sent_;
+  }
+
+private:
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  int32_t next_socket_ = 100;
+  const ISocketListener *listener_ = nullptr;
+  int32_t option_result_ = SOFTBUS_OK;
+  uint32_t option_limit_ = 64 * 1024;
+  std::map<int32_t, size_t> shutdown_calls_;
+  std::vector<std::pair<int32_t, std::vector<uint8_t>>> sent_;
+  std::vector<NodeBasicInfo> online_nodes_;
+  std::map<int32_t, std::string> socket_network_ids_;
+  bool hold_listen_ = false;
+  bool release_listen_ = false;
+  size_t listen_started_ = 0;
+  BindCallbackMode bind_callback_mode_ = BindCallbackMode::NONE;
+  bool release_bind_callbacks_ = false;
+  size_t bind_calls_ = 0;
+  size_t bind_started_ = 0;
+  size_t bind_returned_ = 0;
+  size_t get_nodes_calls_ = 0;
+};
+
+FakeDsoftbus &fake() {
+  static FakeDsoftbus state;
+  return state;
+}
+
+template <typename Predicate>
+bool wait_until(Predicate predicate,
+                std::chrono::milliseconds timeout = 2s) {
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  do {
+    if (predicate()) {
+      return true;
+    }
+    std::this_thread::sleep_for(2ms);
+  } while (std::chrono::steady_clock::now() < deadline);
+  return predicate();
+}
+
+void emit_bind(int32_t fd, const std::string &network_id) {
+  const ISocketListener *const listener = fake().listener();
+  ASSERT_NE(listener, nullptr);
+  ASSERT_NE(listener->OnBind, nullptr);
+  PeerSocketInfo info{};
+  info.networkId = const_cast<char *>(network_id.c_str());
+  listener->OnBind(fd, info);
+}
+
+void emit_bind_raw(int32_t fd, char *network_id) {
+  const ISocketListener *const listener = fake().listener();
+  ASSERT_NE(listener, nullptr);
+  ASSERT_NE(listener->OnBind, nullptr);
+  PeerSocketInfo info{};
+  info.networkId = network_id;
+  listener->OnBind(fd, info);
+}
+
+void emit_shutdown(int32_t fd, ShutdownReason reason) {
+  const ISocketListener *const listener = fake().listener();
+  ASSERT_NE(listener, nullptr);
+  ASSERT_NE(listener->OnShutdown, nullptr);
+  listener->OnShutdown(fd, reason);
+}
+
+void emit_bytes(int32_t fd, const void *data, uint32_t len) {
+  const ISocketListener *const listener = fake().listener();
+  ASSERT_NE(listener, nullptr);
+  ASSERT_NE(listener->OnBytes, nullptr);
+  listener->OnBytes(fd, data, len);
+}
+
+class RecordingListener : public mdds::TransportListener {
+public:
+  void on_peer_up(mdds::PeerId peer) override {
+    std::function<void()> hook;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      hook = on_up_hook_;
+    }
+    // A synchronous BindAsync completion can run on the transport poll
+    // worker. Model a participant graph callback that destroys the owner from
+    // that exact path, without holding the listener mutex.
+    if (hook) {
+      hook();
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    ups_.push_back(peer);
+    cv_.notify_all();
+  }
+
+  void on_peer_down(mdds::PeerId peer) override {
+    std::function<void()> hook;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      hook = on_down_hook_;
+    }
+    // This models ParticipantImpl::handle_peer_down() reaching a graph/event
+    // callback that stops its owning participant/transport.  Run it outside
+    // the listener mutex so the test can wait for completion deterministically.
+    if (hook) {
+      hook();
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    downs_.push_back(peer);
+    cv_.notify_all();
+  }
+
+  void on_bytes(mdds::PeerId peer, const uint8_t *data, size_t len) override {
+    std::function<void()> hook;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      hook = on_bytes_hook_;
+    }
+    if (hook) {
+      hook();
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    received_.emplace_back(peer, std::vector<uint8_t>(data, data + len));
+  }
+
+  std::vector<mdds::PeerId> ups() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return ups_;
+  }
+
+  std::vector<mdds::PeerId> downs() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return downs_;
+  }
+
+  void set_on_up_hook(std::function<void()> hook) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    on_up_hook_ = std::move(hook);
+  }
+
+  void set_on_down_hook(std::function<void()> hook) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    on_down_hook_ = std::move(hook);
+  }
+
+  void set_on_bytes_hook(std::function<void()> hook) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    on_bytes_hook_ = std::move(hook);
+  }
+
+  bool wait_for_down(size_t count = 1,
+                     std::chrono::milliseconds timeout = 6s) const {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return downs_.size() >= count; });
+  }
+
+  bool wait_for_up(size_t count = 1,
+                   std::chrono::milliseconds timeout = 6s) const {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return cv_.wait_for(lock, timeout,
+                        [this, count] { return ups_.size() >= count; });
+  }
+
+private:
+  mutable std::mutex mutex_;
+  mutable std::condition_variable cv_;
+  std::vector<mdds::PeerId> ups_;
+  std::vector<mdds::PeerId> downs_;
+  std::vector<std::pair<mdds::PeerId, std::vector<uint8_t>>> received_;
+  std::function<void()> on_up_hook_;
+  std::function<void()> on_down_hook_;
+  std::function<void()> on_bytes_hook_;
+};
