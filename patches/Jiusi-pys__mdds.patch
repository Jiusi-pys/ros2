+/// Stand-in for a transport object whose C-callback handlers can be parked
+/// inside a dispatch. `events` is a mutex-protected ordered log used to
+/// assert cross-thread happens-before order without sleeps.
+struct FakeInstance
+{
+  std::mutex mutex;
+  std::condition_variable cv;
+  int entered = 0;
+  bool gate_open = false;
+  std::vector<std::string> events;
+
+  /// Log `event` under the lock (ordered against gate waits/releases).
+  void log(const std::string & event)
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    events.push_back(event);
+  }
+
+  void mark_entered()
+  {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      ++entered;
+    }
+    cv.notify_all();
+  }
+
+  /// Park inside the "handler" until the gate opens, then log the leave.
+  void wait_gate(const std::string & leave_event)
+  {
+    std::unique_lock<std::mutex> lock(mutex);
+    cv.wait(lock, [this] {return gate_open;});
+    events.push_back(leave_event);
+  }
+
+  void wait_entered(int count)
+  {
+    std::unique_lock<std::mutex> lock(mutex);
+    const bool ok = cv.wait_for(lock, 5s, [this, count] {return entered >= count;});
+    ASSERT_TRUE(ok) << "handlers did not enter in time";
+  }
+
+  void open_gate()
+  {
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      gate_open = true;
+    }
+    cv.notify_all();
+  }
+
+  std::vector<std::string> snapshot()
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    return events;
+  }
+};
+
+class CallbackRegistryTest : public ::testing::Test
+{
+protected:
+  mdds::CallbackRegistry<FakeInstance> registry_;
+};
+
+/// Register/Unregister round trip; after the drain no instance is acquirable.
+TEST_F(CallbackRegistryTest, RegisterDrainUnregister)
+{
+  FakeInstance inst;
+  const uint64_t gen = registry_.Register(&inst);
+  ASSERT_NE(gen, 0u);
+  ASSERT_EQ(registry_.Acquire(), &inst);
+  registry_.Release();
+
+  registry_.UnregisterAndDrain(&inst, gen, false);
+  EXPECT_EQ(registry_.Acquire(), nullptr);
+  registry_.MarkCleanupDone(gen);  // owner cleanup acked: gate reopens
+}
+
+/// A second registration while an instance is live cannot proceed: the
+/// non-blocking start() path (mutex() + RegisterLocked) reports the closed
+/// gate with 0, while Register() would BLOCK until the slot frees (pinned by
+/// NewGenerationWaitsForOldCleanup). After draining the first instance AND
+/// acknowledging its cleanup, a new instance registers with a fresh
+/// generation token.
+TEST_F(CallbackRegistryTest, SingleInstanceAndGenerationFence)
+{
+  FakeInstance a;
+  FakeInstance b;
+  const uint64_t gen_a = registry_.Register(&a);
+  ASSERT_NE(gen_a, 0u);
+  {
+    // Slot occupied: RegisterLocked (called under mutex(), as a serialized
+    // start() does) fails fast instead of blocking.
+    std::lock_guard<std::mutex> lock(registry_.mutex());
+    EXPECT_EQ(registry_.RegisterLocked(&b), 0u);
+  }
+
+  registry_.UnregisterAndDrain(&a, gen_a, false);
+  registry_.MarkCleanupDone(gen_a);  // drain alone does not reopen the gate
+  const uint64_t gen_b = registry_.Register(&b);
+  ASSERT_NE(gen_b, 0u);
+  ASSERT_NE(gen_a, gen_b);
+
+  // ABA fence: a stale unregistration for (a, gen_a) must not evict b —
+  // not even when the allocator hands a new instance the old address, which
+  // the generation token alone catches.
+  registry_.UnregisterAndDrain(&a, gen_a, false);
+  EXPECT_EQ(registry_.Acquire(), &b);
+  registry_.Release();
+
+  registry_.UnregisterAndDrain(&b, gen_b, false);
+  EXPECT_EQ(registry_.Acquire(), nullptr);
+  registry_.MarkCleanupDone(gen_b);
+}
+
+/// The drain alone does NOT reopen the registration gate: a new Register()
+/// blocks until the retired generation's owner acknowledges its cleanup via
+/// MarkCleanupDone(). A new instance can never become dispatchable while the
+/// previous owner's sockets/threads are still being torn down.
+TEST_F(CallbackRegistryTest, NewGenerationWaitsForOldCleanup)
+{
+  FakeInstance a;
+  FakeInstance b;
+  const uint64_t gen_a = registry_.Register(&a);
+  ASSERT_NE(gen_a, 0u);
+
+  registry_.UnregisterAndDrain(&a, gen_a, false);
+  // Drained but NOT cleanup-acked: a concurrent Register() must block.
+
+  std::atomic<bool> registered{false};
+  uint64_t gen_b = 0;
+  std::thread t([this, &b, &registered, &gen_b] {
+      gen_b = registry_.Register(&b);
+      registered.store(true);
+    });
+
+  std::this_thread::sleep_for(200ms);
+  EXPECT_FALSE(registered.load())
+    << "Register() returned before MarkCleanupDone() opened the gate";
+
+  registry_.MarkCleanupDone(gen_a);
+  t.join();
+  ASSERT_TRUE(registered.load());
+  ASSERT_NE(gen_b, 0u);
+  EXPECT_GT(gen_b, gen_a);
+
+  registry_.UnregisterAndDrain(&b, gen_b, false);
+  registry_.MarkCleanupDone(gen_b);
+}
+
+/// The generation token fences every operation against ABA: once gen1 is
+/// retired and gen2 is live, a stale UnregisterAndDrain/MarkCleanupDone
+/// carrying gen1 must no-op — gen2 stays dispatchable, and gen2's cleanup
+/// gate stays closed until gen2's own MarkCleanupDone().
+TEST_F(CallbackRegistryTest, StaleGenerationOpsAreNoops)
+{
+  FakeInstance a;
+  FakeInstance b;
+  FakeInstance c;
+  const uint64_t gen1 = registry_.Register(&a);
+  ASSERT_NE(gen1, 0u);
+  registry_.UnregisterAndDrain(&a, gen1, false);
+  registry_.MarkCleanupDone(gen1);  // gen1 fully retired
+
+  const uint64_t gen2 = registry_.Register(&b);
+  ASSERT_NE(gen2, 0u);
+  ASSERT_GT(gen2, gen1);
+
+  // Stale ops for the retired generation must not disturb gen2.
+  registry_.UnregisterAndDrain(&a, gen1, false);
+  registry_.MarkCleanupDone(gen1);
+  EXPECT_EQ(registry_.Acquire(), &b);  // still dispatchable
+  registry_.Release();
+
+  // Nor may the stale MarkCleanupDone have opened the cleanup gate: after
+  // draining gen2 without its ack, a new Register() must still block.
+  registry_.UnregisterAndDrain(&b, gen2, false);
+  std::atomic<bool> registered{false};
+  uint64_t gen3 = 0;
+  std::thread t([this, &c, &registered, &gen3] {
+      gen3 = registry_.Register(&c);
+      registered.store(true);
+    });
+  std::this_thread::sleep_for(200ms);
+  EXPECT_FALSE(registered.load())
+    << "stale MarkCleanupDone() opened the registration gate";
+
+  registry_.MarkCleanupDone(gen2);
+  t.join();
+  ASSERT_TRUE(registered.load());
+  ASSERT_NE(gen3, 0u);
+  EXPECT_GT(gen3, gen2);
+
+  registry_.UnregisterAndDrain(&c, gen3, false);
+  registry_.MarkCleanupDone(gen3);
