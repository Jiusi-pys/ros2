+class FakeWriter final : public mdds::Writer
+{
+public:
+  FakeWriter(
+    std::shared_ptr<FakeStats> stats, std::string topic, std::string type,
+    const mdds::QosProfile & qos)
+  : stats_(std::move(stats)), topic_(std::move(topic)), type_(std::move(type)), qos_(qos)
+  {}
+
+  mdds::Guid guid() const override {return {};}
+  const std::string & topic() const override {return topic_;}
+  const std::string & type_name() const override {return type_;}
+  const mdds::QosProfile & qos() const override {return qos_;}
+  bool write(const uint8_t *, size_t) override
+  {
+    stats_->mdds_writes.fetch_add(1, std::memory_order_relaxed);
+    return true;
+  }
+  size_t matched_count() const override {return 1;}
+  void assert_liveliness() override {}
+  mdds::WriterHistoryStatus history_status() const override {return {};}
+
+private:
+  std::shared_ptr<FakeStats> stats_;
+  std::string topic_;
+  std::string type_;
+  mdds::QosProfile qos_;
+};
+
+class FakeReader final : public mdds::Reader
+{
+public:
+  FakeReader(
+    std::shared_ptr<FakeStats> stats, std::string topic, std::string type,
+    const mdds::QosProfile & qos, std::vector<uint8_t> payload)
+  : stats_(std::move(stats)), topic_(std::move(topic)), type_(std::move(type)), qos_(qos),
+    payload_(std::move(payload))
+  {}
+
+  mdds::Guid guid() const override {return {};}
+  const std::string & topic() const override {return topic_;}
+  const std::string & type_name() const override {return type_;}
+  const mdds::QosProfile & qos() const override {return qos_;}
+  bool take(std::vector<uint8_t> & out, mdds::MessageInfo & info) override
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (taken_) {
+      return false;
+    }
+    taken_ = true;
+    out = payload_;
+    info = {};
+    stats_->mdds_takes.fetch_add(1, std::memory_order_relaxed);
+    return true;
+  }
+  size_t available() const override
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return taken_ ? 0 : 1;
+  }
+  size_t matched_count() const override {return 1;}
+  size_t compatible_matched_count() const override {return 1;}
+  uint64_t messages_lost() const override {return 0;}
+  uint64_t resource_limit_drops() const override {return 0;}
+  void set_data_callback(std::function<void()> cb) override
+  {
+    callback_ = std::move(cb);
+    if (callback_) {
+      callback_();
+    }
+  }
+  void set_sample_filter(std::function<bool(const uint8_t *, size_t)>) override {}
+
+private:
+  std::shared_ptr<FakeStats> stats_;
+  std::string topic_;
+  std::string type_;
+  mdds::QosProfile qos_;
+  std::vector<uint8_t> payload_;
+  mutable std::mutex mutex_;
+  bool taken_ = false;
+  std::function<void()> callback_;
+};
