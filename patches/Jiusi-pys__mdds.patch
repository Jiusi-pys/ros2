+/// Parse "a.b.c.d/n" into (network, mask), host byte order.
+bool parse_cidr(const std::string & s, uint32_t & net, uint32_t & mask)
+{
+  const size_t slash = s.find('/');
+  if (slash == std::string::npos) {
+    return false;
+  }
+  in_addr a{};
+  if (inet_pton(AF_INET, s.substr(0, slash).c_str(), &a) != 1) {
+    return false;
+  }
+  const std::string prefix = s.substr(slash + 1);
+  if (prefix.empty() || prefix.size() > 2 ||
+    prefix.find_first_not_of("0123456789") != std::string::npos)
+  {
+    return false;
+  }
+  const unsigned bits = static_cast<unsigned>(std::stoul(prefix));
+  if (bits > 32) {
+    return false;
+  }
+  mask = bits == 0 ? 0u : (0xFFFFFFFFu << (32 - bits));
+  net = ntohl(a.s_addr) & mask;
+  return true;
+}
+
 bool debug_enabled()
