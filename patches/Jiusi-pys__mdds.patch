+TEST(UdpLoopback, PeerCapRejectsFreshPingAndReAdmitsAfterTimeout)
+{
+  RecordingListener listener;
+  auto transport = mdds::make_udp_loopback_transport();
+  auto cfg = test_config();
+  cfg.domain_id = 79;  // isolate this raw-presence test from the other cases
+  cfg.max_peers = 1;
+  // Leave a clear deterministic window for the cap assertion, then use the
+  // normal timeout sweep to prove that removing the sole peer frees capacity.
+  cfg.udp_announce_ms = 200;
+  ASSERT_TRUE(transport->start(cfg, &listener));
+  const uint16_t target_port = bound_udp_port(*transport);
+  ASSERT_NE(target_port, 0U);
+
+  RawPingSender admitted;
+  RawPingSender initially_rejected;
+  ASSERT_TRUE(admitted.valid());
+  ASSERT_TRUE(initially_rejected.valid());
+
+  ASSERT_TRUE(admitted.send_presence(cfg.domain_id, target_port));
+  ASSERT_TRUE(listener.wait_for_peer_up(1, 2s));
+  EXPECT_EQ(transport->status().peer_count, 1U);
+
+  // A syntactically valid, same-domain PING from a second source port is the
+  // cap+1 admission attempt. It must not alter the live peer count or emit a
+  // second callback while the first source is still within its lease.
+  ASSERT_TRUE(initially_rejected.send_presence(cfg.domain_id, target_port));
+  EXPECT_FALSE(listener.wait_for_peer_up(2, 200ms));
+  EXPECT_EQ(transport->status().peer_count, 1U);
