+// cppcheck-suppress syntaxError
+typedef enum RMW_PUBLIC_TYPE rmw_qos_liveliness_policy_e
+{
+  /// 实现特定的默认值
+  RMW_QOS_POLICY_LIVELINESS_SYSTEM_DEFAULT = 0,
+
+  /// 确立话题处于活跃状态的信号来自 ROS rmw 层。
+  RMW_QOS_POLICY_LIVELINESS_AUTOMATIC = 1,
+
+  /// 此情况下需要显式断言节点活跃度。
