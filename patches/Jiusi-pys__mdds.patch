+  uint64_t gen_b = 0;
+  std::thread next([this, &b, &registered, &gen_b] {
+      gen_b = registry_.Register(&b);
+      registered.store(true);
+    });
+
+  std::this_thread::sleep_for(100ms);
+  EXPECT_FALSE(registered.load());
+  registry_.Release(true);  // inner frame unwinds first
+  std::this_thread::sleep_for(100ms);
+  EXPECT_FALSE(registered.load()) << "outer old-generation pin was not fenced";
+  registry_.Release(true);  // outer frame can now unwind
+  next.join();
+
+  ASSERT_TRUE(registered.load());
+  ASSERT_GT(gen_b, gen_a);
+  registry_.UnregisterAndDrain(&b, gen_b, false);
+  registry_.MarkCleanupDone(gen_b);
+}
+
+/// Two concurrent drainers must not deadlock: BOTH wait for the in-flight
+/// handler to leave (a concurrent drainer never gets an early pass — pinned
+/// by TwoStoppersWaitForParkedCallback); both complete once it Releases.
+TEST_F(CallbackRegistryTest, ConcurrentDrainersDoNotDeadlock)
+{
+  FakeInstance inst;
+  const uint64_t gen = registry_.Register(&inst);
+  ASSERT_NE(gen, 0u);
+
+  std::thread parked([this, &inst] {
+      if (registry_.Acquire() == nullptr) {
+        return;
+      }
+      inst.mark_entered();
+      inst.wait_gate("parked-leave");
+      registry_.Release();
+    });
+  inst.wait_entered(1);
+
+  std::thread d1([this, &inst, gen] {registry_.UnregisterAndDrain(&inst, gen, false);});
+  std::thread d2([this, &inst, gen] {registry_.UnregisterAndDrain(&inst, gen, false);});
+  std::this_thread::sleep_for(20ms);
+  inst.open_gate();
+
+  parked.join();
+  d1.join();
+  d2.join();
+  EXPECT_EQ(registry_.Acquire(), nullptr);
+  registry_.MarkCleanupDone(gen);
+}
+
+/// Two concurrent stoppers of the same generation (e.g. a transport
+/// destructor racing an explicit stop()) BOTH stay blocked while a parked
+/// non-draining callback of that generation is still executing; once it
+/// leaves, both drains return.
+TEST_F(CallbackRegistryTest, TwoStoppersWaitForParkedCallback)
+{
+  FakeInstance inst;
+  const uint64_t gen = registry_.Register(&inst);
+  ASSERT_NE(gen, 0u);
+
+  std::thread parked([this, &inst] {
+      if (registry_.Acquire() == nullptr) {
+        return;
+      }
+      inst.mark_entered();
+      inst.wait_gate("parked-leave");
+      registry_.Release();
+    });
+  inst.wait_entered(1);  // parked holds its pin before any drain can start
+
+  std::atomic<bool> d1_returned{false};
+  std::atomic<bool> d2_returned{false};
+  std::thread d1([this, &inst, gen, &d1_returned] {
+      registry_.UnregisterAndDrain(&inst, gen, false);
+      d1_returned.store(true);
+    });
+  std::thread d2([this, &inst, gen, &d2_returned] {
+      registry_.UnregisterAndDrain(&inst, gen, false);
+      d2_returned.store(true);
+    });
+
+  // 200ms observation window: neither stopper may return while the parked
+  // callback is still inside its handler.
+  std::this_thread::sleep_for(200ms);
+  EXPECT_FALSE(d1_returned.load())
+    << "drainer 1 got an early pass while a callback was parked";
+  EXPECT_FALSE(d2_returned.load())
+    << "drainer 2 got an early pass while a callback was parked";
+
+  inst.open_gate();
+  parked.join();
+  d1.join();
+  d2.join();
+  EXPECT_TRUE(d1_returned.load());
+  EXPECT_TRUE(d2_returned.load());
+  EXPECT_EQ(registry_.Acquire(), nullptr);
+  registry_.MarkCleanupDone(gen);
+}
+
+/// Two threads stopping from INSIDE their own dispatched callbacks: each
+/// drainer tolerates its own frame AND the frames of other in-dispatch
+/// drainers, so both drains return without deadlock once no OTHER
+/// (non-draining) callback of the generation is in flight.
+TEST_F(CallbackRegistryTest, ConcurrentInDispatchDrainers)
+{
+  FakeInstance inst;
+  const uint64_t gen = registry_.Register(&inst);
+  ASSERT_NE(gen, 0u);
+
+  std::atomic<int> drains_done{0};
+  auto in_dispatch_stopper = [this, &inst, gen, &drains_done] {
+    FakeInstance * pin = registry_.Acquire();
+    if (pin == nullptr) {
+      return;
+    }
+    inst.mark_entered();
+    // Barrier: hold the dispatch frame until BOTH threads are inside their
+    // callbacks, so the two drains genuinely overlap (otherwise the first
+    // drain could close dispatch before the second thread even Acquires).
+    inst.wait_gate("stopper-drain");
+    registry_.UnregisterAndDrain(pin, gen, true);
+    drains_done.fetch_add(1);
+    registry_.Release(true);
+  };
+  std::thread t1(in_dispatch_stopper);
+  std::thread t2(in_dispatch_stopper);
+
+  inst.wait_entered(2);  // both hold dispatch pins; neither has drained yet
+  inst.open_gate();
+  t1.join();
+  t2.join();
+
+  EXPECT_EQ(drains_done.load(), 2);
+  EXPECT_EQ(registry_.Acquire(), nullptr);
+  registry_.MarkCleanupDone(gen);
+}
+
+/// Stress: many threads Acquire/Release while the main thread drains; every
+/// in-flight frame finishes, none starts after unregister, and the registry
+/// stays usable for the next generation (no counter underflow).
+TEST_F(CallbackRegistryTest, AcquireReleaseStressThenDrain)
+{
+  FakeInstance inst;
+  const uint64_t gen = registry_.Register(&inst);
+  ASSERT_NE(gen, 0u);
+
+  std::atomic<bool> stop{false};
+  std::atomic<uint64_t> cycles{0};
+  std::vector<std::thread> workers;
+  for (int i = 0; i < 8; ++i) {
+    workers.emplace_back([this, &stop, &cycles] {
+        while (!stop.load(std::memory_order_relaxed)) {
+          if (registry_.Acquire() != nullptr) {
+            registry_.Release();
+            cycles.fetch_add(1, std::memory_order_relaxed);
+          }
+        }
+      });
+  }
+  std::this_thread::sleep_for(20ms);
+  registry_.UnregisterAndDrain(&inst, gen, false);
+  stop.store(true);
+  for (auto & t : workers) {
+    t.join();
+  }
+  EXPECT_GT(cycles.load(), 0u);
+  EXPECT_EQ(registry_.Acquire(), nullptr);
+
+  // The registry survives the full cycle and accepts a new generation once
+  // the retired generation's cleanup is acknowledged.
+  registry_.MarkCleanupDone(gen);
+  const uint64_t gen2 = registry_.Register(&inst);
+  ASSERT_NE(gen2, 0u);
+  EXPECT_EQ(registry_.Acquire(), &inst);
+  registry_.Release();
+  registry_.UnregisterAndDrain(&inst, gen2, false);
+  registry_.MarkCleanupDone(gen2);
+}
+
+}  // namespace
