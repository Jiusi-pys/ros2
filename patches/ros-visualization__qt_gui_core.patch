From 78a2a0f9a08ab09089c220e32494b1748fce407f Mon Sep 17 00:00:00 2001
From: Yusheng Peng <jiusi0519@gmail.com>
Date: Sat, 29 Aug 2026 02:07:11 +0800
Subject: [PATCH] qt_gui_cpp_sip: OHOS cross build via standalone sip4

sip_configure.py is host-bound end to end (imports sip4's sipconfig, probes
host qmake); under OHOS_CROSS_BUILD generate the C++ with a standalone sip4
binary and cross-compile it with plain CMake instead.
---
 qt_gui_cpp/src/qt_gui_cpp_sip/CMakeLists.txt  | 16 +++-
 .../qt_gui_cpp_sip/qt_gui_cpp_sip_ohos.cmake  | 94 +++++++++++++++++++
 2 files changed, 107 insertions(+), 3 deletions(-)
 create mode 100644 qt_gui_cpp/src/qt_gui_cpp_sip/qt_gui_cpp_sip_ohos.cmake

diff --git a/qt_gui_cpp/src/qt_gui_cpp_sip/CMakeLists.txt b/qt_gui_cpp/src/qt_gui_cpp_sip/CMakeLists.txt
index 47c2495..b3cad8b 100644
--- a/qt_gui_cpp/src/qt_gui_cpp_sip/CMakeLists.txt
+++ b/qt_gui_cpp/src/qt_gui_cpp_sip/CMakeLists.txt
@@ -70,15 +70,24 @@ foreach(_lib_name ${_qt_gui_cpp_sip_LIBRARIES})
   endif()
 endforeach()
 
-find_package(python_qt_binding REQUIRED)
-include(${python_qt_binding_DIR}/sip_helper.cmake)
-
 ament_export_dependencies(pluginlib)
 include_directories(${PROJECT_NAME} ${qt_gui_cpp_INCLUDE_DIRECTORIES} ${deps_include_dirs})
 
 # The include directories used by build_sip_binding are different than the one set in include directories
 set(qt_gui_cpp_sip_INCLUDE_DIRS ${qt_gui_cpp_sip_INCLUDE_DIRS} ${deps_include_dirs})
 
+if(OHOS_CROSS_BUILD)
+  # sip_helper.cmake's sip4/sipconfig/Makefile pipeline is host-bound; use the
+  # standalone sip4 generator + cross toolchain variant instead.
+  include(${CMAKE_CURRENT_SOURCE_DIR}/qt_gui_cpp_sip_ohos.cmake)
+  if(qt_gui_cpp_sip_ohos_OK)
+    list(APPEND qt_gui_cpp_BINDINGS "sip")
+    set(qt_gui_cpp_BINDINGS "${qt_gui_cpp_BINDINGS}" PARENT_SCOPE)
+  endif()
+else()
+find_package(python_qt_binding REQUIRED)
+include(${python_qt_binding_DIR}/sip_helper.cmake)
+
 if(sip_helper_FOUND)
   list(APPEND qt_gui_cpp_BINDINGS "sip")
   set(qt_gui_cpp_BINDINGS "${qt_gui_cpp_BINDINGS}" PARENT_SCOPE)
@@ -101,3 +110,4 @@ if(sip_helper_FOUND)
   install(FILES ${CMAKE_CURRENT_BINARY_DIR}/libqt_gui_cpp_sip${LIBQT_GUI_CPP_SIP_SUFFIX}
       DESTINATION ${PYTHON_INSTALL_DIR}/${PROJECT_NAME})
 endif()
+endif()
diff --git a/qt_gui_cpp/src/qt_gui_cpp_sip/qt_gui_cpp_sip_ohos.cmake b/qt_gui_cpp/src/qt_gui_cpp_sip/qt_gui_cpp_sip_ohos.cmake
new file mode 100644
index 0000000..39be447
--- /dev/null
+++ b/qt_gui_cpp/src/qt_gui_cpp_sip/qt_gui_cpp_sip_ohos.cmake
@@ -0,0 +1,94 @@
+# OHOS cross build of the qt_gui_cpp sip bindings.
+#
+# python_qt_binding's sip_helper.cmake is host-bound end to end: it requires
+# sip4's python module (sipconfig), probes a *host* qmake and generates a
+# *host* Makefile via sipconfig. None of that can produce an aarch64-linux-ohos
+# binary from a Windows build host, so this file replaces the whole pipeline:
+#
+#   1. a standalone sip4 executable (conda-forge win-64 package, see
+#      OHOS_SIP4_EXECUTABLE) generates the binding C++ at configure time;
+#   2. the generated sources are compiled with the normal CMake cross
+#      toolchain into libqt_gui_cpp_sip.so (imported on the board as
+#      qt_gui_cpp.libqt_gui_cpp_sip).
+#
+# The sip include files come from the host PyQt5 installation (they are
+# platform independent); only the timeline/platform tags are adjusted.
+
+if(NOT DEFINED OHOS_SIP4_EXECUTABLE)
+  message(FATAL_ERROR
+    "qt_gui_cpp sip bindings for OHOS need -DOHOS_SIP4_EXECUTABLE=<sip4 binary> "
+    "(see target_deps_src/qt-host-tools/sip4)")
+endif()
+
+find_package(Python3 REQUIRED COMPONENTS Interpreter)
+
+# The PyQt5 sip include files are platform independent; take them from the
+# PyQt5 sdist used for the target build (NOT from a host python import - the
+# colcon environment puts the freshly installed *target* PyQt5 on PYTHONPATH,
+# whose .so files the host interpreter must never load).
+set(OHOS_PYQT5_SIP_DIR "" CACHE PATH
+  "directory with the PyQt5 .sip files (<PyQt5 sdist>/sip)")
+if(NOT OHOS_PYQT5_SIP_DIR OR NOT EXISTS "${OHOS_PYQT5_SIP_DIR}/QtCore/QtCoremod.sip")
+  message(FATAL_ERROR
+    "PyQt5 sip files not found; pass -DOHOS_PYQT5_SIP_DIR=<PyQt5 sdist>/sip")
+endif()
+set(_pyqt5_bindings_dir "${OHOS_PYQT5_SIP_DIR}")
+
+# SIP4 does not understand the py_ssize_t_clean directive that PyQt5 uses for
+# Qt >= 5.15.6, so work on a copied bindings tree with the directive stripped
+# (same workaround as python_qt_binding's sip_configure.py).
+set(_sip_inc_dir "${CMAKE_CURRENT_BINARY_DIR}/pyqt5_sip")
+file(REMOVE_RECURSE "${_sip_inc_dir}")
+file(COPY "${_pyqt5_bindings_dir}/" DESTINATION "${_sip_inc_dir}")
+file(READ "${_sip_inc_dir}/QtCore/QtCoremod.sip" _qtcore_sip)
+string(REGEX REPLACE ", py_ssize_t_clean=True" "" _qtcore_sip "${_qtcore_sip}")
+file(WRITE "${_sip_inc_dir}/QtCore/QtCoremod.sip" "${_qtcore_sip}")
+
+# Generate the binding sources at configure time so they can be globbed into a
+# normal CMake target. Platform tags: Qt_5_15_8 matches the host PyQt5 5.15.9
+# sip timeline and the target Qt 5.15.8; WS_X11 is the generic unix tag (the
+# host default WS_WIN would bind win32-only Qt APIs).
+set(_sip_gen_dir "${CMAKE_CURRENT_BINARY_DIR}/sip_ohos")
+file(REMOVE_RECURSE "${_sip_gen_dir}")
+file(MAKE_DIRECTORY "${_sip_gen_dir}")
+execute_process(
+  COMMAND ${OHOS_SIP4_EXECUTABLE} -c "${_sip_gen_dir}"
+    -I "${_sip_inc_dir}"
+    -n PyQt5.sip -t Qt_5_15_8 -t WS_X11 -w
+    qt_gui_cpp.sip
+  WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
+  RESULT_VARIABLE _sip_result
+  OUTPUT_VARIABLE _sip_out
+  ERROR_VARIABLE _sip_err)
+if(NOT _sip_result EQUAL 0)
+  message(FATAL_ERROR "sip4 failed on qt_gui_cpp.sip: ${_sip_out} ${_sip_err}")
+endif()
+
+file(GLOB _qt_gui_cpp_sip_SRCS CONFIGURE_DEPENDS "${_sip_gen_dir}/*.cpp")
+
+# The generated code includes <sip.h>; use the header matching the sip4 code
+# generator (PyQt5.sip runtime ABI 12 is backwards compatible with it).
+set(OHOS_SIP4_INCLUDE_DIR "" CACHE PATH
+  "directory containing sip4's sip.h")
+if(NOT OHOS_SIP4_INCLUDE_DIR)
+  message(FATAL_ERROR "set -DOHOS_SIP4_INCLUDE_DIR=<dir with sip.h of sip4>")
+endif()
+
+add_library(qt_gui_cpp_sip MODULE ${_qt_gui_cpp_sip_SRCS})
+set_target_properties(qt_gui_cpp_sip PROPERTIES
+  PREFIX "lib"
+  OUTPUT_NAME "qt_gui_cpp_sip"
+  SUFFIX "${CMAKE_SHARED_LIBRARY_SUFFIX}")
+target_include_directories(qt_gui_cpp_sip PRIVATE
+  "${OHOS_SIP4_INCLUDE_DIR}"
+  "${CMAKE_CURRENT_SOURCE_DIR}/../../include"
+  ${deps_include_dirs})
+target_link_libraries(qt_gui_cpp_sip PRIVATE
+  qt_gui_cpp
+  Python3::Python
+  Qt5::Widgets)
+
+install(TARGETS qt_gui_cpp_sip
+  LIBRARY DESTINATION ${PYTHON_INSTALL_DIR}/qt_gui_cpp)
+
+set(qt_gui_cpp_sip_ohos_OK TRUE)
-- 
