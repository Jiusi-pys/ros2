+// A syntactically valid higher-sequence ANNOUNCE must not be able to mutate
+// QoS under an existing endpoint GUID. This uses the raw transport ingress,
+// rather than a test-only Participant API, and proves that the rejected frame
+// leaves graph, matching, and reliable DATA sequence state untouched.
+TEST(DiscoveryAdmission, RawSameGuidWriterQosMutationIsRejectedAtomically) {
+  auto cfg = raw_admission_config();
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  std::atomic<size_t> graph_callbacks{0};
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  target->set_graph_callback(
+      [&] { graph_callbacks.fetch_add(1, std::memory_order_relaxed); });
+
+  auto *reader = target->create_reader("/qos_update_reader", "test/QosUpdate",
+                                       default_qos());
+  ASSERT_NE(reader, nullptr);
+  const auto reliable = raw_remote_snapshot(
+      0x43, {raw_remote_endpoint(0x43, mdds::EntityKind::WRITER, 1,
+                                 "/qos_update_reader", "test/QosUpdate")});
+  const mdds::Guid writer_guid = reliable.endpoints.front().guid;
+  const mdds::Guid writer_epoch = reliable.endpoints.front().epoch;
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, reliable, 1));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return reader->matched_count() == 1 &&
+               reader->compatible_matched_count() == 1 &&
+               graph_callbacks.load(std::memory_order_relaxed) >= 1;
+      },
+      2s, 10ms));
+
+  const uint8_t accepted[] = {0x51, 0x4f, 0x53, 0x31};
+  ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+  ASSERT_TRUE(peer.send_frame(mdds::encode_data(writer_guid, writer_epoch, 1, 0,
+                                                accepted, sizeof(accepted),
+                                                mdds::kFlagReliable),
+                              kTestBasePort5));
+  std::vector<uint8_t> out;
+  mdds::MessageInfo info;
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        return reader->take(out, info);
+      },
+      2s, 10ms));
+  EXPECT_EQ(out, std::vector<uint8_t>(accepted, accepted + sizeof(accepted)));
+
+  const size_t graph_before_mutation =
+      graph_callbacks.load(std::memory_order_relaxed);
+  auto mutation = reliable;
+  mutation.endpoints.front().qos.reliability = mdds::Reliability::BEST_EFFORT;
+  std::vector<uint8_t> mutation_frame;
+  ASSERT_TRUE(prepare_raw_announce_frame(peer, cfg.domain_id, kTestBasePort5,
+                                         mutation, 2, mutation_frame));
+  mdds::ParticipantSnapshot decoded_mutation;
+  uint64_t decoded_seq = 0;
+  ASSERT_TRUE(mdds::decode_announce(mutation_frame.data(),
+                                    mutation_frame.size(), decoded_mutation,
+                                    decoded_seq));
+  EXPECT_EQ(decoded_seq, 2u);
+  ASSERT_EQ(decoded_mutation.endpoints.size(), 1u);
+  EXPECT_EQ(decoded_mutation.endpoints.front().qos.reliability,
+            mdds::Reliability::BEST_EFFORT);
+
+  // Re-inject long enough to prove the actual callback has consumed the
+  // otherwise valid frame. Keeping PING alive prevents a peer-down event from
+  // being mistaken for the desired no-change result.
+  const auto reject_deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < reject_deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    ASSERT_TRUE(peer.send_frame(mutation_frame, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  const auto after_rejection = target->remote_participants();
+  ASSERT_EQ(after_rejection.size(), 1u);
+  ASSERT_EQ(after_rejection.front().endpoints.size(), 1u);
+  EXPECT_EQ(after_rejection.front().endpoints.front().qos.reliability,
+            mdds::Reliability::RELIABLE);
+  EXPECT_EQ(reader->matched_count(), 1u);
+  EXPECT_EQ(reader->compatible_matched_count(), 1u);
+  EXPECT_EQ(graph_callbacks.load(std::memory_order_relaxed),
+            graph_before_mutation);
+
+  // Reusing the rejected sequence number with a valid QoS-preserving snapshot
+  // proves that the rejected frame did not advance announce_seq.
+  auto recovered = reliable;
+  recovered.nodes.push_back({"/", "qos_writer_recovery"});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, recovered, 2));
+  ASSERT_TRUE(wait_until(
+      [&] {
+        peer.send_presence(cfg.domain_id, kTestBasePort5);
+        const auto remotes = target->remote_participants();
+        return remotes.size() == 1 && remotes.front().nodes.size() == 1 &&
+               remotes.front().nodes.front().name == "qos_writer_recovery" &&
+               reader->matched_count() == 1 &&
