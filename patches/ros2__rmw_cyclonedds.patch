+#ifndef RMW_CYCLONEDDS_CPP__SUBSCRIPTION_RESOURCE_LIMITS_HPP_
+#define RMW_CYCLONEDDS_CPP__SUBSCRIPTION_RESOURCE_LIMITS_HPP_
+
+#include <cstddef>
+
+#include <dds/dds.h>
+
+#include "rmw_cyclonedds_cpp/subscription_resource_limits.h"
+
+namespace rmw_cyclonedds_cpp
+{
+
+enum class SubscriptionResourceLimitsResult
+{
+  NONE,
+  APPLIED,
+  BAD_MAGIC,
+  BAD_VERSION,
+  BAD_SIZE,
+  BAD_VALUE,
+};
+
+inline SubscriptionResourceLimitsResult
+apply_subscription_resource_limits(
+  dds_qos_t * qos,
+  const void * payload) noexcept
+{
+  if (payload == nullptr) {
+    return SubscriptionResourceLimitsResult::NONE;
+  }
+  const auto * const limits =
+    static_cast<const rmw_cyclonedds_cpp_subscription_resource_limits_t *>(payload);
+  if (limits->magic != RMW_CYCLONEDDS_CPP_SUBSCRIPTION_RESOURCE_LIMITS_MAGIC) {
+    return SubscriptionResourceLimitsResult::BAD_MAGIC;
+  }
+  if (limits->version != RMW_CYCLONEDDS_CPP_SUBSCRIPTION_RESOURCE_LIMITS_VERSION) {
+    return SubscriptionResourceLimitsResult::BAD_VERSION;
+  }
+  if (limits->struct_size != sizeof(rmw_cyclonedds_cpp_subscription_resource_limits_t)) {
+    return SubscriptionResourceLimitsResult::BAD_SIZE;
+  }
+  if (limits->max_samples <= 0 || limits->max_instances <= 0 ||
+    limits->max_samples_per_instance <= 0 ||
+    limits->max_samples < limits->max_instances ||
+    limits->max_samples < limits->max_samples_per_instance)
+  {
+    return SubscriptionResourceLimitsResult::BAD_VALUE;
+  }
+  dds_qset_resource_limits(
+    qos, limits->max_samples, limits->max_instances, limits->max_samples_per_instance);
+  return SubscriptionResourceLimitsResult::APPLIED;
+}
+
+}  // namespace rmw_cyclonedds_cpp
+
+#endif  // RMW_CYCLONEDDS_CPP__SUBSCRIPTION_RESOURCE_LIMITS_HPP_
diff --git a/rmw_cyclonedds_cpp/test/test_subscription_resource_limits.cpp b/rmw_cyclonedds_cpp/test/test_subscription_resource_limits.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a99f6cae8ed8751f75a22e5efe91f7243e875a0a
--- /dev/null
+++ b/rmw_cyclonedds_cpp/test/test_subscription_resource_limits.cpp
@@ -0,0 +1,113 @@
+// Copyright 2026 Yusheng Peng
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include <gtest/gtest.h>
+
+#include <dds/dds.h>
+
+#include "rmw_cyclonedds_cpp/subscription_resource_limits.h"
+#include "subscription_resource_limits.hpp"
+
+namespace
+{
+
+rmw_cyclonedds_cpp_subscription_resource_limits_t valid_limits()
+{
+  return rmw_cyclonedds_cpp_subscription_resource_limits_t{
+    RMW_CYCLONEDDS_CPP_SUBSCRIPTION_RESOURCE_LIMITS_MAGIC,
+    RMW_CYCLONEDDS_CPP_SUBSCRIPTION_RESOURCE_LIMITS_VERSION,
+    static_cast<uint32_t>(sizeof(rmw_cyclonedds_cpp_subscription_resource_limits_t)),
+    32, 1, 32};
+}
+
+TEST(SubscriptionResourceLimits, AppliesExactCycloneReaderLimits)
+{
+  dds_qos_t * const qos = dds_create_qos();
+  ASSERT_NE(qos, nullptr);
+  const auto limits = valid_limits();
+  EXPECT_EQ(
+    rmw_cyclonedds_cpp::apply_subscription_resource_limits(qos, &limits),
+    rmw_cyclonedds_cpp::SubscriptionResourceLimitsResult::APPLIED);
+  int32_t max_samples = 0;
+  int32_t max_instances = 0;
+  int32_t max_samples_per_instance = 0;
+  dds_qget_resource_limits(qos, &max_samples, &max_instances, &max_samples_per_instance);
+  EXPECT_EQ(max_samples, 32);
+  EXPECT_EQ(max_instances, 1);
+  EXPECT_EQ(max_samples_per_instance, 32);
+  dds_delete_qos(qos);
+}
+
+TEST(SubscriptionResourceLimits, RejectsMalformedPayloadWithoutChangingQos)
+{
+  dds_qos_t * const qos = dds_create_qos();
+  ASSERT_NE(qos, nullptr);
+  int32_t expected_max_samples = 0;
+  int32_t expected_max_instances = 0;
+  int32_t expected_max_samples_per_instance = 0;
+  dds_qget_resource_limits(
+    qos, &expected_max_samples, &expected_max_instances, &expected_max_samples_per_instance);
+  auto limits = valid_limits();
+  limits.magic = 0;
+  EXPECT_EQ(
+    rmw_cyclonedds_cpp::apply_subscription_resource_limits(qos, &limits),
+    rmw_cyclonedds_cpp::SubscriptionResourceLimitsResult::BAD_MAGIC);
+  limits = valid_limits();
+  limits.version++;
+  EXPECT_EQ(
+    rmw_cyclonedds_cpp::apply_subscription_resource_limits(qos, &limits),
+    rmw_cyclonedds_cpp::SubscriptionResourceLimitsResult::BAD_VERSION);
+  limits = valid_limits();
+  limits.struct_size--;
+  EXPECT_EQ(
+    rmw_cyclonedds_cpp::apply_subscription_resource_limits(qos, &limits),
+    rmw_cyclonedds_cpp::SubscriptionResourceLimitsResult::BAD_SIZE);
+  limits = valid_limits();
+  limits.max_samples = 0;
+  EXPECT_EQ(
+    rmw_cyclonedds_cpp::apply_subscription_resource_limits(qos, &limits),
+    rmw_cyclonedds_cpp::SubscriptionResourceLimitsResult::BAD_VALUE);
+  int32_t max_samples = 0;
+  int32_t max_instances = 0;
+  int32_t max_samples_per_instance = 0;
+  dds_qget_resource_limits(qos, &max_samples, &max_instances, &max_samples_per_instance);
+  EXPECT_EQ(max_samples, expected_max_samples);
+  EXPECT_EQ(max_instances, expected_max_instances);
+  EXPECT_EQ(max_samples_per_instance, expected_max_samples_per_instance);
+  dds_delete_qos(qos);
+}
+
+TEST(SubscriptionResourceLimits, NullPayloadLeavesPortableDefaultUntouched)
+{
+  dds_qos_t * const qos = dds_create_qos();
+  ASSERT_NE(qos, nullptr);
+  int32_t expected_max_samples = 0;
+  int32_t expected_max_instances = 0;
+  int32_t expected_max_samples_per_instance = 0;
+  dds_qget_resource_limits(
+    qos, &expected_max_samples, &expected_max_instances, &expected_max_samples_per_instance);
+  EXPECT_EQ(
+    rmw_cyclonedds_cpp::apply_subscription_resource_limits(qos, nullptr),
+    rmw_cyclonedds_cpp::SubscriptionResourceLimitsResult::NONE);
+  int32_t max_samples = 0;
+  int32_t max_instances = 0;
+  int32_t max_samples_per_instance = 0;
+  dds_qget_resource_limits(qos, &max_samples, &max_instances, &max_samples_per_instance);
+  EXPECT_EQ(max_samples, expected_max_samples);
+  EXPECT_EQ(max_instances, expected_max_instances);
+  EXPECT_EQ(max_samples_per_instance, expected_max_samples_per_instance);
+  dds_delete_qos(qos);
+}
+
+}  // namespace
