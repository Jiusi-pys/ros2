+#include "OgreException.h"
+#include "OgreLogManager.h"
+#include "OgreStringConverter.h"
+#include "OgreRoot.h"
+
+#include "OgreOHOSEGLSupport.h"
+#include "OgreOHOSEGLWindow.h"
+#include "OgreGLUtil.h"
+
+namespace Ogre {
+
+    GLNativeSupport* getGLSupport(int)
+    {
+        return new OHOSEGLSupport();
+    }
+
+    OHOSEGLSupport::OHOSEGLSupport() : EGLSupport(CONTEXT_ES)
+    {
+        mNativeDisplay = EGL_DEFAULT_DISPLAY;
+        mGLDisplay = getGLDisplay();
+
+        // No real display on OHOS boards; report one dummy mode.
+        mCurrentMode.width = 1280;
+        mCurrentMode.height = 800;
+        mCurrentMode.refreshRate = 0;
+        mOriginalMode = mCurrentMode;
+        mVideoModes.push_back(mCurrentMode);
+    }
+
+    OHOSEGLSupport::~OHOSEGLSupport()
+    {
+    }
+
+    void OHOSEGLSupport::switchMode( uint& width, uint& height, short& frequency )
+    {
+    }
+
+    RenderWindow* OHOSEGLSupport::newWindow( const String &name, unsigned int width, unsigned int height, bool fullScreen, const NameValuePairList *miscParams)
+    {
+        OHOSEGLWindow* window = new OHOSEGLWindow(this);
+        window->create(name, width, height, fullScreen, miscParams);
+
+        return window;
+    }
+}
diff --git a/RenderSystems/GLSupport/src/EGL/OHOS/OgreOHOSEGLWindow.cpp b/RenderSystems/GLSupport/src/EGL/OHOS/OgreOHOSEGLWindow.cpp
