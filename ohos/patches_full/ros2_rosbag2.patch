diff --git a/rosbag2_transport/cmake/ohos_direct_launcher.cpp.in b/rosbag2_transport/cmake/ohos_direct_launcher.cpp.in
new file mode 100644
index 00000000..53b7bb4a
--- /dev/null
+++ b/rosbag2_transport/cmake/ohos_direct_launcher.cpp.in
@@ -0,0 +1,29 @@
+#include <exception>
+#include <memory>
+#include <vector>
+
+#include "rclcpp/rclcpp.hpp"
+
+#include "@SOURCE_FILE@"
+
+int main(int argc, char * argv[])
+{
+  std::vector<std::string> args = rclcpp::init_and_remove_ros_arguments(argc, argv);
+  rclcpp::executors::SingleThreadedExecutor executor;
+  rclcpp::NodeOptions options;
+  options.arguments(args);
+
+  try {
+    auto node = std::make_shared<@NODE_TYPE@>(options);
+    executor.add_node(node);
+    executor.spin();
+    executor.remove_node(node);
+  } catch (const std::exception & ex) {
+    RCLCPP_ERROR(rclcpp::get_logger("@LOGGER_NAME@"), "%s", ex.what());
+    rclcpp::shutdown();
+    return 1;
+  }
+
+  rclcpp::shutdown();
+  return 0;
+}
