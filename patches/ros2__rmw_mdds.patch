+namespace
+{
+
+TEST(SpinThreadGuard, ReportsThrowingWakeupAndStillJoins)
+{
+  std::atomic<bool> stop{false};
+  std::atomic<bool> worker_exited{false};
+  std::thread worker([&stop, &worker_exited]() {
+    while (!stop.load(std::memory_order_acquire)) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    worker_exited.store(true, std::memory_order_release);
+  });
+  size_t wakeup_calls = 0;
+  auto throwing_wakeup = [&wakeup_calls]() {
+      ++wakeup_calls;
+      throw std::runtime_error("injected cancel failure");
+    };
+  mdds_gateway::SpinThreadGuard<decltype(throwing_wakeup)> guard(
+    stop, worker, std::move(throwing_wakeup));
+
+  EXPECT_FALSE(guard.stop_and_join());
+  EXPECT_EQ(wakeup_calls, 1u);
+  EXPECT_FALSE(worker.joinable());
+  EXPECT_TRUE(worker_exited.load(std::memory_order_acquire));
+}
+
+TEST(SpinThreadGuard, DestructorContainsThrowingWakeupAndJoins)
+{
+  std::atomic<bool> stop{false};
+  std::atomic<bool> worker_exited{false};
+  std::thread worker([&stop, &worker_exited]() {
+    while (!stop.load(std::memory_order_acquire)) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    worker_exited.store(true, std::memory_order_release);
+  });
+  auto throwing_wakeup = []() {
+      throw std::runtime_error("injected cancel failure");
+    };
+  {
+    mdds_gateway::SpinThreadGuard<decltype(throwing_wakeup)> guard(
+      stop, worker, std::move(throwing_wakeup));
+  }
+  EXPECT_FALSE(worker.joinable());
+  EXPECT_TRUE(worker_exited.load(std::memory_order_acquire));
+}
+
