+    EXPECT_EQ(reader->messages_lost(), 0u);
+    EXPECT_GE(seq2_sends.load(std::memory_order_relaxed), 2u);
+    EXPECT_GE(seq3_sends.load(std::memory_order_relaxed), 2u);
+    std::printf("MDDS_REORDER_BUDGET CASE=%s RESULT=PASS\n", budget.name);
+    std::fflush(stdout);
