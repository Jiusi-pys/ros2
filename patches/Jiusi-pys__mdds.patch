+// ParticipantConfig limits are never "0 means unbounded": a zero cap is a
+// fail-closed policy. This specifically catches a common unsafe convention
+// where callers use zero to request a default, accidentally bypassing remote
+// discovery admission entirely.
+TEST(DiscoveryAdmission, ZeroParticipantCapRejectsEveryNewGuid) {
+  auto cfg = raw_admission_config();
+  cfg.max_remote_participants = 0;
+  RawUdpPeer peer(kTestBasePort5 + 7);
+  ASSERT_TRUE(peer.valid());
+  auto target = mdds::Participant::create(cfg);
+  ASSERT_NE(target, nullptr);
+  const auto snapshot = raw_remote_snapshot(
+      0x31, {raw_remote_endpoint(0x31, mdds::EntityKind::WRITER, 1,
+                                  "/zero", "test/Zero")});
+  ASSERT_TRUE(raw_announce(peer, cfg.domain_id, kTestBasePort5, snapshot, 1));
+
+  const auto deadline = std::chrono::steady_clock::now() + 300ms;
+  while (std::chrono::steady_clock::now() < deadline) {
+    ASSERT_TRUE(peer.send_presence(cfg.domain_id, kTestBasePort5));
+    std::this_thread::sleep_for(10ms);
+  }
+  EXPECT_EQ(target->graph_counts().remote_participants, 0u);
+}
