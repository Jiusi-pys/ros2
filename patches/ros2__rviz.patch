+++ b/rviz_rendering/ogre_media/materials/glsles/nogp/nogp.program
@@ -0,0 +1,89 @@
+// OHOS/GLES2 port of nogp.program (GLSL ES 1.00); program names unchanged.
+// These shaders are work-arounds in case geometry shaders
+// are not supported, so vertices can't be created on the graphics card.
+// Multiple vertices are passed in for each primitive,
+// and each one is offset according to its texture coords.
+// NB: glsles has no `attach` support; passDepth() is inlined under
+// #ifdef WITH_DEPTH in the sources.
+
+vertex_program rviz/glsl120/nogp/billboard_tile.vert glsles
+{
+  source billboard_tile.vert
+  default_params
+  {
+    param_named_auto worldviewproj_matrix worldviewproj_matrix
+    param_named_auto size custom          0
+    param_named_auto normal custom 3
+    param_named_auto up custom 4
+  }
+}
+vertex_program rviz/glsl120/nogp/billboard_tile.vert(with_depth) glsles
+{
+  source billboard_tile.vert
+  preprocessor_defines WITH_DEPTH=1
+  default_params
+  {
+    param_named_auto worldviewproj_matrix worldviewproj_matrix
+    param_named_auto worldview_matrix     worldview_matrix
+    param_named_auto size custom          0
+    param_named_auto normal custom 3
+    param_named_auto up custom 4
+  }
+}
+
+
+vertex_program rviz/glsl120/nogp/billboard.vert glsles
+{
+  source billboard.vert
+  default_params {
+    param_named_auto worldviewproj_matrix worldviewproj_matrix
+    param_named_auto camera_pos           camera_position_object_space
+    param_named_auto size custom          0
+    param_named_auto auto_size custom     6
+  }
+}
+vertex_program rviz/glsl120/nogp/billboard.vert(with_depth) glsles
+{
+  source billboard.vert
+  preprocessor_defines WITH_DEPTH=1
+  default_params {
+    param_named_auto worldviewproj_matrix worldviewproj_matrix
+    param_named_auto worldview_matrix     worldview_matrix
+    param_named_auto camera_pos           camera_position_object_space
+    param_named_auto size custom          0
+    param_named_auto auto_size custom     6
+  }
+}
+
+
+vertex_program rviz/glsl120/nogp/box.vert glsles
+{
+  source box.vert
+  default_params {
+    param_named_auto worldviewproj_matrix worldviewproj_matrix
+    param_named_auto size custom          0
+    param_named_auto auto_size custom     6
+  }
+}
+vertex_program rviz/glsl120/nogp/box.vert(with_depth) glsles
+{
+  source box.vert
+  preprocessor_defines WITH_DEPTH=1
+  default_params {
+    param_named_auto worldviewproj_matrix worldviewproj_matrix
+    param_named_auto worldview_matrix     worldview_matrix
+    param_named_auto size custom          0
+    param_named_auto auto_size custom     6
+  }
+}
+
+
+fragment_program rviz/glsl120/nogp/box.frag glsles
+{
+  source box.frag
+  default_params
+  {
+    param_named_auto highlight custom 5
+    param_named_auto alpha custom 1
+  }
+}
