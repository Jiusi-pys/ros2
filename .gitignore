# Ignore default names for colcon created folders
build
install
log

# OHOS cross-build output and board test logs
build_ohos
install_ohos
log_ohos
ohos_test_logs
# target-side Python staging (pulled from board / cross-built wheels)
python_target
# target_deps_src holds downloaded source trees and tarballs (reproducible via
# the build scripts); track only the cross-build scripts, patches and helpers
target_deps_src/*
!target_deps_src/*.sh
!target_deps_src/*.patch
!target_deps_src/COLCON_IGNORE
!target_deps_src/ohos-autotools-bin
!target_deps_src/qt-host-tools
target_deps_src/qt-host-tools/*
!target_deps_src/qt-host-tools/cross-qmake.bat
!target_deps_src/pyqt
target_deps_src/pyqt/*
!target_deps_src/pyqt/*.sh
!target_deps_src/pyqt/sip_build.py
!target_deps_src/qt_smoke
target_deps_src/qt_smoke/*
!target_deps_src/qt_smoke/*.sh
!target_deps_src/qt_smoke/*.cpp
# deploy artifacts (generated by scripts/deploy_ohos.sh)
ros2_ohos_install.tar.gz
scripts/env.sh
# stray source tarball (canonical location is target_deps_src/)
lttng-ust-*.tar.bz2

# Python bytecode caches (board_sweep.py and helpers are run in place)
__pycache__

# Ignore everything in src except a .gitkeep file
src/*
!src/.gitkeep
