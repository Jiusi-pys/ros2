+bool
+is_safe_topic(const std::string & value)
+{
+  if (value.size() < 2 || value.front() != '/' || value.size() > 240) {
+    return false;
+  }
+  for (const char c : value) {
+    const bool accepted =
+      (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+      (c >= '0' && c <= '9') || c == '_' || c == '/' || c == '-';
+    if (!accepted) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool
+is_safe_type(const std::string & value)
+{
+  if (value.empty() || value.size() > 240) {
+    return false;
+  }
+  for (const char c : value) {
+    const bool accepted =
+      (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+      (c >= '0' && c <= '9') || c == '_' || c == '/';
+    if (!accepted) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool
+parse_u32(const char * value, uint32_t & out)
+{
+  if (value == nullptr || *value == '\0') {
+    return false;
+  }
+  char * end = nullptr;
+  errno = 0;
+  const unsigned long parsed = std::strtoul(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0' || parsed > UINT32_MAX) {
+    return false;
+  }
+  out = static_cast<uint32_t>(parsed);
+  return true;
+}
